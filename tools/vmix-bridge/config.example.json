{
  "logLevel": "info",
  "feed": {
    "url": "https://cloud1-7g8ckb3c7815a011-1419431905.ap-shanghai.app.tcloudbase.com/webLoginApi",
    "method": "POST",
    "token": "<LIVE_FEED_TOKEN>",
    "body": {
      "action": "liveFeed",
      "matchId": "<MATCH_ID>"
    },
    "headers": { "Content-Type": "application/json" },
    "pollIntervalMs": 2000,
    "timeoutMs": 8000
  },
  "vmix": { "host": "127.0.0.1", "port": 8088, "timeoutMs": 5000 },
  "mappings": {
    "clock":     { "input": "Scoreboard", "field": "Clock" },
    "period":    { "input": "Scoreboard", "field": "Period" },
    "homeName":  { "input": "Scoreboard", "field": "HomeName" },
    "awayName":  { "input": "Scoreboard", "field": "AwayName" },
    "homeShort": { "input": "Scoreboard", "field": "HomeShort" },
    "awayShort": { "input": "Scoreboard", "field": "AwayShort" },
    "homeScore": { "input": "Scoreboard", "field": "HomeScore" },
    "awayScore": { "input": "Scoreboard", "field": "AwayScore" }
  },
  "events": {
    "overlayInput": "EventOverlay",
    "titleField": "EventTitle",
    "detailField": "EventDetail",
    "showDurationMs": 5000
  },
  "cacheDir": "cache",
  "stateFile": "state.json",
  "clockTickMs": 1000
}
