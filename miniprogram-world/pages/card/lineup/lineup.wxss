.brand-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.brand-name {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: #ffffff;
}

.brand-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8b93a3;
}

.size-tabs {
  display: flex;
  margin-bottom: 18rpx;
}

.size-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  padding: 16rpx 8rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.size-tab:last-child {
  margin-right: 0;
}

.size-tab.is-on {
  background: rgba(228, 176, 74, 0.12);
  border-color: rgba(228, 176, 74, 0.55);
}

.size-tab.is-locked {
  opacity: 0.6;
}

.size-title {
  font-size: 25rpx;
  color: #f2f4f8;
}

.size-sub {
  margin-top: 2rpx;
  font-size: 19rpx;
  color: #8b93a3;
}

.size-tab.is-on .size-title {
  color: #f6d98b;
}

.progress {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.progress-track {
  flex: 1;
  height: 10rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.08);
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #c88f2c 0%, #f6d98b 100%);
  transition: width 240ms ease;
}

.progress-text {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #e4b04a;
}

.lineup-tip {
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: #8b93a3;
}

.lineup-actions {
  display: flex;
  margin-top: 20rpx;
}

.save-btn {
  flex: none;
  width: 220rpx;
}

.challenge-btn {
  flex: 1;
  margin-left: 16rpx;
}

.log-entry {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.log-icon {
  width: 36rpx;
  height: 36rpx;
}

.log-text {
  flex: 1;
  margin-left: 14rpx;
  font-size: 26rpx;
  color: #dfe4ee;
}

.log-arrow {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.6;
}

.rule-note {
  margin-top: 20rpx;
  text-align: center;
  font-size: 21rpx;
  line-height: 1.6;
  color: #6f7683;
}

.picker-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(4, 6, 10, 0.7);
  z-index: 940;
  display: flex;
  align-items: flex-end;
}

.picker {
  width: 100%;
  max-height: 72vh;
  padding: 28rpx 28rpx 40rpx;
  box-sizing: border-box;
  border-radius: 28rpx 28rpx 0 0;
  background: #10141c;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.picker-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #f2f4f8;
}

.picker-close {
  font-size: 24rpx;
  color: #8b93a3;
  padding: 8rpx;
}

.picker-list {
  max-height: 56vh;
  margin-top: 18rpx;
}

.chip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 22rpx;
  margin-bottom: 12rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.chip-name {
  font-size: 26rpx;
  color: #f2f4f8;
}

.chip.is-remove {
  justify-content: center;
  background: rgba(240, 116, 92, 0.08);
  border-color: rgba(240, 116, 92, 0.28);
}

.chip.is-remove .chip-name {
  color: #f0745c;
}
