.brand-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 26rpx;
}

.brand-name {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: #ffffff;
}

.brand-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: #8b93a3;
}

.sign-panel {
  padding: 28rpx 26rpx 26rpx;
}

.sign-copy {
  display: flex;
  flex-direction: column;
}

.quota-text {
  font-size: 22rpx;
  color: #e4b04a;
}

.sign-main {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(228, 176, 74, 0.06);
  border: 1rpx solid rgba(228, 176, 74, 0.18);
}

.sign-icon {
  width: 44rpx;
  height: 44rpx;
}

.sign-main-copy {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
}

.sign-main-title {
  font-size: 26rpx;
  color: #f2f4f8;
}

.sign-main-sub {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #8b93a3;
}

.sign-btn {
  margin-top: 24rpx;
}

.directed-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.07);
}

.directed-copy {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.directed-title {
  font-size: 26rpx;
  color: #f2f4f8;
}

.directed-sub {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #8b93a3;
}

.directed-btn {
  width: 200rpx;
  height: 68rpx;
  font-size: 24rpx;
  flex: none;
}

.member-panel {
  margin-top: 24rpx;
}

.member-icon {
  width: 34rpx;
  height: 34rpx;
  margin-right: 10rpx;
}

.member-title {
  font-size: 30rpx;
}

.member-line {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-top: 18rpx;
}

.member-key {
  font-size: 24rpx;
  color: #8b93a3;
  flex: none;
}

.member-value {
  font-size: 24rpx;
  color: #dfe4ee;
  text-align: right;
}

.member-value-col {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.member-note {
  display: block;
  margin-top: 20rpx;
  font-size: 21rpx;
  color: #6f7683;
}

.album-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 30rpx 4rpx 18rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.tile {
  width: 33.333%;
  padding: 0 8rpx 20rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.tile-card {
  position: relative;
  width: 100%;
  padding-top: 133.33%;
  border-radius: 16rpx;
  overflow: hidden;
  background: #10131a;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.tile-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.tile-main {
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  color: #201603;
  background: linear-gradient(135deg, #f6d98b, #e4b04a);
}

.tile-name {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #f2f4f8;
}

.tile-meta {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #8b93a3;
}

.tile-ovr {
  font-size: 20rpx;
  color: #e4b04a;
}

.empty {
  padding: 70rpx 0;
  text-align: center;
  font-size: 25rpx;
  color: #8b93a3;
}

.last-signed {
  margin-top: 12rpx;
  text-align: center;
  font-size: 21rpx;
  color: #6f7683;
}
