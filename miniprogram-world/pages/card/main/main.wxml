<view class="wx-page">
  <view class="topbar">
    <image class="topbar-logo" src="/assets/card/card-world-icon.jpg" mode="aspectFill"></image>
    <view class="topbar-title">
      <text class="topbar-name">赛小蜂足球世界</text>
      <text class="topbar-sub">我的主卡 · 签约 · 组阵</text>
    </view>
    <view class="tag">{{card.cityText}}</view>
  </view>

  <view class="panel hero-panel">
    <view class="row-between panel-head">
      <text class="section-title">我的主卡</text>
      <text class="head-hint">{{card.headHint}}</text>
    </view>

    <view class="card-stage">
      <holo-card id="main-holo" card-url="{{card.cardUrl}}" aria-label="{{cardLabel}}" tip-text="{{card.foilTip}}"></holo-card>
    </view>

    <view class="stats-grid">
      <view class="stat" wx:for="{{stats}}" wx:key="label">
        <text class="stat-num">{{item.num}}</text>
        <text class="stat-label">{{item.label}}</text>
      </view>
    </view>

    <view class="quick-nav">
      <view class="quick-nav-btn" bindtap="goLineup" role="button" aria-label="去组阵">
        <image class="quick-nav-ico" src="/assets/icons/tab-pitch.svg" mode="aspectFit"></image>
        <view class="quick-nav-txt">
          <text class="quick-nav-strong">去组阵</text>
          <text class="quick-nav-em">凑齐 5 人发起轻挑战</text>
        </view>
      </view>
      <view class="quick-nav-btn" bindtap="goAlbum" role="button" aria-label="去签约">
        <image class="quick-nav-ico" src="/assets/icons/icon-sign.svg" mode="aspectFit"></image>
        <view class="quick-nav-txt">
          <text class="quick-nav-strong">去签约</text>
          <text class="quick-nav-em">每日免费收样卡</text>
        </view>
      </view>
    </view>

    <view class="action-row">
      <button class="action-btn action-btn-gold" open-type="share" hover-class="none">分享主卡</button>
      <view class="action-btn action-btn-ghost" bindtap="goGrowth" role="button" aria-label="成长印记">成长印记</view>
      <view class="action-btn action-btn-ghost" bindtap="goMe" role="button" aria-label="我的">我的</view>
    </view>

    <view class="log-line" bindtap="goLog" role="button" aria-label="轻对战战报">
      <image class="log-line-icon" src="/assets/icons/icon-log.svg" mode="aspectFit"></image>
      <text class="log-line-text">轻对战战报 · 最近 20 场</text>
      <image class="log-line-arrow" src="/assets/icons/icon-arrow.svg" mode="aspectFit"></image>
    </view>
  </view>

  <view class="panel marks-panel">
    <view class="row-between panel-head">
      <text class="section-title">成长印记</text>
      <text class="tiny muted">按周解锁边框 / 贴纸</text>
    </view>
    <view class="stamps">
      <view class="stamp {{item.lockedClass}}" wx:for="{{stamps}}" wx:key="key">
        <text class="stamp-icon">{{item.icon}}</text>
        <text class="stamp-name">{{item.name}}</text>
        <text class="stamp-state">{{item.stateText}}</text>
      </view>
    </view>
  </view>

  <view class="portrait-note" wx:if="{{card.portraitNote}}">{{card.portraitNote}}</view>

  <view class="foot-note">不随机发放、不可交易 · 主卡与卡册跟随赛事数据</view>
</view>

<card-tabbar current="main"></card-tabbar>
