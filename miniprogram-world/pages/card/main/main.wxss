/* 主卡页：对齐 H5 卡世界（我的主卡）视图 */

.topbar {
  display: flex;
  align-items: center;
  margin-bottom: 26rpx;
}

.topbar-logo {
  width: 78rpx;
  height: 78rpx;
  border-radius: 20rpx;
  flex: none;
  background: #06140a;
  box-shadow: 0 0 0 2rpx rgba(87, 226, 124, 0.35), 0 6rpx 16rpx rgba(0, 0, 0, 0.4);
}

.topbar-title {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
  display: flex;
  flex-direction: column;
}

.topbar-name {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #f8fafc;
}

.topbar-sub {
  margin-top: 4rpx;
  font-size: 21rpx;
  letter-spacing: 1rpx;
  color: #8b93a3;
}

.hero-panel {
  padding: 26rpx 24rpx 24rpx;
}

.panel-head {
  margin-bottom: 10rpx;
}

.head-hint {
  font-size: 22rpx;
  color: #8b93a3;
}

.card-stage {
  width: 100%;
  max-width: 520rpx;
  margin: 12rpx auto 0;
}

/* 四格数据，与 H5 stats-grid 一致 */
.stats-grid {
  display: flex;
  margin-top: 18rpx;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-left: 10rpx;
  padding: 18rpx 6rpx 14rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.04);
}

.stat:first-child {
  margin-left: 0;
}

.stat-num {
  font-size: 38rpx;
  font-weight: 700;
  color: #f6d98b;
  line-height: 1.1;
}

.stat-label {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #8b93a3;
}

/* 快捷入口：去组阵 / 去签约 */
.quick-nav {
  display: flex;
  margin-top: 18rpx;
}

.quick-nav-btn {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
  margin-left: 12rpx;
  padding: 18rpx 16rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(240, 199, 94, 0.28);
  background: linear-gradient(135deg, rgba(240, 199, 94, 0.1), rgba(31, 143, 78, 0.08));
}

.quick-nav-btn:first-child {
  margin-left: 0;
}

.quick-nav-ico {
  width: 52rpx;
  height: 52rpx;
  flex: none;
  border-radius: 14rpx;
  background: rgba(0, 0, 0, 0.28);
}

.quick-nav-txt {
  display: flex;
  flex-direction: column;
  min-width: 0;
  margin-left: 14rpx;
}

.quick-nav-strong {
  font-size: 25rpx;
  font-weight: 700;
  color: #e4b04a;
}

.quick-nav-em {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #9aa3b5;
}

/* 三个操作：分享主卡 / 成长印记 / 我的 */
.action-row {
  display: flex;
  margin-top: 18rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  margin-left: 12rpx;
  padding: 0;
  border-radius: 18rpx;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 88rpx;
}

.action-btn:first-child {
  margin-left: 0;
}

.action-btn::after {
  border: none;
}

.action-btn-gold {
  color: #1a1408;
  background: linear-gradient(135deg, #f6d98b 0%, #e4b04a 55%, #c88f2c 100%);
  box-shadow: 0 10rpx 22rpx rgba(235, 178, 8, 0.3);
}

.action-btn-ghost {
  color: #e8e6e0;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.07);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.log-line {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.log-line-icon {
  width: 34rpx;
  height: 34rpx;
  flex: none;
}

.log-line-text {
  flex: 1;
  min-width: 0;
  margin-left: 12rpx;
  font-size: 23rpx;
  color: #cfd5e0;
}

.log-line-arrow {
  width: 26rpx;
  height: 26rpx;
  opacity: 0.6;
}

.marks-panel {
  margin-top: 24rpx;
}

.stamps {
  display: flex;
  margin-top: 14rpx;
}

.stamp {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
  margin-left: 10rpx;
  padding: 16rpx 4rpx 14rpx;
  border-radius: 16rpx;
  background: rgba(251, 191, 36, 0.13);
  border: 1rpx solid rgba(251, 191, 36, 0.4);
}

.stamp:first-child {
  margin-left: 0;
}

.stamp.is-locked {
  background: rgba(255, 255, 255, 0.04);
  border-color: rgba(255, 255, 255, 0.08);
}

.stamp-icon {
  font-size: 32rpx;
  line-height: 1.2;
}

.stamp-name {
  margin-top: 6rpx;
  font-size: 21rpx;
  font-weight: 600;
  color: #fde68a;
}

.stamp.is-locked .stamp-name {
  color: #e2e8f0;
}

.stamp-state {
  margin-top: 4rpx;
  font-size: 19rpx;
  color: #86efac;
}

.stamp.is-locked .stamp-state {
  color: #64748b;
}

.portrait-note {
  margin-top: 18rpx;
  font-size: 22rpx;
  color: #8b93a3;
}

.foot-note {
  margin-top: 24rpx;
  text-align: center;
  font-size: 21rpx;
  letter-spacing: 1rpx;
  color: #6f7683;
}
