/* 赛小蜂足球世界 · 全局基础样式（深空黑 + 熔金，独立于球队端视觉） */

page {
  background: #07090f;
  color: #f2f4f8;
  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.wx-page {
  min-height: 100vh;
  padding: 32rpx 28rpx 180rpx;
  box-sizing: border-box;
  background:
    radial-gradient(120% 60% at 50% 0%, rgba(228, 176, 74, 0.14) 0%, rgba(7, 9, 15, 0) 55%),
    radial-gradient(90% 50% at 100% 30%, rgba(64, 118, 196, 0.12) 0%, rgba(7, 9, 15, 0) 60%),
    #07090f;
}

.panel {
  background: linear-gradient(160deg, rgba(24, 29, 39, 0.94) 0%, rgba(13, 16, 23, 0.94) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.45);
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.grow {
  flex: 1;
  min-width: 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #f2f4f8;
}

.section-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8b93a3;
}

.gold-text {
  color: #e4b04a;
}

.muted {
  color: #8b93a3;
}

.tiny {
  font-size: 22rpx;
}

.mono {
  font-family: 'SF Mono', Menlo, Consolas, monospace;
}

.divider {
  height: 1rpx;
  background: rgba(255, 255, 255, 0.08);
  margin: 24rpx 0;
}

.btn-gold {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  color: #201603;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  background: linear-gradient(135deg, #f6d98b 0%, #e4b04a 55%, #c88f2c 100%);
  box-shadow: 0 10rpx 26rpx rgba(228, 176, 74, 0.28);
}

.btn-gold.is-disabled {
  color: #6f6a5e;
  background: linear-gradient(135deg, #2a2c31 0%, #22242a 100%);
  box-shadow: none;
}

.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  border-radius: 40rpx;
  color: #e4b04a;
  font-size: 28rpx;
  border: 1rpx solid rgba(228, 176, 74, 0.55);
  background: rgba(228, 176, 74, 0.06);
}

.btn-ghost.is-disabled {
  color: #6f747f;
  border-color: rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.03);
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #e4b04a;
  background: rgba(228, 176, 74, 0.1);
  border: 1rpx solid rgba(228, 176, 74, 0.32);
}

.tag.is-dim {
  color: #8b93a3;
  background: rgba(255, 255, 255, 0.04);
  border-color: rgba(255, 255, 255, 0.1);
}

.safe-bottom {
  height: env(safe-area-inset-bottom);
}

.empty {
  padding: 64rpx 0;
  text-align: center;
  color: #8b93a3;
  font-size: 26rpx;
}

.toast {
  position: fixed;
  left: 50%;
  bottom: 220rpx;
  transform: translateX(-50%);
  max-width: 560rpx;
  padding: 18rpx 30rpx;
  border-radius: 40rpx;
  background: rgba(12, 15, 21, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  color: #f2f4f8;
  font-size: 25rpx;
  text-align: center;
  z-index: 900;
}
