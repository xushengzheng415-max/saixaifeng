/* 全息主卡：对齐 H5 卡世界 player-card-holo（holo-cosmos）
   卡面比例 0.698 / 卡形遮罩内置 base64（不依赖端上加载本地 wxss 图片）/ 星空箔光 / 扫光 / 手指跟随 + 默认循环 */

.holo-wrap {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  perspective: 900px;
}

.holo {
  --card-mask: url("data:image/png;base64,");
  position: relative;
  width: 100%;
  padding-top: 143.27%; /* 卡面 300x430，比例 0.6977 */
  background: transparent;
  transform-style: preserve-3d;
  transition: transform 320ms cubic-bezier(0.2, 0.7, 0.2, 1);
  filter:
    drop-shadow(0 22rpx 34rpx rgba(0, 0, 0, 0.66))
    drop-shadow(0 0 22rpx rgba(240, 199, 94, 0.26));
  will-change: transform;
  /* 未按压/未扫光时默认轻摆，对齐 H5 cosmos-idle-tilt */
  animation: holoSway 7s ease-in-out infinite alternate;
}

.holo.is-active {
  animation: none;
  transition: transform 90ms linear;
}

@keyframes holoSway {
  0% { transform: rotateX(3deg) rotateY(-5deg); }
  100% { transform: rotateX(-3deg) rotateY(5deg); }
}

.card-art {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

/* 卡形遮罩：箔光只落在卡面轮廓内（把卡面 alpha 缩成 150x215 内置成 base64） */
.card-shine,
.card-sweep,
.card-glare {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  pointer-events: none;
  -webkit-mask-image: var(--card-mask);
  -webkit-mask-size: 100% 100%;
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: 0 0;
  mask-image: var(--card-mask);
  mask-size: 100% 100%;
  mask-repeat: no-repeat;
  mask-position: 0 0;
}

/* —— 星空箔光：三层 cosmos 贴图 + 12 段彩虹 —— */
.card-shine {
  mix-blend-mode: color-dodge;
  opacity: 0.3;
  transition: opacity 200ms ease;
}

.tex {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.tex-bottom {
  opacity: 0.36;
}

.tex-middle {
  opacity: 0.24;
}

.tex-top {
  opacity: 0.18;
}

.rain {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background-image: repeating-linear-gradient(
    82deg,
    hsl(53, 45%, 62%) 0%,
    hsl(93, 40%, 55%) 5%,
    hsl(176, 38%, 55%) 10%,
    hsl(228, 42%, 58%) 15%,
    hsl(283, 40%, 58%) 20%,
    hsl(326, 38%, 56%) 25%,
    hsl(326, 38%, 56%) 30%,
    hsl(283, 40%, 58%) 35%,
    hsl(228, 42%, 58%) 40%,
    hsl(176, 38%, 55%) 45%,
    hsl(93, 40%, 55%) 50%,
    hsl(53, 45%, 62%) 55%
  );
  background-size: 220% 220%;
  background-position: 30% 30%;
  animation: rainDrift 7s ease-in-out infinite alternate;
}

@keyframes rainDrift {
  0% { background-position: 26% 32%; }
  100% { background-position: 74% 62%; }
}

/* —— 常驻扫光：保证端上有可见动效 —— */
.card-sweep {
  mix-blend-mode: screen;
  opacity: 0.32;
}

.streak {
  position: absolute;
  top: -20%;
  left: 0;
  width: 46%;
  height: 140%;
  background: linear-gradient(
    100deg,
    rgba(255, 255, 255, 0) 0%,
    rgba(255, 255, 255, 0.5) 45%,
    rgba(255, 255, 255, 0.75) 52%,
    rgba(255, 255, 255, 0) 100%
  );
  transform: translateX(-120%) rotate(14deg);
  animation: streakMove 5s ease-in-out infinite;
}

@keyframes streakMove {
  0% { transform: translateX(-120%) rotate(14deg); }
  55% { transform: translateX(230%) rotate(14deg); }
  100% { transform: translateX(230%) rotate(14deg); }
}

/* —— 镜面高光：跟随手指的径向光 —— */
.card-glare {
  mix-blend-mode: soft-light;
  opacity: 0.42;
  transition: opacity 160ms ease;
}

.holo-tip {
  margin-top: 20rpx;
  font-size: 21rpx;
  letter-spacing: 1rpx;
  color: #8b93a3;
  text-align: center;
}
