.holo-wrap {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.holo {
  position: relative;
  width: 100%;
  padding-top: 133.33%;
  border-radius: 28rpx;
  overflow: hidden;
  background: #10131a;
  transform-style: preserve-3d;
  transition: transform 260ms cubic-bezier(0.2, 0.7, 0.2, 1);
  box-shadow:
    0 26rpx 60rpx rgba(0, 0, 0, 0.55),
    0 0 0 1rpx rgba(228, 176, 74, 0.35);
  will-change: transform;
}

.holo.is-touching {
  transition: transform 60ms linear;
}

.card-art {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

/* 烫金流光：两层斜向金箔，随手指位置移动 */
.foil {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background-image:
    linear-gradient(115deg, rgba(255, 255, 255, 0) 20%, rgba(255, 233, 176, 0.42) 42%, rgba(255, 255, 255, 0) 58%),
    linear-gradient(295deg, rgba(255, 255, 255, 0) 24%, rgba(255, 199, 96, 0.28) 46%, rgba(255, 255, 255, 0) 62%);
  background-size: 200% 200%, 200% 200%;
  background-repeat: no-repeat;
  animation: foilDrift 7s ease-in-out infinite;
  mix-blend-mode: screen;
  opacity: 0.85;
  pointer-events: none;
}

.holo.is-touching .foil {
  animation: none;
}

@keyframes foilDrift {
  0% { background-position: 30% 30%, 70% 70%; }
  50% { background-position: 70% 60%, 30% 40%; }
  100% { background-position: 30% 30%, 70% 70%; }
}

.glare {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  mix-blend-mode: soft-light;
  pointer-events: none;
  transition: background 60ms linear;
}

.edge-light {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  border-radius: 28rpx;
  box-shadow: inset 0 0 40rpx rgba(255, 240, 200, 0.12);
  pointer-events: none;
}

.holo-hint {
  margin-top: 18rpx;
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: #7f8795;
}
