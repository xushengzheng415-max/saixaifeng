/* 全息主卡：对齐 H5 卡世界 player-card-holo（holo-cosmos）
   性能约束：真机上禁止 mask / mix-blend-mode / filter / 常驻重绘动画。
   卡形轮廓由离线烘焙的 foil-shine.png 自带 alpha 承担；
   扫光与高光只在卡面内部的矩形区域裁剪，动画一律只改 transform / opacity。 */

.holo-wrap {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  perspective: 900px;
}

.holo {
  position: relative;
  width: 100%;
  padding-top: 143.27%; /* 卡面 300x430，比例 0.6977 */
  background: transparent;
  transform-origin: center center;
  transition: transform 320ms cubic-bezier(0.2, 0.7, 0.2, 1);
  will-change: transform;
}

.holo.is-active,
.holo.is-showcase {
  transition: transform 90ms linear;
}

/* 卡后静态光晕：给卡片浮起感，取代原来的 drop-shadow（drop-shadow 会让整卡每帧重算） */
.holo-glow {
  position: absolute;
  left: -6%;
  top: -3%;
  right: -6%;
  bottom: -2%;
  background: radial-gradient(
    58% 44% at 50% 64%,
    rgba(240, 199, 94, 0.22) 0%,
    rgba(240, 199, 94, 0.06) 46%,
    rgba(240, 199, 94, 0) 72%
  );
  pointer-events: none;
}

.card-art {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

/* —— 星空箔光：烘焙图自带卡形 alpha，运行时只做透明度呼吸 —— */
.card-foil {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  opacity: 0.34;
  pointer-events: none;
  will-change: opacity;
  animation: foilBreath 4.6s ease-in-out infinite alternate;
}

@keyframes foilBreath {
  0% { opacity: 0.26; }
  100% { opacity: 0.42; }
}

.holo.is-active .card-foil {
  animation: none;
  opacity: 0.62;
}

.holo.is-showcase .card-foil {
  animation: none;
  opacity: 0.5;
}

/* —— 扫光：限制在卡面中段矩形内，纯 transform 平移 —— */
.sweep-clip {
  position: absolute;
  left: 8%;
  right: 8%;
  top: 20%;
  bottom: 26%;
  overflow: hidden;
  pointer-events: none;
  opacity: 0.42;
}

.sweep-band {
  position: absolute;
  left: 0;
  top: 0;
  width: 44%;
  height: 100%;
  background: linear-gradient(
    100deg,
    rgba(255, 255, 255, 0) 0%,
    rgba(255, 255, 255, 0.35) 40%,
    rgba(255, 255, 255, 0.62) 50%,
    rgba(255, 255, 255, 0.26) 62%,
    rgba(255, 255, 255, 0) 100%
  );
  transform: translateX(-130%) skewX(-14deg);
  will-change: transform;
  animation: sweepMove 5.4s ease-in-out infinite;
}

@keyframes sweepMove {
  0%, 8% { transform: translateX(-130%) skewX(-14deg); }
  62%, 100% { transform: translateX(260%) skewX(-14deg); }
}

/* —— 镜面高光：跟随手指的高光圆，只改 transform / opacity —— */
.glare-clip {
  position: absolute;
  left: 7%;
  right: 7%;
  top: 15%;
  bottom: 23%;
  overflow: hidden;
  pointer-events: none;
}

.glare-dot {
  position: absolute;
  left: -50%;
  top: -50%;
  width: 200%;
  height: 200%;
  opacity: 0.38;
  background: radial-gradient(
    circle 24% at 50% 50%,
    rgba(255, 255, 255, 0.6) 0%,
    rgba(214, 232, 255, 0.24) 34%,
    rgba(255, 255, 255, 0) 62%
  );
  transition: transform 140ms linear, opacity 220ms ease;
}

.holo.is-active .glare-dot {
  opacity: 0.58;
}

.holo.is-showcase .glare-dot {
  opacity: 0.58;
  animation: glareTour 2.6s ease-in-out 1 both;
}

@keyframes glareTour {
  0% { transform: translate(-12%, 8%); }
  25% { transform: translate(10%, -10%); }
  50% { transform: translate(12%, 10%); }
  75% { transform: translate(-10%, -8%); }
  100% { transform: translate(-12%, 8%); }
}

.holo-tip {
  margin-top: 20rpx;
  font-size: 21rpx;
  letter-spacing: 1rpx;
  color: #8b93a3;
  text-align: center;
}
