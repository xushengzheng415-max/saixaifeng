/* 全息主卡：对齐 H5 卡世界 player-card-holo（holo-cosmos）效果
   比例 0.698 / 透明卡形 / 星空箔光随手指 / 松手回到默认循环流光 */

.holo-wrap {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  perspective: 800px; /* 对齐 H5 .holo-card 的透视，倾斜才有立体感 */
}

.holo {
  position: relative;
  width: 100%;
  padding-top: 143.27%; /* 卡面 300x430，比例 0.6977 */
  background: transparent;
  transform-style: preserve-3d;
  transition: transform 260ms cubic-bezier(0.2, 0.7, 0.2, 1);
  filter:
    drop-shadow(0 22rpx 34rpx rgba(0, 0, 0, 0.66))
    drop-shadow(0 0 22rpx rgba(240, 199, 94, 0.26));
  will-change: transform;
  /* 未按压时默认轻摆，对齐 H5 cosmos-idle-tilt */
  animation: holoSway 7s ease-in-out infinite alternate;
}

.holo.is-grabbing {
  transition: transform 60ms linear;
  animation: none;
}

@keyframes holoSway {
  0% { transform: rotateX(3deg) rotateY(-5deg); }
  100% { transform: rotateX(-3deg) rotateY(5deg); }
}

.card-art {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 26rpx;
}

/* 星空箔光：cosmos 底图 + cosmos 顶图 + 12 段彩虹，默认缓慢流动 */
.card-shine {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 26rpx;
  background-image:
    url('/assets/card/cosmos/cosmos-top-trans.jpg'),
    url('/assets/card/cosmos/cosmos-bottom.jpg'),
    repeating-linear-gradient(
      82deg,
      hsl(53, 45%, 62%) 0%,
      hsl(93, 40%, 55%) 5%,
      hsl(176, 38%, 55%) 10%,
      hsl(228, 42%, 58%) 15%,
      hsl(283, 40%, 58%) 20%,
      hsl(326, 38%, 56%) 25%,
      hsl(326, 38%, 56%) 30%,
      hsl(283, 40%, 58%) 35%,
      hsl(228, 42%, 58%) 40%,
      hsl(176, 38%, 55%) 45%,
      hsl(93, 40%, 55%) 50%,
      hsl(53, 45%, 62%) 55%
    );
  background-size: 100% 100%, 100% 100%, 210% 210%;
  background-position: 50% 50%, 50% 50%, 30% 30%;
  background-repeat: no-repeat, no-repeat, no-repeat;
  background-blend-mode: soft-light, soft-light, normal;
  mix-blend-mode: color-dodge;
  opacity: 0.26;
  pointer-events: none;
  transition: opacity 200ms ease;
  animation: shineDrift 7s ease-in-out infinite;
}

.holo.is-grabbing .card-shine {
  animation: none;
}

@keyframes shineDrift {
  0% { background-position: 50% 50%, 50% 50%, 30% 30%; }
  50% { background-position: 50% 50%, 50% 50%, 72% 60%; }
  100% { background-position: 50% 50%, 50% 50%, 30% 30%; }
}

/* 镜面高光：中景星空 + 跟随手指的径向光 */
.card-glare {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 26rpx;
  background-image: url('/assets/card/cosmos/cosmos-middle-trans.jpg');
  background-size: 100% 100%;
  background-position: 50% 50%;
  background-repeat: no-repeat;
  background-blend-mode: soft-light;
  mix-blend-mode: soft-light;
  opacity: 0.42;
  pointer-events: none;
  transition: opacity 160ms ease;
}

.holo-tip {
  margin-top: 20rpx;
  font-size: 21rpx;
  letter-spacing: 1rpx;
  color: #8b93a3;
  text-align: center;
}
