<view class="holo-wrap">
  <view
    class="holo {{grabbingClass}}"
    style="{{tiltStyle}}"
    bindtouchmove="onTouchMove"
    bindtouchstart="onTouchStart"
    bindtouchend="onTouchEnd"
    bindtouchcancel="onTouchEnd"
    aria-label="{{ariaLabel}}"
  >
    <image class="card-art" src="{{cardUrl}}" mode="scaleToFill"></image>
    <view class="card-shine" style="{{shineStyle}}"></view>
    <view class="card-glare" style="{{glareStyle}}"></view>
  </view>
  <view class="holo-tip">{{tipText}}</view>
</view>
