<view class="holo-wrap">
  <view
    class="holo {{stateClass}}"
    style="{{tiltStyle}}"
    bindtouchstart="onTouchStart"
    bindtouchmove="onTouchMove"
    bindtouchend="onTouchEnd"
    bindtouchcancel="onTouchEnd"
    aria-label="{{ariaLabel}}"
  >
    <view class="holo-glow"></view>
    <image class="card-art" src="{{cardUrl}}" mode="scaleToFill"></image>
    <image class="card-foil" src="/assets/card/foil-shine.png" mode="scaleToFill"></image>
    <view class="sweep-clip">
      <view class="sweep-band"></view>
    </view>
    <view class="glare-clip">
      <view class="glare-dot" style="{{glareStyle}}"></view>
    </view>
  </view>
  <view class="holo-tip">{{tipText}}</view>
</view>
