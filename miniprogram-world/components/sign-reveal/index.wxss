.reveal {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 950;
  display: flex;
  align-items: center;
  justify-content: center;
}

.reveal-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(4, 5, 9, 0.82);
  backdrop-filter: blur(10rpx);
}

.reveal-body {
  position: relative;
  width: 100%;
  padding: 0 48rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.reveal-head {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.reveal-eyebrow {
  font-size: 24rpx;
  letter-spacing: 3rpx;
  color: #e4b04a;
}

.reveal-close {
  font-size: 24rpx;
  color: #8b93a3;
  padding: 8rpx 4rpx;
}

.reveal-stage {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.reveal-halo {
  position: absolute;
  width: 620rpx;
  height: 620rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(228, 176, 74, 0.28) 0%, rgba(228, 176, 74, 0) 68%);
  filter: blur(2rpx);
}

.reveal-card {
  position: relative;
  width: 520rpx;
  height: 693rpx;
  perspective: 1200rpx;
}

.flip-inner {
  position: relative;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  transition: transform 900ms cubic-bezier(0.2, 0.7, 0.2, 1);
}

.reveal-card.is-revealed .flip-inner {
  transform: rotateY(180deg);
}

.flip-back,
.flip-front {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 30rpx;
  overflow: hidden;
  backface-visibility: hidden;
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.6);
}

.flip-back-img {
  width: 100%;
  height: 100%;
}

.flip-back-shade {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(6, 8, 13, 0.55) 0%, rgba(6, 8, 13, 0.9) 100%);
}

.flip-back-line {
  position: absolute;
  left: 40rpx;
  right: 40rpx;
  top: 50%;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(228, 176, 74, 0) 0%, rgba(228, 176, 74, 0.7) 50%, rgba(228, 176, 74, 0) 100%);
}

.flip-back-title {
  position: absolute;
  left: 0;
  right: 0;
  top: 46%;
  text-align: center;
  font-size: 34rpx;
  letter-spacing: 8rpx;
  color: #f6d98b;
}

.flip-back-sub {
  position: absolute;
  left: 0;
  right: 0;
  top: 58%;
  text-align: center;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: #9aa1ad;
}

.flip-front {
  transform: rotateY(180deg);
  border: 1rpx solid rgba(228, 176, 74, 0.6);
}

.flip-front-img {
  width: 100%;
  height: 100%;
}

.flip-front-gloss {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(125deg, rgba(255, 255, 255, 0) 35%, rgba(255, 241, 204, 0.35) 50%, rgba(255, 255, 255, 0) 62%);
  mix-blend-mode: screen;
}

.reveal-info {
  width: 100%;
  margin-top: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.reveal-name-row {
  display: flex;
  align-items: baseline;
}

.reveal-name {
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #f7f9ff;
}

.reveal-number {
  margin-left: 14rpx;
  font-size: 26rpx;
  color: #e4b04a;
}

.reveal-meta {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
}

.reveal-chip {
  margin: 0 8rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #dfe4ee;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.reveal-quota {
  margin-top: 18rpx;
  font-size: 23rpx;
  color: #8b93a3;
}

.reveal-actions {
  width: 100%;
  margin-top: 34rpx;
}

.reveal-primary {
  width: 100%;
}

.reveal-secondary {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.reveal-again {
  font-size: 26rpx;
  color: #e4b04a;
  padding: 12rpx 24rpx;
}

.reveal-later {
  margin-left: 24rpx;
  font-size: 26rpx;
  color: #8b93a3;
  padding: 12rpx 24rpx;
}
