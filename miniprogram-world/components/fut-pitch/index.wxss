.pitch {
  position: relative;
  width: 100%;
  height: 940rpx;
  border-radius: 26rpx;
  overflow: hidden;
  background: #0b1210;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.pitch-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.pitch-shade {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(5, 12, 9, 0.55) 0%, rgba(5, 10, 8, 0.2) 40%, rgba(5, 10, 8, 0.75) 100%);
}

.pitch-rows {
  position: relative;
  z-index: 2;
  height: 100%;
  padding: 54rpx 18rpx 96rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.pitch-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-around;
}

.pitch-cell {
  width: 124rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cell-token {
  position: relative;
  width: 112rpx;
  height: 150rpx;
  border-radius: 12rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(9, 14, 20, 0.55);
  border: 1rpx dashed rgba(255, 255, 255, 0.28);
}

.pitch-cell.is-filled .cell-token {
  border: 1rpx solid rgba(228, 176, 74, 0.6);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.5);
  background: #0c1118;
}

.pitch-cell.is-active .cell-token {
  border-color: #f6d98b;
  box-shadow: 0 0 0 3rpx rgba(228, 176, 74, 0.35), 0 10rpx 24rpx rgba(0, 0, 0, 0.55);
}

.pitch-cell.is-mismatch .cell-token {
  border-color: rgba(240, 116, 92, 0.75);
}

.cell-card {
  width: 100%;
  height: 100%;
}

.cell-empty-icon {
  width: 42rpx;
  height: 42rpx;
  opacity: 0.5;
}

.cell-name {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #eef1f7;
  max-width: 124rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.pitch-cell.is-filled .cell-name {
  color: #ffffff;
}

.cell-number {
  font-size: 19rpx;
  color: #e4b04a;
  line-height: 1.3;
}

.cell-pos {
  margin-top: 2rpx;
  font-size: 18rpx;
  color: #8b93a3;
  letter-spacing: 1rpx;
}
