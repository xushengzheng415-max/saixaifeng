@import "../../styles/proto.wxss";
.page{min-height:100vh;position:relative;overflow:hidden;background:#001e13}.stadium-bg,.shade{position:fixed;inset:0;width:100%;height:100%}.shade{background:linear-gradient(180deg,rgba(0,18,11,.2),rgba(0,35,20,.68))}.content{position:relative;z-index:1;padding:102rpx 50rpx calc(145rpx + env(safe-area-inset-bottom))}.head{display:flex;align-items:center;justify-content:center;position:relative;color:#fff;font-size:42rpx;font-weight:900}.mark-all{position:absolute;right:0;color:#fff;font-size:25rpx;font-weight:500}.tabs{display:flex;height:70rpx;margin-top:39rpx;padding:2rpx;border:2rpx solid rgba(53,178,100,.53);border-radius:38rpx;background:rgba(0,39,24,.64)}.tab{width:25%;display:flex;align-items:center;justify-content:center;border-radius:34rpx;color:#fff;font-size:28rpx}.tab.is-active{background:linear-gradient(135deg,#20a84e,#008345);font-weight:800;box-shadow:0 6rpx 16rpx rgba(0,0,0,.16)}.message-panel{margin-top:30rpx;padding:16rpx 28rpx;border-radius:28rpx;background:rgba(255,255,255,.98)}.message-row{display:flex;align-items:center;min-height:142rpx;padding:20rpx 0;border-bottom:2rpx solid #edf0ee}.message-row:last-child{border-bottom:0}.message-row image{width:86rpx;height:86rpx;padding:18rpx;border-radius:50%;background:#ecf7ee;box-sizing:border-box}.message-main{flex:1;min-width:0;margin-left:22rpx}.message-title,.message-desc{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.message-title{color:#131914;font-size:30rpx;font-weight:800}.message-desc{margin-top:13rpx;color:#747b77;font-size:23rpx}.message-meta{width:120rpx;display:flex;align-items:center;justify-content:flex-end;gap:9rpx;flex-wrap:wrap;color:#7b827e;font-size:20rpx}.message-meta view{width:16rpx;height:16rpx;border-radius:50%;background:#129348}.message-meta text:last-child{font-size:39rpx;line-height:25rpx}.loading{padding:80rpx 0;color:#eef8f0;font-size:25rpx;text-align:center}.error-card{display:flex;justify-content:space-between;margin-top:25rpx;padding:22rpx;border-radius:18rpx;background:#fff0ef;color:#a43e37;font-size:24rpx}.empty-card{display:flex;flex-direction:column;align-items:center;margin-top:32rpx;padding:74rpx 38rpx;border-radius:28rpx;background:rgba(255,255,255,.97);color:#27322c;font-size:30rpx;font-weight:800}.empty-card image{width:112rpx;height:112rpx;margin-bottom:24rpx;padding:4rpx;box-sizing:border-box}.empty-card text:last-child{margin-top:14rpx;color:#7c847f;font-size:23rpx;font-weight:400;text-align:center}
.mark-all{right:126rpx;white-space:nowrap}
