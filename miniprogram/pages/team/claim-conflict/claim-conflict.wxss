.claim-page{min-height:100vh;position:relative;background:#02291c;color:#15241b}.claim-bg{position:absolute;inset:0;width:100%;height:100%;opacity:.88}.claim-content{position:relative;z-index:1;padding:0 28rpx 70rpx}.claim-nav{height:208rpx;position:relative;display:flex;align-items:flex-end;justify-content:center;padding-bottom:28rpx;box-sizing:border-box;color:#fff}.claim-back{position:absolute;left:4rpx;bottom:15rpx;width:70rpx;height:70rpx;line-height:60rpx;font-size:80rpx;font-weight:300;text-align:center}.claim-title{font-size:42rpx;line-height:70rpx;font-weight:700}.claim-alert-card{border-radius:28rpx;padding:42rpx 34rpx 38rpx;background:#fff;text-align:center;box-shadow:0 18rpx 38rpx rgba(0,19,10,.19)}.claim-alert-icon{width:126rpx;height:126rpx;margin:auto}.claim-alert-title{display:block;margin-top:16rpx;font-size:42rpx;font-weight:800;color:#162219}.claim-alert-desc{display:block;margin-top:18rpx;font-size:27rpx;line-height:1.55;color:#737c75}.claim-team-card{margin-top:28rpx;overflow:hidden;border-radius:28rpx;background:#fff;box-shadow:0 18rpx 38rpx rgba(0,19,10,.17)}.claim-team-main{position:relative;min-height:216rpx;padding:30rpx 24rpx 24rpx 200rpx;box-sizing:border-box}.claim-crest{position:absolute;left:30rpx;top:35rpx;width:138rpx;height:138rpx}.claim-team-name{display:block;font-size:39rpx;font-weight:800}.claim-meta{display:block;margin-top:13rpx;color:#68736c;font-size:25rpx}.claim-reasons{border-top:1rpx solid #e7ece8;padding:28rpx}.claim-section-title{display:block;margin-bottom:20rpx;font-size:32rpx;font-weight:800}.claim-reason{display:flex;align-items:center;min-height:68rpx;margin-top:14rpx;padding:0 18rpx;border:1rpx solid #fee1c9;border-radius:15rpx;background:#fff8f2;color:#6e665d;font-size:25rpx}.claim-dot{margin-right:16rpx;font-size:40rpx;line-height:1;color:#f06422}.claim-primary,.claim-secondary{display:block;width:100%;height:96rpx;margin-top:26rpx;line-height:96rpx;border-radius:22rpx;font-size:37rpx;font-weight:800}.claim-primary{background:#0a9954;color:#fff;box-shadow:0 14rpx 27rpx rgba(0,72,38,.3)}.claim-secondary{margin-top:18rpx;background:#fff;color:#29362d}.claim-primary::after,.claim-secondary::after{border:0}.claim-proof-card{margin-top:34rpx;padding:28rpx;border-radius:28rpx;background:#fff}.claim-proof-heading{display:flex;align-items:flex-start;gap:16rpx}.claim-proof-heading image{width:47rpx;height:47rpx;flex:none}.claim-proof-heading text{display:block;font-size:30rpx;font-weight:800}.claim-proof-heading text:last-child{margin-top:8rpx;font-size:24rpx;line-height:1.45;font-weight:400;color:#7c857f}.claim-proof-list{display:flex;margin-top:28rpx}.claim-proof{width:33.33%;padding:0 9rpx;box-sizing:border-box;text-align:center;border-right:1rpx solid #e8ece9}.claim-proof:last-child{border:0}.claim-proof image{width:80rpx;height:80rpx}.claim-proof text{display:block;margin-top:9rpx;font-size:24rpx;font-weight:700;line-height:1.3}.claim-proof text:last-child{margin-top:6rpx;font-size:20rpx;font-weight:400;color:#7a837d}
.claim-proof-selected{background:#effaf3;border-radius:18rpx;box-shadow:inset 0 0 0 2rpx #0a9954}.claim-proof-selected-label{display:block;margin-top:22rpx;color:#0a9954;font-size:23rpx;font-weight:700}.claim-proof-upload{margin-top:18rpx;height:76rpx;line-height:76rpx;border-radius:18rpx;background:#e8f7ed;color:#087c43;font-size:27rpx;font-weight:700}.claim-proof-upload::after{border:0}.claim-proof-files{margin-top:16rpx}.claim-proof-file{display:flex;align-items:center;gap:10rpx;padding:13rpx 14rpx;border-radius:14rpx;background:#f6f8f6;color:#5e6a62;font-size:22rpx}.claim-proof-file text:first-child{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.claim-proof-file text:nth-child(2){color:#0a9954}.claim-proof-file button{margin:0;padding:0 12rpx;height:48rpx;line-height:48rpx;border:1rpx solid #d9e4dc;border-radius:12rpx;background:#fff;color:#69766d;font-size:21rpx}.claim-proof-file button::after{border:0}
