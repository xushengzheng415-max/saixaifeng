.member-page{min-height:100vh;position:relative;background:#03271b}.member-page-bg{position:absolute;inset:0;width:100%;height:100%;opacity:.78}.member-content{position:relative;z-index:1;padding:0 28rpx 148rpx;color:#17251d}.member-nav{height:208rpx;position:relative;color:#fff;display:flex;align-items:flex-end;justify-content:center;padding-bottom:28rpx;box-sizing:border-box}.member-back{position:absolute;left:8rpx;bottom:16rpx;width:70rpx;height:70rpx;line-height:60rpx;font-size:76rpx;font-weight:300;text-align:center}.member-nav-title{font-size:40rpx;line-height:70rpx;font-weight:700}.member-loading{padding:160rpx 0;text-align:center;color:#fff}.member-hero{min-height:170rpx;display:flex;align-items:center;gap:18rpx;padding:20rpx;box-sizing:border-box;border:2rpx solid #ddbd63;border-radius:26rpx;background:linear-gradient(135deg,rgba(5,76,49,.96),rgba(1,57,37,.94));box-shadow:0 16rpx 35rpx rgba(0,0,0,.16);color:#fff}.member-crest-wrap{width:110rpx;height:122rpx;display:flex;align-items:center;justify-content:center}.member-crest,.member-crest-fallback{width:104rpx;height:104rpx;border-radius:22rpx;background:rgba(255,255,255,.09);display:flex;align-items:center;justify-content:center;color:#fff;font-size:22rpx}.member-hero-info{flex:1;min-width:0}.member-team-name{display:block;font-size:29rpx;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.member-count{display:block;margin-top:12rpx;font-size:25rpx;color:rgba(255,255,255,.9)}.member-invite{margin:0;padding:0 18rpx;min-width:0;height:70rpx;line-height:70rpx;border-radius:38rpx;background:#12ad57;color:#fff;font-size:24rpx;font-weight:700}.member-invite-icon{width:34rpx;height:34rpx;vertical-align:middle;margin-right:7rpx}.member-invite::after,.member-resend::after,.member-channel::after{border:0}.member-card{margin-top:28rpx;padding:28rpx;border-radius:30rpx;background:#fff;box-shadow:0 14rpx 34rpx rgba(0,26,15,.16)}.member-search{height:82rpx;border:2rpx solid #e4e7e5;border-radius:1