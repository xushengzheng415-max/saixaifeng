.member-crest-wrap{width:94rpx;flex:none}.member-crest,.member-crest-fallback{width:92rpx;height:92rpx}.member-team-name{font-size:27rpx;overflow:visible;text-overflow:clip}.member-invite{width:174rpx;min-width:174rpx;padding:0;font-size:24rpx}.member-invite-icon{width:32rpx;height:32rpx;margin-right:5rpx}
