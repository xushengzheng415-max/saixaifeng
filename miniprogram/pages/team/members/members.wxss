.member-invite-view{padding-top:36rpx}.member-invite-card{padding:42rpx 32rpx;border:2rpx solid #d5b45b;border-radius:30rpx;background:linear-gradient(145deg,rgba(5,76,49,.97),rgba(1,57,37,.95));box-shadow:0 18rpx 42rpx rgba(0,25,15,.24);color:#fff;text-align:center}.member-invite-kicker{font-size:25rpx;letter-spacing:3rpx;color:#f6d889}.member-invite-crest-wrap{width:150rpx;height:150rpx;margin:34rpx auto 24rpx;display:flex;align-items:center;justify-content:center}.member-invite-crest{width:138rpx;height:138rpx;border-radius:28rpx;background:rgba(255,255,255,.1);display:flex;align-items:center;justify-content:center;color:#fff;font-size:26rpx}.member-invite-team{display:block;font-size:38rpx;font-weight:700;line-height:1.35}.member-invite-role,.member-invite-expiry{display:block;margin-top:16rpx;color:rgba(255,255,255,.88);font-size:25rpx}.member-invite-boundary{margin-top:34rpx;padding:22rpx 24rpx;border:2rpx solid rgba(80,210,137,.62);border-radius:18rpx;background:rgba(0,45,28,.58);text-align:left;color:#e3f4e9;font-size:23rpx;line-height:1.55}.member-invite-confirm{margin-top:34rpx;height:82rpx;line-height:82rpx;border:0;border-radius:42rpx;background:#16b65c;color:#fff;font-size:29rpx;font-weight:700}.member-invite-error{margin-top:36rpx;color:#fff3d1;font-size:28rpx;line-height:1.6}
