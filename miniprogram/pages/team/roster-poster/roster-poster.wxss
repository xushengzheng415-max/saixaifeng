page{background:#06130f;color:#edf5ef}.rp-page{padding:22rpx 18rpx calc(30rpx + env(safe-area-inset-bottom));box-sizing:border-box}.rp-state{min-height:60vh;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:24rpx;font-size:30rpx}.rp-toolbar,.rp-pager{display:flex;align-items:center;justify-content:space-between;gap:16rpx;font-size:26rpx;margin-bottom:18rpx;color:#b6c8ba}.rp-page button{font-size:26rpx;border-radius:8rpx;margin:0;padding:0 22rpx;line-height:2.4;background:#d8e6dc;color:#174b36}.rp-page button::after{border:0}.rp-notice{font-size:25rpx;color:#efcf95;line-height:1.5;margin:16rpx 0;display:flex;align-items:center;gap:18rpx}
.rp-poster{position:relative;overflow:hidden;background:linear-gradient(155deg,#12372c 0%,#071a14 30%,#06130f 75%,#143b2d 100%);padding:30rpx 28rpx 24rpx;box-sizing:border-box}.rp-beam{position:absolute;pointer-events:none;transform:rotate(-24deg);background:#b6e36f08;left:-200rpx;width:1300rpx;height:110rpx}.rp-beam-a{top:160rpx}.rp-beam-b{top:780rpx;height:260rpx;background:#75cba206}.rp-watermark{position:absolute;width:450rpx;height:450rpx;right:-96rpx;top:-60rpx;opacity:.045;pointer-events:none}.rp-heading{position:relative}.rp-event{font-size:24rpx;line-height:1.5;letter-spacing:1rpx;color:#adbcaf;padding-bottom:22rpx;border-bottom:1rpx solid #bdd6c521}.rp-team{display:flex;align-items:center;gap:16rpx;margin-top:24rpx}.rp-team>image{width:70rpx;height:70rpx;flex:none}.rp-team>view{min-width:0;flex:1;display:flex;flex-direction:column;gap:4rpx}.rp-team-name{font-size:32rpx;font-weight:700;line-height:1.3;color:#ecf3e9}.rp-division{font-size:22rpx;color:#a7bdaa}.rp-headline{display:flex;justify-content:space-between;align-items:center;gap:14rpx;margin-top:22rpx}.rp-headline>view:first-child{flex:1;min-width:0;display:flex;flex-direction:column;gap:12rpx}.rp-title{font-size:52rpx;letter-spacing:2rpx;font-weight:800;line-height:1.2;color:#eef2df}.rp-roster-status{font-size:21rpx;letter-spacing:2rpx;color:#cbeb9d}.rp-count{display:flex;flex-direction:column;text-align:right;align-items:flex-end;padding-right:4rpx}.rp-count>text:first-child{font-size:92rpx;line-height:1;font-weight:800;color:#cbed9b;letter-spacing:-4rpx}.rp-count>text:last-child{font-size:20rpx;letter-spacing:4rpx;color:#a9bd9e;margin-top:8rpx}.rp-accent{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin:22rpx 0 30rpx;border-bottom:1rpx solid #bdd6c528}.rp-accent>view{width:74rpx;height:5rpx;background:#cbeb9d;transform:skewX(-28deg)}.rp-accent>text{font-size:18rpx;color:#7e9789;line-height:1.4}
.rp-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));column-gap:16rpx;row-gap:22rpx;position:relative;padding:8rpx 0}.rp-player{position:relative;width:100%;aspect-ratio:300/430;background:transparent;border:0;border-radius:0;box-shadow:none;margin:0;padding:0;box-sizing:border-box;transform-origin:center}.rp-player-0{transform:translateY(4rpx) rotate(-1.8deg) scale(.96)}.rp-player-1{transform:translateY(-4rpx) scale(.96)}.rp-player-2{transform:translateY(4rpx) rotate(1.8deg) scale(.96)}.rp-whole-card{display:block;width:100%;height:100%;background:transparent;border:0;border-radius:0}.rp-fallback{height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#152c224d;padding:8rpx;box-sizing:border-box;gap:8rpx;text-align:center;border:1rpx solid #c9e6bc1a}.rp-fallback>image{width:100%;height:64%;background:transparent}.rp-fallback-name{font-size:21rpx;line-height:1.4;color:#cad8ca}.rp-fallback-state{font-size:19rpx;line-height:1.4;color:#92aa92}.rp-card-skeleton{width:76%;height:62%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12rpx}.rp-card-skeleton>view{width:85%;height:8rpx;background:#c9e6bc12;transform:skewX(-20deg)}.rp-card-skeleton>view:nth-child(2){width:65%}.rp-card-skeleton>view:nth-child(3){width:45%}
.rp-staff-section{position:relative;margin-top:32rpx;padding-top:22rpx;border-top:1rpx solid #bdd6c526}.rp-section-label{display:flex;align-items:center;gap:12rpx}.rp-section-label>view{width:5rpx;height:23rpx;background:#cbed9b;transform:skewX(-18deg)}.rp-section-label>text{font-size:25rpx;font-weight:600;letter-spacing:2rpx;color:#d9e5cd}.rp-staff{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18rpx;margin-top:20rpx}.rp-staff>view{display:flex;flex-direction:column;gap:8rpx;min-width:0}.rp-staff text{font-size:25rpx;line-height:1.4;color:#d4e2d4}.rp-staff text:last-child{font-size:20rpx;color:#829c8a}.rp-credit{position:relative;display:flex;align-items:center;gap:16rpx;margin-top:30rpx;font-size:18rpx;color:#688574}.rp-credit>view{height:1rpx;background:#8eaf9733;flex:1}.rp-credit>text:last-child{max-width:45%;overflow-wrap:anywhere;text-align:right}.rp-pager{margin-top:22rpx;justify-content:center}.rp-actions{display:flex;gap:18rpx;margin-top:24rpx}.rp-actions button{flex:1;font-size:28rpx;line-height:2.8}.rp-actions .rp-primary{background:#cbed9b;color:#102819}.rp-canvas{position:fixed;left:-20000px;top:0;pointer-events:none;opacity:0}

.rp-staff-person{align-items:center;text-align:center}.rp-staff-card{width:76%;aspect-ratio:300/430;background:transparent;margin:0;padding:0;border:0;box-shadow:none}.rp-staff-unlinked{display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;gap:14rpx}.rp-staff-unlinked>text:last-child{font-size:20rpx;color:#829c8a}.rp-staff .rp-staff-role{font-size:25rpx;color:#cbeb9d;font-weight:600;line-height:1.5;margin-top:12rpx}

.rp-stadium{position:absolute;left:0;top:0;width:100%;height:310rpx;opacity:.8;pointer-events:none}.rp-stadium-shade{position:absolute;left:0;top:0;width:100%;height:335rpx;background:linear-gradient(180deg,#001b1710,#061b16 97%);pointer-events:none}.rp-staff-section{margin-top:30rpx;margin-bottom:32rpx}.rp-staff-portrait{display:block;width:100%;height:75%;background:transparent;border-radius:0}.rp-staff-photo-empty{display:flex;justify-content:center;align-items:center;height:70%;color:#829c8a;font-size:23rpx}.rp-player-section-label{position:relative;margin:26rpx 0 28rpx}.rp-poster{background:linear-gradient(150deg,#07583b,#032e23 55%,#01271e)}

.rp-event{display:flex;align-items:center;gap:16rpx}.rp-event>image{width:40rpx;height:40rpx;flex:none}.rp-event>text{flex:1;min-width:0}

.rp-stadium-window{position:absolute;left:0;top:0;width:100%;height:335rpx;overflow:hidden;pointer-events:none}.rp-stadium-window .rp-stadium{width:100%;height:auto;opacity:.9}

/* Header crest: independent large translucent layer; roster size stays secondary. */
.rp-stadium-window .rp-watermark{width:620rpx;height:620rpx;left:50%;right:auto;top:-190rpx;transform:translateX(-30%);opacity:.12}.rp-team>image{width:110rpx;height:110rpx}.rp-headline{align-items:flex-end}.rp-count{flex-direction:row;align-items:center;padding:0 2rpx 0 12rpx;flex:none}.rp-count>text:first-child{font-size:22rpx;line-height:1.6;font-weight:500;letter-spacing:0;color:#afc8a3}

/* Club identity is one aligned unit; watermark stays behind the title. */
.rp-stadium-window .rp-watermark{opacity:.055}.rp-team{margin-top:34rpx;gap:20rpx;align-items:center}.rp-team>image{width:96rpx;height:96rpx}.rp-team>view{gap:8rpx;justify-content:center}.rp-team-name{font-size:36rpx;line-height:1.35}.rp-division{font-size:22rpx;line-height:1.4}.rp-headline{margin-top:34rpx}.rp-accent{margin-top:28rpx;margin-bottom:34rpx}

/* Center the headline independently of the small metadata line. */
.rp-stadium-window .rp-watermark{opacity:.18}.rp-team>image{width:88rpx;height:88rpx}.rp-team-name{font-size:32rpx}.rp-team>view{gap:7rpx}.rp-headline{display:block;text-align:center;margin-top:32rpx}.rp-title{display:block;width:100%;text-align:center}.rp-headmeta{display:flex;align-items:center;justify-content:space-between;min-height:30rpx;margin-top:14rpx;gap:16rpx}.rp-headmeta .rp-count{margin-left:auto}
