page{background:#003c25}.page{min-height:100vh;padding:0 28rpx 80rpx;box-sizing:border-box;color:#fff}.bg{position:fixed;inset:0;width:100%;height:100%;z-index:-1}.nav{height:208rpx;display:flex;align-items:flex-end;justify-content:center;padding-bottom:28rpx;box-sizing:border-box;font-size:36rpx;font-weight:700;position:relative}.back{position:absolute;left:0;bottom:16rpx;font-size:76rpx;font-weight:200}.team-heading{display:flex;align-items:center;gap:22rpx;padding:20rpx 10rpx 30rpx;font-size:34rpx;font-weight:600}.team-logo{width:92rpx;height:100rpx}.form{background:#fff;border-radius:24rpx;padding:28rpx;color:#18231d}.form-note{display:block;color:#69766e;font-size:25rpx;margin-bottom:20rpx}.field{padding:24rpx 0;border-bottom:1rpx solid #e7ece9}.field text{display:block;color:#617168;font-size:26rpx}.field input,.picker{height:64rpx;line-height:64rpx;font-size:32rpx;margin-top:8rpx}.save{width:100%;height:88rpx;display:flex;align-items:center;justify-content:center;padding:0;line-height:normal;margin-top:36rpx;border-radius:12rpx;background:#087a48;color:#fff;font-size:32rpx;font-weight:600}.save::after{border:0}
