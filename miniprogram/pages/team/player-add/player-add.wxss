.page {
  min-height: 100vh;
  background: #f4f8f2;
  padding: 20rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.form-card,
.photo-card {
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(46, 125, 50, 0.08);
}

.form-card {
  padding: 0 28rpx;
}

.form-item {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #edf3ea;
}

.form-item.no-border {
  border-bottom: none;
}

.label {
  width: 176rpx;
  font-size: 28rpx;
  color: #475346;
  font-weight: 500;
  flex-shrink: 0;
}

.input,
.picker,
.readonly-value {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
}

.input {
  height: 72rpx;
  line-height: 72rpx;
  color: #1d1f1e;
  text-align: right;
}

.picker {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.picker-display {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  width: 100%;
  gap: 12rpx;
}

.picker-text,
.readonly-value {
  text-align: right;
  color: #2E7D32;
  font-weight: 500;
}

.picker-text.placeholder {
  color: #98a59b;
  font-weight: 400;
}

.picker-arrow {
  color: #8ca08a;
  font-size: 24rpx;
}

.readonly-value {
  color: #356f38;
  letter-spacing: 1rpx;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #1f6c2c;
  padding: 28rpx 0 16rpx;
}

.section-title.compact {
  padding-top: 0;
}

.section-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #2E7D32;
  flex-shrink: 0;
}

.photo-card {
  margin-top: 20rpx;
  padding: 28rpx;
}

.photo-upload {
  width: 260rpx;
  height: 346rpx;
  margin: 8rpx auto 0;
  position: relative;
  border-radius: 18rpx;
  border: 2rpx dashed #9ac89d;
  overflow: hidden;
  background:
    linear-gradient(45deg, #f7faf7 25%, transparent 25%),
    linear-gradient(-45deg, #f7faf7 25%, transparent 25%),
    linear-gradient(45deg, transparent 75%, #f7faf7 75%),
    linear-gradient(-45deg, transparent 75%, #f7faf7 75%);
  background-size: 28rpx 28rpx;
  background-position: 0 0, 0 14rpx, 14rpx -14rpx, -14rpx 0;
  background-color: #eef6ec;
}

.photo-preview {
  width: 100%;
  height: 100%;
  display: block;
}

.photo-placeholder {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  box-sizing: border-box;
  text-align: center;
}

.photo-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #2E7D32;
  color: #ffffff;
  font-size: 48rpx;
  line-height: 72rpx;
  text-align: center;
}

.photo-title {
  margin-top: 18rpx;
  font-size: 28rpx;
  color: #1e6c2c;
  font-weight: 600;
}

.photo-desc {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #7a887a;
}

.photo-action-badge {
  position: absolute;
  left: 50%;
  bottom: 18rpx;
  transform: translateX(-50%);
  min-width: 128rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(46, 125, 50, 0.88);
  text-align: center;
}

.photo-action-text {
  color: #ffffff;
  font-size: 22rpx;
  line-height: 1;
}

.photo-hint {
  display: block;
  margin-top: 18rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #8b948b;
  text-align: center;
}

.action-bar {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}

.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.btn::after {
  border: none;
}

.btn-secondary {
  background: #f0f4ee;
  color: #6a736a;
  border: 2rpx solid #dce5da;
}

.btn-primary {
  background: linear-gradient(135deg, #1B5E20 0%, #2E7D32 55%, #43A047 100%);
  color: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(46, 125, 50, 0.24);
}

.btn-primary[disabled] {
  opacity: 0.58;
  box-shadow: none;
}

.cropper-mask {
  position: fixed;
  inset: 0;
  z-index: 99;
  background: rgba(15, 24, 18, 0.68);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}

.cropper-panel {
  width: 100%;
  max-width: 680rpx;
  background: #f7faf6;
  border-radius: 24rpx;
  padding: 32rpx 28rpx 28rpx;
  box-sizing: border-box;
}

.cropper-header {
  text-align: center;
}

.cropper-title {
  display: block;
  color: #182118;
  font-size: 34rpx;
  font-weight: 700;
}

.cropper-subtitle {
  display: block;
  margin-top: 14rpx;
  color: #6f7d70;
  font-size: 24rpx;
  line-height: 1.6;
}

.cropper-stage {
  position: relative;
  margin: 28rpx auto 0;
  overflow: hidden;
  border-radius: 12rpx;
  background:
    linear-gradient(45deg, #d7d7d7 25%, transparent 25%),
    linear-gradient(-45deg, #d7d7d7 25%, transparent 25%),
    linear-gradient(45deg, transparent 75%, #d7d7d7 75%),
    linear-gradient(-45deg, transparent 75%, #d7d7d7 75%);
  background-size: 28rpx 28rpx;
  background-position: 0 0, 0 14rpx, 14rpx -14rpx, -14rpx 0;
  background-color: #f3f3f3;
}

.cropper-image {
  position: absolute;
  display: block;
}

.cropper-frame {
  position: absolute;
  inset: 0;
  border: 3rpx solid rgba(82, 145, 255, 0.95);
  box-sizing: border-box;
  pointer-events: none;
}

.cropper-slider-wrap {
  margin-top: 28rpx;
}

.slider-label {
  display: block;
  margin-bottom: 12rpx;
  color: #547054;
  font-size: 24rpx;
}

.cropper-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 18rpx;
}

.hidden-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 300px;
  height: 400px;
  opacity: 0;
  pointer-events: none;
}

.invite-card,
.share-card {
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(46, 125, 50, 0.08);
  margin-bottom: 20rpx;
  padding: 28rpx;
}

.invite-title {
  display: block;
  color: #1B5E20;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
}

.invite-desc {
  display: block;
  margin-top: 12rpx;
  color: #6e7d70;
  font-size: 24rpx;
  line-height: 1.6;
}

.share-player-btn {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  color: #1B5E20;
  background: #F7FBF6;
  border: 2rpx solid #B7D7B9;
  font-size: 28rpx;
  font-weight: 600;
}

.share-player-btn::after {
  border: none;
}
