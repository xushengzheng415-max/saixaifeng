page{background:#003c25}.page{min-height:100vh;padding:72rpx 28rpx 100rpx;box-sizing:border-box;color:#fff}.bg{position:fixed;inset:0;width:100%;height:100%;z-index:-1;opacity:.95}.nav{height:88rpx;display:flex;align-items:center;justify-content:center;font-size:38rpx;font-weight:700;position:relative}.back{position:absolute;left:0;font-size:76rpx;font-weight:200}.hero{min-height:214rpx;border:2rpx solid #ba9347;border-radius:30rpx;background:linear-gradient(120deg,#07533a,#3da878);padding:34rpx 42rpx;position:relative;box-sizing:border-box}.eyebrow{display:block;font-size:22rpx;letter-spacing:2rpx;color:#b9d8ca}.hero-title{display:block;font-size:50rpx;font-weight:800;margin-top:18rpx}.hero-desc{display:block;width:490rpx;line-height:1.6;font-size:26rpx;margin-top:12rpx;color:#e8f5ef}.crest{position:absolute;width:140rpx;height:140rpx;right:36rpx;top:38rpx}.form{margin-top:28rpx;border-radius:28rpx;background:#fff;color:#18231d;padding:36rpx 20rpx}.field{border:2rpx solid #eef0ef;border-radius:22rpx;padding:22rpx 24rpx;margin-bottom:20rpx}.field text{display:block;color:#717b76;font-size:25rpx}.field input,.picker{height:54rpx;line-height:54rpx;font-size:34rpx;margin-top:12rpx}.hint{display:flex;align-items:center;gap:20rpx;border-radius:20rpx;background:#eef8f4;padding:25rpx;margin:30rpx 0}.hint-icon{width:72rpx;height:72rpx;flex:none}.hint-title,.hint-sub,.switch-title,.switch-sub{display:block}.hint-title,.switch-title{font-size:29rpx;font-weight:700}.hint-sub,.switch-sub{font-size:23rpx;color:#727b77;margin-top:8rpx}.switch-row{display:flex;justify-content:space-between;align-items:center;border:2rpx solid #edf0ee;border-radius:20rpx;padding:24rpx;margin-bottom:28rpx}.switch-icon{width:80rpx;height:80rpx;flex:none;margin-right:18rpx}.switch-copy{flex:1}.save,.only-save{font-size:32rpx;border-radius:22rpx;height:84rpx;line-height:84rpx;margin-top:18rpx}.save{background:#087a48;color:#fff}.only-save{color:#087a48;background:#fff;border:2rpx solid #087a48}
