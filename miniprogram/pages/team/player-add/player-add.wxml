<view class="page">
  <view class="invite-card" wx:if="{{inviteMode && teamName}}">
    <text class="invite-title">{{teamName}}邀请你填写球员资料</text>
    <text class="invite-desc">提交后资料会自动归入该球队，方便球队负责人统一管理报名与阵容。</text>
  </view>

  <view class="form-card">
    <view class="form-item">
      <text class="label">球员姓名</text>
      <input class="input" placeholder="请输入球员姓名" value="{{form.name}}" bindinput="onNameInput" />
    </view>

    <view class="form-item">
      <text class="label">身份证号</text>
      <input class="input" placeholder="输入后自动识别出生日期和性别" value="{{form.idCard}}" bindinput="onIdCardInput" maxlength="18" />
    </view>

    <view class="form-item">
      <text class="label">性别</text>
      <picker class="picker" range="{{genderOptions}}" range-key="label" bindchange="onGenderChange" value="{{genderIndex}}">
        <view class="picker-display">
          <text wx:if="{{genderLabel}}" class="picker-text">{{genderLabel}}</text>
          <text wx:else class="picker-text placeholder">请选择性别</text>
          <text class="picker-arrow">></text>
        </view>
      </picker>
    </view>

    <view class="form-item">
      <text class="label">出生日期</text>
      <picker class="picker" mode="date" bindchange="onBirthDateChange" value="{{form.birthDate}}">
        <view class="picker-display">
          <text wx:if="{{form.birthDate}}" class="picker-text">{{form.birthDate}}</text>
          <text wx:else class="picker-text placeholder">请选择出生日期</text>
          <text class="picker-arrow">></text>
        </view>
      </picker>
    </view>

    <view class="form-item">
      <text class="label">国籍</text>
      <input class="input" placeholder="请输入国籍" value="{{form.nationality}}" bindinput="onNationalityInput" />
    </view>

    <view class="form-item">
      <text class="label">籍贯</text>
      <input class="input" placeholder="请输入籍贯" value="{{form.nativePlace}}" bindinput="onNativePlaceInput" />
    </view>

    <view class="form-item">
      <text class="label">球衣号码</text>
      <input class="input" type="number" placeholder="请输入球衣号码" value="{{form.jerseyNumber}}" bindinput="onJerseyNumberInput" maxlength="2" />
    </view>

    <view class="form-item">
      <text class="label">场上位置</text>
      <picker class="picker" range="{{positionOptions}}" range-key="label" bindchange="onPositionChange" value="{{positionIndex}}">
        <view class="picker-display">
          <text wx:if="{{positionLabel}}" class="picker-text">{{positionLabel}}</text>
          <text wx:else class="picker-text placeholder">请选择位置</text>
          <text class="picker-arrow">></text>
        </view>
      </picker>
    </view>

    <view class="form-item">
      <text class="label">球衣姓名</text>
      <view class="readonly-value">{{form.jerseyName || '自动生成'}}</view>
    </view>

    <view class="form-item">
      <text class="label">衣服尺码</text>
      <picker class="picker" range="{{clothingSizeOptions}}" range-key="label" bindchange="onClothingSizeChange" value="{{clothingSizeIndex}}">
        <view class="picker-display">
          <text wx:if="{{clothingSizeLabel}}" class="picker-text">{{clothingSizeLabel}}</text>
          <text wx:else class="picker-text placeholder">请选择衣服尺码</text>
          <text class="picker-arrow">></text>
        </view>
      </picker>
    </view>

    <view class="section-title">
      <view class="section-dot"></view>
      <text>联系方式</text>
    </view>

    <view class="form-item">
      <text class="label">联系人</text>
      <input class="input" placeholder="请输入联系人姓名" value="{{form.contactName}}" bindinput="onContactNameInput" />
    </view>

    <view class="form-item no-border">
      <text class="label">联系电话</text>
      <input class="input" type="number" placeholder="请输入联系电话" value="{{form.contactPhone}}" bindinput="onContactPhoneInput" maxlength="11" />
    </view>
  </view>

  <view class="photo-card">
    <view class="section-title compact">
      <view class="section-dot"></view>
      <text>证件照片</text>
    </view>

    <view class="photo-upload" bindtap="onUploadPhoto">
      <image wx:if="{{photoUrl}}" class="photo-preview" src="{{photoUrl}}" mode="aspectFit" />
      <view wx:else class="photo-placeholder">
        <view class="photo-icon">+</view>
        <text class="photo-title">上传球员照片</text>
        <text class="photo-desc">先拖动裁剪头像位置，再自动抠图上传</text>
      </view>

      <view wx:if="{{photoUrl}}" class="photo-action-badge">
        <text class="photo-action-text">重新选择</text>
      </view>
    </view>

    <text class="photo-hint">支持 JPG、PNG，建议上传正面半身照，背景越干净越好</text>
  </view>

  <view class="share-card" wx:if="{{teamId || teamCode}}">
    <button class="share-player-btn" open-type="share">分享给其他球员填写资料</button>
  </view>

  <view class="action-bar">
    <button class="btn btn-secondary" bindtap="onCancel">取消</button>
    <button class="btn btn-primary" bindtap="onSubmit" disabled="{{isSubmitting}}">
      <text wx:if="{{isSubmitting}}">保存中...</text>
      <text wx:else>保存球员</text>
    </button>
  </view>

  <view wx:if="{{cropper.visible}}" class="cropper-mask" catchtouchmove="noop">
    <view class="cropper-panel" catchtap="noop">
      <view class="cropper-header">
        <text class="cropper-title">调整头像位置</text>
        <text class="cropper-subtitle">拖动照片调整位置，滑动缩放，框选区域将用于球员卡显示</text>
      </view>

      <view class="cropper-stage" style="width: {{cropper.cropWidth}}px; height: {{cropper.cropHeight}}px;" bindtouchstart="onCropTouchStart" bindtouchmove="onCropTouchMove" bindtouchend="onCropTouchEnd" bindtouchcancel="onCropTouchEnd">
        <image class="cropper-image" src="{{cropper.imagePath}}" mode="scaleToFill" style="width: {{cropper.renderWidth}}px; height: {{cropper.renderHeight}}px; left: {{cropper.offsetX}}px; top: {{cropper.offsetY}}px;" />
        <view class="cropper-frame"></view>
      </view>

      <view class="cropper-slider-wrap">
        <text class="slider-label">缩放</text>
        <slider min="{{cropper.minSlider}}" max="{{cropper.maxSlider}}" value="{{cropper.sliderValue}}" activeColor="#2E7D32" backgroundColor="#D7E6D4" block-color="#2E7D32" block-size="18" bindchanging="onCropScaleChange" bindchange="onCropScaleChange" />
      </view>

      <view class="cropper-actions">
        <button class="btn btn-secondary" bindtap="onCancelCropper">取消</button>
        <button class="btn btn-primary" bindtap="onConfirmCrop">确认裁剪</button>
      </view>
    </view>
  </view>

  <canvas canvas-id="photoProcessCanvas" class="hidden-canvas"></canvas>
</view>
