<view class="page">
  <image class="bg" src="/images/runtime/stadium-tech-bg.jpg" mode="aspectFill"/>
  <view class="nav"><text bindtap="onBack" class="back">‹</text><text>{{pageTitle}}</text></view>
  <view class="team-heading"><image wx:if="{{teamLogo}}" class="team-logo" src="{{teamLogo}}" mode="aspectFit"/><text>{{teamName}}</text></view>
  <view class="form">
    <text class="form-note">姓名或手机号至少填一项，资料可后补</text>
    <view class="field"><text>球员姓名</text><input maxlength="30" value="{{name}}" bindinput="inputName"/></view>
    <view class="field"><text>联系手机号</text><input type="number" maxlength="11" value="{{contactPhone}}" bindinput="inputPhone"/></view>
    <view class="field"><text>出生日期</text><picker mode="date" value="{{birthDate}}" bindchange="changeBirth"><view class="picker">{{birthDate || '暂不填写'}}</view></picker></view>
    <button class="save" loading="{{isSubmitting}}" disabled="{{isSubmitting}}" bindtap="save">保存</button>
  </view>
</view>
