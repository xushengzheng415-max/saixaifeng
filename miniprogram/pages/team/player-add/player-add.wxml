<view class="page"><image class="bg" src="/images/runtime/stadium-tech-bg.jpg" mode="aspectFill"/><view class="nav"><text bindtap="onBack" class="back">‹</text><text>{{pageTitle}}</text></view><view class="hero"><text class="hero-title">建立球员档案</text><image wx:if="{{teamLogo}}" class="crest" src="{{teamLogo}}" mode="aspectFit"/></view><view class="form"><view class="field"><text>球员姓名 *</text><input placeholder="请输入球员姓名" value="{{name}}" bindinput="inputName"/></view><view class="field"><text>出生日期 *</text><picker mode="date" value="{{birthDate}}" bindchange="changeBirth"><view class="picker">{{birthDate || '请选择出生日期'}}</view></picker></view><view class="field"><text>{{contactPhoneLabel}}</text><input type="number" maxlength="11" placeholder="请输入手机号" value="{{contactPhone}}" bindinput="inputPhone"/></view><view class="hint"><image class="hint-icon" src="/images/runtime/icons/brand-v2-16.png" mode="aspectFit"/><view><text class="hint-title">{{ageGroup}}</text></view></view><view wx:if="{{showParentLink}}" class="switch-row"><image class="switch-icon" src="/images/runtime/icons/brand-v2-06.png" mode="aspectFit"/><view class="switch-copy"><text class="switch-title">{{collaborationTitle}}</text><text class="switch-sub">{{collaborationSub}}</text></view><switch checked="{{createParentLink}}" color="#087a48" bindchange="toggleLink"/></view><button wx:if="{{showParentLink}}" class="save" loading="{{isSubmitting}}" disabled="{{isSubmitting}}" data-link="{{true}}" bindtap="save">{{saveWithLinkText}}</button><button class="only-save" disabled="{{isSubmitting}}" data-link="{{false}}" bindtap="save">{{onlySaveText}}</button></view></view>
