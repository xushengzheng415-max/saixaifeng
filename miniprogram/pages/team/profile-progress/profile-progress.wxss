.progress-page{min-height:100vh;position:relative;background:#03271b}.progress-bg{position:absolute;inset:0;width:100%;height:100%;opacity:.78}.progress-content{position:relative;padding:0 28rpx 100rpx;color:#fff}.progress-nav{height:208rpx;position:relative;display:flex;align-items:flex-end;justify-content:center;padding-bottom:28rpx;box-sizing:border-box;font-size:40rpx;font-weight:700}.progress-back{position:absolute;left:8rpx;bottom:16rpx;font-size:76rpx;font-weight:300}.progress-loading{padding:180rpx 0;text-align:center}.progress-hero{display:flex;align-items:center;gap:22rpx;padding:25rpx;border:2rpx solid #d9bc67;border-radius:28rpx;background:linear-gradient(135deg,rgba(2,83,51,.96),rgba(1,57,36,.95))}.progress-crest{width:132rpx;height:132rpx;flex:none}.progress-team{flex:1;min-width:0}.progress-team>text{display:block;font-size:34rpx;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.progress-team>text:last-of-type{margin-top:11rpx;font-size:23rpx;font-weight:400}.progress-score{display:flex;align-items:flex-end;gap:20rpx;margin-top:20rpx}.progress-score>text{font-size:54rpx;line-height:1;color:#4ee38e;font-weight:800}.progress-score>view{flex:1}.progress-bar{height:14rpx;border-radius:9rpx;background:rgba(220,237,225,.48);overflow:hidden}.progress-fill{height:100%;border-radius:9rpx;background:#48d787}.progress-score>view>text{display:block;margin-top:9rpx;font-size:21rpx}.progress-filters{display:flex;gap:12rpx;overflow:hidden;margin:22rpx 0}.progress-filter{flex:none;padding:16rpx 20rpx;border-radius:28rpx;background:#fff;color:#657168;font-size:24rpx;white-space:nowrap}.progress-filter-active{background:#07884c;color:#fff;font-weight:700}.progress-list{overflow:hidden;border-radius:28rpx;background:#fff;color:#202a23}.progress-row{display:flex;align-items:center;gap:15rpx;min-height:148rpx;padding:20rpx 18rpx;border-bottom:1rpx solid #e7ece9;box-sizing:border-box}.progress-row:last-child{border:0}.progress-avatar{width:84rpx;height:84rpx;border-radius:50%;background:#dcece2;flex:none}.progress-avatar-letter{display:flex;align-items:center;justify-content:center;color:#07844b;font-size:29rpx;font-weight:700}.progress-info{flex:1;min-width:0}.progress-info>text{display:block;font-size:28rpx;font-weight:700}.progress-info>text:nth-child(2){margin-top:6rpx;color:#6c7971;font-size:21rpx;font-weight:400}.progress-chips{display:flex;gap:6rpx;flex-wrap:wrap;margin-top:9rpx}.profile-chip{padding:4rpx 7rpx;border-radius:8rpx;background:#e8f5ec;color:#19784d;font-size:18rpx}.profile-chip-wait{background:#fff1df;color:#d97d14}.profile-chip-error{background:#ffe5e3;color:#cf443d}.progress-actions{display:flex;flex-direction:column;align-items:flex-end;gap:7rpx}.profile-ok,.profile-wait,.profile-error{padding:6rpx 9rpx;border-radius:12rpx;background:#e5f4e9;color:#167d4b;font-size:20rpx;white-space:nowrap}.profile-wait{background:#fff1df;color:#d97d14}.profile-error{background:#ffe5e3;color:#cb3e38}.progress-actions button{display:flex;align-items:center;justify-content:center;gap:4rpx;min-width:100rpx;height:42rpx;line-height:38rpx;margin:0;padding:0;border:1rpx solid #087b47;border-radius:9rpx;background:#fff;color:#087b47;font-size:19rpx}.progress-actions button image{width:23rpx;height:23rpx}.progress-actions button:last-child{background:#087b47;color:#fff}.progress-actions button::after,.progress-remind-all::after{border:0}.progress-remind-all{display:flex;align-items:center;justify-content:center;gap:10rpx;margin-top:26rpx;height:78rpx;line-height:78rpx;border:2rpx solid #35bb79;border-radius:40rpx;background:rgba(0,73,43,.86);color:#fff;font-size:28rpx}.progress-remind-all image{width:39rpx;height:39rpx}.progress-note{margin-top:18rpx;padding:21rpx;border:1rpx solid #2cb576;border-radius:18rpx;background:rgba(0,74,42,.86);font-size:23rpx;line-height:1.55}
