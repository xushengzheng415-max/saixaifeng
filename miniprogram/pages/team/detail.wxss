/* pages/team/detail.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
}

/* ========== 创建/编辑模式 ========== */
.form-section {
  margin: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.label {
  font-size: 28rpx;
  color: #212121;
  font-weight: bold;
  display: block;
  margin-bottom: 16rpx;
}

.input {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.textarea {
  width: 100%;
  height: 160rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.logo-upload { margin-top: 10rpx; }

.logo-preview {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
}

.logo-placeholder {
  width: 180rpx;
  height: 180rpx;
  border: 2rpx dashed #bdbdbd;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.plus {
  font-size: 60rpx;
  color: #bdbdbd;
  font-weight: 300;
}

.hint {
  font-size: 24rpx;
  color: #bdbdbd;
}

.save-btn {
  margin: 30rpx 20rpx;
  height: 88rpx;
  background: #2E7D32;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 44rpx;
}

/* ========== 查看模式 ========== */
.team-header {
  background: linear-gradient(135deg, #2E7D32, #4CAF50);
  padding: 40rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.team-logo-box {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  border: 3rpx solid rgba(255,255,255,0.4);
}

.team-logo {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
}

.team-logo-text {
  font-size: 60rpx;
}

.team-header .team-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
}

.team-meta {
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
  margin-bottom: 4rpx;
}

/* 球队代码 */
.code-section {
  margin: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}

.code-label {
  font-size: 26rpx;
  color: #757575;
  display: block;
  margin-bottom: 16rpx;
}

.code-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #E3F2FD;
  border-radius: 16rpx;
  padding: 24rpx;
}

.code-text {
  font-size: 48rpx;
  font-weight: bold;
  color: #1565C0;
  letter-spacing: 8rpx;
}

.copy-hint {
  font-size: 24rpx;
  color: #1565C0;
}

/* 快捷操作 */
.action-section {
  margin: 20rpx;
}

.section-title-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 10rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #212121;
}

.more {
  font-size: 26rpx;
  color: #2E7D32;
}

.action-grid {
  display: flex;
  gap: 16rpx;
}

.action-card {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.action-icon {
  font-size: 44rpx;
  margin-bottom: 10rpx;
}

.action-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #212121;
  margin-bottom: 4rpx;
}

.action-desc {
  font-size: 22rpx;
  color: #757575;
}

/* 球员预览 */
.player-section {
  margin: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.player-preview {
  margin-top: 16rpx;
}

.player-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.player-row:last-child {
  border-bottom: none;
}

.jersey-num {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #E8F5E9;
  color: #2E7D32;
  font-size: 24rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.player-name {
  flex: 1;
  font-size: 28rpx;
  color: #212121;
}

.player-pos {
  font-size: 22rpx;
  color: #1565C0;
  background: #E3F2FD;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  margin-right: 10rpx;
}

.bind-status {
  font-size: 22rpx;
  color: #F44336;
  background: #FFEBEE;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}

.bind-status.bound {
  color: #2E7D32;
  background: #E8F5E9;
}

.empty-small {
  text-align: center;
  padding: 30rpx;
  color: #9e9e9e;
  font-size: 26rpx;
}