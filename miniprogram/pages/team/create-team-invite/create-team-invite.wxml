<view class="create-invite-page"><image class="create-invite-bg" src="/images/runtime/team-data-emerald-stadium-v1.jpg" mode="aspectFill"/><view class="create-invite-content"><view class="create-invite-nav"><text class="create-invite-back" bindtap="back">‹</text><text>赛事邀请</text></view><view wx:if="{{loading}}" class="create-invite-loading">正在核验赛事邀请…</view><view wx:elif="{{errorText}}" class="create-invite-error">{{errorText}}</view><block wx:else><view class="create-invite-tournament"><image src="/images/runtime/icons/brand-v2-02.png" mode="aspectFit"/><view><text>{{tournament.name}}</text><text>{{invite.divisionName}}</text></view></view><view class="create-invite-card"><image class="create-invite-mail" src="/images/runtime/icons/brand-v2-13.png" mode="aspectFit"/><text class="create-invite-title">主办方邀请你创建球队参赛</text><view class="create-invite-steps"><view><text>1</text><image src="/images/runtime/icons/brand-v2-12.png" mode="aspectFit"/><text>创建球队</text></view><view><text>2</text><image src="/images/runtime/icons/brand-v2-09.png" mode="aspectFit"/><text>确认参赛</text></view><view><text>3</text><image src="/images/runtime/icons/brand-v2-11.png" mode="aspectFit"/><text>完成加入</text></view></view><button bindtap="create">创建球队并加入赛事</button><button bindtap="later" class="create-invite-later">暂不处理</button></view></block></view></view>
