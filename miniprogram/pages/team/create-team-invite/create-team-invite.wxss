.create-invite-page{min-height:100vh;position:relative;background:#03271b}.create-invite-bg{position:absolute;inset:0;width:100%;height:100%;opacity:.76}.create-invite-content{position:relative;padding:0 28rpx 100rpx;color:#202a23}.create-invite-nav{height:208rpx;display:flex;align-items:flex-end;justify-content:center;padding-bottom:28rpx;box-sizing:border-box;color:#fff;font-size:40rpx;font-weight:700;position:relative}.create-invite-back{position:absolute;left:8rpx;bottom:16rpx;font-size:76rpx;font-weight:300}.create-invite-loading,.create-invite-error{padding:170rpx 20rpx;text-align:center;color:#effaf2}.create-invite-error{color:#ffd0c8}.create-invite-tournament{display:flex;align-items:center;gap:24rpx;padding:28rpx;background:#fff;border-radius:28rpx}.create-invite-tournament image{width:104rpx;height:104rpx}.create-invite-tournament text{display:block;font-size:34rpx;font-weight:700}.create-invite-tournament text:last-child{margin-top:12rpx;color:#68756d;font-size:27rpx;font-weight:400}.create-invite-card{margin-top:84rpx;padding:50rpx 30rpx 34rpx;background:#fff;border-radius:28rpx;text-align:center}.create-invite-mail{width:78rpx;height:78rpx}.create-invite-title{display:block;margin-top:25rpx;font-size:37rpx;font-weight:700}.create-invite-desc{display:block;margin-top:16rpx;color:#68746d;font-size:26rpx}.create-invite-steps{display:flex;justify-content:space-between;gap:12rpx;margin:48rpx 0 32rpx}.create-invite-steps view{width:32%;display:flex;flex-direction:column;align-items:center}.create-invite-steps view>text:first-child{display:flex;align-items:center;justify-content:center;width:52rpx;height:52rpx;border-radius:50%;background:#087f49;color:#fff;font-size:26rpx;font-weight:700}.create-invite-steps image{width:66rpx;height:66rpx;margin:16rpx 0 10rpx}.create-invite-steps view>text:nth-of-type(2){font-size:26rpx;font-weight:700}.create-invite-steps view>text:last-child{margin-top:11rpx;color:#6d7972;font-size:20rpx;line-height:1.45}.create-invite-tip{display:flex;align-items:center;gap:12rpx;padding:18rpx;border:1rpx solid #bdddc7;border-radius:15rpx;background:#f1f9f3;color:#287149;font-size:23rpx;line-height:1.5;text-align:left}.create-invite-tip image{width:38rpx;height:38rpx;flex:none}.create-invite-card button{width:100%;height:90rpx;line-height:90rpx;margin-top:25rpx;border-radius:16rpx;background:#087f49;color:#fff;font-size:31rpx;font-weight:700}.create-invite-card button::after{border:0}.create-invite-card .create-invite-later{margin-top:8rpx;background:transparent;color:#6e7771}
