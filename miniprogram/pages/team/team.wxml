<view class="page">
  <image class="stadium-bg" src="/images/runtime/team-data-emerald-stadium-v1.jpg" mode="aspectFill"></image><view class="shade"></view>
  <view class="content">
    <view class="top"><text bindtap="onBack">‹</text><text>球队详情</text></view>
  <view class="empty" wx:if="{{!hasTeam}}"><image src="/images/runtime/icons/brand-v1-tab-team.png" mode="aspectFit"></image><text>当前还没有球队</text><button bindtap="onCreateTeam">创建球队</button></view>
    <block wx:if="{{hasTeam}}">
  <view class="team-summary" data-id="profile" bindtap="onMenuTap"><view class="hero"><image wx:if="{{teamLogo}}" src="{{teamLogo}}" mode="aspectFit"></image><view class="logo-fallback" wx:if="{{!teamLogo}}"><image src="/images/runtime/icons/brand-v1-tab-team.png" mode="aspectFit"></image></view><view class="hero-main"><text class="name">{{teamName}}</text><view class="hero-meta"><text class="claim">{{claimText}}</text><text class="leader" wx:if="{{leaderText}}">{{leaderText}}</text></view><view class="hero-meta"><text wx:if="{{foundedText}}">{{foundedText}}</text><text wx:if="{{completionText}}" class="completion">{{completionText}}</text></view></view><text class="summary-arrow">›</text></view><view class="metrics"><view><text>{{playerCount}}</text><text>名球员</text></view><view><text>{{coachCount}}</text><text>名教练</text></view><view><text>{{tournamentCount}}</text><text>项赛事</text></view></view></view>
      <view class="friendly" wx:if="{{hasFriendly}}"><view class="friendly-head"><text class="section">约球数据</text><text class="friendly-sub">{{friendlySummaryText}}</text></view><view class="friendly-metrics"><view><text>{{friendlyWin}}</text><text>胜</text></view><view><text>{{friendlyDraw}}</text><text>平</text></view><view><text>{{friendlyLose}}</text><text>负</text></view><view><text>{{friendlyGoalsFor}}</text><text>进球</text></view><view><text>{{friendlyGoalsAgainst}}</text><text>失球</text></view></view><view class="friendly-official"><text class="friendly-official-label">正式战绩</text><text class="friendly-official-text">{{friendlyOfficialText}}</text></view></view>
      <view class="venues"><view class="venues-head"><text class="section">我的主场</text><text class="venues-add" bindtap="openAddVenue">+ 添加</text></view><view wx:if="{{hasHomeVenues}}" class="venue-list"><view class="venue-card" wx:for="{{homeVenues}}" wx:key="id"><view class="venue-card-head"><view class="venue-name-row"><text class="venue-name">{{item.name}}</text><text wx:if="{{item.isDefault}}" class="venue-badge">默认</text></view><text wx:if="{{item.address}}" class="venue-addr">{{item.address}}</text></view><view class="venue-btns"><text class="venue-btn" catchtap="openVenueMap" data-index="{{index}}" wx:if="{{item.hasLocation}}">导航</text><text class="venue-btn" catchtap="editVenue" data-index="{{index}}">编辑</text><text class="venue-btn" catchtap="setDefaultVenue" data-index="{{index}}" wx:if="{{!item.isDefault}}">设默认</text><text class="venue-btn danger" catchtap="deleteVenue" data-index="{{index}}">删除</text></view></view></view><view wx:else class="venue-empty" bindtap="openAddVenue"><text class="venue-empty-text">还没保存主场，点这里添加</text></view></view>
      <view class="venue-editor-mask" wx:if="{{venueEditorVisible}}" bindtap="closeVenueEditor"><view class="venue-editor" catchtap=""><text class="venue-editor-title">{{venueEditorTitle}}</text><view class="venue-editor-row"><text class="venue-editor-label">场地名称</text><input class="venue-editor-input" placeholder="如：开封立洋小学足球场" placeholder-class="venue-editor-ph" value="{{editorVenueName}}" bindinput="onEditorNameInput" maxlength="30" /></view><view class="venue-editor-row"><text class="venue-editor-label">定位</text><view class="venue-editor-loc-row"><view class="venue-editor-map-btn" bindtap="onPickEditorLocation"><text>📍 地图选点</text></view><view wx:if="{{editorVenueHasLoc}}" class="venue-editor-loc-info"><text class="venue-editor-loc-addr">{{editorVenueAddress}}</text><text class="venue-editor-loc-clear" bindtap="clearEditorLocation">清除</text></view><text wx:else class="venue-editor-loc-hint">选过点后发起邀约能直接导航</text></view></view><view class="venue-editor-btns"><button class="venue-editor-btn cancel" bindtap="closeVenueEditor">取消</button><button class="venue-editor-btn save" bindtap="saveVenue">保存</button></view></view></view>
      <view class="menu"><view class="menu-row" wx:for="{{menuItems}}" wx:key="id" data-id="{{item.id}}" bindtap="onMenuTap"><image src="{{item.icon}}" mode="aspectFit"></image><text class="menu-title">{{item.title}}</text><text class="menu-arrow">›</text></view></view>
      <view class="current" wx:if="{{hasCurrentTournament}}" bindtap="enterTournament"><text class="section">当前参赛</text><text class="event-name">{{currentTournamentName}}</text><text>{{currentTournamentMeta}}</text><button>进入赛事</button></view>
      <view class="notice">球队资料修改不影响已审核名单和历史比赛记录。</view>
    </block>
    <view class="loading" wx:if="{{loading}}">正在加载球队详情…</view><view class="error" wx:if="{{errorText}}">{{errorText}}</view>
  </view>
</view>
