<view class="page">
  <block wx:if="{{modeManager}}">
    <image class="manager-bg" src="/images/runtime/team-data-emerald-stadium-v1.jpg" mode="aspectFill"/>
    <view class="manager-nav"><text class="back" bindtap="onBack">‹</text><text>球员入队邀请</text></view>
    <view wx:if="{{loading}}" class="state"><text>正在生成球员邀请…</text></view>
    <view wx:elif="{{errorText}}" class="state error"><text>{{errorText}}</text><button bindtap="createInviteAssets">重新生成</button></view>
    <block wx:else>
      <view class="invite-hero">
        <view><text>{{team.name}}</text><text>球员入队邀请已生成</text><text>家长扫码后匹配孩子；没有档案时先登记孩子信息。</text></view>
        <image wx:if="{{team.logo}}" src="{{team.logo}}" mode="aspectFit"/>
      </view>
      <view class="invite-sheet">
        <view class="qr-actions">
          <view class="qr-box"><image wx:if="{{qrReady}}" src="{{qrUrl || qrFileId}}" mode="aspectFit" bindtap="previewQr"/><text wx:else>二维码将在真实环境生成</text></view>
          <view class="qr-side"><text>有效期 <b>7 天</b></text><text>{{expiresAtText}} 前有效</text><button style="width:100%;min-width:0;box-sizing:border-box" bindtap="createInviteAssets">重新生成</button><button style="width:100%;min-width:0;box-sizing:border-box" class="solid" open-type="share">转发给家长</button><button style="width:100%;min-width:0;box-sizing:border-box" bindtap="saveQr">保存二维码</button></view>
        </view>
        <view class="invite-link-row"><view><text>可点击邀请链接</text><text>{{linkDisplayText}}</text></view><button disabled="{{linkDisabled}}" bindtap="copyLink">复制链接</button></view>
        <view class="section-title"><i></i><text>本次邀请内容</text></view>
        <view class="requirements">
          <view><span class="req-icon green"><image style="width:40rpx;height:40rpx" src="/images/icons/players.svg" mode="aspectFit"/></span><view><text>匹配或登记孩子</text><text>已有档案直接匹配；无档案先登记</text></view><b>必填</b></view>
          <view><span class="req-icon orange"><image style="width:40rpx;height:40rpx" src="/images/icons/shield.svg" mode="aspectFit"/></span><view><text>监护人授权</text><text>确认监护关系和资料使用授权</text></view><b class="orange-text">必填</b></view>
          <view><span class="req-icon gray"><image style="width:40rpx;height:40rpx" src="/images/runtime/icons/brand-v2-12.png" mode="aspectFit"/></span><view><text>实名认证</text><text>按当前赛事与球队要求完成</text></view><b class="gray-text">按要求</b></view>
          <view><span class="req-icon blue"><image style="width:40rpx;height:40rpx" src="/images/runtime/icons/brand-v2-04.png" mode="aspectFit"/></span><view><text>标准形象照</text><text>拍摄并确认透明标准形象照</text></view><b class="blue-text">推荐</b></view>
        </view>
        <view class="privacy-note">资料仅用于球队球员库、赛事报名与身份核验；不会自动进入赛事正式名单。</view>
        <view class="poster-actions"><button bindtap="generatePoster">生成入队海报</button><button bindtap="savePoster">保存海报</button></view>
      </view>
    </block>
  </block>

  <block wx:elif="{{modeRecipient}}">
    <view class="parent-header">
      <text class="parent-back" bindtap="onBack">‹</text>
      <view><text>{{pageTitle}}</text><text>{{team.name}} · 家长专属入口</text></view>
      <text wx:if="{{showMatchStep}}" class="step" style="position:absolute;right:230rpx;top:98rpx">1/5</text>
      <text wx:if="{{showRegisterStep}}" class="step" style="position:absolute;right:230rpx;top:98rpx">2/5</text>
      <text wx:if="{{submitted}}" class="step" style="position:absolute;right:230rpx;top:98rpx">完成</text>
    </view>
    <view class="parent-body">
      <view wx:if="{{loading}}" class="parent-state">正在匹配孩子资料…</view>
      <view wx:elif="{{errorText}}" class="parent-state parent-error"><text>{{errorText}}</text><button bindtap="loadInvitation">重新加载</button></view>

      <block wx:elif="{{showMatchStep}}">
        <view class="match-card" style="margin-top:0;padding:32rpx;">
          <view style="display:flex;align-items:center;justify-content:space-between;gap:18rpx;"><text class="card-title">确认孩子</text><text style="padding:8rpx 16rpx;border-radius:22rpx;background:#e8f6ed;color:#087b46;font-size:21rpx;white-space:nowrap;">账号已验证</text></view>
          <text class="card-desc">仅显示与本次邀请相关的孩子</text>
          <block wx:if="{{hasMatchedPlayer}}">
            <text class="match-hint">请选择已匹配的孩子</text>
            <view class="child-card"><view class="jersey" style="background:#edf7f1"><image style="width:92rpx;height:92rpx" src="/images/runtime/icons/brand-v2-04.png" mode="aspectFit"/></view><view><text>{{submittedPlayer.name}}</text><text>出生年月 {{submittedPlayer.birthDate}}</text><text>状态 {{submittedPlayer.profileStatus}}</text></view></view>
            <button class="primary-button" style="width:100%;box-sizing:border-box" loading="{{submitting}}" disabled="{{submitting}}" bindtap="confirmMatchedPlayer">确认是我的孩子</button>
            <button style="width:100%;height:62rpx;margin:12rpx 0 0;padding:0;border:0;background:transparent;color:#6d7972;font-size:23rpx;line-height:62rpx;" bindtap="startRegistration">不是这个孩子？登记新孩子</button>
          </block>
          <block wx:else>
            <view class="no-match-tip" style="margin-top:26rpx;padding:28rpx 18rpx;"><text style="display:block;color:#24342b;font-size:28rpx;font-weight:700;">未找到已有球员档案</text><text style="display:block;margin-top:8rpx;color:#77827c;font-size:22rpx;">请登记孩子的基础信息</text></view>
            <button class="primary-button" style="width:100%;height:94rpx;box-sizing:border-box;display:flex;align-items:center;justify-content:center;padding:0;font-size:32rpx;font-weight:800;line-height:1;text-align:center;" bindtap="startRegistration">登记孩子信息</button>
            <text class="register-note" style="margin-top:20rpx;">提交后由球队负责人确认</text>
          </block>
        </view>
        <view class="entry-note" style="margin-top:24rpx;padding:18rpx 22rpx;text-align:center;">资料仅用于当前球队办理，不公开其他球员信息。</view>
        <view style="height:80rpx"></view>
      </block>

      <block wx:elif="{{showRegisterStep}}">
        <text class="intro">请填写孩子的基础信息。证件信息将在下一步单独核验。</text>
        <view class="form-card">
          <text class="card-title">球员基础信息</text>
          <view class="form-row"><text>球员姓名</text><input value="{{name}}" maxlength="30" placeholder="请输入真实姓名" bindinput="inputName"/></view>
          <view class="form-row"><text>出生日期</text><picker mode="date" value="{{birthDate}}" end="{{maxBirthDate}}" bindchange="changeBirth"><view>{{birthDateText}}</view></picker></view>
          <view class="form-row readonly"><text>所属球队</text><b>{{team.name}}</b><image style="width:30rpx;height:30rpx" src="/images/icons/check.svg" mode="aspectFit"/></view>
        </view>
        <view class="form-card relation-card">
          <text class="card-title">监护关系</text>
          <view class="relation-options"><view class="{{relationFatherClass}}" data-relation="father" bindtap="chooseRelation"><i></i><text>父亲</text></view><view class="{{relationMotherClass}}" data-relation="mother" bindtap="chooseRelation"><i></i><text>母亲</text></view><view class="{{relationOtherClass}}" data-relation="other" bindtap="chooseRelation"><i></i><text>其他监护人</text></view></view>
          <view class="phone-row"><text>监护人手机号</text><input type="number" maxlength="11" value="{{guardianPhone}}" placeholder="请输入11位手机号" bindinput="inputPhone"/></view>
        </view>
        <view class="correction-note">如姓名或出生日期与已有档案冲突，系统会提交人工核验，不会自动合并。</view>
        <view class="{{authorizationClass}}" bindtap="toggleAuthorization"><image wx:if="{{authorizationAgreed}}" style="width:38rpx;height:38rpx;flex:none" src="/images/icons/check.svg" mode="aspectFit"/><text wx:else class="authorization-check"></text><text>我确认是该球员监护人，并同意为本次资料办理提交必要信息。</text></view>
        <button class="primary-button" style="width:100%;box-sizing:border-box" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitPlayer">登记信息，下一步</button>
        <button class="outline-button" style="width:100%;box-sizing:border-box" bindtap="loadInvitation">返回重新匹配</button>
        <view style="height:80rpx"></view>
      </block>

      <block wx:elif="{{submitted}}">
        <view class="success-card"><view class="success-icon"><image style="width:64rpx;height:64rpx" src="/images/icons/check.svg" mode="aspectFit"/></view><text>孩子信息已登记</text><text>{{submittedPlayer.name}} 已提交至 {{team.name}} 球员库，等待球队负责人确认。</text>
          <view class="success-list"><view style="display:flex;align-items:center;gap:12rpx;padding:9rpx 0"><image style="width:28rpx;height:28rpx" src="/images/icons/check.svg" mode="aspectFit"/><text>基础信息已提交</text></view><view style="display:flex;align-items:center;gap:12rpx;padding:9rpx 0"><image style="width:28rpx;height:28rpx" src="/images/icons/check.svg" mode="aspectFit"/><text>监护人授权已确认</text></view><view style="display:flex;align-items:center;gap:12rpx;padding:9rpx 0"><i style="width:24rpx;height:24rpx;border:3rpx solid #91a198;border-radius:50%;box-sizing:border-box"></i><text>实名认证待完成</text></view><view style="display:flex;align-items:center;gap:12rpx;padding:9rpx 0"><i style="width:24rpx;height:24rpx;border:3rpx solid #91a198;border-radius:50%;box-sizing:border-box"></i><text>标准形象照待完成</text></view></view>
          <button wx:if="{{canContinueProfile}}" class="primary-button" style="width:100%;box-sizing:border-box" bindtap="openParentProfile">继续实名与形象照资料</button><button class="outline-button" style="width:100%;box-sizing:border-box" bindtap="goHome">稍后处理，返回首页</button>
          <view style="height:80rpx"></view>
        </view>
      </block>
    </view>
  </block>
  <canvas canvas-id="playerInviteCanvas" class="poster-canvas"></canvas>
</view>
