<view class="page">
  <block wx:if="{{modeManager}}">
    <image class="manager-bg" src="/images/runtime/team-data-emerald-stadium-v1.jpg" mode="aspectFill"/>
    <view class="manager-nav"><text class="back" bindtap="onBack">‹</text><text>球员认领</text></view>
    <view wx:if="{{loading}}" class="state"><text>正在生成认领邀请…</text></view>
    <view wx:elif="{{errorText}}" class="state error"><text>{{errorText}}</text><button bindtap="createInviteAssets">重新生成</button></view>
    <block wx:else>
      <view class="invite-hero compact-hero"><view><text>{{team.name}}</text></view><image wx:if="{{team.logo}}" src="{{team.logo}}" mode="aspectFit"/></view>
      <view class="invite-sheet compact-sheet">
        <text class="qr-title">球队专属认领二维码</text>
        <image class="service-qr" wx:if="{{qrReady}}" src="{{qrUrl}}" mode="aspectFit" bindtap="previewQr"/>
        <text class="scan-title">扫码关注服务号并认领</text>
        <text class="expiry-text">有效期至 {{expiresAtText}}</text>
        <view class="compact-qr-actions"><button bindtap="createInviteAssets" disabled="{{posterBusy}}">重新生成</button><button bindtap="saveQr">保存二维码</button></view>
        <text wx:if="{{posterError}}" class="poster-error">{{posterError}}</text>
        <button class="poster-primary" bindtap="generatePoster" loading="{{posterBusy}}" disabled="{{posterBusy}}">生成认领海报</button>
      </view>
      <view class="poster-preview" wx:if="{{posterReady}}"><image src="{{posterPath}}" mode="widthFix" bindtap="previewPoster"/><view class="poster-actions"><button bindtap="savePoster">保存海报</button><button bindtap="sharePoster" loading="{{shareBusy}}" disabled="{{shareBusy}}">分享图片</button></view></view>
    </block>
  </block>

  <block wx:elif="{{modeRecipient}}">
    <view class="parent-header">
      <text class="parent-back" bindtap="onBack">‹</text>
      <view><text>{{pageTitle}}</text><text>{{team.name}} · {{recipientEntryLabel}}</text></view>
      <text wx:if="{{showMatchStep}}" class="step" style="position:absolute;right:230rpx;top:98rpx">1/5</text>
      <text wx:if="{{showRegisterStep}}" class="step" style="position:absolute;right:230rpx;top:98rpx">2/5</text>
      <text wx:if="{{submitted}}" class="step" style="position:absolute;right:230rpx;top:98rpx">完成</text>
    </view>
    <view class="parent-body">
      <view wx:if="{{loading}}" class="parent-state">正在读取球员资料…</view>
      <view wx:elif="{{errorText}}" class="parent-state parent-error"><text>{{errorText}}</text><button bindtap="loadInvitation">重新加载</button></view>

      <block wx:elif="{{showMatchStep}}">
        <view class="match-card" style="margin-top:0;padding:32rpx;">
          <view style="display:flex;align-items:center;justify-content:space-between;gap:18rpx;"><text class="card-title">{{confirmTitle}}</text><text style="padding:8rpx 16rpx;border-radius:22rpx;background:#e8f6ed;color:#087b46;font-size:21rpx;white-space:nowrap;">账号已验证</text></view>
          <text class="card-desc">{{matchIntro}}</text>
          <block wx:if="{{hasMatchedPlayer}}">
            <text class="match-hint">请选择已匹配的孩子</text>
            <view class="child-card"><view class="jersey" style="background:#edf7f1"><image style="width:92rpx;height:92rpx" src="/images/runtime/icons/brand-v2-04.png" mode="aspectFit"/></view><view><text>{{submittedPlayer.name}}</text><text>出生年月 {{submittedPlayer.birthDate}}</text><text>状态 {{submittedPlayer.profileStatus}}</text></view></view>
            <button class="primary-button" style="width:100%;box-sizing:border-box" loading="{{submitting}}" disabled="{{submitting}}" bindtap="confirmMatchedPlayer">{{confirmActionText}}</button>
            <button style="width:100%;height:62rpx;margin:12rpx 0 0;padding:0;border:0;background:transparent;color:#6d7972;font-size:23rpx;line-height:62rpx;" bindtap="startRegistration">资料不符？重新填写</button>
          </block>
          <block wx:else>
            <view class="no-match-tip" style="margin-top:26rpx;padding:28rpx 18rpx;"><text style="display:block;color:#24342b;font-size:28rpx;font-weight:700;">未找到待认领球员</text><text style="display:block;margin-top:8rpx;color:#77827c;font-size:22rpx;">填写姓名与出生日期后提交认领</text></view>
            <button class="primary-button" style="width:100%;height:94rpx;box-sizing:border-box;display:flex;align-items:center;justify-content:center;padding:0;font-size:32rpx;font-weight:800;line-height:1;text-align:center;" bindtap="startRegistration">认领球员资料</button>
            <text class="register-note" style="margin-top:20rpx;">提交后由球队负责人确认</text>
          </block>
        </view>
        <view class="entry-note" style="margin-top:24rpx;padding:18rpx 22rpx;text-align:center;">资料仅用于当前球队办理，不公开其他球员信息。</view>
        <view style="height:80rpx"></view>
      </block>

      <block wx:elif="{{showRegisterStep}}">

        <view class="form-card">
          <text class="card-title">球员基础信息</text>
          <view class="form-row"><text>球员姓名</text><input value="{{name}}" maxlength="30" placeholder="请输入真实姓名" bindinput="inputName"/></view>
          <view class="form-row"><text>出生日期</text><picker mode="date" value="{{birthDate}}" end="{{maxBirthDate}}" bindchange="changeBirth"><view>{{birthDateText}}</view></picker></view>
          <view class="form-row readonly"><text>所属球队</text><b>{{team.name}}</b><image style="width:30rpx;height:30rpx" src="/images/icons/check.svg" mode="aspectFit"/></view>
        </view>
        <view wx:if="{{showGuardianFields}}" class="form-card relation-card">
          <text class="card-title">监护关系</text>
          <view class="relation-options"><view class="{{relationFatherClass}}" data-relation="father" bindtap="chooseRelation"><i></i><text>父亲</text></view><view class="{{relationMotherClass}}" data-relation="mother" bindtap="chooseRelation"><i></i><text>母亲</text></view><view class="{{relationOtherClass}}" data-relation="other" bindtap="chooseRelation"><i></i><text>其他监护人</text></view></view>
          <view class="phone-row"><text>监护人手机号</text><b style="min-width:0;flex:1;text-align:right;font-size:26rpx">{{accountPhoneMasked}}</b></view>
        </view>
        <view wx:else class="form-card relation-card"><text class="card-title">登记身份</text><view class="phone-row"><text>球员本人</text><b style="min-width:0;flex:1;text-align:right;font-size:26rpx">{{accountPhoneMasked}}</b></view></view>
        <view class="correction-note">系统会自动匹配球队名单中同名且出生日期相同的待认领球员，匹配成功将直接认领该档案；如与已被认领的档案冲突，系统会提交人工核验，不会自动合并。</view>
        <view class="{{authorizationClass}}" bindtap="toggleAuthorization"><image wx:if="{{authorizationAgreed}}" style="width:38rpx;height:38rpx;flex:none" src="/images/icons/check.svg" mode="aspectFit"/><text wx:else class="authorization-check"></text><text>{{authorizationText}}</text></view>
        <button class="primary-button" style="width:100%;box-sizing:border-box" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitPlayer">确认认领</button>
        <button class="outline-button" style="width:100%;box-sizing:border-box" bindtap="loadInvitation">返回重新匹配</button>
        <view style="height:80rpx"></view>
      </block>

      <block wx:elif="{{submitted}}">
        <view class="success-card"><view class="success-icon"><image style="width:64rpx;height:64rpx" src="/images/icons/check.svg" mode="aspectFit"/></view><text>{{successTitle}}</text><text>{{submittedSummary}}</text>
          <view class="success-list"><view style="display:flex;align-items:center;gap:12rpx;padding:9rpx 0"><image style="width:28rpx;height:28rpx" src="/images/icons/check.svg" mode="aspectFit"/><text>{{submittedBasicText}}</text></view><view style="display:flex;align-items:center;gap:12rpx;padding:9rpx 0"><image style="width:28rpx;height:28rpx" src="/images/icons/check.svg" mode="aspectFit"/><text>{{successAuthorizationText}}</text></view><view style="display:flex;align-items:center;gap:12rpx;padding:9rpx 0"><i style="width:24rpx;height:24rpx;border:3rpx solid #91a198;border-radius:50%;box-sizing:border-box"></i><text>人证核验待完成</text></view><view style="display:flex;align-items:center;gap:12rpx;padding:9rpx 0"><i style="width:24rpx;height:24rpx;border:3rpx solid #91a198;border-radius:50%;box-sizing:border-box"></i><text>标准形象照待完成</text></view></view>
          <button wx:if="{{canContinueProfile}}" class="primary-button" style="width:100%;box-sizing:border-box" bindtap="openParentProfile">继续实名与形象照资料</button><button class="outline-button" style="width:100%;box-sizing:border-box" bindtap="goHome">稍后处理，返回首页</button>
          <view style="height:80rpx"></view>
        </view>
      </block>
    </view>
  </block>
  <canvas type="2d" id="playerInviteCanvas" class="poster-canvas"></canvas>
</view>
