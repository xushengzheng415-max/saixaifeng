<view class="roster-page member-page" wx:if="{{!editing}}">
  <image class="roster-bg" src="/images/runtime/team-data-emerald-stadium-v1.jpg" mode="aspectFill"/>
  <view class="member-content">
    <view class="roster-nav"><text class="roster-back" bindtap="back">‹</text><text>正式名单</text></view>
    <view wx:if="{{loading}}" class="member-state">正在读取名单…</view>
    <view wx:elif="{{errorText}}" class="member-state"><text>{{errorText}}</text><button bindtap="load">重新加载</button></view>
    <block wx:else>
      <view class="member-event"><text class="member-team">{{team.name}}</text><text>{{tournament.name}}</text><text>{{tournament.divisionName}}</text></view>
      <view class="member-toolbar"><view><text>{{rosterStatusText}}</text><text>{{rosterCountText}}</text></view><button wx:if="{{canEditRoster}}" bindtap="editRoster">{{editRosterText}}</button></view>
      <button wx:if="{{hasRosterMembers}}" class="member-poster-entry" bindtap="openPoster">生成海报</button>
      <view wx:if="{{showReturned}}" class="member-return">{{returnReason}}</view>
      <view wx:if="{{!hasRosterMembers}}" class="member-state"><text>暂无本届参赛名单</text><button wx:if="{{canEditRoster}}" bindtap="editRoster">选择球员</button></view>
      <view class="member-card" wx:for="{{rosterMembers}}" wx:key="id">
        <view class="member-card-top" data-id="{{item.id}}" bindtap="openMember">
          <image wx:if="{{item.hasPhoto}}" class="member-photo" src="{{item.photoUrl}}" mode="aspectFit" data-id="{{item.id}}" binderror="portraitFailed"/>
          <view wx:else class="member-photo-empty"><text>{{item.numberText}}</text><text>暂无形象照</text></view>
          <view class="member-main"><view class="member-name-row"><text>{{item.name}}</text><text class="member-number">{{item.numberText}}号</text></view><text class="member-jersey">{{item.jerseyText}}</text><view class="member-facts"><text>{{item.ageText}}</text><text>{{item.positionText}}</text></view><text class="member-qualification">{{item.statusText}}</text><text wx:if="{{item.isUnclaimed}}" class="member-unclaimed">未认领</text></view><text class="member-arrow">›</text>
        </view>
        <view class="member-stats"><view wx:for="{{item.metrics}}" wx:for-item="metric" wx:key="id"><text>{{metric.value}}</text><text>{{metric.label}}</text></view></view>
      </view>
    </block>
  </view>
</view>
<view wx:else class="roster-page"><image class="roster-bg" src="/images/runtime/team-data-emerald-stadium-v1.jpg" mode="aspectFill"/><view class="roster-content"><view class="roster-nav"><text class="roster-back" bindtap="back">‹</text><text>{{pageTitle}}</text></view><view wx:if="{{loading}}" class="roster-loading">正在读取本届参赛球员…</view><block wx:else><view class="roster-event"><view><text>{{team.name}}</text><text>{{tournament.name}}</text><text wx:if="{{tournament.divisionName}}">{{tournament.divisionName}}</text></view><image src="/images/runtime/icons/brand-v2-16.png" mode="aspectFit"/></view><view wx:if="{{showReturned}}" class="roster-warning"><image src="/images/runtime/icons/brand-v2-13.png" mode="aspectFit"/><view><text>名单审核退回</text><text>{{returnReason}}</text></view></view><view wx:else class="roster-requirement"><view><text>本组要求：</text><text>{{requirementText}}</text></view><button>查看主办方要求 ›</button></view><view wx:if="{{!showReturned}}" class="roster-overview"><text>球队球员库不等于本届参赛名单</text><text>加入赛事不会自动提交全队球员</text><view><view><image src="/images/runtime/icons/brand-v2-03.png" mode="aspectFit"/><text>{{overview.libraryCount}}人</text><small>球队球员库</small></view><text class="roster-arrow">→</text><view><image src="/images/runtime/icons/brand-v2-09.png" mode="aspectFit"/><text>{{overview.selectedCount}}人</text><small>已选本届参赛</small></view></view><text class="roster-overview-note">ⓘ 只有勾选的球员进入本届赛事参赛名单；未勾选球员继续保留在球队球员库。</text></view><view class="roster-tip">ⓘ {{rosterTip}}</view><view class="roster-list"><view class="roster-list-head"><text>球队球员库（{{overview.libraryCount}}人）</text><view><text wx:for="{{tabs}}" wx:key="id" class="{{item.className}}" data-id="{{item.id}}" bindtap="chooseTab">{{item.label}}</text></view></view><view class="roster-column-head"><text></text><text>球员信息</text><text>资料状态</text></view><view wx:for="{{visible}}" wx:key="id" class="roster-row" data-id="{{item.id}}" bindtap="toggle"><text class="{{item.checkClass}}">✓</text><text class="roster-avatar">{{item.avatarText}}</text><view><text>{{item.name}}</text><text>{{item.birthDate}}</text></view><view class="roster-state"><image src="{{item.profileIcon}}" mode="aspectFit"/><text class="{{item.stateClass}}">{{item.statusText}}</text><text wx:if="{{item.isUnclaimed}}" class="roster-unclaimed">未认领</text></view><button wx:if="{{!item.canSelect}}" data-id="{{item.id}}" catchtap="handleProblem">处理</button><text wx:if="{{item.canSelect}}" class="roster-chevron">›</text></view></view></block></view><view wx:if="{{!loading}}" class="roster-footer"><view><text>{{overview.footerText}}</text><text>{{overview.submitSummary}}</text></view><button wx:if="{{canEditRoster}}" class="roster-submit" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">{{submitText}}</button></view></view>
