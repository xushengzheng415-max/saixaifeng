.prebuilt-page{min-height:100vh;position:relative;background:#03271b}.prebuilt-bg{position:absolute;inset:0;width:100%;height:100%;opacity:.76}.prebuilt-content{position:relative;padding:0 28rpx 100rpx;color:#fff}.prebuilt-nav{height:208rpx;display:flex;align-items:flex-end;justify-content:center;padding-bottom:28rpx;box-sizing:border-box;font-size:40rpx;font-weight:700;position:relative}.prebuilt-back{position:absolute;left:8rpx;bottom:16rpx;font-size:76rpx;font-weight:300}.prebuilt-loading,.prebuilt-error{padding:170rpx 20rpx;text-align:center}.prebuilt-error{color:#ffd1cf}.prebuilt-tournament,.prebuilt-team,.prebuilt-option{background:#fff;border-radius:28rpx;color:#1e2a22}.prebuilt-tournament{display:flex;align-items:center;gap:25rpx;padding:28rpx}.prebuilt-tournament image{width:104rpx;height:104rpx}.prebuilt-tournament text{display:block;font-size:33rpx;font-weight:700}.prebuilt-tournament text:last-child{margin-top:10rpx;color:#68756d;font-size:27rpx;font-weight:400}.prebuilt-heading{display:block;margin:30rpx 0 17rpx;padding-left:13rpx;border-left:7rpx solid #16a15f;font-size:31rpx;font-weight:700}.prebuilt-team{display:flex;align-items:center;gap:18rpx;padding:25rpx}.prebuilt-team image{width:96rpx;height:96rpx}.prebuilt-team>view{flex:1}.prebuilt-team>view text{display:block;font-size:31rpx;font-weight:700}.prebuilt-team>view text:last-child{margin-top:10rpx;color:#6c7871;font-size:23rpx;font-weight:400}.prebuilt-team>text{padding:7rpx 11rpx;border-radius:15rpx;background:#fff0e6;color:#e6751a;font-size:21rpx}.prebuilt-explain{display:block;margin:20rpx 0 0;color:#e7f1ea;font-size:24rpx;line-height:1.55}.prebuilt-option{position:relative;margin-bottom:22rpx;padding:26rpx}.prebuilt-option>image{width:85rpx;height:85rpx;float:left;margin-right:16rpx}.prebuilt-option>view>text{display:block;font-size:31rpx;font-weight:700}.prebuilt-option>view>text:last-child{margin-top:10rpx;color:#66736b;font-size:22rpx;line-height:1.45;font-weight:400}.prebuilt-option button{width:100%;height:78rpx;line-height:78rpx;margin-top:22rpx;border-radius:15rpx;background:#087e49;color:#fff;font-size:27rpx;font-weight:700}.prebuilt-option button::after{border:0}.prebuilt-option:last-of-type button{background:#fff;color:#087e49;border:2rpx solid #087e49}.prebuilt-recommended{border:3rpx solid #1a9a5c}.prebuilt-mark{position:absolute;right:0;top:0;padding:9rpx 16rpx;border-radius:0 25rpx 0 16rpx;background:#0b8b4f;color:#fff;font-size:20rpx}.candidate{display:flex;justify-content:space-between;clear:both;margin-top:18rpx;padding:16rpx;border:1rpx solid #e2eae4;border-radius:12rpx;font-size:24rpx}.candidate-selected{border-color:#07844b;background:#ecf8ef;color:#087b47}.candidate text:last-child{color:#758178}.prebuilt-warning{display:flex;gap:14rpx;padding:20rpx;border-radius:18rpx;background:#fff3e6;color:#95531f;font-size:23rpx;line-height:1.5}.prebuilt-warning image{width:40rpx;height:40rpx;flex:none}.prebuilt-flow{display:flex;align-items:center;justify-content:space-around;margin-top:20rpx;padding:19rpx;border:1rpx solid #21a965;border-radius:17rpx;background:rgba(0,69,41,.84);font-size:22rpx}
.prebuilt-review-action{margin-top:20rpx;padding:22rpx;border-radius:18rpx;background:#fff8f0;color:#81531f;font-size:24rpx;line-height:1.5}.prebuilt-review-action button{width:100%;height:76rpx;line-height:76rpx;margin-top:16rpx;border-radius:14rpx;background:#f07821;color:#fff;font-size:27rpx;font-weight:700}.prebuilt-review-action button::after{border:0}
