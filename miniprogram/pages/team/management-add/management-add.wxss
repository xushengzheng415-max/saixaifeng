/* pages/team/management-add/management-add.wxss */
/* 官员添加页面样式 */
page {
  background: linear-gradient(135deg, #1a5d27 0%, #2E7D32 45%, #4CAF50 75%, #81C784 100%);
  background-size: cover;
  background-repeat: no-repeat;
  background-attachment: fixed;
  background-position: center;
  min-height: 100vh;
  padding: 40rpx 20rpx;
  box-sizing: border-box;
}

.management-add-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
}

/* 头部区域 */
.header-section {
  text-align: center;
  padding: 60rpx 40rpx 40rpx;
  position: relative;
  z-index: 1;
  animation: fadeInDown 0.8s ease-out;
}

.header-content {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  border-radius: 30rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.page-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #2E7D32;
  margin-bottom: 16rpx;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.1);
  letter-spacing: 2rpx;
}

.team-info {
  display: block;
  font-size: 28rpx;
  color: #666;
}

/* 表单容器 */
.form-container {
  flex: 1;
  position: relative;
  z-index: 1;
  animation: fadeInUp 0.8s ease-out 0.2s;
}

.form-section {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  margin: 0 20rpx 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2E7D32;
  margin-bottom: 40rpx;
  letter-spacing: 1rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid rgba(76, 175, 80, 0.3);
}

/* 表单项 */
.form-item {
  margin-bottom: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.label {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  letter-spacing: 1rpx;
}

.input {
  background: rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(76, 175, 80, 0.3);
  border-radius: 15rpx;
  padding: 24rpx 20rpx;
  font-size: 28rpx;
  color: #333;
  transition: all 0.3s ease;
}

.input:focus {
  border-color: rgba(76, 175, 80, 0.8);
  box-shadow: 0 0 0 4rpx rgba(76, 175, 80, 0.1);
}

.input::placeholder {
  color: #999;
  font-size: 26rpx;
}

/* 选择器 */
.picker {
  background: rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(76, 175, 80, 0.3);
  border-radius: 15rpx;
  padding: 24rpx 20rpx;
  font-size: 28rpx;
  color: #333;
  transition: all 0.3s ease;
}

.picker:active {
  border-color: rgba(76, 175, 80, 0.8);
  box-shadow: 0 0 0 4rpx rgba(76, 175, 80, 0.1);
}

.picker-display {
  color: #333;
  font-size: 28rpx;
}

.picker-display:empty {
  color: #999;
}

/* 头像上传 */
.avatar-upload-section {
  text-align: center;
  padding: 20rpx 0;
}

.avatar-preview {
  width: 200rpx;
  height: 200rpx;
  margin: 0 auto 30rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
  overflow: hidden;
  border: 4rpx solid rgba(46, 125, 50, 0.3);
  position: relative;
  cursor: pointer;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  object-fit: cover;
}

.upload-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.avatar-preview:active .upload-overlay {
  opacity: 1;
}

.upload-text {
  color: white;
  font-size: 24rpx;
  font-weight: bold;
  letter-spacing: 1rpx;
}

.upload-hint {
  font-size: 24rpx;
  color: #666;
  margin-top: 16rpx;
}

/* 操作按钮 */
.action-section {
  display: flex;
  gap: 30rpx;
  margin: 60rpx 20rpx 40rpx;
  position: relative;
  z-index: 1;
}

.cancel-btn,
.submit-btn {
  flex: 1;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  border-radius: 25rpx;
  padding: 28rpx 40rpx;
  font-size: 30rpx;
  font-weight: bold;
  letter-spacing: 1rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(76, 175, 80, 0.3);
}

.cancel-btn {
  background: rgba(244, 67, 54, 0.95);
  color: white;
  border-color: rgba(244, 67, 54, 0.5);
  box-shadow: 0 8rpx 32rpx rgba(244, 67, 54, 0.3);
}

.submit-btn {
  background: linear-gradient(135deg, #4CAF50 0%, #66BB6A 100%);
  color: white;
  border-color: rgba(76, 175, 80, 0.5);
  box-shadow: 0 8rpx 32rpx rgba(76, 175, 80, 0.3);
}

.submit-btn.disabled {
  background: rgba(76, 175, 80, 0.5);
  color: rgba(255, 255, 255, 0.7);
  border-color: rgba(76, 175, 80, 0.3);
  box-shadow: none;
  cursor: not-allowed;
}

.cancel-btn:active,
.submit-btn:active:not(.disabled) {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

/* 动画 */
@keyframes fadeInDown {
  from {
    opacity: 0;
    transform: translateY(-50rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(50rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 响应式设计 */
@media screen and (max-width: 750rpx) {
  .header-content {
    padding: 40rpx 30rpx;
  }
  
  .page-title {
    font-size: 40rpx;
  }
  
  .team-info {
    font-size: 24rpx;
  }
  
  .form-section {
    margin: 0 10rpx 30rpx;
    padding: 30rpx 20rpx;
  }
  
  .section-title {
    font-size: 28rpx;
    margin-bottom: 30rpx;
    padding-bottom: 16rpx;
  }
  
  .form-item {
    margin-bottom: 30rpx;
  }
  
  .label {
    font-size: 26rpx;
  }
  
  .input,
  .picker {
    padding: 20rpx 16rpx;
    font-size: 26rpx;
  }
  
  .avatar-preview {
    width: 160rpx;
    height: 160rpx;
  }
  
  .action-section {
    margin: 40rpx 10rpx 30rpx;
    gap: 20rpx;
  }
  
  .cancel-btn,
  .submit-btn {
    padding: 24rpx 30rpx;
    font-size: 28rpx;
  }
}
