.match-list{margin:0 0 22rpx;border-top:1rpx solid #e7ebe8}.match-row{display:grid;grid-template-columns:132rpx minmax(0,1fr) 116rpx;gap:12rpx;align-items:center;padding:20rpx 0;border-bottom:1rpx solid #eef1ef}.match-time{min-width:0}.match-time text,.match-main text{display:block}.match-time text:first-child{color:#20392c;font-size:24rpx;font-weight:700;white-space:nowrap}.match-time text:last-child{margin-top:5rpx;color:#078247;font-size:28rpx;font-weight:800;white-space:nowrap}.match-main{min-width:0}.match-main text:first-child{overflow:hidden;color:#20392c;font-size:24rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap}.match-main text:last-child{margin-top:8rpx;color:#7b857f;font-size:20rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.match-actions{text-align:right;min-width:0}.match-actions>text{display:block;font-size:20rpx;white-space:nowrap}.match-actions button{display:block;width:116rpx;box-sizing:border-box;height:52rpx;margin:9rpx 0 0;padding:0 4rpx;border:0;border-radius:9rpx;background:#e9f7ef;color:#087b46;font-size:20rpx;line-height:52rpx;white-space:nowrap}.match-actions button::after{border:0}.match-status-live{color:#e16822}.match-status-wait{color:#9b741f}.match-status-done{color:#6e7972}.match-empty{margin-bottom:22rpx;padding:28rpx 0;border-top:1rpx solid #e7ebe8;color:#8a948d;font-size:24rpx;text-align:center}
