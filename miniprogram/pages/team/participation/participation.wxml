<view class="event-page">
  <image class="event-bg" src="/images/runtime/team-data-emerald-stadium-v1.jpg" mode="aspectFill" />
  <view class="event-content">
    <view class="event-nav"><text class="event-back" bindtap="back">‹</text><text>参赛管理</text></view>
    <view wx:if="{{loading}}" class="event-loading">正在读取赛事关系…</view>
    <block wx:else>
      <view class="event-team"><image src="{{team.logo}}" mode="aspectFit" /><view><text>{{team.name}}</text><view class="event-count"><image src="/images/runtime/icons/brand-v2-02.png" mode="aspectFit" /><text>{{eventCount}} 项赛事</text></view></view></view>
      <view class="event-tabs"><text wx:for="{{filters}}" wx:key="id" class="{{item.className}}" data-id="{{item.id}}" bindtap="choose">{{item.label}}</text></view>
      <view wx:for="{{visible}}" wx:key="id" class="event-card"><view class="event-title"><image src="/images/runtime/icons/brand-v2-01.png" mode="aspectFit" /><view><text>{{item.name}}</text><text>{{item.divisionName}}</text></view><text class="{{item.statusClass}}">{{item.statusText}}</text></view><view class="event-meta"><text>{{item.rosterText}}</text><text>{{item.nextMatchText}}</text></view><button data-item="{{item}}" bindtap="open" class="{{item.actionClass}}">{{item.actionText}}</button><button wx:if="{{item.nextMatchId}}" class="event-lineup" data-id="{{item.nextMatchId}}" bindtap="openMatch">本场阵容待提交</button></view>
      <view class="event-note">ⓘ 球队资料不等于赛事参赛快照；确认参赛后按赛事要求提交名单。</view>
    </block>
  </view>
</view>
