.page{min-height:100vh;position:relative;background:#03261a;color:#26332b}.bg{position:fixed;inset:0;width:100%;height:100%;opacity:.72}.content{position:relative;z-index:1;padding:0 28rpx calc(74rpx + env(safe-area-inset-bottom))}.nav{height:208rpx;color:#fff;display:flex;align-items:center;justify-content:center;position:relative}.back{position:absolute;left:12rpx;top:52rpx;font-size:80rpx}.nav-title{margin-top:52rpx;font-size:40rpx;font-weight:700}.loading{padding:170rpx 20rpx;text-align:center;color:#effaf2}.hero{display:flex;align-items:center;gap:27rpx;padding:31rpx;margin-bottom:28rpx;border:2rpx solid #d0aa4a;border-radius:25rpx;background:rgba(0,60,36,.93);color:#fff}.crest{width:140rpx;height:140rpx}.placeholder{display:flex;align-items:center;justify-content:center;background:#1c7547;color:#d7eddd;border-radius:50%}.name,.claimed,.complete{display:block}.name{font-size:39rpx;font-weight:700}.claimed{display:inline-block;margin-top:15rpx;padding:6rpx 13rpx;border-radius:16rpx;background:#597a69;font-size:21rpx}.complete{margin-top:15rpx;color:#b4ffbe;font-size:25rpx}.card{padding:27rpx;margin-bottom:24rpx;border-radius:23rpx;background:#fff}.card-title{display:block;padding-left:14rpx;border-left:7rpx solid #099444;font-size:31rpx;font-weight:700;margin-bottom:18rpx}.row{display:flex;justify-content:space-between;gap:20rpx;padding:25rpx 8rpx;border-top:1rpx solid #edf0ed;font-size:27rpx}.row text:last-child{color:#59675f;text-align:right}.card input{height:82rpx;border-bottom:1rpx solid #dfe5e0;font-size:28rpx}.note{padding:24rpx;margin-bottom:24rpx;border-radius:15rpx;background:#eaf6ec;color:#28734b;font-size:24rpx;line-height:1.5}.primary,.secondary{width:100%;height:92rpx;line-height:92rpx;border-radius:16rpx;font-size:31rpx}.primary{background:#0ca044;color:#fff}.secondary{margin-top:17rpx;background:#fff;color:#277045}.secondary::after{border:0}
.delete-team{margin-top:32rpx;padding:22rpx 0;border-top:1rpx solid rgba(255,255,255,.2)}.delete-team button{background:transparent;color:#ffe3e4;font-size:26rpx;line-height:72rpx}.delete-team button::after{border:1rpx solid rgba(255,220,220,.5);border-radius:10rpx}.delete-team button[disabled]{color:#adbbb4}.delete-reason{display:block;margin-top:12rpx;color:#d5e3da;font-size:23rpx;line-height:1.5}
.transfer-team{margin-top:32rpx;padding:22rpx 0;border-top:1rpx solid rgba(255,255,255,.2)}.transfer-team button{background:transparent;color:#d8f5e3;font-size:26rpx;line-height:72rpx}.transfer-team button::after{border:1rpx solid rgba(200,255,220,.45);border-radius:10rpx}.transfer-team button[disabled]{color:#adbbb4}.transfer-tip{display:block;margin-top:12rpx;color:#cfe4d8;font-size:23rpx;line-height:1.5}
.venue-head{display:flex;align-items:center;justify-content:space-between}.venue-head .card-title{margin-bottom:0}.venue-add{padding:6rpx 18rpx;border-radius:16rpx;background:#e7f6ec;color:#0c8a4a;font-size:25rpx;font-weight:700}.venue-list{margin-top:20rpx}.venue-card{display:flex;align-items:center;padding:20rpx 22rpx;margin-bottom:14rpx;border-radius:18rpx;background:#f3f8f5}.venue-card:last-child{margin-bottom:0}.venue-card-head{flex:1;min-width:0}.venue-name-row{display:flex;align-items:center;gap:12rpx}.venue-name{color:#182d21;font-size:29rpx;font-weight:700;word-break:break-all}.venue-badge{flex:none;padding:3rpx 12rpx;border-radius:12rpx;background:#0c8a4a;color:#fff;font-size:20rpx}.venue-addr{display:block;margin-top:8rpx;color:#59675f;font-size:23rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.venue-btns{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:10rpx;margin-left:14rpx;max-width:300rpx}.venue-btn{padding:8rpx 16rpx;border-radius:14rpx;background:#fff;color:#0c8a4a;font-size:22rpx;font-weight:700}.venue-btn.danger{color:#c0423a}.venue-empty{margin-top:20rpx;padding:34rpx 20rpx;border:2rpx dashed #cfe0d6;border-radius:18rpx;text-align:center}.venue-empty-icon{display:block;font-size:40rpx}.venue-empty-text{display:block;margin-top:10rpx;color:#4a5a52;font-size:27rpx;font-weight:600}.venue-tip{display:block;margin-top:18rpx;color:#4a5a52;font-size:25rpx;line-height:1.5}.venue-editor-mask{position:fixed;top:0;left:0;right:0;bottom:0;z-index:99;display:flex;align-items:flex-end;background:rgba(0,0,0,.45)}.venue-editor{padding:34rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));width:100%;border-radius:28rpx 28rpx 0 0;background:#fff;box-sizing:border-box}.venue-editor-title{display:block;color:#182d21;font-size:34rpx;font-weight:900;text-align:center}.venue-editor-row{margin-top:28rpx}.venue-editor-label{display:block;color:#5b6c61;font-size:25rpx}.venue-editor-input{margin-top:12rpx;padding:0 20rpx;height:84rpx;border-radius:16rpx;background:#f3f8f5;color:#182d21;font-size:28rpx}.venue-editor-ph{color:#a9b5ad}.venue-editor-loc-row{display:flex;align-items:center;margin-top:12rpx}.venue-editor-map-btn{padding:0 24rpx;height:72rpx;line-height:72rpx;border-radius:16rpx;background:#e7f6ec;color:#0c8a4a;font-size:26rpx;font-weight:700}.venue-editor-loc-info{flex:1;min-width:0;display:flex;align-items:center;margin-left:16rpx}.venue-editor-loc-addr{flex:1;min-width:0;color:#182d21;font-size:24rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.venue-editor-loc-clear{flex:none;margin-left:14rpx;color:#c0423a;font-size:24rpx}.venue-editor-loc-hint{flex:1;margin-left:16rpx;color:#a9b5ad;font-size:22rpx}.venue-editor-btns{display:flex;gap:18rpx;margin-top:36rpx}.venue-editor-btn{flex:1;height:84rpx;line-height:84rpx;border-radius:18rpx;font-size:30rpx;font-weight:700}.venue-editor-btn.cancel{background:#f1f5f2;color:#5b6c61}.venue-editor-btn.save{background:#078143;color:#fff}