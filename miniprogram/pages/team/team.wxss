@import "../../styles/proto.wxss";
.page{min-height:100vh;background:#002819;position:relative}.stadium-bg,.shade{position:fixed;inset:0;width:100%;height:100%}.stadium-bg{object-position:center top}.shade{background:linear-gradient(180deg,rgba(0,24,15,.08),rgba(0,39,23,.82))}.content{position:relative;z-index:1;padding:94rpx 22rpx calc(140rpx + env(safe-area-inset-bottom))}.top{position:relative;height:72rpx;display:flex;align-items:center;justify-content:center;color:#fff;font-size:42rpx;font-weight:900}.top text:first-child{position:absolute;left:18rpx;font-size:70rpx;font-weight:400}.team-summary{margin-top:26rpx;padding:28rpx;border:2rpx solid #d9b55d;border-radius:28rpx;background:rgba(0,61,38,.56);box-sizing:border-box}.team-summary .hero{display:flex;align-items:center;margin:0;padding:0;border:0;border-radius:0;background:transparent;box-shadow:none;color:#fff;overflow:visible;min-height:0}.team-summary .hero>image,.team-summary .logo-fallback{width:148rpx;height:164rpx;flex:0 0 148rpx}.team-summary .hero>image{padding:0;background:transparent}.team-summary .logo-fallback{padding:30rpx;border-radius:0;background:rgba(234,244,236,.96);clip-path:polygon(50% 0,91% 16%,91% 70%,50% 100%,9% 70%,9% 16%);box-sizing:border-box}.team-summary .hero-main{min-width:0;flex:1;margin-left:24rpx}.team-summary .name{display:block;font-size:40rpx;line-height:1.35;font-weight:800;word-break:break-all}.hero-meta{display:flex;flex-wrap:wrap;align-items:center;gap:10rpx 15rpx;margin-top:12rpx;color:rgba(255,255,255,.9);font-size:28rpx;line-height:1.5;word-break:break-all}.hero-meta .claim{margin:0;padding:5rpx 13rpx;border-radius:15rpx;background:#e5f5e8;color:#158446;font-size:26rpx}.hero-meta .completion{margin:0;color:#76e3a6;font-size:28rpx}.summary-arrow{margin-left:12rpx;color:#fff;font-size:58rpx;font-weight:300}.team-summary .metrics{display:flex;margin-top:28rpx;padding:25rpx 0;border-radius:22rpx;background:rgba(255,255,255,.98)}.team-summary .metrics view{flex:1;text-align:center;border-right:2rpx solid #e5e8e6}.team-summary .metrics view:last-child{border:0}.team-summary .metrics text{display:block}.team-summary .metrics text:first-child{color:#078143;font-size:46rpx;font-weight:800;line-height:1.3}.team-summary .metrics text:last-child{margin-top:10rpx;color:#56665c;font-size:28rpx;line-height:1.4}.menu{margin-top:28rpx;border-radius:26rpx;background:rgba(255,255,255,.98);overflow:hidden}.menu-row{display:flex;align-items:center;min-height:124rpx;padding:22rpx 26rpx;border-bottom:1rpx solid #e5ece7;box-sizing:border-box}.menu-row:last-child{border:0}.menu-row image{display:block;flex:none;width:62rpx;height:62rpx;margin-right:22rpx;padding:10rpx;border-radius:15rpx;background:#edf7f0;box-sizing:border-box}.menu-title{display:block;flex:1;min-width:0;color:#182d21;font-size:34rpx;font-weight:600;line-height:1.5;word-break:break-all}.menu-arrow{display:block;flex:none;margin-left:18rpx;color:#718178;font-size:40rpx;line-height:1}.current{margin-top:32rpx;padding:30rpx;border-radius:26rpx;background:rgba(255,255,255,.98)}.section{display:block;padding-left:15rpx;border-left:7rpx solid #0ca65a;color:#1a241d;font-size:32rpx;font-weight:900}.event-name{display:block;margin-top:19rpx;color:#182d21;font-size:34rpx;font-weight:700;line-height:1.5;word-break:break-all}.current>text:nth-child(3){display:block;margin-top:10rpx;color:#5b6c61;font-size:28rpx;line-height:1.5}.current button{margin-top:22rpx;background:#078143;color:#fff;border-radius:16rpx;font-size:30rpx;line-height:88rpx}.notice{margin-top:26rpx;padding:24rpx;border:2rpx solid rgba(34,192,100,.45);border-radius:20rpx;background:rgba(0,65,38,.76);color:#eaf7ef;font-size:28rpx;line-height:1.6}.empty{margin-top:250rpx;padding:70rpx 40rpx;border-radius:26rpx;background:#fff;text-align:center}.empty image{width:180rpx;height:180rpx}.empty text{display:block;margin-top:34rpx;font-size:36rpx;font-weight:900}.empty button{margin-top:40rpx;background:#078143;color:#fff;border-radius:22rpx}.loading,.error{margin-top:30rpx;color:#fff;font-size:28rpx;line-height:1.5;text-align:center}.error{padding:20rpx;border-radius:16rpx;background:#fff0ee;color:#a43e38}
