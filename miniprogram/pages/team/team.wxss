/* pages/team/team.wxss */
/* 专业足球风格球队页面 */

page {
  background: #f5f5f5;
  min-height: 100vh;
}

.team-page {
  padding-bottom: 100rpx;
}

/* ============ 空状态 ============ */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 40rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.empty-subtitle {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 60rpx;
}

.create-btn {
  background: linear-gradient(135deg, #1B5E20 0%, #2E7D32 100%);
  color: #fff;
  border: none;
  border-radius: 50rpx;
  padding: 24rpx 80rpx;
  font-size: 30rpx;
  font-weight: bold;
}

/* 空状态提示 */
.empty-tip {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 28rpx;
}


.create-btn::after {
  border: none;
}

/* ============ 顶部球队信息区 ============ */
.team-header {
  position: relative;
  background: linear-gradient(135deg, #1B5E20 0%, #2E7D32 50%, #43A047 100%);
  padding: 60rpx 30rpx 40rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image: radial-gradient(circle, rgba(255,255,255,0.08) 1px, transparent 1px);
  background-size: 20rpx 20rpx;
}

.header-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 六边形队徽 - 蜂巢风格 */
.team-logo-wrapper {
  width: 170rpx;
  height: 170rpx;
  background: rgba(255, 255, 255, 0.95);
  padding: 6rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
  margin-bottom: 24rpx;
  clip-path: polygon(50% 0%, 93.3% 25%, 93.3% 75%, 50% 100%, 6.7% 75%, 6.7% 25%);
  -webkit-clip-path: polygon(50% 0%, 93.3% 25%, 93.3% 75%, 50% 100%, 6.7% 75%, 6.7% 25%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.team-logo {
  width: 96%;
  height: 96%;
  clip-path: polygon(50% 0%, 93.3% 25%, 93.3% 75%, 50% 100%, 6.7% 75%, 6.7% 25%);
  -webkit-clip-path: polygon(50% 0%, 93.3% 25%, 93.3% 75%, 50% 100%, 6.7% 75%, 6.7% 25%);
}

.team-name-section {
  text-align: center;
  margin-bottom: 20rpx;
}

.team-name-cn {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
}

.team-name-en {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.team-tags {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.tag-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
}

.tag-icon {
  font-size: 24rpx;
}

.tag-text {
  font-size: 24rpx;
  color: #fff;
}

.header-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn-small {
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  color: #fff;
  font-size: 24rpx;
  padding: 12rpx 32rpx;
  border-radius: 30rpx;
}

.action-btn-small::after {
  border: none;
}

/* ============ 数据统计区 ============ */
.stats-section {
  background: #fff;
  padding: 30rpx;
  margin-top: -20rpx;
  border-radius: 30rpx 30rpx 0 0;
}

.stats-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.stats-scroll {
  display: flex;
  gap: 20rpx;
  overflow-x: auto;
  padding-bottom: 10rpx;
}

.stat-card {
  flex-shrink: 0;
  width: 160rpx;
  background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #1B5E20;
  line-height: 1;
  margin-bottom: 8rpx;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #666;
}

.team-share-panel {
  background: #fff;
  padding: 0 30rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.team-share-primary {
  width: 100%;
  height: 82rpx;
  line-height: 82rpx;
  background: linear-gradient(135deg, #2E7D32 0%, #43A047 100%);
  color: #fff;
  border-radius: 41rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 22rpx rgba(46, 125, 50, 0.24);
}

.team-share-primary::after {
  border: none;
}

.team-share-tip {
  font-size: 22rpx;
  color: #7A8B7C;
}

/* ============ Tab 导航 ============ */
.tab-nav {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 100;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #1B5E20;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: #1B5E20;
  border-radius: 3rpx;
}

/* ============ Tab 内容 ============ */
.tab-content {
  padding: 20rpx;
}

/* ============ 阵容模块 ============ */
.squad-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-count {
  font-size: 24rpx;
  color: #999;
  background: #f5f5f5;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

/* 教练组列表 */
.staff-list {
  margin-bottom: 20rpx;
}

.staff-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.staff-item:last-child {
  border-bottom: none;
}

/* 六边形头像 - 蜂巢风格 */
.staff-avatar {
  width: 84rpx;
  height: 84rpx;
  background: linear-gradient(135deg, #1B5E20 0%, #43A047 100%);
  padding: 3rpx;
  flex-shrink: 0;
  clip-path: polygon(50% 0%, 93.3% 25%, 93.3% 75%, 50% 100%, 6.7% 75%, 6.7% 25%);
  -webkit-clip-path: polygon(50% 0%, 93.3% 25%, 93.3% 75%, 50% 100%, 6.7% 75%, 6.7% 25%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.staff-avatar image {
  width: 96%;
  height: 96%;
  clip-path: polygon(50% 0%, 93.3% 25%, 93.3% 75%, 50% 100%, 6.7% 75%, 6.7% 25%);
  -webkit-clip-path: polygon(50% 0%, 93.3% 25%, 93.3% 75%, 50% 100%, 6.7% 75%, 6.7% 25%);
}

.staff-info {
  flex: 1;
  min-width: 0;
}

.staff-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 6rpx;
}

.staff-role {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.staff-actions {
  display: flex;
  gap: 16rpx;
}

.icon-btn {
  font-size: 28rpx;
  padding: 8rpx;
}

.icon-btn.delete {
  opacity: 0.6;
}

/* 按位置分组 */
.position-group {
  margin-bottom: 30rpx;
}

.position-label {
  font-size: 26rpx;
  font-weight: bold;
  color: #1B5E20;
  padding: 12rpx 20rpx;
  background: linear-gradient(90deg, #E8F5E9 0%, transparent 100%);
  border-radius: 10rpx;
  margin-bottom: 16rpx;
}

/* 球员列表行 */
.player-list {
  display: flex;
  flex-direction: column;
}

.player-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 12rpx;
  background: #fafafa;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
}

.player-number {
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #1B5E20 0%, #2E7D32 100%);
  color: #fff;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  flex-shrink: 0;
}

/* 六边形球员头像 - 蜂巢风格 */
.player-avatar-small {
  width: 68rpx;
  height: 68rpx;
  background: linear-gradient(135deg, #1B5E20 0%, #43A047 100%);
  padding: 2rpx;
  flex-shrink: 0;
  clip-path: polygon(50% 0%, 93.3% 25%, 93.3% 75%, 50% 100%, 6.7% 75%, 6.7% 25%);
  -webkit-clip-path: polygon(50% 0%, 93.3% 25%, 93.3% 75%, 50% 100%, 6.7% 75%, 6.7% 25%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.player-avatar-small image {
  width: 96%;
  height: 96%;
  clip-path: polygon(50% 0%, 93.3% 25%, 93.3% 75%, 50% 100%, 6.7% 75%, 6.7% 25%);
  -webkit-clip-path: polygon(50% 0%, 93.3% 25%, 93.3% 75%, 50% 100%, 6.7% 75%, 6.7% 25%);
}

.player-info {
  flex: 1;
  min-width: 0;
}

.player-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 4rpx;
}

.player-meta {
  display: block;
  font-size: 22rpx;
  color: #999;
}

.player-stats-mini {
  display: flex;
  gap: 16rpx;
  flex-shrink: 0;
}

.mini-stat {
  font-size: 22rpx;
  color: #666;
  background: #fff;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

.player-actions-mini {
  display: flex;
  gap: 8rpx;
  flex-shrink: 0;
}

.icon-btn-small {
  font-size: 24rpx;
  padding: 6rpx;
}

.icon-btn-small.delete {
  opacity: 0.6;
}

/* 添加按钮 */
.add-btn-row {
  margin-top: 20rpx;
}

.add-btn-outline {
  background: transparent;
  border: 2rpx dashed #1B5E20;
  color: #1B5E20;
  font-size: 26rpx;
  padding: 20rpx 0;
  border-radius: 16rpx;
  width: 100%;
}

.add-btn-outline::after {
  border: none;
}

.add-btn-primary {
  background: linear-gradient(135deg, #1B5E20 0%, #2E7D32 100%);
  color: #fff;
  border: none;
  font-size: 28rpx;
  padding: 24rpx 0;
  border-radius: 50rpx;
  width: 100%;
  font-weight: bold;
}

.add-btn-primary::after {
  border: none;
}

/* ============ 开发中提示 ============ */
.coming-soon {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  text-align: center;
}

.coming-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.coming-text {
  font-size: 28rpx;
  color: #999;
}


.share-create-btn {
  margin-top: 24rpx;
  background: #ffffff;
  color: #1B5E20;
  border: 2rpx solid #1B5E20;
  border-radius: 50rpx;
  padding: 20rpx 56rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.share-create-btn::after,
.invite-player-btn::after {
  border: none;
}

.add-actions-row {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 20rpx;
}

.invite-player-btn {
  width: 100%;
  background: #ffffff;
  color: #1B5E20;
  border: 2rpx solid #B7D7B9;
  border-radius: 50rpx;
  font-size: 28rpx;
  padding: 22rpx 0;
  font-weight: 600;
}
