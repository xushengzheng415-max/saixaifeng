/* pages/team/detail/detail.wxss */
/* 青训版本 - 球队详情页样式 */

.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ===== 加载状态 ===== */
.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
  color: #999;
  font-size: 28rpx;
}

/* ===== 顶部卡片 ===== */
.team-header {
  background: linear-gradient(135deg, #2E7D32 0%, #4CAF50 100%);
  padding: 40rpx 30rpx 60rpx;
  display: flex;
  align-items: flex-start;
}

.team-logo {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  background-color: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  overflow: hidden;
}

.team-logo image {
  width: 100%;
  height: 100%;
}

.logo-placeholder {
  font-size: 60rpx;
}

.team-info {
  flex: 1;
}

.team-name {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
}

.team-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.meta-item {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.team-code-box {
  display: inline-flex;
  align-items: center;
  background-color: rgba(255, 255, 255, 0.15);
  border-radius: 8rpx;
  padding: 12rpx 20rpx;
}

.code-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-right: 12rpx;
}

.code-value {
  font-size: 28rpx;
  color: #fff;
  font-weight: bold;
  margin-right: 12rpx;
}

.copy-hint {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* ===== 统计 ===== */
.stats-section {
  display: flex;
  background-color: #fff;
  margin: -30rpx 30rpx 20rpx;
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.stat-item {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid #f0f0f0;
}

.stat-item:last-child {
  border-right: none;
}

.stat-number {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #2E7D32;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-top: 6rpx;
}

/* ===== 操作按钮 ===== */
.action-section {
  display: flex;
  gap: 16rpx;
  padding: 0 30rpx;
  margin-bottom: 20rpx;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  background-color: #fff;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #333;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn::after {
  border: none;
}

.action-btn.primary {
  background: linear-gradient(135deg, #2E7D32 0%, #4CAF50 100%);
  color: #fff;
  border: none;
}

.btn-icon {
  margin-right: 8rpx;
}

/* ===== 球员列表 ===== */
.players-section {
  background-color: #fff;
  margin: 0 30rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}

.section-header {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.player-list {
  border-top: 1rpx solid #f0f0f0;
}

.player-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.player-item:last-child {
  border-bottom: none;
}

.player-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.avatar-placeholder {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #E8F5E9;
  color: #2E7D32;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  margin-right: 20rpx;
}

.player-info {
  flex: 1;
}

.player-name {
  display: block;
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.player-meta {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.arrow {
  font-size: 28rpx;
  color: #ccc;
}

/* ===== 空状态 ===== */
.empty-state {
  padding: 60rpx 0;
  text-align: center;
}

.empty-icon {
  font-size: 60rpx;
  display: block;
  margin-bottom: 16rpx;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 24rpx;
}

.btn-add {
  display: inline-block;
  width: 200rpx;
  height: 64rpx;
  line-height: 64rpx;
  background: linear-gradient(135deg, #2E7D32 0%, #4CAF50 100%);
  color: #fff;
  font-size: 26rpx;
  border-radius: 32rpx;
}

.btn-add::after {
  border: none;
}

/* ===== 我的主场 ===== */
.venues-section {
  background-color: #fff;
  margin: 0 30rpx 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}
.section-add { float: right; font-size: 28rpx; color: #2E7D32; font-weight: 600 }
.venue-list { display: flex; flex-direction: column; gap: 16rpx }
.venue-card { padding: 18rpx; border-radius: 12rpx; background: #f6f9f7; border: 1rpx solid #e6f1e9 }
.venue-card-head { margin-bottom: 12rpx }
.venue-card-title-row { display: flex; align-items: center; gap: 10rpx }
.venue-card-name { font-size: 30rpx; font-weight: 700; color: #1a4020 }
.venue-default-badge { font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 10rpx; background: #2E7D32; color: #fff }
.venue-card-addr { display: block; font-size: 24rpx; color: #666; margin-top: 6rpx }
.venue-card-btns { display: flex; gap: 14rpx; flex-wrap: wrap }
.venue-btn { font-size: 24rpx; color: #2E7D32; padding: 4rpx 12rpx; border-radius: 8rpx; background: #e6f1e9 }
.venue-btn.danger { color: #c62828; background: #fde8e8 }
.venue-empty { padding: 40rpx 0; text-align: center; border: 2rpx dashed #c8e0cc; border-radius: 12rpx }
.venue-empty-icon { font-size: 44rpx; display: block; margin-bottom: 10rpx }
.venue-empty-text { font-size: 26rpx; color: #888 }

/* 主场编辑弹窗 */
.venue-editor-mask { position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 1000; display: flex; align-items: center; justify-content: center }
.venue-editor { width: 600rpx; background: #fff; border-radius: 20rpx; padding: 32rpx 28rpx }
.venue-editor-title { font-size: 32rpx; font-weight: 800; color: #1a4020; display: block; margin-bottom: 24rpx; text-align: center }
.venue-editor-row { margin-bottom: 22rpx }
.venue-editor-label { font-size: 26rpx; color: #444; display: block; margin-bottom: 10rpx }
.venue-editor-input { width: 100%; padding: 16rpx 20rpx; border-radius: 12rpx; background: #f6f9f7; font-size: 28rpx; box-sizing: border-box }
.venue-editor-ph { color: #aaa }
.venue-editor-loc-row { display: flex; flex-direction: column; gap: 10rpx }
.venue-editor-map-btn { align-self: flex-start; padding: 14rpx 22rpx; border-radius: 14rpx; background: #2E7D32; color: #fff; font-size: 26rpx; font-weight: 600 }
.venue-editor-loc-info { display: flex; align-items: flex-start; gap: 10rpx }
.venue-editor-loc-addr { flex: 1; font-size: 24rpx; color: #666; line-height: 1.5 }
.venue-editor-loc-clear { font-size: 22rpx; color: #c62828; padding: 2rpx 10rpx }
.venue-editor-loc-hint { font-size: 22rpx; color: #aaa }
.venue-editor-btns { display: flex; gap: 16rpx; margin-top: 20rpx }
.venue-editor-btn { flex: 1; height: 76rpx; line-height: 76rpx; border-radius: 14rpx; font-size: 28rpx; font-weight: 600; padding: 0 }
.venue-editor-btn.cancel { background: #f0f0f0; color: #555 }
.venue-editor-btn.save { background: #2E7D32; color: #fff }
.venue-editor-btn::after { border: none }