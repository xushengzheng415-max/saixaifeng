page{background:#003621}.player-library-page{position:relative;min-height:100vh;overflow:hidden;color:#fff}.player-library-bg{position:fixed;z-index:0;inset:0;width:100%;height:100%;opacity:.96}.player-library-content{position:relative;z-index:1;padding:0 26rpx 132rpx;box-sizing:border-box}.player-library-nav{height:180rpx;display:flex;align-items:flex-end;justify-content:center;padding-bottom:28rpx;box-sizing:border-box;position:relative}.player-library-back{position:absolute;left:4rpx;bottom:18rpx;width:70rpx;color:#fff;font-size:76rpx;font-weight:200;line-height:1;text-align:center}.player-library-title{font-size:38rpx;font-weight:700;letter-spacing:2rpx}.player-library-state{min-height:620rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:24rpx;text-align:center}.player-library-state button{font-size:26rpx}.player-team-card{min-height:276rpx;padding:24rpx 22rpx 18rpx;border:2rpx solid #b49a47;border-radius:28rpx;background:linear-gradient(135deg,rgba(0,99,62,.97),rgba(0,55,36,.95));box-sizing:border-box;box-shadow:0 14rpx 30rpx rgba(0,25,14,.16)}.player-team-top{min-height:148rpx;display:flex;align-items:center;position:relative}.player-crest-wrap{width:150rpx;height:148rpx;display:flex;align-items:center;justify-content:center;flex:none}.player-crest{width:138rpx;height:138rpx;object-fit:contain}.player-crest-empty{display:flex;align-items:center;justify-content:center;border:2rpx solid rgba(225,195,104,.8);border-radius:22rpx;color:#e7cf89;font-size:22rpx}.player-team-copy{min-width:0;flex:1;padding:0 218rpx 0 16rpx}.player-team-name{display:block;overflow:hidden;color:#fff;font-size:34rpx;font-weight:800;line-height:1.35;text-overflow:ellipsis;white-space:nowrap}.player-team-desc{display:block;margin-top:12rpx;color:#d8e9df;font-size:24rpx;white-space:nowrap}.player-team-actions{position:absolute;right:0;top:0;width:208rpx;display:flex;flex-direction:column;gap:12rpx}.player-team-actions button{width:100%;height:60rpx;margin: