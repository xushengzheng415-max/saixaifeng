<view class="page">
  <image class="stadium-bg" src="/images/runtime/home-roles-emerald-stadium-v1.jpg" mode="aspectFill"></image>
  <view class="shade"></view>
  <view class="content">
    <view class="topbar">
      <text>我的</text>
      <view class="message-trigger" wx:if="{{!guestMode}}" bindtap="goToMessages">
        <image src="/images/icons/bell-white.svg" mode="aspectFit"></image>
        <text class="unread-badge" wx:if="{{hasUnread}}">{{unreadText}}</text>
      </view>
    </view>
    <view class="guest-mode-banner" wx:if="{{guestMode}}" bindtap="goToInfo"><view><text>当前未登录</text><text>“我的”功能演示 · 示例数据不保存</text></view><text>去登录 ›</text></view>
    <view class="user-card" bindtap="goToInfo">
      <image class="avatar" wx:if="{{hasUserAvatar}}" src="{{userAvatar}}" mode="aspectFill"></image>
      <view class="avatar avatar-fallback" wx:if="{{!hasUserAvatar}}"><image src="/images/runtime/icons/brand-v1-tab-profile.png" mode="aspectFit"></image></view>
      <view class="user-main"><text>{{userName}}</text><text>{{phoneMasked}}</text><text class="login-tag {{phoneStateClass}}">{{phoneVerifiedText}}</text></view>
      <text class="chevron">›</text>
    </view>
    <view class="authorization-card">
      <view class="authorization-head"><text>账号授权</text><text>按手机号隔离</text></view>
      <view class="authorization-row"><text>授权岗位</text><text>{{positionsText}}</text></view>
      <view class="authorization-row"><text>权限范围</text><text>{{permissionsText}}</text></view>
    </view>
    <view class="identity-card">
      <view class="identity-head"><text>当前身份</text><text bindtap="openIdentitySheet">切换身份 ›</text></view>
      <view class="identity-body">
        <image wx:if="{{hasWorkspaceLogo}}" src="{{workspaceLogo}}" mode="aspectFit"></image>
        <view class="identity-logo" wx:if="{{!hasWorkspaceLogo}}"><image src="{{currentIdentityIcon}}" mode="aspectFit"></image></view>
        <view><text>{{workspaceName}}</text><text>当前使用身份</text><text class="identity-tag">{{currentIdentityName}}</text></view>
      </view>
    </view>
    <view class="profile-menu">
      <view class="menu-row" wx:for="{{primaryMenus}}" wx:key="action" data-action="{{item.action}}" bindtap="onMenuTap">
        <image src="{{item.icon}}" mode="aspectFit"></image><text>{{item.title}}</text><text class="menu-badge" wx:if="{{item.badgeText}}">{{item.badgeText}}</text><text class="menu-arrow">›</text>
      </view>
    </view>
    <view class="profile-menu support-menu">
      <view class="menu-row" wx:for="{{supportMenus}}" wx:key="action" data-action="{{item.action}}" bindtap="onMenuTap">
        <image src="{{item.icon}}" mode="aspectFit"></image><text>{{item.title}}</text><text class="menu-arrow">›</text>
      </view>
    </view>
    <button class="logout" wx:if="{{!guestMode}}" bindtap="onLogout">退出登录</button>
    <button class="guest-login-button" wx:if="{{guestMode}}" bindtap="goToInfo">登录后使用完整功能</button>
    <text class="version-entry" bindtap="onMenuTap" data-action="versionLog">版本 {{appVersion}} · 查看更新日志</text>
    <text class="support-note">由赛小蜂足球提供技术支持</text>
    <view class="loading" wx:if="{{loading}}">正在同步我的信息…</view>
    <view class="error-card" wx:if="{{errorText}}">{{errorText}}</view>
  </view>
  <view class="sheet-mask" wx:if="{{isIdentitySheet}}" bindtap="closeIdentitySheet">
    <view class="identity-sheet" catchtap="noop">
      <view class="sheet-handle"></view><text class="sheet-title">切换身份</text>
      <view class="identity-options"><view class="identity-option {{item.selectedClass}}" wx:for="{{identityOptions}}" wx:key="id" data-id="{{item.id}}" bindtap="selectIdentity"><image src="{{item.icon}}" mode="aspectFit"></image><text>{{item.title}}</text><text>{{workspaceName}}</text><text class="identity-state">{{item.selectedText}}</text></view></view>
      <button class="confirm" bindtap="confirmIdentitySwitch" loading="{{submitting}}" disabled="{{confirmDisabled}}">{{confirmText}}</button><text class="cancel" bindtap="closeIdentitySheet">取消</text><view class="sheet-error" wx:if="{{errorText}}">{{errorText}}</view>
    </view>
  </view>
</view>
