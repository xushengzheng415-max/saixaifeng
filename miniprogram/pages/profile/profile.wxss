@import "../../styles/proto.wxss";.page{min-height:100vh;position:relative;overflow:hidden;background:#001d12}.stadium-bg,.shade{position:fixed;inset:0;width:100%;height:100%}.shade{background:linear-gradient(180deg,rgba(0,16,10,.26),rgba(0,25,14,.8))}.content{position:relative;z-index:1;padding:102rpx 42rpx calc(145rpx + env(safe-area-inset-bottom))}.topbar{display:flex;align-items:center;justify-content:center;position:relative;color:#fff;font-size:42rpx;font-weight:900}.topbar view{position:absolute;right:0}.topbar image{width:54rpx;height:54rpx}.user-card{display:flex;align-items:center;margin-top:42rpx;padding:28rpx;border:2rpx solid rgba(43,178,94,.45);border-radius:29rpx;background:rgba(0,51,30,.78);color:#fff}.avatar{width:128rpx;height:128rpx;border-radius:50%;background:#e8f0ea}.avatar-fallback{padding:31rpx;box-sizing:border-box}.user-card view:nth-child(3){flex:1;margin-left:26rpx}.user-card text{display:block}.user-card text:first-child{font-size:37rpx;font-weight:800}.user-card text:nth-child(2){margin-top:12rpx;color:rgba(255,255,255,.72);font-size:25rpx}.user-card>text{font-size:44rpx}.identity-card{margin-top:24rpx;padding:30rpx;border-radius:29rpx;background:rgba(255,255,255,.97)}.identity-head{display:flex;justify-content:space-between;color:#181d19;font-size:32rpx;font-weight:900}.identity-head text:last-child{color:#5d655f;font-size:25rpx;font-weight:500}.identity-body{display:flex;align-items:center;margin-top:32rpx}.identity-body>image,.identity-logo{width:122rpx;height:122rpx;margin-right:28rpx}.identity-logo{padding:25rpx;border-radius:50%;background:#eff7f1;box-sizing:border-box}.identity-body view{flex:1}.identity-body text{display:block}.identity-body text:first-child{color:#171c18;font-size:33rpx;font-weight:800}.identity-body text:nth-child(2){margin-top:10rpx;color:#727a75;font-size:24rpx}.identity-tag{display:inline-block!important;margin-top:15rpx;padding:8rpx 16rpx;border-radius:18rpx;background:#e7f5ea;color:#1c8a44!important;font-size:23rpx!important}.profile-menu{margin-top:24rpx;border-radius:26rpx;background:rgba(255,255,255,.97);overflow:hidden}.profile-menu view{display:flex;align-items:center;height:96rpx;padding:0 28rpx;border-bottom:2rpx solid #edf0ee}.profile-menu view:last-child{border:0}.profile-menu image{width:34rpx;height:34rpx;margin-right:18rpx}.profile-menu text:nth-child(2){flex:1;color:#202720;font-size:28rpx}.profile-menu text:last-child{color:#88908b;font-size:39rpx}.logout{margin-top:28rpx;background:rgba(255,255,255,.96);color:#bf4037;border-radius:22rpx;font-size:28rpx}.loading,.error-card{margin-top:24rpx;color:#fff;font-size:23rpx;text-align:center}.error-card{padding:18rpx;border-radius:16rpx;background:#fff0ef;color:#a43e38}.sheet-mask{position:fixed;z-index:20;inset:0;display:flex;align-items:flex-end;background:rgba(0,0,0,.54)}.identity-sheet{width:100%;padding:24rpx 42rpx calc(36rpx + env(safe-area-inset-bottom));border-radius:38rpx 38rpx 0 0;background:#fff;box-sizing:border-box}.sheet-handle{width:130rpx;height:10rpx;margin:0 auto 36rpx;border-radius:10rpx;background:#ccd0cd}.sheet-title{display:block;color:#101510;font-size:44rpx;font-weight:900;text-align:center}.sheet-subtitle{display:block;margin:18rpx 0 42rpx;color:#777f7a;font-size:25rpx;text-align:center}.identity-options{display:flex;gap:18rpx}.identity-option{position:relative;width:33.33%;min-height:330rpx;display:flex;flex-direction:column;align-items:center;padding:28rpx 12rpx;border:2rpx solid #e1e5e2;border-radius:22rpx;box-sizing:border-box;text-align:center}.identity-option.is-current,.identity-option.is-selected{border-color:#168842;background:#f3faf4}.identity-option image{width:112rpx;height:112rpx;padding:24rpx;border-radius:50%;background:#eaf4ec;box-sizing:border-box}.identity-option text:nth-child(2){margin-top:26rpx;color:#151a16;font-size:28rpx;font-weight:800}.identity-option text:nth-child(3){margin-top:13rpx;color:#777f7a;font-size:21rpx}.identity-state{position:absolute;bottom:22rpx;color:#168842!important;font-size:22rpx!important}.confirm{margin-top:44rpx;background:#118b43;color:#fff;border-radius:20rpx;font-size:34rpx;font-weight:800}.confirm[disabled]{opacity:.5}.cancel{display:block;margin-top:29rpx;color:#737a75;font-size:29rpx;text-align:center}.sheet-error{margin-top:20rpx;color:#a43e38;font-size:23rpx;text-align:center}
/* 覆盖头像条件渲染造成的序号差异：资料文案区域始终占据剩余宽度。 */
.user-card > view:not(.avatar){flex:1;margin-left:26rpx}.avatar-fallback image{display:block;width:78rpx;height:78rpx}.identity-logo image{display:block;width:72rpx;height:72rpx}
.authorization-card{margin-top:24rpx;padding:28rpx;border-radius:26rpx;background:rgba(255,255,255,.97)}.authorization-head{display:flex;align-items:center;justify-content:space-between;padding-bottom:21rpx;border-bottom:2rpx solid #edf0ee}.authorization-head text:first-child{color:#172019;font-size:31rpx;font-weight:900}.authorization-head text:last-child{color:#168842;font-size:22rpx}.authorization-row{display:flex;align-items:flex-start;padding-top:21rpx}.authorization-row text:first-child{flex:0 0 132rpx;color:#727a75;font-size:23rpx}.authorization-row text:last-child{flex:1;color:#202720;font-size:24rpx;line-height:1.55;text-align:right}.user-main .login-tag.is-verified{border-color:#1dca67;color:#32d174!important}.user-main .login-tag.is-unverified{border-color:#e9a23b;color:#ffd27a!important}
.version-entry{display:block;margin-top:28rpx;color:rgba(255,255,255,.92);font-size:24rpx;text-align:center;text-decoration:underline}
/* 我的主页的动态状态与重复菜单行。 */
.message-trigger{position:absolute!important;right:0;top:0;width:58rpx;height:58rpx}.message-trigger image{width:54rpx!important;height:54rpx!important}.message-trigger .unread-badge{position:absolute;right:-12rpx;top:-16rpx;display:block;min-width:34rpx;height:34rpx;padding:0 6rpx;border:3rpx solid #fff;border-radius:22rpx;background:#e84b3f;color:#fff;font-size:21rpx;line-height:34rpx;text-align:center;box-sizing:border-box}.user-main{flex:1!important;margin-left:26rpx}.user-main .login-tag{display:inline-block!important;margin-top:13rpx;padding:6rpx 14rpx;border:2rpx solid #1dca67;border-radius:14rpx;color:#32d174!important;font-size:23rpx!important;line-height:29rpx}.chevron{margin-left:18rpx!important;color:rgba(255,255,255,.85);font-size:50rpx!important}.profile-menu .menu-row{display:flex;align-items:center;height:96rpx;padding:0 28rpx;border-bottom:2rpx solid #edf0ee}.profile-menu .menu-row:last-child{border:0}.profile-menu .menu-badge{flex:0!important;display:block;min-width:39rpx;height:39rpx;margin-right:18rpx;border-radius:20rpx;background:#e6483e;color:#fff!important;font-size:23rpx!important;line-height:39rpx;text-align:center}.profile-menu .menu-arrow{flex:0!important;color:#88908b;font-size:39rpx}.support-menu{margin-top:24rpx}.support-note{display:block;margin:26rpx 0 7rpx;color:rgba(255,255,255,.82);font-size:23rpx;text-align:center}
