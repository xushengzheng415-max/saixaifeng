@import "../../styles/proto.wxss";
.page{min-height:100vh;position:relative;overflow:hidden;background:#001d12}
.stadium-bg,.shade{position:fixed;inset:0;width:100%;height:100%}
.shade{background:linear-gradient(180deg,rgba(0,16,10,.26),rgba(0,25,14,.8))}
.content{position:relative;z-index:1;padding:102rpx 42rpx calc(145rpx + env(safe-area-inset-bottom))}
.topbar{display:flex;align-items:center;gap:20rpx;min-height:58rpx;color:#fff;font-size:40rpx;font-weight:800}
.message-trigger{position:relative;flex:none;width:46rpx;height:46rpx}
.message-trigger image{display:block;width:46rpx;height:46rpx}
.unread-badge{position:absolute;right:-12rpx;top:-12rpx;min-width:30rpx;height:30rpx;padding:0 5rpx;border:2rpx solid #fff;border-radius:18rpx;background:#e84b3f;color:#fff;font-size:19rpx;line-height:28rpx;text-align:center;box-sizing:border-box}
.user-card{display:flex;align-items:center;margin-top:30rpx;padding:26rpx;border:2rpx solid rgba(43,178,94,.45);border-radius:24rpx;background:rgba(0,51,30,.78);color:#fff}
.avatar{display:block;flex:none;width:120rpx;height:120rpx;border-radius:50%;background:#e8f0ea}
.avatar-fallback{padding:24rpx;box-sizing:border-box}
.avatar-fallback image{display:block;width:72rpx;height:72rpx}
.user-main{flex:1;min-width:0;margin-left:24rpx}
.user-main>text{display:block}
.user-main>text:first-child{font-size:36rpx;font-weight:800;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.user-main>text:nth-child(2){margin-top:10rpx;color:rgba(255,255,255,.72);font-size:25rpx}
.user-main .login-tag{display:inline-block;margin-top:12rpx;padding:4rpx 12rpx;border:1rpx solid #1dca67;border-radius:8rpx;color:#32d174;font-size:21rpx;line-height:28rpx}
.user-main .is-unverified{border-color:#e9a23b;color:#ffd27a}
.chevron{flex:none;margin-left:16rpx;color:rgba(255,255,255,.8);font-size:42rpx}
.identity-card{display:flex;align-items:center;gap:22rpx;margin-top:22rpx;padding:26rpx;border-radius:24rpx;background:#f8fbf9}
.identity-icon{display:flex;flex:none;align-items:center;justify-content:center;width:88rpx;height:88rpx;border-radius:20rpx;background:#e6f3ec}
.identity-icon image{display:block;width:48rpx;height:48rpx}
.identity-main{flex:1;min-width:0}
.identity-label{display:block;color:#718078;font-size:23rpx;line-height:1.4}
.identity-name{display:block;margin-top:5rpx;color:#172c20;font-size:33rpx;font-weight:700;line-height:1.4}
.identity-switch{display:flex;flex:none;align-items:center;gap:10rpx;color:#087a48;font-size:24rpx}
.identity-switch>text:last-child{font-size:36rpx;line-height:1}
.profile-menu{margin-top:22rpx;border-radius:24rpx;background:rgba(255,255,255,.97);overflow:hidden}
.menu-row{display:flex;align-items:center;min-height:96rpx;padding:0 28rpx;border-bottom:1rpx solid #e8eeea}
.menu-row:last-child{border:0}
.menu-row image{display:block;flex:none;width:32rpx;height:32rpx;margin-right:18rpx}
.menu-row>text:nth-child(2){flex:1;color:#202e25;font-size:30rpx}
.menu-arrow{flex:none;color:#88968d;font-size:36rpx}
.menu-badge{flex:none;min-width:36rpx;height:36rpx;margin-right:18rpx;border-radius:20rpx;background:#e6483e;color:#fff;font-size:21rpx;line-height:36rpx;text-align:center}
.logout{margin-top:26rpx;background:rgba(255,255,255,.96);color:#bf4037;border-radius:20rpx;font-size:30rpx}
.version-entry{display:block;margin-top:26rpx;color:rgba(255,255,255,.9);font-size:23rpx;text-align:center;text-decoration:underline}
.support-note{display:block;margin:22rpx 0 7rpx;color:rgba(255,255,255,.7);font-size:22rpx;text-align:center}
.loading,.error-card{margin-top:22rpx;color:#fff;font-size:23rpx;text-align:center}
.error-card{padding:18rpx;border-radius:14rpx;background:#fff0ef;color:#a43e38}
.guest-mode-banner{display:flex;align-items:center;justify-content:space-between;margin-top:28rpx;padding:22rpx 24rpx;border:2rpx solid rgba(74,211,125,.55);border-radius:20rpx;background:rgba(0,38,23,.92);color:#fff}
.guest-mode-banner view text{display:block}
.guest-mode-banner view text:first-child{font-size:27rpx;font-weight:800}
.guest-mode-banner view text:last-child{margin-top:7rpx;color:rgba(255,255,255,.68);font-size:20rpx}
.guest-mode-banner>text{color:#55d682;font-size:23rpx;font-weight:800}
.guest-login-button{margin-top:26rpx;border-radius:20rpx;background:#159346;color:#fff;font-size:28rpx;font-weight:800}
.sheet-mask{position:fixed;z-index:100;inset:0;display:flex;align-items:flex-end;background:rgba(0,0,0,.54)}
.identity-sheet{width:100%;padding:20rpx 38rpx calc(20rpx + env(safe-area-inset-bottom));border-radius:30rpx 30rpx 0 0;background:#fff;box-sizing:border-box}
.sheet-handle{width:72rpx;height:8rpx;margin:0 auto 24rpx;border-radius:8rpx;background:#d1d9d4}
.sheet-title{display:block;margin-bottom:28rpx;color:#172c20;font-size:36rpx;font-weight:700;text-align:center}
.identity-options{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}
.identity-option{position:relative;min-width:0;min-height:224rpx;display:flex;flex-direction:column;align-items:center;padding:24rpx 12rpx 46rpx;border:2rpx solid #dde7e0;border-radius:18rpx;box-sizing:border-box;text-align:center}
.identity-option image{display:block;width:80rpx;height:80rpx;padding:16rpx;border-radius:18rpx;background:#edf5f0;box-sizing:border-box}
.identity-option>text:nth-child(2){margin-top:16rpx;color:#172c20;font-size:28rpx;font-weight:600}
.identity-state{position:absolute;bottom:18rpx;color:#738078;font-size:22rpx}
.identity-option.is-selected{border-color:#087a48;background:#eef8f2}
.identity-option.is-selected .identity-state{color:#087a48;font-weight:600}
.identity-option.is-disabled{opacity:.45}
.confirm{width:100%;height:88rpx;margin-top:28rpx;padding:0;background:#087a48;color:#fff;border-radius:14rpx;font-size:30rpx;font-weight:600;line-height:88rpx}
.confirm[disabled]{background:#dbe8df;color:#6c8476}
.cancel{width:100%;height:80rpx;margin-top:8rpx;padding:0;background:transparent;color:#66776c;border-radius:14rpx;font-size:28rpx;line-height:80rpx}
.cancel::after{border:0}
.sheet-error{margin-top:20rpx;color:#a43e38;font-size:24rpx;line-height:1.5;text-align:center}
