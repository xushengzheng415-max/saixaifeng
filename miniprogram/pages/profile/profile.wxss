/* pages/profile/profile.wxss */
/* 赛小蜂 - 个人中心（教练端 v2 — 待办体系） */

.container {
  background-color: #f5f6fa;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ========== 顶部用户信息区 ========== */
.header-bg {
  background: linear-gradient(160deg, #1B5E20 0%, #2E7D32 40%, #43A047 100%);
  padding: 0 32rpx 36rpx;
  border-radius: 0 0 40rpx 40rpx;
}

.user-info-row {
  display: flex;
  align-items: center;
  padding: 48rpx 0 36rpx;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.4);
  flex-shrink: 0;
}

.avatar-placeholder {
  background-color: rgba(255,255,255,0.2);
  color: #fff;
  font-size: 44rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}

.info-text {
  flex: 1;
  margin-left: 28rpx;
  overflow: hidden;
}

.nickname {
  font-size: 38rpx;
  font-weight: bold;
  color: #fff;
}

/* 昵称 + 身份标签同行 */
.nickname-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}
.nickname {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 12rpx;
  max-width: 320rpx;
}

/* 身份标签（紧跟昵称） */
.role-badge {
  display: inline-flex;
  align-items: center;
  font-size: 20rpx;
  padding: 2rpx 14rpx;
  border-radius: 16rpx;
  white-space: nowrap;
  flex-shrink: 0;
  line-height: 1.6;
}
.role-badge.organizer { background: rgba(255,224,130,0.25); color: #FFE082; border: 1rpx solid rgba(255,224,130,0.35); }
.role-badge.coach { background: rgba(129,212,250,0.25); color: #81D4FA; border: 1rpx solid rgba(129,212,250,0.35); }
.role-badge.referee { background: rgba(186,104,200,0.25); color: #CE93D8; border: 1rpx solid rgba(186,104,200,0.35); }
.role-badge.player { background: rgba(129,212,250,0.25); color: #81D4FA; border: 1rpx solid rgba(129,212,250,0.35); }

.team-name {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
}

.account-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 4rpx;
}

.account-phone {
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
}

.account-email {
  font-size: 22rpx;
  color: rgba(165,214,167,0.85);
}

.team-info-line {
  display: flex;
  align-items: center;
}

.teams-count {
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
  margin-left: 8rpx;
}

.team-icon {
  margin-right: 6rpx;
}

.edit-entry {
  padding: 16rpx 12rpx;
  margin-left: 12rpx;
}

.edit-icon {
  font-size: 28rpx;
  color: rgba(255,255,255,0.5);
}

/* 统计卡片 */
.stats-card {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: rgba(255,255,255,0.15);
  border-radius: 20rpx;
  padding: 28rpx 16rpx;
  backdrop-filter: blur(10rpx);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 120rpx;
}

.stat-num {
  font-size: 42rpx;
  font-weight: bold;
  color: #fff;
  line-height: 1.2;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.75);
  margin-top: 6rpx;
}

.stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: rgba(255,255,255,0.25);
}

/* ========== 待办事项（新增） ========== */
.pending-group {
  background: linear-gradient(135deg, #ffffff, #f8fbff);
  border: 2rpx solid #e8eef7;
}

.menu-group-title {
  padding: 26rpx 30rpx 0;
  font-size: 24rpx;
  color: #999;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pending-badge {
  display: flex;
  align-items: center;
  background: #FFF3E0;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.badge-num {
  font-size: 28rpx;
  font-weight: bold;
  color: #F57C00;
  margin-right: 6rpx;
}

.badge-label {
  font-size: 20rpx;
  color: #F57C00;
}

.todo-grid {
  display: flex;
  padding: 24rpx 20rpx 28rpx;
  gap: 16rpx;
}

.todo-card {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
  transition: transform 0.15s;
}

.todo-card:active {
  transform: scale(0.96);
}

.todo-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.todo-pending .todo-icon-wrap { background: #FFF3E0; }
.todo-reviewing .todo-icon-wrap { background: #E3F2FD; }
.todo-done .todo-icon-wrap { background: #E8F5E9; }

.todo-icon {
  font-size: 36rpx;
}

.todo-count {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.2;
}

.todo-pending .todo-count { color: #E65100; }
.todo-reviewing .todo-count { color: #1565C0; }
.todo-done .todo-count { color: #2E7D32; }

.todo-label {
  font-size: 24rpx;
  color: #666;
  margin-top: 6rpx;
  font-weight: 500;
}

.todo-desc {
  font-size: 20rpx;
  color: #999;
  margin-top: 6rpx;
  text-align: center;
}

.todo-empty-desc {
  color: #ccc;
}

/* ========== 功能菜单组 ========== */
.menu-group {
  margin: 24rpx 28rpx 0;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.04);
}

.menu-list {
  padding: 16rpx 0;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx;
  transition: background 0.15s;
}

.menu-item:active {
  background: #f8f9fb;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.icon-team    { background: #E8F5E9; color: #2E7D32; }
.icon-player  { background: #E3F2FD; color: #1565C0; }
.icon-add     { background: #FFF3E0; color: #E65100; }
.icon-squad   { background: #F3E5F5; color: #7B1FA2; }
.icon-match   { background: #FFEBEE; color: #C62828; }
.icon-idcard  { background: #E0F7FA; color: #00838F; }
.icon-password { background: #EFEBE9; color: #5D4037; }
.icon-settings { background: #ECEFF1; color: #455A64; }
.icon-tournament { background: #E8F0FE; color: #1A73E8; }
.icon-edit { background: #FFF8E1; color: #F9A825; }
.icon-switch-team { background: #F1F8E9; color: #558B2F; }

.menu-text {
  font-size: 30rpx;
  color: #333;
}

.menu-right {
  display: flex;
  align-items: center;
}

.menu-tag {
  font-size: 22rpx;
  color: #FF6B35;
  background: #FFF0EB;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
}

.menu-tag-green {
  font-size: 22rpx;
  color: #2E7D32;
  background: #E8F5E9;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
}

.menu-arrow {
  font-size: 26rpx;
  color: #ccc;
}

/* ========== 退出登录 ========== */
.logout-wrap {
  padding: 48rpx 28rpx 20rpx;
}

.logout-btn {
  background: #fff;
  border: 1rpx solid #eee;
  border-radius: 20rpx;
  text-align: center;
  padding: 28rpx;
  font-size: 30rpx;
  color: #E53935;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.logout-btn:active {
  background: #FFEBEE;
}

/* ========== 底部版本 ========== */
.footer {
  text-align: center;
  padding: 20rpx 0 40rpx;
}

.footer-text {
  font-size: 22rpx;
  color: #bbb;
}

/* ========== 设置密码弹窗 ========== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-box {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 44rpx;
  color: #999;
  padding: 8rpx;
}

.modal-body {
  padding: 32rpx;
}

.form-row {
  margin-bottom: 24rpx;
}

.form-row:last-of-type {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 84rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #fafafa;
}

.pwd-tips {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  background: #FFF8E1;
  border-radius: 10rpx;
}

.tips-txt {
  font-size: 24rpx;
  color: #B08D00;
  line-height: 1.5;
}

.modal-foot {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 30rpx;
  font-size: 32rpx;
}

.btn-cancel {
  color: #888;
  border-right: 1rpx solid #f0f0f0;
}

.btn-confirm {
  color: #2E7D32;
  font-weight: bold;
}

