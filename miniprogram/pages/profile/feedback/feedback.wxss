page{background:#f5f7f6;color:#192b22}.page{padding:24rpx 28rpx calc(40rpx + env(safe-area-inset-bottom))}button{margin:0;font-size:28rpx;border-radius:8rpx}button::after{border:0}.tabs{display:flex;border-bottom:1rpx solid #dce5df;margin-bottom:28rpx}.tabs button{flex:1;background:transparent;color:#657269;border-radius:0;padding:12rpx}.tabs button.active{color:#087b43;border-bottom:4rpx solid #087b43;font-weight:600}.form,.records{background:#fff;padding:28rpx;border-radius:8rpx}.label{display:block;font-size:28rpx;font-weight:600;margin-bottom:18rpx}.types{display:flex;flex-wrap:wrap;gap:14rpx;margin-bottom:30rpx}.type{padding:0 22rpx;color:#4a5d50;background:#f2f5f3;border:1rpx solid #dbe4de;font-size:26rpx}.type.active{color:#087b43;border-color:#087b43;background:#edf7f0}textarea,input{box-sizing:border-box;width:100%;font-size:28rpx;border:1rpx solid #d6e0d9;border-radius:8rpx;padding:18rpx;background:#fff}textarea{height:260rpx;line-height:1.6}input{height:88rpx}.count{display:block;text-align:right;color:#738077;font-size:24rpx;margin:8rpx 0 26rpx}.note{display:block;font-size:24rpx;line-height:1.5;color:#67766c;margin:16rpx 0 24rpx}.primary{background:#087b43;color:#fff;margin-top:28rpx}.primary[disabled]{background:#a7c4b0;color:#fff}.state{padding:42rpx 12rpx;text-align:center;color:#69776e;font-size:28rpx}.state text{display:block}.state button{margin:24rpx auto 0;max-width:300rpx}.error,.success{display:block;font-size:26rpx;margin-top:20rpx;line-height:1.6}.error{color:#be3636}.success{color:#087b43}.records-head,.record-head{display:flex;justify-content:space-between;align-items:center;font-size:28rpx;font-weight:600}.records-head button{color:#087b43;background:transparent;font-size:26rpx}.record{padding:28rpx 0;border-bottom:1rpx solid #e6ebe8}.record:last-child{border-bottom:0}.status{font-size:24rpx;color:#4f6557;font-weight:400}.time{display:block;color:#79857d;font-size:23rpx;margin:6rpx 0 14rpx}.content{display:block;font-size:28rpx;line-height:1.7;white-space:pre-wrap;overflow-wrap:anywhere}.reply{margin-top:24rpx;border-left:4rpx solid #8fb99e;padding-left:20rpx}.reply .label{margin-bottom:0}.tutorial{color:#087b43;background:transparent;text-align:left;white-space:normal;font-size:26rpx;padding:12rpx 0;line-height:1.6}

.types .type{flex:0 0 calc(50% - 8rpx);width:calc(50% - 8rpx);height:72rpx;line-height:72rpx;margin:0;padding:0 12rpx;box-sizing:border-box}.form .primary{width:100%;height:88rpx;line-height:88rpx;font-size:30rpx}.tabs button{width:50%;min-width:0}.records-head button{width:auto}
