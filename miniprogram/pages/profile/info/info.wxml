<view class="page">
  <view class="card">
    <view class="section-title">头像</view>
    <view class="avatar-row">
      <image wx:if="{{form.avatarUrl}}" class="avatar-preview" src="{{form.avatarUrl}}" mode="aspectFill" />
      <view wx:else class="avatar-preview avatar-empty">
        <text>头像</text>
      </view>
      <view class="avatar-actions">
        <button class="action-btn" bindtap="chooseAvatar">更换头像</button>
        <button class="action-btn action-btn-wechat" bindtap="useWechatProfile">使用微信头像昵称</button>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">昵称</view>
    <input
      class="input"
      value="{{form.nickName}}"
      placeholder="请输入昵称"
      maxlength="20"
      bindinput="onNickNameInput"
    />

    <view class="meta-row" wx:if="{{currentPhone}}">
      <text class="meta-label">手机号</text>
      <text class="meta-value">{{currentPhone}}</text>
    </view>
    <view class="meta-row" wx:if="{{currentRoleName}}">
      <text class="meta-label">当前身份</text>
      <text class="meta-value">{{currentRoleName}}</text>
    </view>
  </view>

  <view class="footer">
    <button class="save-btn" bindtap="saveProfile">保存资料</button>
  </view>
</view>
