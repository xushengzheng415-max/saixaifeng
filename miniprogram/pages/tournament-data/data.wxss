.data-page{min-height:100vh;position:relative;background:#00301e;color:#fff}.data-bg,.data-shade{position:fixed;inset:0;width:100%;height:100%}.data-bg{object-position:center top}.data-shade{background:linear-gradient(180deg,rgba(0,20,13,.3),rgba(0,43,26,.9))}.data-nav{position:relative;height:170rpx;padding-top:env(safe-area-inset-top);display:flex;align-items:flex-end;justify-content:center;padding-bottom:28rpx;box-sizing:border-box;font-size:40rpx;font-weight:900}.data-back{position:absolute;left:28rpx;bottom:18rpx;font-size:78rpx;font-weight:300;line-height:1}.data-content{position:relative;padding:0 28rpx 80rpx}.data-hero{padding:22rpx 26rpx;border:2rpx solid rgba(213,170,80,.8);border-radius:24rpx;background:rgba(0,74,43,.9)}.data-hero-label{display:block;font-size:27rpx;color:#e8f1e9;font-weight:700}.data-hero-title{display:block;margin-top:8rpx;color:#9fe1b6;font-size:23rpx}.data-tabs{display:flex;gap:10rpx;margin-top:20rpx;padding:6rpx;border-radius:20rpx;background:rgba(255,255,255,.13)}.data-tab{flex:1;padding:15rpx 4rpx;border-radius:15rpx;color:#d7e9df;text-align:center;font-size:22rpx}.data-tab-active{background:#079252;color:#fff;font-weight:800}.data-panel{margin-top:18rpx;overflow:hidden;border-radius:22rpx;background:rgba(255,255,255,.98);color:#1c2c23}.standings-head{display:grid;grid-template-columns:70rpx 1fr 52rpx 100rpx 58rpx;padding:18rpx 20rpx;border-bottom:1rpx solid #e5ebe7;color:#87938c;font-size:20rpx}.standings-head text{text-align:center}.standings-head text:nth-child(2){text-align:left}.data-row{display:flex;align-items:center;min-height:94rpx;padding:14rpx 20rpx;border-bottom:1rpx solid #edf1ee}.data-row:last-child{border-bottom:0}.rank{width:52rpx;color:#16814e;font-size:28rpx;font-weight:900;text-align:center}.data-subject{display:flex;align-items:center;min-width:0;flex:1;gap:12rpx}.data-subject image{width:54rpx;height:54rpx;padding:5rpx;border-radius:50%;background:#edf7f0;box-sizing:border-box}.data-subject view{min-width:0}.data-subject view text{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:25rpx;font-weight:700}.data-subject view text:last-child{margin-top:5rpx;color:#88948d;font-size:19rpx;font-weight:400}.data-num,.data-record,.data-points,.data-count{width:60rpx;color:#52645a;font-size:22rpx;text-align:center}.data-record{width:100rpx}.data-points{color:#0a8049;font-size:28rpx;font-weight:900}.data-count{width:78rpx;color:#0a8049;font-size:30rpx;font-weight:900}.data-empty{margin-top:18rpx;padding:90rpx 20rpx;border-radius:22rpx;background:rgba(255,255,255,.96);color:#7c8982;text-align:center;font-size:25rpx}
