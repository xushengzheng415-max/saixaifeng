.event-page{min-height:100vh;position:relative;background:#03271a;color:#fff}.event-bg{position:absolute;inset:0;width:100%;height:100%;opacity:.88}.event-content{position:relative;z-index:1;padding:0 36rpx 150rpx}.event-nav{height:232rpx;position:relative;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;padding-bottom:30rpx;box-sizing:border-box}.event-title{font-size:46rpx;font-weight:800}.event-workspace{margin-top:14rpx;font-size:28rpx;color:#d9ece2}.event-relation-tabs{display:flex;height:104rpx;border-radius:28rpx;background:rgba(255,255,255,.92);overflow:hidden}.event-relation{flex:1;display:flex;align-items:center;justify-content:center;color:#7d837f;font-size:31rpx}.event-relation-active{background:#fff;color:#088350;font-weight:800;border-radius:28rpx;box-shadow:0 8rpx 20rpx rgba(0,0,0,.08)}.event-filter-row{display:flex;align-items:center;gap:18rpx;margin:36rpx 0}.event-filter{padding:17rpx 24rpx;border-radius:40rpx;background:rgba(255,255,255,.16);font-size:28rpx}.event-filter-active{background:#0c9255;font-weight:700}.event-filter-action{margin-left:auto;font-size:28rpx}.event-card{margin-top:24rpx;padding:30rpx;border-radius:30rpx;background:#fff;color:#18241d;box-shadow:0 20rpx 40rpx rgba(0,15,8,.17)}.event-card-pro{border:3rpx solid #d5aa50;background:linear-gradient(130deg,#075f40,#004d32);color:#fff}.event-card-top,.event-metrics{display:flex;align-items:center;justify-content:space-between}.event-relation-badge,.event-mode,.event-status{padding:10rpx 18rpx;border-radius:24rpx;background:#e8f6ed;color:#117a4c;font-size:23rpx}.event-card-pro .event-relation-badge,.event-card-pro .event-mode{background:rgba(255,237,181,.85);color:#755112}.event-mode{background:#edf0ee;color:#717c75}.event-name{display:block;margin-top:24rpx;font-size:40rpx;font-weight:800;line-height:1.25}.event-date{display:block;margin-top:25rpx;color:#89928d;font-size:25rpx}.event-card-pro .event-date{color:#d7e9df}.event-divider{height:1rpx;margin:26rpx 0;background:#e1e8e3}.event-card-pro .event-divider{background:rgba(255,255,255,.28)}.event-metrics text{font-size:26rpx}.event-status{font-size:24rpx}.event-task{display:flex;align-items:center;gap:20rpx;margin-top:32rpx;padding:30rpx;border-radius:28rpx;background:#fff;color:#18251d}.event-task image{width:82rpx;height:82rpx;border-radius:50%;background:#e1f5e8}.event-task view{flex:1}.event-task view text{display:block;font-size:31rpx;font-weight:800}.event-task view text:last-child{margin-top:12rpx;font-size:25rpx;font-weight:400;color:#7d8781}.event-bubble{padding:13rpx 20rpx;border-radius:22rpx;background:#ffe8e8;color:#d85a58;font-size:30rpx}.event-arrow{font-size:52rpx;color:#8d9691}.event-loading,.event-empty,.event-error{margin-top:70rpx;padding:38rpx;border-radius:24rpx;background:#fff;color:#657068;text-align:center}.event-error{background:#fff0ed;color:#c15248}
