.guest-login-title{font-size:28rpx;font-weight:900}
.guest-login-desc{margin-top:8rpx;color:rgba(255,255,255,.7);font-size:20rpx;line-height:1.45}
.guest-login-action{flex:none;margin-left:18rpx;color:#50d27c;font-size:24rpx;font-weight:800}
.guest-section-heading{display:flex;align-items:center;justify-content:space-between;margin:0 12rpx 16rpx}
.guest-section-heading text:first-child{font-size:34rpx;font-weight:900}
.guest-section-heading text:last-child{color:rgba(255,255,255,.76);font-size:21rpx}
.guest-demo-overview{padding:28rpx 26rpx 22rpx;border:2rpx solid rgba(43,187,104,.62);border-radius:28rpx;background:linear-gradient(115deg,rgba(0,74,42,.96),rgba(0,48,30,.94));box-shadow:0 18rpx 42rpx rgba(0,0,0,.24)}
