.guest-public-card{position:relative;min-height:300rpx;padding:30rpx 28rpx 84rpx;overflow:hidden;border:2rpx solid rgba(43,187,104,.65);border-radius:28rpx;background:linear-gradient(125deg,rgba(0,72,42,.97),rgba(0,42,27,.94));box-shadow:0 18rpx 42rpx rgba(0,0,0,.24);box-sizing:border-box}
.guest-public-copy{position:relative;z-index:2;display:flex;max-width:430rpx;flex-direction:column}
.guest-public-label{align-self:flex-start;padding:6rpx 14rpx;border-radius:15rpx;background:rgba(92,211,130,.18);color:#91e7ad;font-size:20rpx}
.guest-public-title{margin-top:24rpx;font-size:40rpx;font-weight:900}
.guest-public-desc{margin-top:15rpx;color:rgba(255,255,255,.68);font-size:22rpx;line-height:1.6}
.guest-public-card image{position:absolute;right:22rpx;top:38rpx;width:150rpx;height:150rpx;opacity:.42}
.guest-public-action{position:absolute;left:22rpx;right:22rpx;bottom:20rpx;z-index:2;height:58rpx;border-radius:14rpx;background:#159346;font-size:23rpx;font-weight:800;line-height:58rpx;text-align:center}
.guest-service-heading{margin-top:34rpx}
.guest-service-grid{display:flex;gap:12rpx}
.guest-service-card{display:flex;min-width:0;flex:1;flex-direction:column;align-items:center;padding:24rpx 10rpx 22rpx;border:1rpx solid rgba(255,255,255,.2);border-radius:20rpx;background:rgba(0,39,24,.76);box-sizing:border-box;text-align:center}
.guest-service-card image{display:block;width:72rpx;height:72rpx}
.guest-service-title{margin-top:12rpx;font-size:29rpx;font-weight:800}
.guest-service-desc{margin-top:8rpx;color:rgba(255,255,255,.62);font-size:18rpx;line-height:1.4}

