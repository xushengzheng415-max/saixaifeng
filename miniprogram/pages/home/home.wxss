.organizer-pc>view:first-child{line-height:1.5}.organizer-pc>text{margin-top:14rpx;line-height:1.65}
.organizer-pc-address{margin-top:22rpx}.organizer-public{box-sizing:border-box;min-height:112rpx;line-height:1.5}
.team-home{background:#edf3ef;color:#17392e;min-height:100vh}
.team-home .content{padding-left:34rpx;padding-right:34rpx;padding-bottom:170rpx}
.team-home .stadium-bg{position:absolute;height:auto;width:100%}
.team-home .page-shade{position:absolute;height:520rpx;background:linear-gradient(180deg,rgba(0,25,17,.52),rgba(0,25,17,.08) 50%,rgba(237,243,239,.2) 72%,#edf3ef 100%)}
.team-home-heading{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin:86rpx 0 22rpx;padding:20rpx 24rpx;background:rgba(255,255,255,.97);border-radius:16rpx}
.team-home-heading>text{font-size:34rpx;font-weight:600;line-height:1.5}
.team-home-heading button{display:flex;align-items:center;justify-content:center;flex:none;width:auto;min-width:0;height:68rpx;margin:0;padding:0 20rpx;background:#087a48;color:#fff;border-radius:10rpx;font-size:26rpx;line-height:1.4}
.team-home-heading button:after{border:0}
.team-launch-icon{right:26rpx;top:43rpx;width:140rpx;height:140rpx}
.team-participation-empty{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:30rpx 26rpx;background:#fff;border-radius:16rpx;font-size:26rpx;line-height:1.6;color:#7b9181}
.team-participation-empty>text+text{color:#087a48}
.team-home .loading{color:#6c8b74}
