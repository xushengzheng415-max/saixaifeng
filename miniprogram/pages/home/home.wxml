<view class="page {{homePageClass}}">
  <image class="stadium-bg" src="{{homeBackgroundImage}}" mode="{{homeBackgroundMode}}"></image>
  <view class="page-shade"></view>

  <view class="content" style="{{homeContentStyle}}">
    <view class="organizer-nav" wx:if="{{showWorkHome}}"><image class="home-brand-logo" src="/images/brand/logo-saixiaofeng-football.png" mode="aspectFit" aria-label="赛小蜂足球"/></view>
    <view class="organizer-identity" wx:if="{{showWorkHome}}"><text>{{homeRoleLabel}}</text></view>
    <block wx:if="{{!showWorkHome}}">
    <view class="topbar {{topbarClass}}" wx:if="{{isLoggedIn}}">
      <view class="topbar-left">
        <view class="message-button" wx:if="{{!useEntryHome}}" bindtap="goToMessages">
          <image src="/images/icons/bell-white.svg" mode="aspectFit"></image>
          <text class="message-badge" wx:if="{{hasUnreadMessages}}">{{unreadMessageCount}}</text>
        </view>
        <view class="resource-brand" wx:if="{{useEntryHome}}"><image class="home-brand-logo" src="/images/brand/logo-saixiaofeng-football.png" mode="aspectFit" aria-label="赛小蜂足球"/><text class="home-role-label">{{homeRoleLabel}}</text></view>
        <text class="role-title" wx:if="{{!useEntryHome}}">{{roleTitle}}</text>
      </view>
    </view>
    </block>

    <block wx:if="{{!isLoggedIn}}">
      <view class="guest-login-guide" bindtap="goToLogin">
        <view class="guest-login-copy">
          <text class="guest-login-title">当前未登录</text>

        </view>
        <text class="guest-login-action">去登录 ›</text>
      </view>

      <view class="guest-section-heading"><text>首页功能演示</text><text>示例数据 · 不保存</text></view>
      <view class="guest-demo-overview">
        <view class="guest-demo-top">
          <view><text class="guest-demo-label">功能演示</text><text class="guest-demo-title">今日工作概览</text></view>
          <image src="/images/runtime/icons/brand-v2-16.png" mode="aspectFit"></image>
        </view>
        <view class="guest-demo-metrics">
          <view class="guest-demo-metric" wx:for="{{guestDemoMetrics}}" wx:key="label">
            <image src="{{item.icon}}" mode="aspectFit"></image>
            <text class="guest-demo-value">{{item.value}}</text>
            <text class="guest-demo-name">{{item.label}}</text>
          </view>
        </view>
        <text class="guest-demo-note">以下内容用于了解首页能力，不代表真实赛事或球队数据</text>
      </view>

      <view class="guest-section-heading guest-task-heading"><text>需要我处理</text><text>演示任务</text></view>
      <view class="guest-demo-tasks">
        <view class="guest-demo-task" wx:for="{{guestDemoTasks}}" wx:key="id" bindtap="openGuestDemoAction">
          <image src="{{item.icon}}" mode="aspectFit"></image>
          <view><text class="guest-demo-task-title">{{item.title}}</text></view>
          <text class="guest-demo-arrow">›</text>
        </view>
      </view>

      <view class="guest-section-heading"><text>赛事服务</text><text bindtap="goToPublicTournaments">全部赛事 ›</text></view>
      <view class="guest-public-card" bindtap="goToPublicTournaments">
        <view class="guest-public-copy">
          <text class="guest-public-label">公开赛事</text>
          <text class="guest-public-title">查看赛程、比分与排名</text>

        </view>
        <image src="/images/runtime/icons/brand-v2-16.png" mode="aspectFit"></image>
        <view class="guest-public-action">免登录浏览公开赛事　›</view>
      </view>

      <view class="guest-section-heading guest-service-heading"><text>平台功能</text><text>浏览后，可自行选择登录</text></view>
      <view class="guest-service-grid">
        <view class="guest-service-card" bindtap="goToPublicTournaments">
          <image src="/images/runtime/icons/brand-v1-tab-event.png" mode="aspectFit"></image>
          <text class="guest-service-title">赛事</text>

        </view>
        <view class="guest-service-card" bindtap="goToLogin">
          <image src="/images/runtime/icons/brand-v1-tab-team.png" mode="aspectFit"></image>
          <text class="guest-service-title">球队</text>

        </view>
        <view class="guest-service-card" bindtap="goToLogin">
          <image src="/images/runtime/icons/brand-v1-tab-training.png" mode="aspectFit"></image>
          <text class="guest-service-title">青训</text>

        </view>
      </view>
    </block>

    <view class="loading" wx:if="{{loading}}">正在准备首页…</view>
    <view class="error-card" wx:if="{{errorText}}"><text>{{errorText}}</text><text bindtap="loadData">重新加载</text></view>

    <block wx:if="{{showOrganizerHome}}">
      <view class="organizer-launch" wx:if="{{!hasOrganizerEvents}}"><image class="launch-photo" src="/images/runtime/organizer-home-stadium-v2.jpg" mode="aspectFill"/><view class="launch-photo-shade"></view><image class="launch-calendar" src="/images/runtime/icons/brand-v2-01.png" mode="aspectFit"/><text class="launch-heading">组织一场比赛</text><text class="launch-description">手机快速发起，电脑接续编排。</text><button class="launch-primary" size="default" style="display:flex;align-items:center;justify-content:center;width:310rpx;max-width:100%;margin-left:0;margin-right:0;" bindtap="createTournament"><text class="launch-plus">＋</text><text>创建赛事</text></button></view>
      <view class="organizer-start" wx:if="{{hasOrganizerEvents}}"><view><text>发起新赛事</text><text>手机创建 · 电脑接续</text></view><button size="mini" bindtap="createTournament">＋ 创建赛事</button></view>
      <view class="organizer-flow" wx:if="{{!hasOrganizerEvents}}"><text>① 创建赛事</text><text>—</text><text>② 邀请球队</text><text>—</text><text>③ 安排赛程</text></view>
      <view class="organizer-todos" wx:if="{{hasOrganizerTasks}}"><view class="organizer-heading"><text>待处理</text><text bindtap="goToTodo">全部待办 ›</text></view><view class="organizer-todo-list"><view class="organizer-todo-row" wx:for="{{organizerTasks}}" wx:key="id" bindtap="goToTodo"><image src="{{item.icon}}" mode="aspectFit"/><view><text>{{item.title}}</text><text wx:if="{{item.hasSubtitle}}">{{item.subtitle}}</text></view><text class="organizer-task-count" wx:if="{{item.hasCount}}">{{item.countText}}</text><text class="organizer-task-arrow">›</text></view></view></view>
      <view class="organizer-resources" wx:if="{{hasHomeEntries}}"><view class="organizer-heading"><text>我的赛事</text><text bindtap="goToSharedEvents">全部赛事 ›</text></view><workspace-entry-card wx:for="{{homeEntries}}" wx:key="key" entry="{{item}}" data-key="{{item.key}}" bindopen="onHomeEntryTap"/></view>
      <view class="organizer-pc"><view><image src="/images/icons/monitor.svg" mode="aspectFit"/><text>在电脑上完整办赛</text></view><text>复杂赛制、批量导入和抽签编排</text><view class="organizer-pc-address"><text>www.sxffootball.cn</text><button size="mini" bindtap="copyPcAddress">复制网址</button></view></view>
      <view class="organizer-public" bindtap="goToPublicCenter"><text>先看看公开赛事</text><text>赛事中心　›</text></view>
    </block>

    <block wx:if="{{showTeamHome}}">
      <view class="organizer-launch team-launch" wx:if="{{!hasTeamHomeTeams}}"><image class="launch-photo" src="/images/runtime/organizer-home-stadium-v2.jpg" mode="aspectFill"/><view class="launch-photo-shade"></view><image class="launch-calendar team-launch-icon" src="/images/runtime/icons/brand-v1-tab-team.png" mode="aspectFit"/><text class="launch-heading">组建一支球队</text><text class="launch-description">维护球员资料，管理报名与参赛。</text><button class="launch-primary" size="default" style="display:flex;align-items:center;justify-content:center;width:310rpx;max-width:100%;margin-left:0;margin-right:0;" bindtap="createHomeTeam"><text class="launch-plus">＋</text><text>创建球队</text></button></view>
      <view class="team-home-heading" wx:if="{{hasTeamHomeTeams}}"><text>我的球队</text><button size="mini" bindtap="createHomeTeam">＋ 创建球队</button></view>
      <view class="team-home-clubs" wx:if="{{hasTeamHomeTeams}}"><workspace-entry-card wx:for="{{teamHomeTeams}}" wx:key="key" entry="{{item}}" data-key="{{item.key}}" bindopen="onHomeEntryTap"/></view>
      <view class="organizer-todos" wx:if="{{hasTeamHomeTasks}}"><view class="organizer-heading"><text>待处理</text><text bindtap="goToTodo">全部待办 ›</text></view><view class="organizer-todo-list"><view class="organizer-todo-row" wx:for="{{teamHomeTasks}}" wx:key="id" bindtap="goToTodo"><image src="{{item.icon}}" mode="aspectFit"/><view><text>{{item.title}}</text><text wx:if="{{item.hasSubtitle}}">{{item.subtitle}}</text></view><text class="organizer-task-count" wx:if="{{item.hasCount}}">{{item.countText}}</text><text class="organizer-task-arrow">›</text></view></view></view>
      <view class="team-home-participation" wx:if="{{hasTeamHomeTeams}}"><view class="organizer-heading"><text>我的参赛</text><text bindtap="goToSharedEvents">全部参赛 ›</text></view><workspace-entry-card wx:for="{{teamHomeEvents}}" wx:key="key" entry="{{item}}" data-key="{{item.key}}" bindopen="onHomeEntryTap"/><view class="team-participation-empty" wx:if="{{!hasTeamHomeEvents}}"><block wx:if="{{teamParticipationUnavailable}}"><text>参赛记录暂未就绪</text><text bindtap="loadData">重新加载</text></block><block wx:else><text>暂无参赛记录</text><text bindtap="goToPublicCenter">浏览赛事 ›</text></block></view></view>
      <view class="organizer-public" bindtap="goToPublicCenter"><text>先看看公开赛事</text><text>赛事中心　›</text></view>
    </block>

    <block wx:if="{{!showWorkHome}}">
    <block wx:if="{{isLoggedIn}}">
      <view wx:if="{{useEntryHome}}" class="entry-section">
        <view class="section-heading"><text>赛事与球队</text></view>
        <workspace-entry-card wx:for="{{homeEntries}}" wx:key="key" entry="{{item}}" data-key="{{item.key}}" bindopen="onHomeEntryTap"></workspace-entry-card>
        <view class="empty-card light-empty" wx:if="{{showHomeEntryEmpty}}"><text>暂无可进入的赛事或球队</text><text class="entry-refresh" bindtap="loadData">刷新</text></view>
      </view>
      <view wx:if="{{!useEntryHome}}" class="overview-card {{overviewClass}}">

        <text class="overview-name" wx:if="{{hasOverviewName}}">{{overviewName}}</text>
        <text class="overview-status" wx:if="{{hasOverviewStatus}}">{{overviewStatus}}</text>
        <image class="overview-logo" wx:if="{{hasOverviewLogo}}" src="{{overviewLogo}}" mode="aspectFit"></image>
        <image class="overview-ball" wx:if="{{!hasOverviewLogo}}" src="/images/runtime/icons/brand-v2-16.png" mode="aspectFit"></image>
        <view class="metrics">
          <view class="metric" wx:for="{{metrics}}" wx:key="label">
            <image class="metric-icon" src="{{item.icon}}" mode="aspectFit"></image>
            <text class="metric-value">{{item.value}}</text>
            <text class="metric-label">{{item.label}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{hasTaskCards}}" class="task-card">
        <view class="card-heading"><text>需要我处理</text><text bindtap="goToTodo">全部任务 ›</text></view>
        <view class="task-grid" wx:if="{{hasTaskCards}}">
          <view class="task-item" wx:for="{{homeTaskCards}}" wx:key="id" bindtap="goToTodo">
            <view class="task-icon-wrap {{item.toneClass}} {{item.assetClass}}" style="{{item.taskWrapStyle}}">
              <image src="{{item.icon}}" mode="aspectFit" style="{{item.taskImageStyle}}"></image>
              <text class="task-badge" wx:if="{{!item.isPrototypeReference}}">{{item.count}}</text>
            </view>
            <text class="task-title">{{item.title}}</text>

          </view>
        </view>
        <view class="empty-card" wx:if="{{!hasTaskCards}}">当前没有需要处理的事项</view>
      </view>

      <view class="section" wx:if="{{!useEntryHome}}" hidden="{{!isTeamCoach}}">
        <view class="section-heading"><text>我的球队</text><text bindtap="goToTeams">全部球队 ›</text></view>
        <view class="team-card" wx:for="{{teams}}" wx:key="id" data-id="{{item.id}}" bindtap="onTeamTap">
          <image class="team-logo" src="{{item.logo}}" mode="aspectFit"></image>
          <view class="team-main">
            <view class="team-title-row"><text class="team-name">{{item.name}}</text><text class="team-owner">{{item.ownerText}}</text></view>
            <view class="team-meta"><text>{{item.playerText}}</text><text>{{item.coachText}}</text><text>{{item.eventText}}</text></view>
            <text class="completion">{{item.completionText}}</text>
          </view>
          <text class="row-arrow">›</text>
        </view>
        <view class="empty-card light-empty" wx:if="{{!hasTeams}}">当前没有可管理球队</view>
      </view>

      <view class="section other-role" wx:if="{{showOtherRoleContent}}">
        <view class="section-heading"><text>{{otherSectionTitle}}</text><text bindtap="goToOtherSection">查看全部 ›</text></view>
        <view class="empty-card light-empty">{{otherSectionEmptyText}}</view>
      </view>

      <view class="section training-home-section" wx:if="{{isTrainingCoach}}">
        <view class="section-heading"><text>今日课程</text><text bindtap="goToOtherSection">全部课程 ›</text></view>
        <view class="training-course-card" wx:for="{{trainingCourses}}" wx:key="id" bindtap="goToOtherSection">
          <view class="training-course-time"><text>{{item.timeText}}</text><text>{{item.venueText}}</text></view>
          <view class="training-course-main"><text class="training-course-name">{{item.classText}}</text><text class="training-course-coach">{{item.coachText}} · {{item.studentText}}</text></view>
        </view>
        <view class="empty-card light-empty" wx:if="{{!hasTrainingCourses}}">当前没有课程安排</view>
        <view class="training-permission-note"><image src="/images/icons/check.svg" mode="aspectFit"></image><text>青训经营数据仅对有权限的机构成员开放</text></view>
      </view>
    </block>
    </block>
  </view>
  <quick-create-sheet id="quick-create" visible="{{createVisible}}" kind="{{createKind}}" bindclose="closeCreateSheet" bindcreated="onQuickCreated" bindcomplete="onQuickComplete"/>
</view>
