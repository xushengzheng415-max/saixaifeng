/* pages/guide/referee-info.wxss */
.guide-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #f0f4f8 0%, #e2e8f0 100%);
  display: flex;
  flex-direction: column;
}

/* 头部区域 */
.header-section {
  text-align: center;
  padding: 60rpx 40rpx 40rpx;
  animation: fadeInDown 0.8s ease-out;
}

@keyframes fadeInDown {
  from {
    opacity: 0;
    transform: translateY(-50rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.guide-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #2E7D32;
  margin-bottom: 16rpx;
  text-shadow: 0 2rpx 4rpx rgba(46, 125, 50, 0.1);
}

.guide-subtitle {
  display: block;
  font-size: 26rpx;
  color: #666;
  opacity: 0.8;
}

/* 表单区域 */
.form-section {
  flex: 1;
  background: white;
  margin: 0 20rpx 20rpx;
  padding: 40rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  animation: fadeInUp 0.8s ease-out;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(50rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.input-group {
  margin-bottom: 32rpx;
}

.input-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 12rpx;
}

.input-wrapper {
  position: relative;
  width: 100%;
  box-sizing: border-box;
}

.input-field {
  width: 100%;
  padding: 24rpx 32rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 30rpx;
  background: #fafafa;
  transition: all 0.3s ease;
  box-sizing: border-box;
}

.input-field:focus {
  border-color: #2E7D32;
  background: white;
  box-shadow: 0 0 0 6rpx rgba(46, 125, 50, 0.1);
}

.input-icon {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 32rpx;
  color: #999;
}

/* 裁判等级选择器 */
.picker-field {
  padding: 24rpx 32rpx;
  font-size: 30rpx;
  color: #666;
}

/* 执裁经验 */
.input-field[disabled] {
  color: #999;
}

/* 字符计数 */
.char-count {
  display: block;
  font-size: 24rpx;
  color: #999;
  text-align: right;
  margin-top: 8rpx;
}

/* 头像上传 */
.image-uploader {
  position: relative;
}

.upload-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  border: 2rpx dashed #e0e0e0;
  border-radius: 12rpx;
  background: #fafafa;
  transition: all 0.3s ease;
}

.upload-btn:active {
  background: #f0f0f0;
  border-color: #2E7D32;
}

.upload-icon {
  font-size: 48rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.upload-text {
  font-size: 26rpx;
  color: #999;
}

.avatar-preview {
  width: 100%;
  height: 200rpx;
  margin-top: 16rpx;
  border-radius: 12rpx;
  object-fit: cover;
}

/* 按钮区域 */
.button-section {
  padding: 0 20rpx 40rpx;
  animation: fadeIn 1s ease-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.submit-btn {
  width: 100%;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  transition: all 0.3s ease;
  margin-bottom: 16rpx;
}

.submit-btn.primary {
  background: linear-gradient(135deg, #2E7D32 0%, #4CAF50 100%);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(46, 125, 50, 0.3);
}

.submit-btn.primary:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(46, 125, 50, 0.3);
}

.submit-btn.disabled {
  background: #ccc;
  color: white;
  box-shadow: none;
}

.skip-btn {
  width: 100%;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: 1rpx solid #e0e0e0;
  background: white;
  color: #666;
  transition: all 0.3s ease;
}

.skip-btn:active {
  background: #f0f0f0;
}

.skip-btn.disabled {
  opacity: 0.5;
}

/* 错误提示 */
.error-message {
  display: block;
  font-size: 24rpx;
  color: #f44336;
  margin-top: 8rpx;
  padding-left: 8rpx;
  animation: shake 0.5s ease-out;
}

@keyframes shake {
  0%, 100% {
    transform: translateX(0);
  }
  25% {
    transform: translateX(-10rpx);
  }
  75% {
    transform: translateX(10rpx);
  }
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .form-section {
    padding: 30rpx 20rpx;
  }
  
  .input-field {
    padding: 20rpx 24rpx;
    font-size: 28rpx;
  }
  
  .submit-btn {
    padding: 20rpx;
    font-size: 28rpx;
  }
  
  .skip-btn {
    padding: 20rpx;
    font-size: 28rpx;
  }
}