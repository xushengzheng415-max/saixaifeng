/* pages/guide/referee-info.wxss */
.guide-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #1a5d27 0%, #2E7D32 30%, #4CAF50 60%, #81C784 100%);
  padding: 40rpx 20rpx;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

/* 背景装饰 */
.guide-container::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
  animation: rotate 20s linear infinite;
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 头部区域 */
.header-section {
  position: relative;
  z-index: 1;
  margin-bottom: 40rpx;
}

.progress-bar {
  width: 100%;
  height: 6rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 3rpx;
  margin-bottom: 40rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4CAF50 0%, #2E7D32 100%);
  border-radius: 3rpx;
  transition: width 0.3s ease;
  box-shadow: 0 0 10rpx rgba(76, 175, 80, 0.5);
}

.header-content {
  text-align: center;
  padding: 40rpx 20rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
  backdrop-filter: blur(10rpx);
  animation: fadeInDown 0.8s ease-out;
}

@keyframes fadeInDown {
  from {
    opacity: 0;
    transform: translateY(-50rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.icon-wrapper {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 20rpx;
  background: linear-gradient(135deg, #2E7D32 0%, #4CAF50 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(46, 125, 50, 0.3);
  animation: scaleIn 1s ease-out;
}

@keyframes scaleIn {
  from {
    opacity: 0;
    transform: scale(0.5);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.step-icon {
  font-size: 60rpx;
  color: white;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #1a5d27;
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: 24rpx;
  color: #666;
}

/* 表单区域 */
.form-section {
  position: relative;
  z-index: 1;
  margin-bottom: 40rpx;
}

.form-card {
  background: rgba(255, 255, 255, 0.95);
  padding: 40rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
  backdrop-filter: blur(10rpx);
  animation: fadeInUp 0.8s ease-out;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(50rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.input-group {
  margin-bottom: 32rpx;
}

.input-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #1a5d27;
  margin-bottom: 12rpx;
}

.input-wrapper, .select-wrapper, .textarea-wrapper {
  position: relative;
}

.input-field {
  width: 100%;
  padding: 24rpx 32rpx;
  border: 1rpx solid rgba(46, 125, 50, 0.2);
  border-radius: 12rpx;
  font-size: 30rpx;
  background: rgba(255, 255, 255, 0.9);
  transition: all 0.3s ease;
  color: #333;
  backdrop-filter: blur(5rpx);
}

.input-field:focus {
  border-color: #2E7D32;
  background: white;
  box-shadow: 0 0 0 6rpx rgba(46, 125, 50, 0.15);
  transform: translateY(-2rpx);
}

.input-icon {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 32rpx;
  color: #2E7D32;
}

/* 选择器 */
.select-wrapper {
  position: relative;
  border: 1rpx solid rgba(46, 125, 50, 0.2);
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.9);
  transition: all 0.3s ease;
  backdrop-filter: blur(5rpx);
}

.picker-text {
  padding: 24rpx 32rpx;
  font-size: 30rpx;
  color: #333;
}

.picker-icon {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 24rpx;
  color: #2E7D32;
}

/* 文本域 */
.textarea-field {
  width: 100%;
  min-height: 150rpx;
  padding: 24rpx 32rpx;
  border: 1rpx solid rgba(46, 125, 50, 0.2);
  border-radius: 12rpx;
  font-size: 30rpx;
  background: rgba(255, 255, 255, 0.9);
  transition: all 0.3s ease;
  color: #333;
  backdrop-filter: blur(5rpx);
}

.textarea-field:focus {
  border-color: #2E7D32;
  background: white;
  box-shadow: 0 0 0 6rpx rgba(46, 125, 50, 0.15);
  transform: translateY(-2rpx);
}

.char-count {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  font-size: 24rpx;
  color: #999;
}

/* 图片上传 */
.upload-wrapper {
  margin-bottom: 32rpx;
}

.upload-area {
  width: 100%;
  height: 200rpx;
  border: 2rpx dashed rgba(46, 125, 50, 0.3);
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  position: relative;
}

.upload-area:active {
  transform: scale(0.98);
  border-color: #2E7D32;
  background-color: rgba(76, 175, 80, 0.1);
}

.upload-content {
  text-align: center;
}

.upload-icon {
  font-size: 48rpx;
  color: #2E7D32;
  margin-bottom: 16rpx;
  display: block;
}

.upload-text {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.upload-hint {
  font-size: 24rpx;
  color: #999;
  display: block;
}

/* 操作按钮 */
.action-section {
  position: relative;
  z-index: 1;
  margin-bottom: 40rpx;
}

.submit-btn {
  width: 100%;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.submit-btn.primary {
  background: linear-gradient(135deg, #2E7D32 0%, #4CAF50 100%);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(46, 125, 50, 0.3);
}

.submit-btn.primary::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  transform: translate(-50%, -50%);
  transition: width 0.6s, height 0.6s;
}

.submit-btn.primary:active::before {
  width: 300rpx;
  height: 300rpx;
}

.submit-btn.primary:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(46, 125, 50, 0.3);
}

.submit-btn.disabled {
  background: rgba(158, 158, 158, 0.8);
  color: white;
  box-shadow: none;
}

.skip-text {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #666;
  text-decoration: underline;
  transition: all 0.3s ease;
}

.skip-text:active {
  color: #333;
}

/* 底部提示 */
.footer-section {
  position: relative;
  z-index: 1;
}

.tips {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  text-align: center;
  line-height: 1.5;
}

/* 错误提示 */
.error-message {
  display: block;
  font-size: 24rpx;
  color: #f44336;
  margin-top: 8rpx;
  padding-left: 8rpx;
  animation: shake 0.5s ease-out;
}

@keyframes shake {
  0%, 100% {
    transform: translateX(0);
  }
  25% {
    transform: translateX(-10rpx);
  }
  75% {
    transform: translateX(10rpx);
  }
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .form-card {
    padding: 30rpx 20rpx;
  }
  
  .input-field {
    padding: 20rpx 24rpx;
    font-size: 28rpx;
  }
  
  .submit-btn {
    padding: 20rpx;
    font-size: 28rpx;
  }
}