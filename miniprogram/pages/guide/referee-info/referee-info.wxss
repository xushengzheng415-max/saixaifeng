page {
  background: #f5f8f6;
}

.referee-handoff {
  min-height: 100vh;
  padding: 32rpx 28rpx 64rpx;
  box-sizing: border-box;
  color: #173b2b;
}

.hero {
  padding: 40rpx 28rpx 34rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #075b3c 0%, #0a7a4e 100%);
  color: #fff;
  box-shadow: 0 16rpx 36rpx rgba(7, 91, 60, .16);
}

.hero-icon {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin-bottom: 22rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, .18);
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
}

.hero-title,
.hero-subtitle,
.card-title,
.card-body,
.step-text,
.url-label,
.url-value,
.url-status {
  display: block;
}

.hero-title {
  font-size: 42rpx;
  font-weight: 700;
}

.hero-subtitle {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, .82);
  font-size: 26rpx;
}

.handoff-card,
.url-card {
  margin-top: 24rpx;
  padding: 32rpx 28rpx;
  border: 1rpx solid #d9e9df;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(31, 76, 51, .06);
}

.card-title {
  color: #173b2b;
  font-size: 32rpx;
  font-weight: 700;
}

.card-body {
  margin-top: 18rpx;
  color: #53685c;
  font-size: 27rpx;
  line-height: 1.7;
}

.steps {
  margin-top: 28rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid #edf3ef;
  border-bottom: 1rpx solid #edf3ef;
}

.step {
  display: flex;
  align-items: center;
  min-height: 66rpx;
}

.step-number {
  width: 42rpx;
  height: 42rpx;
  line-height: 42rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  background: #e1f3e8;
  color: #087647;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
}

.step-text {
  color: #2c4b39;
  font-size: 27rpx;
}

button.primary-btn,
button.secondary-btn {
  width: 100%;
  margin: 24rpx 0 0;
  border-radius: 44rpx;
  font-size: 30rpx;
}

button.primary-btn {
  background: #087647;
  color: #fff;
}

button.secondary-btn {
  background: #f1f7f3;
  color: #087647;
}

.url-card {
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}

.url-label {
  color: #6f8276;
  font-size: 23rpx;
}

.url-value {
  margin-top: 8rpx;
  color: #087647;
  word-break: break-all;
  font-size: 24rpx;
}

.url-status {
  margin-top: 12rpx;
  color: #2b9a64;
  font-size: 23rpx;
}
