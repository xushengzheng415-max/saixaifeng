<view class="page"><canvas canvas-id="teamCrestCropCanvas" class="hidden-canvas" width="600" height="600"></canvas><image class="bg" src="/images/runtime/home-roles-emerald-stadium-v1.jpg" mode="aspectFill"></image><view class="shade"></view><view class="content">
  <view class="top"><text class="top-back" bindtap="onBack">‹</text><text>创建球队</text></view><view class="steps"><view class="step-line step-line-one"></view><view class="step-line step-line-two"></view><view class="active"><text>1</text><text>基础资料</text></view><view><text>2</text><text>确认信息</text></view><view><text>3</text><text>创建完成</text></view></view>
  <view class="form-card"><text class="crest-label">上传队徽 <text>*</text></text><view class="crest" bindtap="chooseCrest"><image wx:if="{{hasCrest}}" src="{{crestPreview}}" mode="aspectFit"></image><view wx:if="{{!hasCrest}}"><image src="/images/runtime/icons/brand-v1-tab-team.png" mode="aspectFit"></image><text>上传队徽</text></view></view><text class="crest-hint">建议使用清晰正方形图片</text><view class="divider"></view>
    <text class="label">球队名称</text><input value="{{teamName}}" bindinput="onNameInput" placeholder="例如：赛小蜂 U12 竞技队" maxlength="30"></input>
    <text class="label">球队简称</text><input value="{{shortName}}" bindinput="onShortNameInput" placeholder="例如：赛小蜂U12" maxlength="12"></input>
    <text class="label">年龄组</text><picker range="{{divisionOptions}}" bindchange="onDivisionChange"><view class="picker">{{divisionText}}<text>›</text></view></picker>
    <text class="label">所属机构</text><view class="readonly">{{organizationName || '将由服务端确认归属'}}</view>
    <text class="label">所在城市</text><picker mode="region" bindchange="onCityChange"><view class="picker">{{city || '请选择城市'}}<text>›</text></view></picker>
    <text class="label">负责人</text><view class="readonly">{{ownerText || '由服务端确认负责人'}}</view>
  </view><text class="crest-state" wx:if="{{crestStateText}}">{{crestStateText}}</text><view class="snapshot"><image src="/images/icons/shield.svg" mode="aspectFit"></image><text>报名后，队名和队徽会冻结为赛事参赛快照。</text></view><text class="error" wx:if="{{errorText}}">{{errorText}}</text><button bindtap="saveDraftAndContinue">下一步：确认球队信息</button>
</view><view class="crop-mask" wx:if="{{cropVisible}}"><view class="crop-dialog"><text class="crop-title">裁剪队徽</text><view class="crop-window" bindtouchstart="onCropTouchStart" bindtouchmove="onCropTouchMove"><image class="crop-image" src="{{tempCrestPath}}" mode="aspectFit" style="transform: {{crestTransform}}"></image></view><text class="crop-label">缩放</text><slider min="100" max="220" value="100" bindchange="onCropScaleChange" activeColor="#19974c"></slider><view class="crop-actions"><button class="crop-cancel" bindtap="closeCrop">取消</button><button class="crop-confirm" bindtap="confirmCrop">确认裁剪</button></view></view></view></view>
