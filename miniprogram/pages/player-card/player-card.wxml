<view class="container">
  <view class="header">
    <text class="title">我的球员卡</text>
  </view>

  <view wx:if="{{PlayersLen > 0}}" class="cards-list">
    <view class="card-item" wx:for="{{players}}" wx:key="_id">
      <text class="card-name">{{item.name || '未知'}}</text>
      <text class="card-number">#{{item.jerseyNumber || '?'}}</text>
      <text class="card-position">{{item.position || '前锋'}}</text>
    </view>
  </view>

  <view wx:else class="empty">
    <text>暂无球员卡</text>
  </view>
</view>