<view class="container"><view class="header"><text class="title">球员卡</text></view><view wx:if="{{errorText}}" class="empty"><text>{{errorText}}</text><button bindtap="loadPlayers">重新加载</button></view><view wx:elif="{{isLoading}}" class="empty">正在读取成卡…</view><view wx:else class="cards-list"><view class="card-item" wx:for="{{players}}" wx:key="id" data-id="{{item.id}}" bindtap="viewCard"><image wx:if="{{item.ready}}" src="{{item.cardUrl}}" class="saved-card" mode="aspectFit"/><view wx:else class="card-meta"><image wx:if="{{item.portraitUrl}}" src="{{item.portraitUrl}}" class="player-photo" mode="aspectFit"/><text>{{item.name}}</text><text wx:if="{{item.needsSupplement}}">资料待补充</text></view></view></view></view>
