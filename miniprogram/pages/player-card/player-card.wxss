.container{min-height:100vh;background:#f5f8f6;padding:32rpx}.header{font-size:36rpx;font-weight:700;margin-bottom:24rpx}.cards-list{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.saved-card{display:block;width:100%;height:430rpx;aspect-ratio:30/43}.card-meta{padding:40rpx 10rpx;background:white;display:flex;flex-direction:column;gap:16rpx;font-size:24rpx}.empty{padding:60rpx 20rpx;text-align:center;color:#718078}

.player-photo{display:block;width:100%;height:330rpx}.card-meta{padding:20rpx 10rpx}
