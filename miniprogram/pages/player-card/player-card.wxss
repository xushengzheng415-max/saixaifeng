/* pages/player-card/player-card.wxss */
/* 球员卡展示页 - 简化版 */

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  padding: 30rpx 24rpx 120rpx;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 16rpx;
}

.cards-list {
  display: flex;
  flex-direction: column;
  gap: 36rpx;
}

.card-item {
  background: rgba(255,255,255,0.1);
  border-radius: 24rpx;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.card-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}

.card-number {
  font-size: 28rpx;
  color: #FFD700;
}

.card-position {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  color: rgba(255,255,255,0.6);
  font-size: 28rpx;
}
