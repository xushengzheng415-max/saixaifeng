.qc-page{padding:24rpx 28rpx 60rpx}

/* 表单卡 */
.qc-card{background:#fff;border-radius:20rpx;padding:8rpx 28rpx;box-shadow:0 4rpx 20rpx rgba(0,0,0,.06)}
.qc-row{display:flex;align-items:center;padding:26rpx 0;flex-wrap:wrap}
.qc-row-col{padding:26rpx 0}
.qc-divider{height:1rpx;background:#f0f2ee}
.qc-label{font-size:28rpx;color:#5a6b5e;width:170rpx;flex-shrink:0}
.qc-team{font-size:30rpx;color:#1c2b21;font-weight:600;flex:1}
.qc-auto-tag{font-size:20rpx;color:#7fe0a8;background:rgba(88,220,146,.15);border-radius:8rpx;padding:4rpx 12rpx}
.qc-optional{font-size:22rpx;color:#9aa8a0;margin-right:16rpx}
.qc-opponent-head{display:flex;align-items:center;margin-bottom:16rpx}
.qc-opponent-head .qc-label{margin-bottom:0}
.qc-invite-btn{margin-left:auto;background:linear-gradient(160deg,#e88a0c,#d97706);border-radius:26rpx;padding:10rpx 26rpx}
.qc-invite-btn-text{color:#fff;font-size:24rpx;font-weight:600}
.qc-input{flex:1;font-size:30rpx;color:#1c2b21;padding:8rpx 0}
.qc-input-num{width:110rpx;font-size:30rpx;color:#1c2b21;text-align:center;border-bottom:2rpx solid #2E7D32;padding-bottom:6rpx}
.qc-unit{font-size:26rpx;color:#9aa8a0;margin-left:12rpx}
.qc-picker-wrap{margin-right:16rpx}
.qc-picker{background:#f4f8f5;border-radius:12rpx;padding:14rpx 22rpx;font-size:28rpx;color:#1c2b21}

/* 提交按钮 */
.qc-submit{margin-top:36rpx;background:linear-gradient(160deg,#0aa85a,#065431);border-radius:48rpx;padding:26rpx 0;text-align:center;box-shadow:0 8rpx 24rpx rgba(10,168,90,.3)}
.qc-submit-disabled{opacity:.45;box-shadow:none}
.qc-submit{text-align:center}

/* 底部说明 */
.qc-footer{margin-top:32rpx;padding:0 8rpx}
.qc-footer-title{font-size:24rpx;color:#9aa8a0;margin-bottom:10rpx}
.qc-footer-item{font-size:24rpx;color:#6b7a6f;line-height:1.9}

/* 成功态 */
.qc-success{background:#fff;border-radius:20rpx;padding:48rpx 36rpx;text-align:center;box-shadow:0 4rpx 20rpx rgba(0,0,0,.06)}
.qc-success-icon{font-size:88rpx;margin-bottom:16rpx}
.qc-success-title{font-size:36rpx;font-weight:700;color:#1c2b21;margin-bottom:28rpx}
.qc-success-summary{background:#f4f8f5;border-radius:14rpx;padding:20rpx 24rpx;text-align:left}
.qc-success-row{display:flex;font-size:27rpx;line-height:2;color:#1c2b21}
.qc-success-label{color:#8a978e;width:150rpx;flex-shrink:0}

.qc-share-btn{margin-top:40rpx;background:linear-gradient(160deg,#0aa85a,#065431);color:#fff;border-radius:48rpx;font-size:32rpx;font-weight:600;padding:26rpx 0;line-height:1.4}
.qc-share-btn::after{border:none}
.qc-share-hint{text-align:center;font-size:23rpx;color:#9aa8a0;margin-top:14rpx}
.qc-success-secondary{text-align:center;font-size:26rpx;color:#e88a0c;margin-top:40rpx}
.qc-success-done{text-align:center;font-size:28rpx;color:#6b7a6f;margin-top:24rpx;padding:16rpx}
.qc-venue-presets{display:flex;flex-wrap:wrap;margin:6rpx 0 10rpx}.qc-venue-preset{max-width:100%;margin:0 10rpx 10rpx 0;padding:8rpx 18rpx;border-radius:12rpx;background:#e7f6ec;color:#0c8a4a;font-size:22rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
