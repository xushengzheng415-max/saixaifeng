.page{min-height:100vh;background:#f4f6f4}.hero{min-height:690rpx;padding:70rpx 34rpx 0;box-sizing:border-box;background-image:linear-gradient(180deg,rgba(0,19,13,.84),rgba(0,77,49,.91)),url('/images/runtime/stadium-tech-bg.jpg');background-size:cover;background-position:center}.nav{height:76rpx;display:flex;align-items:center;justify-content:center;position:relative}.back{position:absolute;left:0;color:#fff;font-size:68rpx;line-height:50rpx}.title{color:#fff;font-size:39rpx;font-weight:700}.event-card{margin-top:35rpx;padding:27rpx;border:2rpx solid #dcad4a;border-radius:30rpx;background:linear-gradient(130deg,rgba(0,91,58,.93),rgba(0,44,29,.91));color:#fff}.tag-row{display:flex;justify-content:space-between}.host-tag,.pro-tag{padding:10rpx 16rpx;border-radius:22rpx;font-size:21rpx}.host-tag{background:#ffe2a1;color:#885b0a}.pro-tag{background:rgba(207,152,48,.72);color:#fff4cd}.event-name{display:block;margin-top:28rpx;font-size:38rpx;font-weight:700}.event-meta{display:block;margin-top:18rpx;color:rgba(255,255,255,.75);font-size:23rpx}.event-stats{display:flex;margin-top:24rpx;padding-top:20rpx;border-top:1rpx solid rgba(255,255,255,.25)}.event-stats view{flex:1;text-align:center;border-right:1rpx solid rgba(255,255,255,.18)}.event-stats view:last-child{border:0}.event-stats text{display:block}.event-stats text:first-child{font-size:33rpx;font-weight:700}.event-stats text:last-child{margin-top:6rpx;color:rgba(255,255,255,.62);font-size:20rpx}.readiness{display:flex;justify-content:space-between;margin-top:28rpx;padding:23rpx 12rpx;background:rgba(0,46,28,.76);border-radius:23rpx}.ready-step{width:25%;display:flex;flex-direction:column;align-items:center;color:rgba(255,255,255,.73);font-size:20rpx;text-align:center}.step-dot{display:block;width:46rpx;height:46rpx;margin-bottom:9rpx;border-radius:50%;background:#63776b;color:#fff;font-size:26rpx;line-height:46rpx}.ready-step.ready .step-dot{background:#1da66e}.step-value{margin-top:7rpx;color:#f3c96a;font-size:19rpx}.content{margin-top:-11rpx;padding:0 34rpx 120rpx}.loading,.error{text-align:center;padding:100rpx 0;color:#849088}.error{color:#bd5146}.card-list{display:flex;flex-direction:column;gap:20rpx}.work-card{display:flex;align-items:center;min-height:162rpx;padding:24rpx;border-radius:23rpx;background:#fff;box-shadow:0 8rpx 25rpx rgba(12,55,36,.08);box-sizing:border-box}.glyph{flex:none;width:77rpx;height:77rpx;margin-right:20rpx;border-radius:50%;background:linear-gradient(135deg,#1ba76e,#08754b);color:#fff;font-size:31rpx;font-weight:700;line-height:77rpx;text-align:center}.attention .glyph{background:linear-gradient(135deg,#f4c65c,#b97a12)}.card-copy{flex:1;min-width:0}.card-title,.card-main,.card-sub{display:block}.card-title{font-size:29rpx;font-weight:700}.card-main{margin-top:9rpx;font-size:24rpx;color:#3a5b4b}.card-sub{margin-top:8rpx;color:#87928d;font-size:20rpx}.card-action{padding:12rpx 15rpx;border-radius:14rpx;background:#e9f5ed;color:#18734f;font-size:21rpx}.arrow{margin-left:10rpx;color:#aab4ae;font-size:40rpx}.note{margin-top:24rpx;padding:22rpx;border-radius:19rpx;background:#e9f4ed;color:#456f59;font-size:22rpx;line-height:1.6}.todo-button{margin-top:24rpx;border-radius:21rpx;background:linear-gradient(90deg,#f4d37c,#d89e39);color:#553608;font-size:30rpx;font-weight:700}.denied{margin-top:100rpx;text-align:center}.denied-icon{display:block;width:82rpx;height:82rpx;margin:0 auto;border-radius:50%;background:#fde7e2;color:#bc5045;font-size:42rpx;line-height:82rpx}.denied-title,.denied-desc{display:block}.denied-title{margin-top:24rpx;font-size:30rpx;font-weight:600}.denied-desc{margin-top:13rpx;color:#839088;font-size:23rpx}
.page{padding-top:0}.hero{padding-top:0;min-height:690rpx}.nav{height:208rpx;box-sizing:border-box;align-items:flex-end;padding-bottom:28rpx}.back{bottom:16rpx}.glyph image{width:62rpx;height:62rpx;margin:7rpx}
