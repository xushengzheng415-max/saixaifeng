.shared-page{padding:36rpx;min-height:100vh;box-sizing:border-box;background:#f5f8f6;color:#203629}.badge{display:inline-block;padding:8rpx 18rpx;background:#e0f2e7;color:#087b3d;border-radius:8rpx;font-size:24rpx}.name{font-size:38rpx;font-weight:700;line-height:1.5;margin:24rpx 0}.meta{font-size:28rpx;color:#65746b;margin:14rpx 0}.rights{border-top:1rpx solid #dce6df;margin-top:32rpx;padding-top:28rpx;font-size:28rpx;line-height:1.8}.rights text{display:block}.label{font-weight:600;margin-bottom:12rpx}.note{margin-top:28rpx;color:#6e7c72;font-size:25rpx;line-height:1.7}.back{margin-top:40rpx;color:#087b3d;background:#fff;font-size:28rpx}.state{text-align:center;padding:60rpx 0;font-size:28rpx}.state text{display:block;margin-bottom:30rpx}
.modules{margin-top:30rpx;border-top:1rpx solid #dce6df}.module{display:flex;justify-content:space-between;padding:30rpx 8rpx;border-bottom:1rpx solid #dce6df;font-size:30rpx;color:#087b3d}
