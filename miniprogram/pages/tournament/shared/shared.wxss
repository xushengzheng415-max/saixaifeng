page{background:#00452e}.shared-page{padding:28rpx 28rpx 70rpx;color:#183329}.hero{padding:26rpx;border:2rpx solid #aeaa57;border-radius:22rpx;background:#005c3d;color:#fff}.hero-top,.hero-bottom{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.badge,.division{padding:10rpx 18rpx;background:#e5d581;color:#52602b;border-radius:12rpx;font-size:23rpx}.division{max-width:300rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.event-name{display:block;margin:26rpx 0 18rpx;font-size:33rpx;font-weight:700;line-height:1.4}.event-meta{font-size:24rpx;color:#d9e8df;line-height:1.6}.hero-bottom{border-top:1rpx solid #438764;margin-top:22rpx;padding-top:20rpx;font-size:24rpx}.summary{display:flex;background:#fff;border-radius:20rpx;margin-top:22rpx;padding:28rpx 0}.summary>view{flex:1;text-align:center;border-right:1rpx solid #dce6df}.summary>view:last-child{border:0}.summary text{display:block;color:#738077;font-size:25rpx}.summary text:last-child{font-size:44rpx;font-weight:700;color:#078349;margin-top:14rpx}.standings,.modules{background:#fff;border-radius:20rpx;margin-top:20rpx;padding:24rpx}.section-title{display:block;font-size:29rpx;font-weight:700}.group-name{display:block;margin:20rpx 0 12rpx;font-size:24rpx;color:#65766c}.table-head,.table-row{display:flex;align-items:center;gap:12rpx;padding:16rpx 0;font-size:24rpx;border-bottom:1rpx solid #e6ece8}.table-head{color:#768279}.table-head text,.table-row text{width:62rpx;flex-shrink:0;text-align:center}.table-head text:nth-child(2),.table-row text:nth-child(2){flex:1;width:auto;text-align:left;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.modules{padding:0 24rpx}.module{display:flex;align-items:center;gap:20rpx;min-height:98rpx;border-bottom:1rpx solid #e0e9e3;font-size:28rpx;font-weight:600}.module:last-child{border:0}.module image{width:42rpx;height:42rpx}.arrow{margin-left:auto;color:#94a49b;font-weight:400}.schedule{margin-top:28rpx;color:#fff}.day-title{display:block;margin:22rpx 0 14rpx;font-size:25rpx;color:#d5e5dc}.match{background:#fff;color:#1c392b;border-radius:18rpx;padding:22rpx;margin-top:14rpx}.match-meta,.match-bottom{display:flex;justify-content:space-between;gap:12rpx;font-size:23rpx;color:#6b7e72}.opponents{display:flex;align-items:center;justify-content:space-between;gap:14rpx;margin:22rpx 0}.opponents>view{flex:1;min-width:0;text-align:center}.opponents image{display:block;width:68rpx;height:68rpx;margin:0 auto 12rpx}.opponents>view text{font-size:25rpx;line-height:1.4;display:block}.score{font-size:32rpx;font-weight:700;white-space:nowrap}.match-bottom{border-top:1rpx solid #e2eae5;padding-top:16rpx}.match-bottom text:last-child{color:#07824b}.empty{display:block;font-size:25rpx;color:#7d8a82;padding:24rpx 0}.schedule>.empty{color:#dce9e2}.state{padding:120rpx 24rpx;text-align:center;color:#fff;font-size:27rpx}.state text{display:block;margin:24rpx 0}.state button{color:#087b43;font-size:27rpx}

.standings-heading{display:flex;justify-content:space-between;align-items:center;gap:12rpx}.standings-heading picker{color:#07804b;font-size:24rpx}.table-row>.standing-team{flex:1;min-width:0;display:flex;align-items:center;gap:10rpx}.standing-team image{width:42rpx;height:42rpx;flex-shrink:0}.table-row>.standing-team text{width:auto;flex:1;text-align:left;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.table-row>text:nth-child(2){flex:none;width:62rpx}

.division-tabs{display:flex;gap:12rpx;margin-top:22rpx}.division-tab{flex:1;min-width:0;padding:20rpx 8rpx;text-align:center;border:1rpx solid rgba(255,255,255,.32);border-radius:12rpx;color:#e5f1e9;font-size:27rpx;white-space:nowrap}.division-tab.active{background:#fff;border-color:#fff;color:#087d49;font-weight:700}.group-tabs{display:flex;gap:16rpx;margin:22rpx 0 4rpx;border-bottom:1rpx solid #dfe9e2}.group-tab{padding:12rpx 22rpx 18rpx;font-size:26rpx;color:#738277;border-bottom:4rpx solid transparent}.group-tab.active{color:#087e49;border-color:#087e49;font-weight:700}

.day-heading{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin:24rpx 0 14rpx}.day-heading .day-title{margin:0}.day-position{font-size:22rpx;color:#d5e5dc;white-space:nowrap}.day-matches{height:340rpx}.day-matches .match{height:340rpx;box-sizing:border-box;margin:0;display:flex;flex-direction:column;border-radius:14rpx}.day-matches .opponents{flex:1;margin:18rpx 0;min-height:0}.day-matches .opponents>view text{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:70rpx;word-break:break-all}.day-matches .match-meta text{overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.day-matches .match-meta text:first-child{flex:1;min-width:0}.day-matches .match-meta text:last-child{max-width:220rpx}.day-matches .match-bottom{flex-shrink:0}.division-tabs{flex-wrap:wrap}.division-tab{flex:none;min-width:140rpx;box-sizing:border-box}

.scorer-team{flex:1;min-width:0;display:flex;align-items:center;gap:10rpx}.scorer-team text{width:auto;flex:1;text-align:left;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.knockout-list{margin-top:6rpx}.knockout-match{padding:18rpx 0;border-bottom:1rpx solid #e6ece8}.knockout-match:last-child{border:0}.knockout-meta{display:block;font-size:23rpx;color:#768279}
.bracket{margin-top:6rpx}
.bracket-tabs{display:flex;justify-content:center;gap:16rpx;margin-bottom:10rpx}.bracket-tab{padding:10rpx 34rpx;border:1rpx solid #dfe9e2;border-radius:999rpx;font-size:24rpx;color:#738277}.bracket-tab.active{background:#087e49;border-color:#087e49;color:#fff;font-weight:600}
.bracket-round{margin-top:14rpx}.bracket-round:first-child{margin-top:0}
.bracket-title{display:block;text-align:center;font-size:23rpx;color:#768279;margin-bottom:10rpx}
.bracket-grid{display:flex;flex-wrap:wrap;justify-content:center;gap:14rpx}
.bracket-card{width:46%;box-sizing:border-box;background:#f7faf8;border:1rpx solid #e3ece6;border-radius:14rpx;padding:14rpx 18rpx 16rpx}
.bracket-meta{display:block;font-size:20rpx;color:#93a099;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.bracket-side{display:flex;align-items:center;gap:10rpx;min-width:0;margin-top:10rpx}
.bracket-logo{width:40rpx;height:40rpx;border-radius:8rpx;background:#eef4ef;flex-shrink:0}
.bracket-name{flex:1;min-width:0;font-size:25rpx;font-weight:600;color:#1c392b;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.bracket-mid{display:block;text-align:center;font-size:30rpx;font-weight:700;color:#078349;margin:2rpx 0 0;line-height:1.2}
.bracket-link{display:flex;justify-content:center}
.bracket-unit{position:relative;height:34rpx}
.unit-merge{width:96%}
.unit-straight{width:46%}
.bl-v{position:absolute;top:50%;bottom:0;width:0;border-left:2rpx solid #c3d2c8}
.bl-left{left:25%}
.bl-right{left:75%}
.bl-h{position:absolute;left:25%;right:25%;top:50%;height:0;border-top:2rpx solid #c3d2c8}
.bl-mid{position:absolute;left:50%;top:0;height:50%;width:0;border-left:2rpx solid #c3d2c8}
.unit-straight .bl-mid{height:100%}
.rank-more{margin:18rpx 0 4rpx;padding:14rpx 0;background:#f1f7f3;border-radius:12rpx;font-size:24rpx;color:#087d49;line-height:1.4}.rank-more::after{border:0}
.sheet-mask{position:fixed;left:0;top:0;right:0;bottom:0;z-index:60;background:rgba(0,0,0,.5);display:flex;align-items:flex-end}
.sheet{width:100%;max-height:76vh;background:#fff;border-radius:24rpx 24rpx 0 0;padding:26rpx 28rpx 44rpx;box-sizing:border-box}
.sheet-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:8rpx}.sheet-title{font-size:29rpx;font-weight:700;color:#183329}.sheet-close{font-size:25rpx;color:#087d49;padding:8rpx 0 8rpx 24rpx}
.sheet-body{max-height:58vh}
