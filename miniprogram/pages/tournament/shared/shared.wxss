.shared-page{padding:26rpx;min-height:100vh;box-sizing:border-box;background:#f5f8f6;color:#203629}.return-link{color:#087b3d;font-size:25rpx;margin:4rpx 0 22rpx}.summary{padding:22rpx 4rpx 26rpx;border-bottom:1rpx solid #dce6df}.name{font-size:32rpx;font-weight:600;line-height:1.45}.status{display:inline-block;margin-top:16rpx;color:#087b3d;font-size:24rpx}.meta{display:flex;flex-wrap:wrap;gap:8rpx 22rpx;color:#65746b;font-size:23rpx;line-height:1.6;margin-top:12rpx}.modules{margin-top:20rpx;background:#fff;border-radius:10rpx;overflow:hidden}.module{display:flex;align-items:center;justify-content:space-between;min-height:104rpx;padding:0 26rpx;border-bottom:1rpx solid #e4ece7;font-size:29rpx;font-weight:500;color:#203629}.module:last-child{border-bottom:0}.module-end{display:flex;gap:20rpx;align-items:center;color:#7b8980;font-size:34rpx}.tag{font-size:22rpx;color:#658071;font-weight:400}.note{padding:24rpx 0;color:#6e7c72;font-size:25rpx}.state{text-align:center;padding:50rpx 0;font-size:27rpx;line-height:1.6}.state text{display:block;margin-bottom:24rpx}.state button{font-size:27rpx;color:#087b3d;background:#fff}
