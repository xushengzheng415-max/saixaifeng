<view class="page">
  <view wx:if="{{loading}}" class="state">加载中…</view>
  <view wx:elif="{{errorText}}" class="state"><text>{{errorText}}</text><button bindtap="onRetry">重新加载</button></view>
  <block wx:else>
    <view wx:if="{{dataWarning}}" class="data-warning">{{dataWarning}}</view>
    <block wx:if="{{!isDetail}}">
      <view wx:if="{{isMatchModule}}" class="match-filters">
        <view class="status-tabs"><view wx:for="{{statusTabs}}" wx:for-item="tab" wx:key="id" class="status-tab {{tab.itemClass}}" data-id="{{tab.id}}" bindtap="onStatus"><text>{{tab.name}}</text><text class="tab-count">{{tab.count}}</text></view></view>
        <view class="filter-line"><picker range="{{divisions}}" range-key="name" value="{{divisionIndex}}" bindchange="onDivision"><view>{{divisionName}} ▾</view></picker><picker wx:if="{{isMatches}}" range="{{matchScopes}}" range-key="name" value="{{matchScopeIndex}}" bindchange="onMatchScope"><view>{{matchScopeName}} ▾</view></picker><picker wx:else range="{{dates}}" range-key="name" value="{{dateIndex}}" bindchange="onDate"><view>{{dateName}} ▾</view></picker><button bindtap="clearFilters">重置</button></view>
        <input class="match-search" value="{{keyword}}" bindinput="onSearch" placeholder="搜索球队或场序" confirm-type="search"/>
      </view>
      <view wx:if="{{isReferees}}" class="actions"><button bindtap="addReferee" disabled="{{submitting}}">添加临时裁判</button><button bindtap="inviteReferee" disabled="{{submitting}}">邀请持证裁判</button></view>
      <view wx:if="{{!hasItems}}" class="state"><text>{{emptyText}}</text><button wx:if="{{isMatchModule}}" bindtap="clearFilters">重置筛选</button></view>
      <view wx:for="{{items}}" wx:key="id" class="list-row">
        <view wx:if="{{isMatchModule}}" class="match-list-item" data-id="{{item.id}}" bindtap="onOpen">
          <view class="match-list-head"><text>{{item.date || '日期待定'}} · {{item.matchMeta}}</text><text class="match-list-status {{item.statusClass}}">{{item.listStatus}}</text></view>
          <view class="match-list-sides"><text class="team-name home">{{item.homeName}}</text><text class="match-list-score">{{item.score}}</text><text class="team-name away">{{item.awayName}}</text></view>
          <view class="match-list-foot"><text>{{item.venue || '场地待定'}}</text><text class="match-list-action">{{item.listAction}} ›</text></view>
        </view>
        <view wx:else class="row-main" data-id="{{item.id}}" bindtap="onOpen">
          <image wx:if="{{item.hasLogo}}" class="logo" src="{{item.logo}}" mode="aspectFit"/>
          <view class="row-copy"><text class="name">{{item.name}}</text><text class="meta">{{item.detail}}</text><text wx:if="{{item.missingTeam}}" class="meta">球队资料待补齐</text><text class="meta">{{item.date}} {{item.time}} {{item.venue}}</text></view>
          <view><text class="status">{{item.status}}</text><text class="score">{{item.score}}</text></view>
        </view>
        <view wx:if="{{isReferees}}" class="ref-actions"><text>{{item.availabilityText}}</text><button wx:if="{{item.canConfirm}}" size="mini" data-id="{{item.id}}" bindtap="confirmReferee" disabled="{{submitting}}">确认认领</button><button wx:if="{{item.canManage}}" size="mini" data-id="{{item.id}}" data-value="{{item.availabilityNext}}" bindtap="changeAvailability" disabled="{{submitting}}">切换可用状态</button></view>
      </view>
      <view wx:if="{{showAdd}}" class="form">
        <text class="section-title">临时裁判</text><text class="label">姓名</text><input data-field="name" value="{{form.name}}" bindinput="onInput" maxlength="40"/>
        <text class="label">手机号</text><input data-field="phone" value="{{form.phone}}" bindinput="onInput" type="number" maxlength="11"/>
        <text class="label">添加原因</text><textarea data-field="reason" value="{{form.reason}}" bindinput="onInput" maxlength="200"/>
        <button class="primary" bindtap="saveReferee" loading="{{submitting}}" disabled="{{submitting}}">保存并生成认领码</button>
      </view>
      <view wx:if="{{hasInvite}}" class="invite"><image wx:if="{{qrCodeUrl}}" src="{{qrCodeUrl}}" mode="aspectFit"/><text>裁判认领后仍需核对资料。</text><button bindtap="copyInvite">复制邀请链接</button></view>
    </block>
    <block wx:if="{{isDetail}}">
      <view wx:if="{{!isMatches}}"><view class="back" bindtap="onBack">‹ 返回列表</view><text class="title">{{item.name}}</text><text class="meta">{{item.status}} {{item.score}}</text></view>
      <view wx:if="{{isTeams}}" class="details"><view><text>简称</text><text>{{item.shortName}}</text></view><view><text>球队编号</text><text>{{item.teamCode}}</text></view><view><text>所在城市</text><text>{{item.city}}</text></view><view><text>联系人</text><text>{{item.contactName}}</text></view><view><text>联系电话</text><text>{{item.phoneMasked}}</text></view><text>{{item.description}}</text></view>
      <view wx:if="{{isRegistration}}">
        <text class="meta">{{item.detail}}</text><text class="meta">{{item.reason}}</text><button wx:if="{{item.canReviewPlayers}}" bindtap="openRegistrationSource" disabled="{{submitting}}">查看报名表</button>
        <view wx:if="{{item.canReviewPlayers}}" class="form"><text class="section-title">球员资料审核</text><view wx:for="{{item.players}}" wx:for-item="player" wx:key="id" class="player-row"><view><text>{{player.jerseyNumber}}号 {{player.name}}</text><text class="meta">{{player.birthDate}} · {{player.qualification}}</text></view><text>{{player.status}}</text><button wx:if="{{player.canApprove}}" size="mini" data-id="{{player.id}}" bindtap="approvePlayer" disabled="{{submitting}}">审核通过</button></view></view><view wx:for="{{item.rosters}}" wx:for-item="roster" wx:key="id" class="form"><text class="section-title">名单 · {{roster.status}}</text><view wx:for="{{roster.players}}" wx:for-item="player" wx:key="id" class="player-row"><text>{{player.jerseyNumber}}号 {{player.name}}</text><text>{{player.qualification}}</text></view><text wx:if="{{!roster.hasPlayers}}" class="meta">名单人员尚未提供</text></view>
        <view wx:if="{{item.canReview}}" class="form"><text class="label">审核原因</text><textarea value="{{reason}}" bindinput="onReason" maxlength="300"/><view class="actions"><button data-decision="rejected" bindtap="reviewRegistration" disabled="{{submitting}}">驳回</button><button class="primary" data-decision="approved" bindtap="reviewRegistration" disabled="{{submitting}}">通过报名</button></view></view>
      </view>
      <block wx:if="{{isMatches}}">
        <referee-report-import id="paperImporter" players-on-field="{{playersOnField}}" hidden-entry="{{true}}" tournament-id="{{tournamentId}}" match="{{item}}" players="{{item.players}}" can-lineup="{{canImportLineup}}" can-result="{{canImportResult}}" bind:statechange="onReportState" bind:saved="onReportSaved"/>
        <match-lineup-editor wx:if="{{!reportOpen}}" primary-view="{{true}}" read-only="{{!canSelectLineup}}" can-edit="{{item.canEdit}}" can-upload="{{canImportLineup || canImportResult}}" can-start="{{canStart}}" can-record="{{canRecord}}" can-finish="{{canFinish}}" tournament-id="{{tournamentId}}" match="{{item}}" players="{{item.players}}" home-starters="{{homeStarters}}" away-starters="{{awayStarters}}" home-bench="{{homeBench}}" away-bench="{{awayBench}}" saving="{{submitting}}" dirty="{{lineupDirty}}" bind:rules="onLineupRules" bind:change="onGameLineupChange" bind:save="saveLineup" bind:back="onBack" bind:settings="openMatchSettings" bind:report="openMatchReport" bind:events="openEvent" bind:start="startMatch" bind:finish="finishMatch"/>
        <view wx:if="{{showSettings}}" class="match-sheet-mask" bindtap="closeMatchSettings"><view class="match-sheet" catchtap="noop"><view class="sheet-heading"><text>比赛设置</text><text bindtap="closeMatchSettings">关闭</text></view><view wx:if="{{item.canEdit}}"><text class="label">日期</text><picker mode="date" value="{{form.date}}" data-field="date" bindchange="onInput"><view class="input">{{form.date}}</view></picker><text class="label">时间</text><picker mode="time" value="{{form.time}}" data-field="time" bindchange="onInput"><view class="input">{{form.time}}</view></picker><text class="label">场地</text><input value="{{form.venue}}" data-field="venue" bindinput="onInput" maxlength="100"/><button class="primary" bindtap="saveMatch" disabled="{{submitting}}">保存设置</button></view></view></view>
        <view wx:if="{{showEvent}}" class="match-sheet-mask" bindtap="closeEvent"><scroll-view scroll-y class="match-sheet event-sheet" catchtap="noop"><view class="sheet-heading"><text>比赛事件</text><text bindtap="closeEvent">关闭</text></view><view wx:if="{{canRecord}}"><text class="label">事件类型</text><picker range="{{eventTypes}}" range-key="text" value="{{eventTypeIndex}}" bindchange="onEventType"><view class="input">{{eventTypeLabel}}</view></picker><text class="label">事件球员 / 换上球员</text><picker range="{{playerOptions}}" range-key="label" value="{{eventPlayerIndex}}" bindchange="onEventPlayer"><view class="input">{{eventPlayerLabel}}</view></picker><picker wx:if="{{isSubstitution}}" range="{{outOptions}}" range-key="label" value="{{eventOutIndex}}" bindchange="onEventOut"><view class="input">{{eventOutLabel}}</view></picker><text class="label">比赛分钟</text><input value="{{minute}}" type="number" bindinput="onMinute"/><button class="primary" bindtap="saveEvent" disabled="{{submitting}}">保存事件</button></view><view wx:for="{{item.events}}" wx:for-item="entry" wx:key="id" class="player-row"><text>{{entry.minute}}′ {{entry.typeText}}</text><text>{{entry.playerName}} {{entry.outPlayerName}}</text></view></scroll-view></view>
      </block> <view wx:if="{{!isMatches}}"><view class="events" wx:if="{{item.hasEvents}}"><text class="section-title">已保存事件</text><view wx:for="{{item.events}}" wx:for-item="entry" wx:key="id" class="player-row"><text>{{entry.minute}}′ {{entry.typeText}}</text><text>{{entry.playerName}} {{entry.outPlayerName}}</text></view></view></view>
      <view wx:if="{{isResults}}" class="form"><text class="section-title">裁判记录</text><text>{{item.report}}</text><text class="meta">{{item.reviewStatus}}</text><view wx:if="{{item.canReview}}"><text class="label">退回原因</text><textarea value="{{reason}}" bindinput="onReason" maxlength="300"/><view class="actions"><button data-decision="return" bindtap="reviewResult" disabled="{{submitting}}">退回修正</button><button class="primary" data-decision="archive" bindtap="reviewResult" disabled="{{submitting}}">确认并归档</button></view></view></view>
    </block>
  </block>
</view>
