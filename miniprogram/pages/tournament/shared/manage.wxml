<view class="page">
  <view wx:if="{{loading}}" class="state">加载中…</view>
  <view wx:elif="{{errorText}}" class="state"><text>{{errorText}}</text><button bindtap="onBack">重新加载</button></view>
  <block wx:else>
    <block wx:if="{{!isDetail}}">
      <view wx:if="{{isReferees}}" class="actions"><button bindtap="addReferee" disabled="{{submitting}}">添加临时裁判</button><button bindtap="inviteReferee" disabled="{{submitting}}">邀请持证裁判</button></view>
      <view wx:if="{{!hasItems}}" class="state">当前赛事暂无记录</view>
      <view wx:for="{{items}}" wx:key="id" class="list-row">
        <view class="row-main" data-id="{{item.id}}" bindtap="onOpen">
          <image wx:if="{{item.hasLogo}}" class="logo" src="{{item.logo}}" mode="aspectFit"/>
          <view class="row-copy"><text class="name">{{item.name}}</text><text class="meta">{{item.detail}}</text><text class="meta">{{item.date}} {{item.time}} {{item.venue}}</text></view>
          <view><text class="status">{{item.status}}</text><text class="score">{{item.score}}</text></view>
        </view>
        <view wx:if="{{isResults}}" class="meta">核查状态：{{item.reviewStatus}}</view>
        <view wx:if="{{isReferees}}" class="ref-actions"><text>{{item.availabilityText}}</text><button wx:if="{{item.canConfirm}}" size="mini" data-id="{{item.id}}" bindtap="confirmReferee" disabled="{{submitting}}">确认认领</button><button wx:if="{{item.canManage}}" size="mini" data-id="{{item.id}}" data-value="{{item.availabilityNext}}" bindtap="changeAvailability" disabled="{{submitting}}">切换可用状态</button></view>
      </view>
      <view wx:if="{{showAdd}}" class="form">
        <text class="section-title">临时裁判</text><text class="label">姓名</text><input data-field="name" value="{{form.name}}" bindinput="onInput" maxlength="40"/>
        <text class="label">手机号</text><input data-field="phone" value="{{form.phone}}" bindinput="onInput" type="number" maxlength="11"/>
        <text class="label">添加原因</text><textarea data-field="reason" value="{{form.reason}}" bindinput="onInput" maxlength="200"/>
        <button class="primary" bindtap="saveReferee" loading="{{submitting}}" disabled="{{submitting}}">保存并生成认领码</button>
      </view>
      <view wx:if="{{hasInvite}}" class="invite"><image wx:if="{{qrCodeUrl}}" src="{{qrCodeUrl}}" mode="aspectFit"/><text>裁判认领后仍需核对资料。</text><button bindtap="copyInvite">复制邀请链接</button></view>
    </block>
    <block wx:if="{{isDetail}}">
      <view class="back" bindtap="onBack">‹ 返回列表</view><text class="title">{{item.name}}</text><text class="meta">{{item.status}} {{item.score}}</text>
      <view wx:if="{{isTeams}}" class="details"><view><text>简称</text><text>{{item.shortName}}</text></view><view><text>球队编号</text><text>{{item.teamCode}}</text></view><view><text>所在城市</text><text>{{item.city}}</text></view><view><text>联系人</text><text>{{item.contactName}}</text></view><view><text>联系电话</text><text>{{item.phoneMasked}}</text></view><text>{{item.description}}</text></view>
      <view wx:if="{{isRegistration}}">
        <text class="meta">{{item.detail}}</text><text class="meta">{{item.reason}}</text><button wx:if="{{item.canReviewPlayers}}" bindtap="openRegistrationSource" disabled="{{submitting}}">查看报名表</button>
        <view wx:if="{{item.canReviewPlayers}}" class="form"><text class="section-title">球员资料审核</text><view wx:for="{{item.players}}" wx:for-item="player" wx:key="id" class="player-row"><view><text>{{player.jerseyNumber}}号 {{player.name}}</text><text class="meta">{{player.birthDate}} · {{player.qualification}}</text></view><text>{{player.status}}</text><button wx:if="{{player.canApprove}}" size="mini" data-id="{{player.id}}" bindtap="approvePlayer" disabled="{{submitting}}">审核通过</button></view></view><view wx:for="{{item.rosters}}" wx:for-item="roster" wx:key="id" class="form"><text class="section-title">名单 · {{roster.status}}</text><view wx:for="{{roster.players}}" wx:for-item="player" wx:key="id" class="player-row"><text>{{player.jerseyNumber}}号 {{player.name}}</text><text>{{player.qualification}}</text></view><text wx:if="{{!roster.hasPlayers}}" class="meta">名单人员尚未提供</text></view>
        <view wx:if="{{item.canReview}}" class="form"><text class="label">审核原因</text><textarea value="{{reason}}" bindinput="onReason" maxlength="300"/><view class="actions"><button data-decision="rejected" bindtap="reviewRegistration" disabled="{{submitting}}">驳回</button><button class="primary" data-decision="approved" bindtap="reviewRegistration" disabled="{{submitting}}">通过报名</button></view></view>
      </view>
      <block wx:if="{{isMatches}}">
        <view wx:if="{{item.canEdit}}" class="form"><text class="label">日期</text><picker mode="date" value="{{form.date}}" data-field="date" bindchange="onInput"><view class="input">{{form.date}}</view></picker><text class="label">时间</text><picker mode="time" value="{{form.time}}" data-field="time" bindchange="onInput"><view class="input">{{form.time}}</view></picker><text class="label">场地</text><input value="{{form.venue}}" data-field="venue" bindinput="onInput" maxlength="100"/><button bindtap="saveMatch" disabled="{{submitting}}">保存基本信息</button></view>
        <view wx:if="{{canSelectLineup}}" class="form"><text class="section-title">选择首发</text><text class="label">{{item.homeName}}</text><checkbox-group data-side="home" bindchange="onStarter"><label wx:for="{{homePlayers}}" wx:key="id" class="player-row"><checkbox value="{{item.id}}" checked="{{item.checked}}" color="#087b3d"/><text>{{item.jerseyNumber}}号 {{item.name}}</text></label></checkbox-group><text class="label">{{item.awayName}}</text><checkbox-group data-side="away" bindchange="onStarter"><label wx:for="{{awayPlayers}}" wx:key="id" class="player-row"><checkbox value="{{item.id}}" checked="{{item.checked}}" color="#087b3d"/><text>{{item.jerseyNumber}}号 {{item.name}}</text></label></checkbox-group><text class="label">主队替补</text><checkbox-group data-side="home" bindchange="onBench"><label wx:for="{{homePlayers}}" wx:key="id" class="player-row"><checkbox value="{{item.id}}" checked="{{item.benchChecked}}" color="#087b3d"/><text>{{item.jerseyNumber}}号 {{item.name}}</text></label></checkbox-group><text class="label">客队替补</text><checkbox-group data-side="away" bindchange="onBench"><label wx:for="{{awayPlayers}}" wx:key="id" class="player-row"><checkbox value="{{item.id}}" checked="{{item.benchChecked}}" color="#087b3d"/><text>{{item.jerseyNumber}}号 {{item.name}}</text></label></checkbox-group><button wx:if="{{!hasReport}}" bindtap="saveLineup" disabled="{{submitting}}">保存首发</button></view>
        <view class="actions"><button wx:if="{{canStart}}" class="primary" bindtap="startMatch" disabled="{{submitting}}">开始比赛</button><button wx:if="{{canRecord}}" bindtap="openEvent" disabled="{{submitting}}">添加事件</button><button wx:if="{{canFinish}}" class="primary" bindtap="finishMatch" disabled="{{submitting}}">结束比赛</button></view>
        <view wx:if="{{showEvent}}" class="form"><text class="section-title">比赛事件</text><text class="label">事件类型</text><picker range="{{eventTypes}}" range-key="text" value="{{eventTypeIndex}}" bindchange="onEventType"><view class="input">{{eventTypeLabel}}</view></picker><text class="label">事件球员 / 换上球员</text><picker range="{{playerOptions}}" range-key="label" value="{{eventPlayerIndex}}" bindchange="onEventPlayer"><view class="input">{{eventPlayerLabel}}</view></picker><picker wx:if="{{isSubstitution}}" range="{{outOptions}}" range-key="label" value="{{eventOutIndex}}" bindchange="onEventOut"><view class="input">{{eventOutLabel}}</view></picker><text class="label">比赛分钟</text><input value="{{minute}}" type="number" bindinput="onMinute"/><button class="primary" bindtap="saveEvent" disabled="{{submitting}}">保存事件</button></view>
        <view wx:if="{{canStart}}" class="form"><text class="section-title">裁判表识别</text><button bindtap="uploadReport" loading="{{submitting}}" disabled="{{submitting}}">拍照或上传裁判表</button></view>
        <view wx:if="{{hasReport}}" class="form">
          <text class="section-title">核对识别结果</text><view class="back" bindtap="cancelReport">取消本次识别</view><view class="back" bindtap="previewReport">查看原图</view><text wx:for="{{warnings}}" wx:key="*this" class="warning">{{item}}</text>
          <view wx:for="{{recognizedPlayers}}" wx:for-item="recognized" wx:key="key" class="player-row"><text>{{recognized.jerseyNumber}}号 {{recognized.name}}</text><text>{{recognized.roleLabel}} · 待核对</text></view><text class="label">主队比分</text><input value="{{homeScore}}" data-side="home" bindinput="scoreInput" type="number"/><text class="label">客队比分</text><input value="{{awayScore}}" data-side="away" bindinput="scoreInput" type="number"/>
          <text class="meta">请在上方首发名单中核对本场首发与替补。</text>
          <view wx:for="{{reportRows}}" wx:for-item="row" wx:key="index" class="report-row"><text class="meta">{{row.rawText}}</text><picker range="{{sideOptions}}" value="{{row.sideIndex}}" data-index="{{row.index}}" data-field="side" bindchange="reportChange"><view class="input">{{row.sideLabel}}</view></picker><picker range="{{eventTypes}}" range-key="text" value="{{row.typeIndex}}" data-index="{{row.index}}" data-field="type" bindchange="reportChange"><view class="input">{{row.typeLabel}}</view></picker><picker range="{{row.choices}}" range-key="label" value="{{row.playerIndex}}" data-index="{{row.index}}" data-field="playerId" bindchange="reportChange"><view class="input">{{row.playerLabel}}</view></picker><picker wx:if="{{row.isSubstitution}}" range="{{row.choices}}" range-key="label" value="{{row.outIndex}}" data-index="{{row.index}}" data-field="outPlayerId" bindchange="reportChange"><view class="input">{{row.outLabel}}</view></picker><input value="{{row.minute}}" type="number" placeholder="比赛分钟" data-index="{{row.index}}" data-field="minute" bindinput="reportChange"/><button size="mini" data-index="{{row.index}}" bindtap="removeReportRow">移除误识别行</button></view>
          <button bindtap="addReportRow">补充事件</button><view class="raw-lines"><text wx:for="{{rawLines}}" wx:key="index">{{item}}</text></view><button class="primary" bindtap="confirmReport" disabled="{{submitting}}" loading="{{submitting}}">核对并确认</button>
        </view>
      </block>
      <view class="events" wx:if="{{item.hasEvents}}"><text class="section-title">已保存事件</text><view wx:for="{{item.events}}" wx:for-item="entry" wx:key="id" class="player-row"><text>{{entry.minute}}′ {{entry.typeText}}</text><text>{{entry.playerName}} {{entry.outPlayerName}}</text></view></view>
      <view wx:if="{{isResults}}" class="form"><text class="section-title">裁判记录</text><text>{{item.report}}</text><text class="meta">{{item.reviewStatus}}</text><view wx:if="{{item.canReview}}"><text class="label">退回原因</text><textarea value="{{reason}}" bindinput="onReason" maxlength="300"/><view class="actions"><button data-decision="return" bindtap="reviewResult" disabled="{{submitting}}">退回修正</button><button class="primary" data-decision="archive" bindtap="reviewResult" disabled="{{submitting}}">确认并归档</button></view></view></view>
    </block>
  </block>
</view>
