.page{padding:28rpx;background:#f5f8f6;min-height:100vh;box-sizing:border-box;color:#203629;font-size:28rpx}.title{display:block;font-size:36rpx;font-weight:600;margin:24rpx 0}.name{display:block;font-weight:600;font-size:30rpx}.meta{display:block;font-size:25rpx;color:#65746b;margin-top:10rpx;line-height:1.5}.list-row{border-bottom:1rpx solid #dce6df;padding:26rpx 0}.row-main{display:flex;align-items:center;gap:20rpx}.row-copy{flex:1;min-width:0}.status,.score{display:block;text-align:right;font-size:25rpx}.logo{width:76rpx;height:76rpx;flex-shrink:0}.form,.events,.details{margin-top:28rpx;border-top:1rpx solid #dce6df;padding-top:24rpx}.section-title{display:block;font-weight:600;font-size:30rpx;margin-bottom:22rpx}.label{display:block;margin:24rpx 0 12rpx;color:#52635a}.details view,.player-row{display:flex;align-items:center;justify-content:space-between;padding:18rpx 0;border-bottom:1rpx solid #e5ece7;gap:14rpx}.details text{word-break:break-all}.actions{display:flex;flex-wrap:wrap;gap:16rpx;margin-top:24rpx}.actions button{flex:1;min-width:150rpx;margin:0}.ref-actions{display:flex;align-items:center;gap:14rpx;padding-top:18rpx}.ref-actions button{margin:0}button{font-size:27rpx;border-radius:8rpx;margin-top:22rpx;background:#fff;color:#087b3d}button.primary{background:#087b3d;color:#fff}input,.input,textarea{background:#fff;border:1rpx solid #dce6df;padding:18rpx;border-radius:6rpx;box-sizing:border-box;font-size:28rpx;min-height:78rpx;width:100%}textarea{min-height:150rpx}.input{margin-top:12rpx}.back{color:#087b3d;margin:16rpx 0}.state{text-align:center;padding:60rpx 10rpx;line-height:1.6}.state text{display:block}.invite{display:flex;flex-direction:column;align-items:center;padding:28rpx 0}.invite image{width:340rpx;height:340rpx}.invite text{font-size:25rpx;color:#65746b}.report-row{padding:24rpx 0;border-bottom:1rpx solid #dce6df}.warning{display:block;font-size:25rpx;color:#966115;margin-bottom:14rpx}.raw-lines{margin:24rpx 0;max-height:340rpx;overflow:auto}.raw-lines text{display:block;font-size:24rpx;color:#65746b;line-height:1.7}

.data-warning{padding:18rpx 20rpx;margin:8rpx 0;background:#fff7e8;color:#88601b;font-size:24rpx;line-height:1.6;border-radius:6rpx}

.match-filters{padding-bottom:16rpx}.status-tabs{display:flex;border-bottom:1rpx solid #dce6df;gap:10rpx}.status-tab{flex:1;min-width:0;display:flex;flex-direction:column;align-items:center;gap:8rpx;padding:18rpx 0 16rpx;font-size:25rpx;color:#64756a;border-bottom:4rpx solid transparent;white-space:nowrap}.status-tab.active{color:#087b3d;border-bottom-color:#087b3d;font-weight:600}.tab-count{font-size:22rpx;font-weight:400}.filter-line{display:flex;align-items:center;gap:18rpx;margin:20rpx 0}.filter-line picker{min-width:0;flex:1;font-size:25rpx;color:#405c4b;overflow:hidden}.filter-line picker view{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding:12rpx 0}.filter-line button{margin:0;padding:0 12rpx;font-size:24rpx;line-height:56rpx;background:transparent;flex-shrink:0}.filter-line button::after{border:0}.match-search{min-height:72rpx;padding:14rpx 18rpx;font-size:26rpx}.match-list-head,.match-list-foot{display:flex;justify-content:space-between;align-items:flex-start;gap:20rpx;font-size:23rpx;color:#66796d;line-height:1.5}.match-list-head>text:first-child{flex:1;min-width:0}.match-list-status{flex-shrink:0;color:#53685a}.match-state-live{color:#087b3d}.match-list-sides{display:flex;align-items:center;gap:20rpx;margin:22rpx 0}.team-name{flex:1;min-width:0;font-size:28rpx;font-weight:500;line-height:1.45;word-break:break-all}.team-name.away{text-align:right}.match-list-score{font-size:32rpx;font-weight:600;white-space:nowrap}.match-list-action{color:#087b3d;white-space:nowrap}.match-list-item{width:100%}
.match-sheet-mask{position:fixed;inset:0;background:#0009;z-index:1200;display:flex;align-items:flex-end}.match-sheet{box-sizing:border-box;width:100%;padding:24rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));border-radius:12rpx 12rpx 0 0;background:#f5f8f6;max-height:85vh}.sheet-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:20rpx;font-size:30rpx;font-weight:600}.sheet-heading text:last-child{font-size:25rpx;font-weight:400;color:#087b3d}.event-sheet{height:78vh}.match-sheet .input,.match-sheet input{box-sizing:border-box;padding:16rpx;background:#fff;border:1rpx solid #d8e3dc;border-radius:4rpx;min-height:72rpx}.match-sheet button{margin-top:24rpx}
