/* pages/tournament/rules/rules.wxss */

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.form-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.form-tips {
  font-size: 22rpx;
  color: #999;
}

.divider {
  height: 2rpx;
  background: #e8e8e8;
  margin: 30rpx 0;
}

/* AI识别区域 */
.ai-section {
  background: linear-gradient(135deg, #e6f7ff, #bae7ff);
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.ai-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1890ff;
  margin-bottom: 10rpx;
}

.ai-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.ai-btn {
  background: linear-gradient(135deg, #1890ff, #096dd9) !important;
  color: #fff !important;
  border: none !important;
  border-radius: 8rpx !important;
  font-size: 28rpx !important;
}

.ai-tips {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #1890ff;
}

/* 文本域大尺寸 */
.form-textarea.large {
  min-height: 400rpx;
}

/* 按钮组 */
.btn-group {
  display: flex;
  gap: 20rpx;
  padding: 30rpx 0;
}

.btn-group button {
  flex: 1;
  margin: 0;
}
