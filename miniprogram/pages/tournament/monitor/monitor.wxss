.page{min-height:100vh;background:#f4f7f5}.hero{min-height:540rpx;padding:70rpx 34rpx 0;background-image:linear-gradient(180deg,rgba(0,20,14,.9),rgba(0,78,49,.9)),url('/images/runtime/stadium-tech-bg.jpg');background-size:cover}.nav{height:76rpx;position:relative;text-align:center}.back{position:absolute;left:0;color:#fff;font-size:68rpx;line-height:50rpx}.title{color:#fff;font-size:39rpx;font-weight:700}.score-card{margin-top:40rpx;padding:27rpx;border:2rpx solid #1fa76d;border-radius:30rpx;background:rgba(0,65,41,.86);color:#fff}.score-top,.score-row,.state-row,.support{display:flex;align-items:center;justify-content:space-between}.live-tag{padding:9rpx 15rpx;border-radius:20rpx;background:#087b4d}.score-row{margin-top:36rpx}.team{width:175rpx;text-align:center;font-size:23rpx}.team image{display:block;width:78rpx;height:78rpx;margin:0 auto 10rpx}.score{font-size:62rpx;font-weight:700}.readonly{display:block;margin-top:25rpx;padding-top:18rpx;border-top:1rpx solid rgba(255,255,255,.2);color:#c6e5d2;font-size:21rpx}.content{margin-top:-8rpx;padding:0 34rpx 110rpx}.loading,.error,.denied{padding:90rpx 0;text-align:center;color:#849088}.error{color:#bc5146}.panel{margin-top:21rpx;padding:25rpx;border-radius:23rpx;background:#fff;box-shadow:0 8rpx 24rpx rgba(15,55,36,.07)}.panel-title{padding-left:15rpx;border-left:7rpx solid #128055;font-size:29rpx;font-weight:700}.state-row{margin-top:26rpx}.state-row view{flex:1;text-align:center;border-right:1rpx solid #e5ebe7}.state-row view:last-child{border:0}.state-row text,.state-row strong{display:block}.state-row text{color:#839088;font-size:20rpx}.state-row strong{margin-top:9rpx;color:#244436;font-size:24rpx}.event{display:flex;align-items:center;gap:12rpx;padding:21rpx 0;border-bottom:1rpx solid #edf0ee;font-size:22rpx}.minute{width:58rpx;font-size:27rpx;font-weight:700}.event-type{padding:5rpx 9rpx;border:1rpx solid #a9dbc0;border-radius:8rpx;color:#197451}.event-player{flex:1;color:#526b5d}.empty{padding:45rpx 0;text-align:center;color:#839088}.normal{margin-top:22rpx;padding:22rpx;border:1rpx solid #a7dbc0;border-radius:16rpx;background:#f0faf4;color:#197451;font-size:28rpx;font-weight:700;text-align:center}.support{gap:12rpx;margin-top:22rpx}.support button{flex:1;padding:0 10rpx;background:#eef6f1;color:#197451;font-size:21rpx}.support .warn{background:#fff1e8;color:#b76137}
.page{padding-top:0}.hero{padding-top:0}.nav{height:208rpx;box-sizing:border-box;align-items:flex-end;padding-bottom:28rpx}.back{bottom:16rpx}
