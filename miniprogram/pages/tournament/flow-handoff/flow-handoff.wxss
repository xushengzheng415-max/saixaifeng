.page{min-height:100vh;position:relative;background:#06261a;color:#1b3025}.bg{position:absolute;inset:0;width:100%;height:100%;opacity:.72}.content{position:relative;z-index:1;padding:0 42rpx 90rpx}.nav{position:relative;box-sizing:border-box;height:208rpx;padding-top:106rpx;display:flex;align-items:center;justify-content:center;color:#fff}.back{position:absolute;left:0;top:91rpx;font-size:68rpx;line-height:72rpx}.title{font-size:39rpx;font-weight:700}.hero{padding:38rpx 34rpx;border-radius:28rpx;background:linear-gradient(145deg,rgba(10,138,68,.94),rgba(5,73,40,.94));color:#fff}.eyebrow,.hero-title,.hero-desc{display:block}.eyebrow{font-size:22rpx;opacity:.72}.hero-title{margin-top:14rpx;font-size:39rpx;font-weight:700}.hero-desc{margin-top:13rpx;font-size:25rpx;line-height:1.6;opacity:.9}.steps{margin-top:25rpx}.step{display:flex;gap:20rpx;padding:28rpx;margin-bottom:16rpx;border-radius:24rpx;background:#fff}.index{display:flex;align-items:center;justify-content:center;flex:0 0 64rpx;height:64rpx;border-radius:50%;background:#e9f6ed;color:#088544;font-size:27rpx;font-weight:700}.step-body{flex:1}.role,.step-title,.step-desc,.action{display:block}.role{color:#0b9249;font-size:21rpx}.step-title{margin-top:7rpx;font-size:30rpx;font-weight:700}.step-desc{margin-top:9rpx;color:#6a786f;font-size:23rpx;line-height:1.55}.action{margin-top:15rpx;color:#088b47;font-size:23rpx;font-weight:600}.boundary{padding:29rpx;border-radius:23rpx;background:#f0faf3;color:#5f6f65;font-size:23rpx;line-height:1.65}.boundary-title{display:block;margin-bottom:8rpx;color:#108648;font-size:28rpx;font-weight:700}.primary{width:100%;height:92rpx;line-height:92rpx;margin-top:28rpx;border-radius:16rpx;background:#0b9848;color:#fff;font-size:30rpx}
