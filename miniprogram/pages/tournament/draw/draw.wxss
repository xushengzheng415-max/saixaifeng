.page { padding: 0; background: #f5f5f5; min-height:100vh; }
.loading-box { display:flex; flex-direction:column; align-items:center; padding:100rpx 0; color:#999; }
.header { background: linear-gradient(135deg, #1B5E20, #43A047); padding: 30rpx 24rpx; color:#fff; }
.h-title { font-size: 36rpx; font-weight: 700; display: block; }
.h-row { display:flex; align-items:center; gap:16rpx; margin-top:8rpx; }
.h-tag { background:rgba(255,255,255,0.25); padding:4rpx 12rpx; border-radius:8rpx; font-size:22rpx; }
.h-count { font-size:22rpx; opacity:0.85; }
.empty { display:flex; flex-direction:column; align-items:center; padding:120rpx 0; }
.empty-icon { font-size:72rpx; }
.empty-text { font-size:30rpx; color:#666; margin-top:20rpx; }
.empty-desc { font-size:24rpx; color:#999; margin-top:8rpx; }
.draw-section { padding: 24rpx; background:#fff; margin:20rpx 24rpx; border-radius:16rpx; }
.section-title { font-size:30rpx; font-weight:700; color:#333; margin-bottom:20rpx; padding-bottom:16rpx; border-bottom:1rpx solid #f0f0f0; }
.group-box { margin-bottom:20rpx; }
.gb-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:12rpx; }
.gb-name { font-size:28rpx; font-weight:600; color:#1B5E20; }
.gb-count { font-size:24rpx; color:#999; }
.gb-teams { display:flex; flex-wrap:wrap; gap:12rpx; }
.gb-team { background:#E8F5E9; color:#1B5E20; font-size:26rpx; padding:8rpx 20rpx; border-radius:20rpx; }
.cup-rows { display:flex; align-items:center; gap:16rpx; }
.cup-half { flex:1; display:flex; flex-direction:column; gap:8rpx; }
.cup-label { font-size:26rpx; font-weight:600; color:#333; margin-bottom:4rpx; }
.cup-team { font-size:24rpx; color:#666; padding:6rpx 0; }
.cup-divider { display:flex; align-items:center; gap:8rpx; flex-shrink:0; }
.cup-line { width:1rpx; height:80rpx; background:#ddd; }
.cup-divider text { font-size:30rpx; font-weight:700; color:#1B5E20; }
.info-row { display:flex; justify-content:space-between; padding:16rpx 0; }
.info-label { font-size:26rpx; color:#999; }
.info-value { font-size:26rpx; font-weight:500; color:#333; }
