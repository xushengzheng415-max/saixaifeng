<view class="page">
  <image class="schedule-bg" src="/images/runtime/team-data-emerald-stadium-v1.jpg" mode="aspectFill" />
  <view class="schedule-nav"><text class="schedule-back" bindtap="back">‹</text><text>赛程赛果</text></view>
  <view class="loading-box" wx:if="{{loading}}"><text>正在加载赛事赛程…</text></view>
  <view class="loading-box" wx:if="{{showError}}"><text>{{errorMsg}}</text><text bindtap="loadData">点击重试</text></view>
  <block wx:if="{{showContent}}">
    <view class="header"><text class="h-title">{{tournamentName}}</text><view class="h-row"><text wx:if="{{typeText}}" class="h-tag">{{typeText}}</text><text wx:if="{{formatText}}" class="h-tag2">{{formatText}}</text><text wx:if="{{teamOnly}}" class="h-count">{{scopeCountText}}</text><text wx:else class="h-count">{{teamsLen}} 队</text></view><text wx:if="{{teamOnly}}" class="scope-team">{{scopeText}}</text></view>
    <view class="tab-bar"><view class="tab-item {{scheduleTabClass}}" data-tab="schedule" bindtap="switchTab">赛程</view><view class="tab-item {{resultsTabClass}}" data-tab="results" bindtap="switchTab">赛果</view><view class="tab-item {{standingsTabClass}}" data-tab="standings" bindtap="switchTab">排名</view></view>
    <view wx:if="{{isScheduleTab}}" class="schedule-content">
      <view class="empty-inner" wx:if="{{hasNoMatches}}"><image src="/images/runtime/icons/brand-v2-01.png" mode="aspectFit"/><text class="ei-text">暂无赛程安排</text></view>
      <view wx:for="{{groupedMatches}}" wx:key="round" class="round-group"><text class="round-title">{{item.round}}</text><view wx:for="{{item.matches}}" wx:for-item="m" wx:key="_id" class="match-card" data-id="{{m._id}}" data-finished="{{m.isFinished}}" bindtap="onMatchTap"><view class="match-top"><text>{{m.matchTimeText}}</text><text>{{m.statusText}}</text></view><view class="match-sides"><view class="match-team"><view class="mc-logo-chip"><text>{{m.homeFirstChar}}</text></view><text>{{m.homeTeamName}}</text></view><view class="match-score"><text>{{m.homeDisplayScore}} : {{m.awayDisplayScore}}</text><text>{{m.round}}</text></view><view class="match-team"><view class="mc-logo-chip"><text>{{m.awayFirstChar}}</text></view><text>{{m.awayTeamName}}</text></view></view><view class="match-action"><image src="/images/runtime/icons/brand-v2-01.png" mode="aspectFit"/><text>{{m.actionText}}</text><text>›</text></view></view></view>
    </view>
    <view wx:if="{{isResultsTab}}" class="schedule-content"><view wx:if="{{!hasResults}}" class="empty-inner"><image src="/images/runtime/icons/brand-v2-09.png" mode="aspectFit"/><text class="ei-text">暂无已结束比赛</text></view><view wx:for="{{resultMatches}}" wx:key="_id" class="match-card" data-id="{{item._id}}" data-finished="{{item.isFinished}}" bindtap="onMatchTap"><view class="match-top"><text>{{item.matchTimeText}}</text><text>已结束</text></view><view class="match-sides"><view class="match-team"><view class="mc-logo-chip"><text>{{item.homeFirstChar}}</text></view><text>{{item.homeTeamName}}</text></view><view class="match-score"><text>{{item.homeDisplayScore}} : {{item.awayDisplayScore}}</text></view><view class="match-team"><view class="mc-logo-chip"><text>{{item.awayFirstChar}}</text></view><text>{{item.awayTeamName}}</text></view></view><view class="match-action"><image src="/images/runtime/icons/brand-v2-09.png" mode="aspectFit"/><text>查看比赛详情</text><text>›</text></view></view></view>
    <view wx:if="{{isStandingsTab}}" class="schedule-standings">
      <block wx:if="{{showTeamStandings}}"><view class="standings-panel" wx:for="{{teamStandingsGroups}}" wx:for-item="group" wx:key="name"><text class="standings-title">{{group.name}}</text><view class="standings-row standings-head"><text>名次</text><text>球队</text><text>赛</text><text>胜/平/负</text><text>分</text></view><view class="standings-row {{row.rowClass}}" wx:for="{{group.rows}}" wx:for-item="row" wx:key="teamId"><text>{{row.rankText}}</text><text>{{row.teamName}}</text><text>{{row.playedText}}</text><text>{{row.recordText}}</text><text>{{row.pointsText}}</text></view></view></block>
      <view wx:elif="{{teamStandingsFailed}}" class="tab-placeholder"><text>本组排名读取失败</text><button bindtap="loadData">重新加载</button></view>
      <view wx:else class="tab-placeholder"><image src="/images/runtime/icons/brand-v2-02.png" mode="aspectFit"/><text>暂未生成排名</text></view>
    </view>
  </block>
</view>
