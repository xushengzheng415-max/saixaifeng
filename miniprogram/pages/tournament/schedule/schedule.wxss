.schedule-content{margin:0 28rpx!important;padding:18rpx 0 56rpx!important}.round-group{margin:12rpx 0 0!important}.round-title{display:block;padding:14rpx 6rpx 12rpx;font-size:28rpx!important}.match-card{display:block!important;min-height:0!important;margin-bottom:18rpx!important;padding:22rpx!important;border-radius:26rpx!important}.match-top{display:flex;justify-content:space-between;color:#68746d;font-size:22rpx}.match-top text:last-child{padding:6rpx 12rpx;border-radius:16rpx;background:#e8f4ec;color:#108251}.match-sides{display:flex;align-items:center;justify-content:space-between;margin-top:26rpx}.match-team{width:30%;display:flex;flex-direction:column;align-items:center;gap:10rpx;text-align:center;color:#19261e;font-size:23rpx;font-weight:700;line-height:1.3}.match-team .mc-logo-chip{width:74rpx!important;height:74rpx!important;background:#e8f5ec!important;font-size:27rpx!important}.match-team .mc-logo-chip text{line-height:74rpx!important}.match-score{width:30%;display:flex;flex-direction:column;align-items:center;color:#17251c}.match-score text:first-child{font-size:42rpx;font-weight:800;white-space:nowrap}.match-score text:last-child{margin-top:8rpx;color:#7b8680;font-size:20rpx}.match-action{display:flex;align-items:center;justify-content:center;gap:10rpx;height:66rpx;margin-top:24rpx;border-radius:16rpx;background:#edf7f0;color:#137b4e;font-size:25rpx;font-weight:700}.match-action image{width:36rpx;height:36rpx}.match-action text:last-child{position:absolute;right:54rpx;font-size:40rpx;font-weight:300}.empty-inner image,.tab-placeholder image{width:100rpx;height:100rpx}
