/* pages/tournament/schedule/schedule.wxss */
/* 赛程安排 - 全新简约Tab布局 - 单行卡片 */

.page { padding: 0; background: #f5f5f5; min-height: 100vh; }

.loading-box { display: flex; flex-direction: column; align-items: center; padding: 100rpx 0; color: #999; font-size: 28rpx; }

/* 头部 */
.header { background: linear-gradient(135deg, #1B5E20, #43A047); padding: 30rpx 24rpx; color: #fff; }
.h-title { font-size: 36rpx; font-weight: 700; display: block; }
.h-row { display: flex; align-items: center; gap: 12rpx; margin-top: 8rpx; }
.h-tag { background: rgba(255,255,255,0.25); padding: 4rpx 12rpx; border-radius: 8rpx; font-size: 22rpx; }
.h-tag2 { background: rgba(255,255,255,0.15); padding: 4rpx 12rpx; border-radius: 8rpx; font-size: 22rpx; }
.h-count { font-size: 22rpx; opacity: 0.85; margin-left: auto; }

/* ========== Tab 切换栏 ========== */
.tab-bar { display: flex; background: #fff; padding: 0 24rpx; border-bottom: 1rpx solid #eee; }
.tab-item { padding: 24rpx 20rpx; font-size: 28rpx; color: #666; position: relative; flex-shrink: 0; }
.tab-active { color: #1B5E20; font-weight: 600; }
.tab-active::after { content: ''; position: absolute; bottom: 0; left: 20rpx; right: 20rpx; height: 4rpx; background: #1B5E20; border-radius: 2rpx; }

/* ========== 赛程内容区 ========== */
.schedule-content { padding: 0 0 20rpx; }

/* 空态 */
.empty-inner { display: flex; flex-direction: column; align-items: center; padding: 80rpx 0; }
.ei-icon { font-size: 64rpx; }
.ei-text { font-size: 28rpx; color: #999; margin-top: 16rpx; }
.ei-desc { font-size: 24rpx; color: #bbb; margin-top: 8rpx; }

/* 轮次分组 */
.round-group { margin: 16rpx 16rpx 0; }
.round-header { padding: 16rpx 8rpx 12rpx; }
.round-title { font-size: 26rpx; font-weight: 700; color: #333; }

/* ========== 单行比赛卡片 ========== */
.match-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx 16rpx;
  margin-bottom: 10rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  gap: 8rpx;
}

/* 第1列：时间 - 固定宽度 */
.mc-time {
  width: 130rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  color: #888;
  text-align: left;
  line-height: 1.3;
}

/* 球队信息：主队左对齐，客队右对齐 */
.mc-team {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}
.mc-home { justify-content: flex-start; }
.mc-away { justify-content: flex-end; }

/* 队徽 */
.mc-logo {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #eee;
  flex-shrink: 0;
}
.mc-logo-chip {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #E8F5E9;
  color: #1B5E20;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.mc-logo-chip text { line-height: 44rpx; text-align: center; }

/* 队名 */
.mc-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #222;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 130rpx;
}
.mc-winner { color: #1B5E20; font-weight: 700; }

/* 比分区域 - 固定宽度居中 */
.mc-score-wrap {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  width: 100rpx;
  flex-shrink: 0;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
}
.sc-pending { background: #f5f5f5; }
.sc-done { background: #E8F5E9; }

.mc-score { font-size: 28rpx; font-weight: 700; color: #333; text-align: center; }
.mc-colon { font-size: 22rpx; color: #999; }
.sc-done .mc-score { color: #1B5E20; }

/* Tab二次内容占位 */
.tab-placeholder { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; color: #ccc; }
