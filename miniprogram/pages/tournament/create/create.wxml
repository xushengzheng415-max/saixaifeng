<!--pages/tournament/create/create.wxml-->
<!-- ★ 同步网页版：4 步 → 基础信息 / 积分规则 / 换人规则 / 停赛规则 -->
<view class="container">
  <!-- 步骤条 -->
  <view class="steps">
    <view class="step-item {{step1Active}}">
      <view class="step-number">1</view>
      <text class="step-title">基础信息</text>
    </view>
    <view class="step-item {{step2Active}}">
      <view class="step-number">2</view>
      <text class="step-title">积分规则</text>
    </view>
    <view class="step-item {{step3Active}}">
      <view class="step-number">3</view>
      <text class="step-title">换人规则</text>
    </view>
    <view class="step-item {{step4Active}}">
      <view class="step-number">4</view>
      <text class="step-title">停赛规则</text>
    </view>
  </view>
  <!-- Step 1: 基础信息 -->
  <view class="card" wx:if="{{isStep1}}">
    <view class="card-title">基础信息</view>

    <!-- 选择赛制 -->
    <view class="form-group">
      <text class="form-label">选择赛制 *</text>
      <picker bindchange="onTypeSelect" value="{{typeIndex}}" range="{{typeLabels}}">
        <view class="form-input picker-input">{{selectedTypeLabel}}</view>
      </picker>
      <view class="type-desc">{{selectedTypeDesc}}</view>
    </view>

    <!-- 赛事类型 -->
    <view class="form-group">
      <text class="form-label">赛事类型 *</text>
      <picker bindchange="onCategorySelect" value="{{categoryIdx}}" range="{{categoryLabels}}">
        <view class="form-input picker-input">{{selectedCategoryLabel}}</view>
      </picker>
      <view class="type-desc">{{categoryLabels[categoryIdx]}}赛事</view>
    </view>

    <view class="form-group">
      <text class="form-label">赛事名称 *</text>
      <input class="form-input" placeholder="请输入赛事名称" value="{{form.name}}" bindinput="onInput" data-field="name" />
    </view>

    <!-- 时间类型 -->
    <view class="form-group">
      <text class="form-label">时间类型</text>
      <picker bindchange="onPicker" data-field="timeType" value="{{timeTypeIdx}}" range="{{timeTypes}}">
        <view class="form-input picker-input">{{selectedTimeType}}</view>
      </picker>
    </view>

    <view wx:if="{{showHalf}}">
      <view class="form-group">
        <text class="form-label">半场时长</text>
        <picker bindchange="onPicker" data-field="halfDur" value="{{halfDurIdx}}" range="{{halfDurations}}">
          <view class="form-input picker-input">{{selectedHalfDuration}}</view>
        </picker>
      </view>
      <view class="form-group">
        <text class="form-label">中场休息（分钟）</text>
        <input class="form-input" type="number" placeholder="如：15" value="{{form.halfTimeBreak}}" bindinput="onInput" data-field="halfTimeBreak" />
      </view>
    </view>

    <view wx:if="{{showQuarter}}">
      <view class="form-group">
        <text class="form-label">每节时长</text>
        <picker bindchange="onPicker" data-field="qDur" value="{{qDurIdx}}" range="{{quarterDurations}}">
          <view class="form-input picker-input">{{selectedQuarterDuration}}</view>
        </picker>
      </view>
      <view class="form-group">
        <text class="form-label">节数</text>
        <picker bindchange="onPicker" data-field="qCount" value="{{qCountIdx}}" range="{{qCountOptions}}">
          <view class="form-input picker-input">{{selectedQCount}}</view>
        </picker>
      </view>
      <view class="form-group">
        <text class="form-label">节间休息（分钟）</text>
        <input class="form-input" type="number" placeholder="如：5" value="{{form.quarterBreak}}" bindinput="onInput" data-field="quarterBreak" />
      </view>
    </view>

    <view class="form-group">
      <text class="form-label">比赛地点</text>
      <input class="form-input" placeholder="请输入比赛地点" value="{{form.location}}" bindinput="onInput" data-field="location" />
    </view>

    <view class="form-group">
      <text class="form-label">冠名商</text>
      <input class="form-input" placeholder="冠名赞助商（选填）" value="{{form.titleSponsor}}" bindinput="onInput" data-field="titleSponsor" />
    </view>

    <view class="form-group">
      <text class="form-label">赛事色调</text>
      <picker bindchange="onThemePick" value="{{themeIdx}}" range="{{themeNames}}">
        <view class="form-input picker-input">{{selectedThemeName}}</view>
      </picker>
      <view class="theme-preview" style="background: {{themeGradient}}; height: 24px; border-radius: 4px; margin-top: 6px;"></view>
    </view>

    <view class="form-group">
      <text class="form-label">报名截止日</text>
      <picker mode="date" value="{{form.deadline}}" bindchange="onDate" data-field="deadline">
        <view class="form-input picker-input">{{deadlineText}}</view>
      </picker>
    </view>

    <view class="form-group">
      <text class="form-label">开始日期</text>
      <picker mode="date" value="{{form.startDate}}" bindchange="onDate" data-field="startDate">
        <view class="form-input picker-input">{{startDateText}}</view>
      </picker>
    </view>

    <view class="form-group">
      <text class="form-label">结束日期</text>
      <picker mode="date" value="{{form.endDate}}" bindchange="onDate" data-field="endDate">
        <view class="form-input picker-input">{{endDateText}}</view>
      </picker>
    </view>

    <view class="form-group">
      <text class="form-label">最大球队数</text>
      <input class="form-input" type="number" placeholder="如：32" value="{{form.maxTeams}}" bindinput="onInput" data-field="maxTeams" />
    </view>

    <view class="form-group">
      <text class="form-label">每队参赛人数</text>
      <input class="form-input" type="number" placeholder="如：15" value="{{form.maxPlayers}}" bindinput="onInput" data-field="maxPlayers" />
    </view>

    <view class="form-group">
      <text class="form-label">赛事说明</text>
      <textarea class="form-textarea" placeholder="请输入赛事说明" value="{{form.description}}" bindinput="onInput" data-field="description" />
    </view>
  </view>

  <!-- Step 2: 积分规则 -->
  <view class="card" wx:if="{{isStep2}}">
    <view class="card-title">积分规则</view>

    <view class="form-group">
      <text class="form-label">胜场得分</text>
      <input class="form-input" type="number" placeholder="默认 3" value="{{form.pointsWin}}" bindinput="onInput" data-field="pointsWin" />
    </view>
    <view class="form-group">
      <text class="form-label">平局得分</text>
      <input class="form-input" type="number" placeholder="默认 1" value="{{form.pointsDraw}}" bindinput="onInput" data-field="pointsDraw" />
    </view>
    <view class="form-group">
      <text class="form-label">负场得分</text>
      <input class="form-input" type="number" placeholder="默认 0" value="{{form.pointsLoss}}" bindinput="onInput" data-field="pointsLoss" />
    </view>
    <view class="form-group">
      <text class="form-label">弃权得分</text>
      <input class="form-input" type="number" placeholder="默认 -1" value="{{form.pointsForfeit}}" bindinput="onInput" data-field="pointsForfeit" />
    </view>

    <view class="form-group form-switch">
      <text class="form-label">启用进球加分</text>
      <switch checked="{{form.goalBonusEnabled}}" bindchange="onSwitch" data-field="goalBonusEnabled" />
    </view>
    <view class="form-group form-switch">
      <text class="form-label">启用红黄牌扣分</text>
      <switch checked="{{form.cardDeductionEnabled}}" bindchange="onSwitch" data-field="cardDeductionEnabled" />
    </view>

    <view wx:if="{{form.cardDeductionEnabled}}">
      <view class="form-group">
        <text class="form-label">黄牌扣分数</text>
        <input class="form-input" type="number" placeholder="默认 1" value="{{form.yellowCardDeduction}}" bindinput="onInput" data-field="yellowCardDeduction" />
      </view>
      <view class="form-group">
        <text class="form-label">红牌扣分数</text>
        <input class="form-input" type="number" placeholder="默认 3" value="{{form.redCardDeduction}}" bindinput="onInput" data-field="redCardDeduction" />
      </view>
    </view>
  </view>

  <!-- Step 3: 换人规则 -->
  <view class="card" wx:if="{{isStep3}}">
    <view class="card-title">换人规则</view>

    <view class="form-group">
      <text class="form-label">最大换人次数</text>
      <input class="form-input" type="number" placeholder="如：5" value="{{form.maxSubstitutions}}" bindinput="onInput" data-field="maxSubstitutions" />
    </view>
    <view class="form-group form-switch">
      <text class="form-label">是否允许换回</text>
      <switch checked="{{form.allowSubBack}}" bindchange="onSwitch" data-field="allowSubBack" />
    </view>
    <view class="form-group">
      <text class="form-label">中场休息可额外换人</text>
      <picker bindchange="onExtraSubPick" value="{{extraSubIdx}}" range="{{extraSubOptions}}">
        <view class="form-input picker-input">{{selectedExtraSub}}</view>
      </picker>
    </view>
  </view>

  <!-- Step 4: 停赛规则 -->
  <view class="card" wx:if="{{isStep4}}">
    <view class="card-title">停赛规则</view>

    <view class="form-group">
      <text class="form-label">累计黄牌数量</text>
      <input class="form-input" type="number" placeholder="默认 3" value="{{form.accumulatedYellowCards}}" bindinput="onInput" data-field="accumulatedYellowCards" />
    </view>
    <view class="form-group">
      <text class="form-label">停赛场次</text>
      <input class="form-input" type="number" placeholder="默认 1" value="{{form.suspensionMatches}}" bindinput="onInput" data-field="suspensionMatches" />
    </view>
    <view class="form-group">
      <text class="form-label">直接红牌停赛场次</text>
      <input class="form-input" type="number" placeholder="默认 2" value="{{form.directRedCardSuspension}}" bindinput="onInput" data-field="directRedCardSuspension" />
    </view>
    <view class="form-group">
      <text class="form-label">两黄变红停赛场次</text>
      <input class="form-input" type="number" placeholder="默认 1" value="{{form.twoYellowToRedSuspension}}" bindinput="onInput" data-field="twoYellowToRedSuspension" />
    </view>

    <view class="form-group form-switch">
      <text class="form-label">红牌是否带入下阶段</text>
      <switch checked="{{form.redCardCarryOver}}" bindchange="onSwitch" data-field="redCardCarryOver" />
    </view>
    <view class="form-group form-switch">
      <text class="form-label">黄牌是否带入下阶段</text>
      <switch checked="{{form.yellowCardCarryOver}}" bindchange="onSwitch" data-field="yellowCardCarryOver" />
    </view>
    <view class="form-group form-switch">
      <text class="form-label">小组赛红黄牌是否带入淘汰赛</text>
      <switch checked="{{form.groupStageCardCarryOver}}" bindchange="onSwitch" data-field="groupStageCardCarryOver" />
    </view>
  </view>

  <!-- 步骤按钮 -->
  <view class="step-buttons">
    <button class="btn-secondary" wx:if="{{canPrev}}" bindtap="prevStep">上一步</button>
    <button class="btn-primary" wx:if="{{canNext}}" bindtap="nextStep">下一步</button>
    <button class="btn-primary" wx:if="{{canSubmit}}" bindtap="submit">创建赛事</button>
  </view>
</view>