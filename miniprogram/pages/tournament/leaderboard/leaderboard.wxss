.page{min-height:100vh;padding:calc(88rpx + env(safe-area-inset-top)) 28rpx 60rpx;box-sizing:border-box;background:#f4f7f5;color:#18271f}.nav{height:72rpx;display:grid;grid-template-columns:120rpx 1fr 120rpx;align-items:center}.nav text:first-child{color:#1b2b22;font-size:27rpx;font-weight:700}.nav text:nth-child(2){font-size:34rpx;font-weight:800;text-align:center}.section{margin-top:28rpx}.section-title{display:flex;align-items:baseline;justify-content:space-between;margin:0 8rpx 14rpx}.section-title text:first-child{font-size:32rpx;font-weight:800}.section-title text:last-child{color:#718078;font-size:22rpx}.table,.list{overflow:hidden;border-radius:18rpx;background:#fff}.table-head,.table-row{display:grid;grid-template-columns:72rpx 1fr 90rpx 90rpx;align-items:center;min-height:76rpx;padding:0 20rpx;border-bottom:1rpx solid #ebefec;box-sizing:border-box}.table-head{min-height:64rpx;color:#78857e;font-size:21rpx;background:#f8faf8}.table-row text:first-child,.list-row text:first-child{color:#16864d;font-weight:800}.table-row text:nth-child(2){overflow:hidden;font-size:25rpx;text-overflow:ellipsis;white-space:nowrap}.table-row text:nth-child(n+3){color:#4f5d55;font-size:23rpx;text-align:right}.list-row{display:grid;grid-template-columns:72rpx 1fr auto;align-items:center;min-height:76rpx;padding:0 20rpx;border-bottom:1rpx solid #ebefec}.list-row:last-child,.table-row:last-child{border-bottom:0}.list-row text:nth-child(2){font-size:25rpx}.list-row text:last-child{color:#587168;font-size:22rpx}.empty,.state{padding:48rpx 24rpx;border-radius:18rpx;background:#fff;color:#7d8982;font-size:25rpx;text-align:center}.state{margin-top:120rpx}.state.error{color:#b34b43}
