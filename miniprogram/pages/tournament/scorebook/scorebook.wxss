.page { min-height: 100vh; background: #f4f7f4; padding-bottom: 60rpx; }
.tip { padding: 120rpx 32rpx; text-align: center; color: #8a9a90; font-size: 28rpx; }
.hero { background: linear-gradient(160deg, #0f3d22, #1B5E20); color: #fff; padding: 48rpx 32rpx 40rpx; }
.hero-brand { display: block; font-size: 22rpx; letter-spacing: 6rpx; opacity: 0.75; }
.hero-title { display: block; margin-top: 18rpx; font-size: 44rpx; font-weight: 700; line-height: 1.35; }
.hero-meta { display: flex; align-items: center; gap: 12rpx; margin-top: 16rpx; font-size: 24rpx; opacity: 0.85; }
.dot { opacity: 0.6; }
.hero-tag { display: inline-block; margin-top: 22rpx; padding: 8rpx 22rpx; border-radius: 30rpx; font-size: 22rpx; }
.hero-tag.ok { background: rgba(255, 255, 255, 0.2); }
.hero-tag.pending { background: rgba(255, 196, 0, 0.22); color: #ffe08a; }
.hero-note { display: block; margin-top: 12rpx; font-size: 21rpx; opacity: 0.72; }
.card { margin: 24rpx 24rpx 0; padding: 24rpx; background: #fff; border-radius: 14rpx; box-shadow: 0 2rpx 12rpx rgba(15, 61, 34, 0.05); }
.card-head { display: flex; align-items: baseline; justify-content: space-between; border-bottom: 1rpx solid #eef1ee; padding-bottom: 16rpx; }
.card-title { font-size: 30rpx; font-weight: 700; color: #0f3d22; }
.card-sub { font-size: 22rpx; color: #8a9a90; }
.team-line { display: flex; gap: 14rpx; margin-top: 18rpx; }
.team-pill { flex: 1; padding: 14rpx 18rpx; border-radius: 10rpx; display: flex; flex-direction: column; gap: 4rpx; }
.team-pill.champion { background: #fff6e0; }
.team-pill.runner { background: #f2f5f3; }
.pill-label { font-size: 20rpx; color: #8a7a4a; }
.pill-name { font-size: 26rpx; font-weight: 700; color: #17321f; }
.award-row { display: flex; gap: 18rpx; padding: 18rpx 0; border-bottom: 1rpx solid #f5f7f5; }
.award-row:last-child { border-bottom: none; }
.award-label { width: 150rpx; font-size: 24rpx; color: #6f8077; flex-shrink: 0; }
.award-body { flex: 1; display: flex; flex-direction: column; gap: 4rpx; min-width: 0; }
.award-name { font-size: 30rpx; font-weight: 700; color: #17321f; }
.award-meta { font-size: 22rpx; color: #7a8a80; }
.sub-head { margin-top: 24rpx; font-size: 25rpx; font-weight: 600; color: #1B5E20; }
.xi-wrap { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 14rpx; }
.xi-item { width: calc((100% - 24rpx) / 3); box-sizing: border-box; padding: 12rpx 14rpx; border: 1rpx dashed #cfdad2; border-radius: 10rpx; display: flex; flex-direction: column; gap: 2rpx; }
.xi-slot { font-size: 20rpx; color: #8b9a91; }
.xi-name { font-size: 26rpx; font-weight: 600; color: #17321f; }
.xi-team { font-size: 20rpx; color: #7a8a80; }
.xi-note { font-size: 19rpx; color: #b07b1e; }
.team-award-row { display: flex; align-items: center; gap: 14rpx; padding: 14rpx 0; border-bottom: 1rpx solid #f5f7f5; }
.ta-title { width: 200rpx; font-size: 23rpx; color: #6f8077; flex-shrink: 0; }
.ta-name { font-size: 25rpx; font-weight: 600; color: #1B5E20; flex: 1; }
.ta-note { font-size: 20rpx; color: #98a69d; }
.table { margin-top: 12rpx; }
.trow { display: flex; align-items: center; padding: 14rpx 0; border-bottom: 1rpx solid #f5f7f5; font-size: 22rpx; color: #333; }
.thead { color: #8a9a90; font-size: 20rpx; }
.c-rank { width: 62rpx; text-align: center; }
.c-team { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.c-num { width: 62rpx; text-align: center; }
.strong { font-weight: 700; color: #1B5E20; }
.rule-row { display: flex; gap: 12rpx; padding: 14rpx 0; border-bottom: 1rpx solid #f5f7f5; }
.rule-index { width: 32rpx; height: 32rpx; line-height: 32rpx; text-align: center; border-radius: 50%; background: #eef4ef; color: #1B5E20; font-size: 19rpx; flex-shrink: 0; }
.rule-text { flex: 1; font-size: 22rpx; line-height: 1.7; color: #4d5b53; }
.footer-tip { margin: 26rpx 32rpx 0; font-size: 20rpx; line-height: 1.7; color: #98a69d; text-align: center; }
