/* pages/tournament/transfer/market/market.wxss
 * 赛事转会中心·转会市场
 * 令牌：主色 #087A48 / 深绿 #073A29 / 正文 #172C22 / 辅助 #6E7F76 / 页面底 #F4F7F5 / 边界 #E2E8E4
 * 换算：390px 视口设计值 × 1.92 ≈ rpx
 */
.tc-page{min-height:100vh;background:#F4F7F5;padding-bottom:calc(60rpx + env(safe-area-inset-bottom));box-sizing:border-box}

/* ===== 顶部赛事与窗口 ===== */
.tc-hero{background:linear-gradient(160deg,#0B6B44,#073A29);padding:34rpx 31rpx 30rpx}
.tc-hero-title{display:block;font-size:44rpx;line-height:1.2;font-weight:900;color:#fff;letter-spacing:1rpx}
.tc-hero-event{display:block;margin-top:10rpx;font-size:23rpx;line-height:1.5;color:rgba(255,255,255,.82);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.tc-window{display:flex;align-items:center;gap:12rpx;margin-top:22rpx;padding:12rpx 18rpx;border-radius:12rpx;background:rgba(255,255,255,.14)}
.tc-window-text{font-size:22rpx;font-weight:800;color:#fff;line-height:1.4}
.tc-window-note{font-size:21rpx;color:rgba(255,255,255,.78);line-height:1.4}
.tc-window-open{background:rgba(255,255,255,.22)}
.tc-window-closed{background:rgba(255,255,255,.1)}
.tc-window-unknown{background:rgba(255,255,255,.08)}
.tc-window-unknown .tc-window-text{color:rgba(255,255,255,.82)}

/* ===== 搜索与筛选 ===== */
.tc-search{display:flex;align-items:center;gap:12rpx;margin:22rpx 31rpx 0;height:76rpx;padding:0 20rpx;border-radius:15rpx;background:#fff;border:1rpx solid #E2E8E4;box-sizing:border-box}
.tc-search-icon{width:28rpx;height:28rpx;flex:0 0 28rpx}
.tc-search-input{flex:1;min-width:0;height:76rpx;line-height:76rpx;font-size:25rpx;color:#172C22}
.tc-search-placeholder{color:#A6B2AC;font-size:24rpx}
.tc-search-clear{flex:0 0 auto;font-size:21rpx;font-weight:700;color:#6E7F76;padding:6rpx 2rpx 6rpx 10rpx}

.tc-chips{display:flex;align-items:center;gap:14rpx;margin:20rpx 31rpx 0;overflow:hidden}
.tc-chip{height:56rpx;padding:0 22rpx;border-radius:28rpx;display:flex;align-items:center;justify-content:center;background:#fff;border:1rpx solid #E2E8E4;box-sizing:border-box;flex:0 0 auto}
.tc-chip-text{font-size:22rpx;font-weight:600;color:#6E7F76;white-space:nowrap}
.tc-chip-active{background:#E7F5EC;border-color:#087A48}
.tc-chip-active .tc-chip-text{font-weight:800;color:#087A48}

/* ===== 列表 ===== */
.tc-list-head{margin:24rpx 31rpx 0}
.tc-list-total{font-size:21rpx;color:#6E7F76}

.tc-list{margin:8rpx 31rpx 0;border-radius:15rpx;background:#fff;border:1rpx solid #E2E8E4;overflow:hidden}
.tc-row{display:flex;align-items:center;gap:18rpx;padding:24rpx 22rpx;border-bottom:1rpx solid #EEF2EF}
.tc-row:last-child{border-bottom:none}
.tc-row-avatar{flex:0 0 84rpx;width:84rpx;height:84rpx;border-radius:16rpx;background:#EFF5F1;display:flex;align-items:center;justify-content:center}
.tc-row-avatar-icon{width:44rpx;height:44rpx;opacity:.72}
.tc-row-main{flex:1;min-width:0;display:flex;flex-direction:column;gap:4rpx}
.tc-row-name-line{display:flex;align-items:center;gap:10rpx}
.tc-row-name{font-size:29rpx;font-weight:800;color:#172C22;line-height:1.3;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.tc-row-badge{flex:0 0 auto;font-size:19rpx;font-weight:800;color:#087A48;background:#E7F5EC;border-radius:6rpx;padding:3rpx 10rpx;line-height:1.4}
.tc-row-meta{font-size:21rpx;color:#6E7F76;line-height:1.5}
.tc-row-team{font-size:21rpx;color:#6E7F76;line-height:1.5;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.tc-row-note{font-size:20rpx;color:#C0423A;line-height:1.5}
.tc-row-side{flex:0 0 auto;display:flex;align-items:center;gap:10rpx}
.tc-value{font-size:23rpx;font-weight:800;line-height:1.4;white-space:nowrap}
.tc-value-ready{color:#172C22}
.tc-value-pending{color:#6E7F76}
.tc-value-hidden{color:#8C9A93}
.tc-row-chevron{width:16rpx;height:16rpx;border-top:3rpx solid #AEBAB3;border-right:3rpx solid #AEBAB3;transform:rotate(45deg)}

/* ===== 状态 ===== */
.tc-loading,.tc-empty{margin:40rpx 31rpx 0;padding:40rpx 0;display:flex;align-items:center;justify-content:center}
.tc-loading-text,.tc-empty-text{font-size:23rpx;color:#6E7F76}
.tc-error{margin:32rpx 31rpx 0;padding:28rpx;border-radius:15rpx;background:#FCEEEC;display:flex;flex-direction:column;gap:18rpx}
.tc-error-text{font-size:22rpx;color:#A43E38;line-height:1.6}
.tc-error-btn{align-self:flex-start;padding:10rpx 26rpx;border-radius:12rpx;background:#fff;border:1rpx solid #A43E38}
.tc-error-btn-text{font-size:22rpx;font-weight:800;color:#A43E38}
.tc-more,.tc-end{margin-top:26rpx;display:flex;align-items:center;justify-content:center}
.tc-more-text,.tc-end-text{font-size:21rpx;color:#8C9A93}
.tc-note{margin:24rpx 31rpx 0;padding:20rpx;border-radius:12rpx;background:#F0F4F1}
.tc-note-text{font-size:20rpx;color:#6E7F76;line-height:1.6}
