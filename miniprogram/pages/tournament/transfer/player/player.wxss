/* pages/tournament/transfer/player/player.wxss
 * 赛事转会中心·球员资料（只读）
 */
.tp-page{min-height:100vh;background:#F4F7F5;padding:22rpx 31rpx calc(60rpx + env(safe-area-inset-bottom));box-sizing:border-box}

.tp-hero{display:flex;align-items:center;gap:22rpx;padding:28rpx;border-radius:18rpx;background:linear-gradient(160deg,#0B6B44,#073A29)}
.tp-hero-avatar{flex:0 0 96rpx;width:96rpx;height:96rpx;border-radius:20rpx;background:rgba(255,255,255,.16);display:flex;align-items:center;justify-content:center}
.tp-hero-avatar-icon{width:52rpx;height:52rpx;opacity:.9}
.tp-hero-main{flex:1;min-width:0;display:flex;flex-direction:column;gap:6rpx}
.tp-hero-name-line{display:flex;align-items:center;gap:10rpx}
.tp-hero-name{font-size:36rpx;font-weight:900;color:#fff;line-height:1.25;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.tp-hero-badge{flex:0 0 auto;font-size:19rpx;font-weight:800;color:#073A29;background:#C8F0D6;border-radius:6rpx;padding:3rpx 10rpx;line-height:1.4}
.tp-hero-meta{font-size:21rpx;color:rgba(255,255,255,.8);line-height:1.5}
.tp-hero-team{font-size:22rpx;color:rgba(255,255,255,.9);line-height:1.5;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

.tp-card{margin-top:22rpx;border-radius:15rpx;background:#fff;border:1rpx solid #E2E8E4;overflow:hidden}
.tp-row{display:flex;align-items:center;justify-content:space-between;gap:18rpx;padding:24rpx 22rpx;border-bottom:1rpx solid #EEF2EF}
.tp-card .tp-row:last-child{border-bottom:none}
.tp-row-sub{padding-top:0;border-bottom:none}
.tp-row-sub + .tp-row{padding-top:0}
.tp-row-label{font-size:24rpx;color:#6E7F76;flex:0 0 auto}
.tp-row-value{font-size:25rpx;font-weight:700;color:#172C22;text-align:right;line-height:1.4}
.tp-row-side{display:flex;align-items:center;gap:12rpx;flex:0 0 auto}
.tp-row-note{font-size:20rpx;color:#6E7F76;line-height:1.6}
.tp-row-note-warn{color:#B06A22}
.tp-value{font-size:30rpx;font-weight:900;line-height:1.3;color:#172C22}
.tp-value-pending{color:#6E7F76;font-weight:800;font-size:26rpx}
.tp-value-hidden{color:#8C9A93;font-weight:800;font-size:26rpx}
.tp-row-tier{font-size:20rpx;font-weight:800;color:#087A48;background:#E7F5EC;border-radius:6rpx;padding:3rpx 10rpx}

.tp-notes{margin-top:22rpx;padding:22rpx;border-radius:15rpx;background:#F0F4F1;display:flex;flex-direction:column;gap:8rpx}
.tp-notes-title{font-size:21rpx;font-weight:800;color:#172C22}
.tp-notes-item{font-size:20rpx;color:#6E7F76;line-height:1.6}

.tp-footer{margin-top:26rpx;padding:20rpx;border-radius:12rpx;background:#fff;border:1rpx dashed #C9D6CE}
.tp-footer-text{font-size:20rpx;color:#6E7F76;line-height:1.6}

.tp-loading,.tp-error{margin-top:60rpx;display:flex;flex-direction:column;align-items:center;gap:18rpx}
.tp-loading-text{font-size:23rpx;color:#6E7F76}
.tp-error{padding:28rpx;border-radius:15rpx;background:#FCEEEC;margin-top:32rpx}
.tp-error-text{font-size:22rpx;color:#A43E38;line-height:1.6}
.tp-error-btn{padding:10rpx 26rpx;border-radius:12rpx;background:#fff;border:1rpx solid #A43E38}
.tp-error-btn-text{font-size:22rpx;font-weight:800;color:#A43E38}
