<view class="lineup-result-page"><image class="lineup-result-bg" src="/images/runtime/team-data-emerald-stadium-v1.jpg" mode="aspectFill"/><view class="lineup-result-content"><view class="lineup-result-nav"><text bindtap="back">‹</text><text>单场比赛阵容</text></view><view wx:if="{{loading}}" class="lineup-result-loading">正在读取已提交阵容…</view><block wx:else><view class="lineup-result-hero"><text>阵容提交成功</text><view><image src="/images/runtime/icons/brand-v2-09.png" mode="aspectFit"/><text>已成功提交本场比赛阵容</text></view></view><view class="lineup-result-summary"><image src="/images/runtime/icons/brand-v2-09.png" mode="aspectFit"/><text>{{match.divisionName}}</text><view><text>{{match.homeTeamName}}</text><text>VS</text><text>{{match.awayTeamName}}</text></view><view class="lineup-result-divider"></view><view class="lineup-result-meta"><text>◫ {{match.matchDate}}</text><text>⌑ {{match.venue}}</text></view><view class="lineup-result-meta"><text>♙ 首发 {{starterCount}} 人</text><text>替补 {{substituteCount}} 人</text></view><view class="lineup-result-notice">ⓘ 开赛前可调整，开赛后生成阵容快照并锁定。</view><text>◷ 提交时间：{{submittedAtText}}</text></view><view class="lineup-result-flow"><text>阵容流程</text><view><view><image src="/images/runtime/icons/brand-v2-09.png" mode="aspectFit"/><text>已提交</text><text>阵容已保存</text></view><text>┄┄</text><view><image src="/images/runtime/icons/brand-v2-10.png" mode="aspectFit"/><text>等待比赛</text><text>开赛前可调整</text></view><text>┄┄</text><view><image src="/images/icons/lock.svg" mode="aspectFit"/><text>开赛锁定</text><text>生成阵容快照</text></view></view></view><button wx:if="{{canViewSnapshot}}" bindtap="viewSnapshot">查看阵容快照</button><button bindtap="backToMatch" class="lineup-result-secondary">返回比赛详情</button></block></view></view>
