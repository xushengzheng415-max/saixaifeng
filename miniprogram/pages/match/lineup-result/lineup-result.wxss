.lineup-result-page{min-height:100vh;position:relative;background:#03271b}.lineup-result-bg{position:absolute;inset:0;width:100%;height:100%;opacity:.76}.lineup-result-content{position:relative;padding:0 28rpx 100rpx;color:#26322b}.lineup-result-nav{height:208rpx;position:relative;display:flex;align-items:flex-end;padding:0 8rpx 28rpx;box-sizing:border-box;color:#fff;font-size:32rpx;font-weight:700}.lineup-result-nav text:first-child{font-size:76rpx;font-weight:300;margin-right:18rpx}.lineup-result-loading{padding:180rpx 0;text-align:center;color:#e1f0e7}.lineup-result-hero{padding:44rpx 20rpx 28rpx;text-align:center;color:#fff}.lineup-result-hero>text{display:block;font-size:52rpx;font-weight:700}.lineup-result-hero>view{display:flex;align-items:center;justify-content:center;gap:10rpx;margin-top:22rpx;font-size:27rpx}.lineup-result-hero image{width:34rpx;height:34rpx}.lineup-result-summary,.lineup-result-flow{margin-bottom:24rpx;padding:31rpx;border-radius:28rpx;background:#fff;box-shadow:0 10rpx 22rpx rgba(0,30,15,.17)}.lineup-result-summary>image{display:block;width:94rpx;height:94rpx;margin:0 auto 21rpx}.lineup-result-summary>text{display:block;color:#099a40;text-align:center;font-size:30rpx;font-weight:600}.lineup-result-summary>view:nth-of-type(1){display:flex;justify-content:center;align-items:center;gap:18rpx;margin-top:29rpx;font-size:30rpx;font-weight:600;white-space:nowrap}.lineup-result-summary>view:nth-of-type(1) text:nth-child(2){color:#0c9945}.lineup-result-divider{height:1rpx!important;margin:29rpx 0;background:#e4e8e5}.lineup-result-meta{display:flex;justify-content:center;gap:45rpx;margin:17rpx 0;color:#4c5851;font-size:24rpx}.lineup-result-notice{margin-top:25rpx;padding:19rpx;background:#ecf5ee;border-radius:14rpx;color:#0a8840;font-size:23rpx}.lineup-result-summary>text:last-child{margin-top:23rpx;color:#68736d;font-size:23rpx;font-weight:400}.lineup-result-flow>text{display:block;font-size:29rpx;font-weight:700}.lineup-result-flow>view{display:flex;align-items:flex-start;justify-content:space-between;margin-top:28rpx}.lineup-result-flow>view>view{width:29%;display:flex;flex-direction:column;align-items:center;text-align:center}.lineup-result-flow image{width:65rpx;height:65rpx}.lineup-result-flow>view>text{margin-top:25rpx;color:#1e9a4a}.lineup-result-flow>view>view text:nth-child(2){margin-top:11rpx;color:#168c48;font-size:24rpx;font-weight:700}.lineup-result-flow>view>view text:last-child{margin-top:9rpx;color:#748078;font-size:19rpx;line-height:1.35}.lineup-result-content>button{width:100%;height:90rpx;line-height:90rpx;margin-bottom:18rpx;border-radius:16rpx;background:#0b974e;color:#fff;font-size:31rpx;font-weight:700}.lineup-result-content>button::after{border:0}.lineup-result-content .lineup-result-secondary{background:#fff;color:#087d48;border:2rpx solid #087d48}
