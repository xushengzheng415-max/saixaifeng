px;height:82rpx;margin-right:22rpx;border-radius:50%;background:#165e3b;color:#fff;display:flex;align-items:center;justify-content:center;font-size:25rpx}.picker-player-copy{flex:1}.picker-player-copy text:first-child{display:block;color:#13241a;font-size:32rpx;font-weight:700}.picker-player-copy text:last-child{display:block;margin-top:8rpx;color:#748078;font-size:25rpx}.picker-add{width:58rpx;height:58rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;background:#1ca049;font-size:52rpx;font-weight:300;line-height:1}.picker-empty{padding:80rpx 20rpx;color:#849087;text-align:center;font-size:27rpx}.picker-footer{display:block;margin-top:24rpx;color:#87918c;text-align:center;font-size:25rpx}
