/* pages/match/squad/squad.wxss */
/* 首发阵容设置界面 - 支持5/7/8/11人制 */

.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 180rpx;
}

/* ===== 比赛信息 ===== */
.match-info {
  background: linear-gradient(135deg, #1B5E20 0%, #43A047 100%);
  padding: 40rpx 30rpx;
  color: #fff;
}

.match-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.match-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.match-format {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  background-color: rgba(255, 255, 255, 0.2);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.match-detail {
  display: flex;
  gap: 30rpx;
}

.detail-item {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* ===== 首发阵容预览区域 ===== */
.formation-section {
  background-color: #fff;
  margin: 20rpx 30rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.section-hint {
  font-size: 22rpx;
  color: #999;
}

/* 阵型视图 - 模拟球场 */
.formation-pitch {
  background: linear-gradient(180deg, #2E7D32 0%, #43A047 50%, #66BB6A 100%);
  border-radius: 12rpx;
  padding: 30rpx 20rpx;
  min-height: 600rpx;
  position: relative;
  overflow: hidden;
}

/* 球场线条效果 */
.formation-pitch::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 10%;
  right: 10%;
  height: 2rpx;
  background-color: rgba(255, 255, 255, 0.4);
  transform: translateY(-50%);
}

.formation-pitch::after {
  content: '';
  position: absolute;
  top: 20%;
  left: 50%;
  width: 200rpx;
  height: 200rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 50%;
  transform: translateX(-50%);
}

/* 阵型行 */
.formation-row {
  display: flex;
  justify-content: space-around;
  align-items: center;
  margin-bottom: 30rpx;
}

.formation-row:last-child {
  margin-bottom: 0;
}

/* 球员在阵型中的位置 */
.formation-player {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

/* 简单球员卡片（阵型视图中） */
.player-simple {
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: rgba(255, 255, 255, 0.95);
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  min-width: 100rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
  transition: all 0.3s;
}

.player-simple:active {
  transform: scale(0.95);
  background-color: #FFF9C4;
}

.player-gk {
  background-color: #FFE082;
}

.player-jersey {
  font-size: 36rpx;
  font-weight: bold;
  color: #1B5E20;
}

.player-name-short {
  font-size: 20rpx;
  color: #333;
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== 选择统计 ===== */
.selection-bar {
  background-color: #fff;
  padding: 24rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #f0f0f0;
  position: sticky;
  top: 0;
  z-index: 100;
}

.selection-count {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.selection-actions {
  display: flex;
  gap: 20rpx;
}

.action-text {
  font-size: 26rpx;
  color: #43A047;
}

/* ===== 加载状态 ===== */
.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
  color: #999;
  font-size: 28rpx;
}

/* ===== 位置分区 ===== */
.position-section {
  background-color: #fff;
  margin: 20rpx 30rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}

.position-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.position-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.position-count {
  font-size: 24rpx;
  color: #999;
  background-color: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

/* ===== 球员网格 ===== */
.player-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.player-card {
  width: calc(25% - 12rpx);
  background-color: #f8f8f8;
  border-radius: 12rpx;
  padding: 20rpx 10rpx;
  text-align: center;
  position: relative;
  border: 4rpx solid transparent;
  transition: all 0.2s;
}

.player-card.starting {
  border-color: #43A047;
  background-color: #E8F5E9;
  box-shadow: 0 4rpx 12rpx rgba(67, 160, 71, 0.3);
}

.player-photo {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-bottom: 10rpx;
}

.photo-placeholder {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #E0E0E0;
  color: #666;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 10rpx;
}

.player-number {
  display: block;
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
}

.player-name {
  display: block;
  font-size: 22rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.starting-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  background-color: #43A047;
  color: #fff;
  font-size: 18rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  font-weight: bold;
}

/* ===== 空状态 ===== */
.empty-state {
  background-color: #fff;
  margin: 20rpx 30rpx;
  border-radius: 16rpx;
  padding: 80rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 30rpx;
}

.btn-add {
  display: inline-block;
  width: 240rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: linear-gradient(135deg, #1B5E20 0%, #43A047 100%);
  color: #fff;
  font-size: 28rpx;
  border-radius: 36rpx;
}

.btn-add::after {
  border: none;
}

/* ===== 底部提交 ===== */
.submit-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 20rpx 30rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.08);
  z-index: 1000;
}

.btn-submit {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  background: linear-gradient(135deg, #1B5E20 0%, #43A047 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 45rpx;
}

.btn-submit[disabled] {
  opacity: 0.6;
}

.hint-text {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #f44336;
  margin-top: 12rpx;
}

/* ===== 球员卡预览弹窗 ===== */
.player-card-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.7);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 9999;
}

.modal-content {
  background-color: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  width: 85%;
  max-height: 85vh;
  overflow-y: auto;
}

.player-details {
  margin-top: 30rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.detail-name {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.detail-position {
  display: block;
  font-size: 28rpx;
  color: #43A047;
  margin-bottom: 16rpx;
}

.detail-info {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.btn-close {
  margin-top: 30rpx;
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background-color: #f5f5f5;
  color: #333;
  font-size: 28rpx;
  border-radius: 40rpx;
}

.btn-close::after {
  border: none;
}
