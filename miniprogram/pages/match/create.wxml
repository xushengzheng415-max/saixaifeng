<!-- pages/match/create.wxml - 创建赛事 -->
<view class="container">
  <view class="form-section">

    <!-- 赛事类型 -->
    <view class="form-item">
      <text class="label">赛事类型 *</text>
      <view class="type-list">
        <view class="type-card active" data-type="youth" bindtap="selectType">
          <text class="type-icon">⚽</text>
          <text class="type-name">青少年足球</text>
          <text class="type-desc">U8~U18青少年赛事</text>
          <text class="type-desc">教练/领队提交参赛名单</text>
        </view>
      </view>
    </view>

    <!-- 赛事名称 -->
    <view class="form-item">
      <text class="label">赛事名称 *</text>
      <input class="input" placeholder="请输入赛事名称" value="{{name}}" bindinput="onNameInput" />
    </view>

    <!-- 比赛时间 -->
    <view class="form-item">
      <text class="label">比赛时间</text>
      <view class="date-row">
        <picker mode="date" value="{{startDate}}" bindchange="onStartDateChange">
          <view class="date-picker">{{startDate || '开始日期'}}</view>
        </picker>
        <text class="date-sep">至</text>
        <picker mode="date" value="{{endDate}}" bindchange="onEndDateChange">
          <view class="date-picker">{{endDate || '结束日期'}}</view>
        </picker>
      </view>
    </view>

    <!-- 比赛地点 -->
    <view class="form-item">
      <text class="label">比赛地点</text>
      <input class="input" placeholder="请输入比赛地点" value="{{location}}" bindinput="onLocationInput" />
    </view>

    <!-- 报名设置 -->
    <view class="form-item">
      <text class="label">报名设置</text>
      <view class="number-row">
        <view class="number-item">
          <text class="number-label">最多参赛球队</text>
          <input class="number-input" type="number" value="{{maxTeams}}" bindinput="onMaxTeamsInput" />
        </view>
        <view class="number-item">
          <text class="number-label">每队最多人数</text>
          <input class="number-input" type="number" value="{{maxPlayers}}" bindinput="onMaxPlayersInput" />
        </view>
      </view>
    </view>

    <!-- 赛事说明 -->
    <view class="form-item">
      <text class="label">赛事说明</text>
      <textarea class="textarea" placeholder="请输入赛事说明（赛制、规则等）" value="{{description}}" bindinput="onDescInput" maxlength="500"></textarea>
    </view>

    <!-- 青少年赛事：工作人员配置 -->
    <view class="form-item">
      <text class="label">赛事工作人员（可选）</text>
      <text class="sub-label">选择本赛事需要登记的队伍工作人员职位</text>
      <view class="official-list">
        <view class="official-tag "
              wx:for="{{officialRoles}}" wx:key="*this"
              data-role="{{item.name}}" bindtap="toggleOfficial">
          <text class="check-icon"></text>
          {{item.name}}
        </view>
      </view>
    </view>

    <view class="tip-box">
      <text class="tip-title">青少年足球赛事</text>
      <text class="tip-text">• 领队/教练提交参赛名单</text>
      <text class="tip-text">• 领队全权管理球员信息</text>
      <text class="tip-text">• 后续可按年龄组进行报名审核</text>
    </view>
  </view>

  <button class="save-btn" bindtap="createTournament">创建赛事</button>
</view>
