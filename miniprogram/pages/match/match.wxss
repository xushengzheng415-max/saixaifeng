/* pages/match/match.wxss */
/* 裁判库页面样式 — 和网页端裁判管理风格一致 */

.container {
  background-color: #f5f7fa;
  min-height: 100vh;
  padding-bottom: 30rpx;
}

/* ===== 页面标题栏 ===== */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, #1B5E20 0%, #2E7D32 50%, #43A047 100%);
}

.page-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #fff;
}

.page-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* ===== 加载状态 ===== */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 400rpx;
  gap: 16rpx;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid rgba(46, 125, 50, 0.15);
  border-top-color: #2E7D32;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #999;
}

/* ===== 裁判列表 ===== */
.referee-list {
  padding: 24rpx 28rpx;
  height: calc(100vh - 180rpx);
  box-sizing: border-box;
}

/* ===== 裁判卡片 ===== */
.referee-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

/* 卡片头部：头像 + 姓名 + 标签 */
.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.referee-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #fff;
  box-shadow: 0 2rpx 12rpx rgba(46, 125, 50, 0.15);
}

.avatar-img {
  width: 96rpx;
  height: 96rpx;
}

.avatar-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #2E7D32;
}

.card-info {
  margin-left: 22rpx;
  flex: 1;
}

.referee-name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #222;
  margin-bottom: 10rpx;
}

.tag-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.level-tag {
  display: inline-block;
  font-size: 20rpx;
  padding: 3rpx 14rpx;
  border-radius: 6rpx;
  font-weight: 500;
}

.level-一级,
.level-国家级 {
  background: #FFF3E0;
  color: #E65100;
}

.level-二级,
.level-省级 {
  background: #E3F2FD;
  color: #1565C0;
}

.level-三级,
.level-市级 {
  background: #F3E5F5;
  color: #6A1B9A;
}

.level-初级裁判,
.level-初级 {
  background: #ECEFF1;
  color: #546E7A;
}

.status-tag {
  display: inline-block;
  font-size: 18rpx;
  padding: 3rpx 12rpx;
  border-radius: 6rpx;
  font-weight: 500;
}

.status-approved {
  background: #E8F5E9;
  color: #2E7D32;
}

.status-pending {
  background: #FFF8E1;
  color: #F57F17;
}

.status-rejected {
  background: #FFEBEE;
  color: #C62828;
}

/* 卡片详情行 */
.card-body {
  margin-left: 118rpx; /* 对齐到姓名下方 */
  padding-top: 8rpx;
}

.info-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 8rpx;
}

.info-label {
  font-size: 24rpx;
  color: #888;
  width: 140rpx;
  flex-shrink: 0;
}

.info-value {
  font-size: 25rpx;
  color: #333;
  word-break: break-all;
}

.phone-value {
  color: #1976D2;
}

.cert-value {
  font-size: 23rpx;
  color: #666;
}

/* 底部操作区 */
.card-footer {
  margin-top: 18rpx;
  margin-left: 118rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-btn {
  display: inline-block;
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.invite-btn {
  color: #2E7D32;
  background: #E8F5E9;
  border: 1rpx solid #C8E6C9;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 30rpx;
  color: #666;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #aaa;
}
