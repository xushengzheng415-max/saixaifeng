<!--pages/match/match.wxml-->
<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">裁判管理</text>
  </view>

  <!-- 加载状态 -->
  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{showEmpty}}">
    <text class="empty-icon">📋</text>
    <text class="empty-text">暂无裁判数据</text>
    <text class="empty-hint">请在网页端添加裁判信息</text>
  </view>

  <!-- 裁判列表 -->
  <scroll-view class="referee-list" scroll-y="{{true}}" wx:if="{{showList}}">
    <view class="referee-card" wx:for="{{referees}}" wx:key="_id">
      <!-- 头部：头像 + 姓名 -->
      <view class="card-header">
        <view class="referee-avatar">
          <image wx:if="{{item.avatarUrl}}" class="avatar-img" src="{{item.avatarUrl}}" mode="aspectFill"></image>
          <text wx:else class="avatar-text">{{item.nameFirstLetter}}</text>
        </view>
        <view class="card-info">
          <text class="referee-name">{{item.name}}</text>
          <view class="tag-row">
            <text class="level-tag level-{{item.level}}">{{item.level}}</text>
            <text class="status-tag status-{{item.status}}">{{item.statusText}}</text>
          </view>
        </view>
      </view>
      <!-- 详情 -->
      <view class="card-body">
        <view class="info-row" wx:if="{{item.phone}}">
          <text class="info-label">手机号：</text>
          <text class="info-value phone-value">{{item.phone}}</text>
        </view>
        <view class="info-row" wx:if="{{item.region}}">
          <text class="info-label">地区：</text>
          <text class="info-value">{{item.region}}</text>
        </view>
        <view class="info-row" wx:if="{{item.certNumber}}">
          <text class="info-label">证书编号：</text>
          <text class="info-value cert-value">{{item.certNumber}}</text>
        </view>
        <view class="info-row" wx:if="{{item.hasMatchCount}}">
          <text class="info-label">执裁场次：</text>
          <text class="info-value">{{item.matchCount}} 场</text>
        </view>
      </view>
    </view>
  </scroll-view>
</view>