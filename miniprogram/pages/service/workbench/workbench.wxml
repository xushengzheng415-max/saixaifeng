<view class="page">
  <view class="hero">
    <text class="hero-kicker">赛小蜂足球</text>
    <text class="hero-title">裁判工作台</text>
    <text class="hero-desc">验证手机号后，直接处理已指派比赛</text>
  </view>

  <view class="loading-card" wx:if="{{loading}}">
    <view class="spinner"></view>
    <text>正在加载裁判任务...</text>
  </view>

  <view class="phone-card" wx:if="{{needsPhone}}">
    <text class="card-icon">🧑‍⚖️</text>
    <text class="card-title">验证裁判手机号</text>
    <text class="card-desc">请授权主办方录入的同一手机号，系统会自动显示已指派给您的比赛。</text>
    <button class="primary-btn" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber" loading="{{bindingPhone}}">微信手机号一键进入</button>
  </view>

  <view class="error-card" wx:if="{{errorMsg}}">
    <text class="error-text">{{errorMsg}}</text>
    <button class="plain-btn" bindtap="retryLoad">重新加载</button>
  </view>

  <block wx:if="{{!loading}}">
    <view class="identity-bar" wx:if="{{phoneMasked}}">
      <text>当前裁判手机号</text>
      <text class="identity-phone">{{phoneMasked}}</text>
    </view>

    <view class="section" wx:if="{{hasRefereeTasks}}">
      <view class="section-heading">
        <text class="section-title">我的比赛</text>
        <text class="section-tip">点击比赛即可执裁</text>
      </view>
      <view
        class="task-card"
        wx:for="{{refereeTasks}}"
        wx:key="matchId"
        data-match-id="{{item.matchId}}"
        bindtap="openRefereeTask"
      >
        <view class="task-topline">
          <text class="task-tournament">{{item.tournamentName}}</text>
          <text class="task-status">{{item.matchStatusText}}</text>
        </view>
        <text class="task-teams">{{item.teamsText}}</text>
        <text class="task-meta">{{item.matchTimeText}} · {{item.venue}}</text>
        <view class="task-action">{{item.actionText}} ›</view>
      </view>
    </view>

    <view class="empty-card" wx:if="{{hasNoTasks}}">
      <text class="empty-icon">⚽</text>
      <text class="card-title">暂时没有裁判任务</text>
      <text class="card-desc">请让主办方在场次中指派您，并确认裁判资料手机号与当前授权手机号一致。</text>
      <button class="plain-btn" bindtap="retryLoad">刷新比赛任务</button>
    </view>
  </block>
</view>
