/* pages/roster-change/roster-change.wxss */
.page { padding: 20rpx; background: #f5f5f5; min-height: 100vh; }

.loading-box { text-align: center; padding: 100rpx 0; }
.lb-spin { font-size: 48rpx; animation: spin 1s linear infinite; }
@keyframes spin { from { transform: rotate(0); } to { transform: rotate(360deg); } }

/* 提示卡片 */
.tip-card {
  background: #e3f2fd;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  border-left: 6rpx solid #1565c0;
}
.tip-row { font-size: 26rpx; color: #1565c0; line-height: 1.8; }
.tip-remain { font-weight: bold; margin-top: 4rpx; }

/* 区块 */
.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.section-title { font-size: 30rpx; font-weight: bold; color: #333; }
.section-count { font-size: 24rpx; color: #999; }

/* 球员列表 */
.player-list { max-height: 600rpx; overflow-y: auto; }
.player-item {
  display: flex;
  align-items: center;
  padding: 20rpx 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.player-item:last-child { border-bottom: none; }
.player-item.selected {
  background: #e8f5e9;
  border-radius: 8rpx;
}
.p-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #e8e8e8;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #999;
}
.p-info { flex: 1; }
.p-name { font-size: 28rpx; color: #333; font-weight: 500; }
.p-num { font-size: 24rpx; color: #999; margin-top: 4rpx; }
.p-tag {
  font-size: 22rpx;
  color: #fff;
  background: #2E7D32;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.empty-inline {
  text-align: center;
  padding: 30rpx 0;
  font-size: 26rpx;
  color: #bbb;
}

/* 原因选择 */
.reason-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.reason-item {
  padding: 16rpx 28rpx;
  background: #f5f5f5;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #666;
}
.reason-item.selected {
  background: #2E7D32;
  color: #fff;
}
.reason-text { font-size: 26rpx; }

.reason-text-input {
  margin-top: 20rpx;
}
.reason-textarea {
  width: 100%;
  min-height: 100rpx;
  padding: 16rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #333;
  box-sizing: border-box;
}

/* 提交栏 */
.submit-bar {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 40rpx;
}
.sb-summary {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
  min-height: 40rpx;
}
.sb-btn {
  background: #2E7D32;
  color: #fff;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 500;
}
.sb-btn.disabled {
  background: #ccc;
}

/* 空状态 */
.empty-box {
  text-align: center;
  padding: 80rpx 0;
  background: #fff;
  border-radius: 16rpx;
}
.eb-emoji { font-size: 72rpx; margin-bottom: 16rpx; }
.eb-text { font-size: 28rpx; color: #999; }
