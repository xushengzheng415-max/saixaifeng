<!-- pages/card-preview/card-preview.wxml -->
<!-- 深色精美球员卡预览 -->
<view class="container">
  <!-- 预览区域 -->
  <view class="preview-section">
    <view wx:if="{{playerData.name}}" class="card-preview {{tier}}">
      <!-- 卡片背景 -->
      <view class="card-bg"></view>
      
      <!-- 顶部：队徽 + 等级 -->
      <view class="card-top">
        <view class="team-logo-box" wx:if="{{teamLogoUrl}}">
          <image class="team-logo-img" src="{{teamLogoUrl}}" mode="aspectFit"></image>
        </view>
        <text class="tier-badge {{tier}}">{{tierName}}</text>
      </view>
      
      <!-- 头像 -->
      <view class="avatar-section">
        <view class="avatar-circle">
          <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill"></image>
          <text wx:else class="avatar-placeholder">?</text>
        </view>
      </view>
      
      <!-- 球员信息 -->
      <view class="player-info">
        <text class="player-name">{{playerData.name}}</text>
        <text class="player-role">{{playerData.position}}</text>
        <text class="player-number">#{{playerData.number || '?'}}</text>
      </view>
      
      <!-- 数据网格 -->
      <view class="data-grid">
        <view class="data-row">
          <text class="data-label">球衣名</text>
          <text class="data-value jersey">{{playerData.jerseyName}}</text>
        </view>
        <view class="data-row">
          <text class="data-label">国籍</text>
          <text class="data-value">{{playerData.nationality}}</text>
        </view>
        <view class="data-row">
          <text class="data-label">身高</text>
          <text class="data-value">{{playerData.height}}</text>
        </view>
        <view class="data-row">
          <text class="data-label">体重</text>
          <text class="data-value">{{playerData.weight}}</text>
        </view>
      </view>
    </view>

    <!-- 无数据 -->
    <view wx:else class="empty-state">
      <text>暂无球员数据</text>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-bar">
    <view class="action-btn primary" bindtap="generateCard">
      <text>✨</text><text>生成卡片</text>
    </view>
    <view class="action-btn" bindtap="saveCard" wx:if="{{cardImagePath}}">
      <text>💾</text><text>保存</text>
    </view>
  </view>
</view>
