<view class="container"><image wx:if="{{ready}}" class="card" src="{{cardUrl}}" mode="aspectFit" bindtap="preview" binderror="imageFailed" show-menu-by-longpress="true"/><view wx:elif="{{hasPortrait}}" class="player-profile"><image class="portrait" src="{{portraitUrl}}" mode="aspectFit" bindtap="preview" binderror="portraitFailed"/><text>{{playerName}}</text><text wx:if="{{stateText}}">{{stateText}}</text></view><view wx:else class="state"><text>{{stateText}}</text><button bindtap="load">重新加载</button><button wx:if="{{canSupplement}}" bindtap="supplement">补充资料</button></view><button wx:if="{{ready}}" bindtap="saveCard">保存到相册</button></view>
