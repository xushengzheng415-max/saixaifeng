<view class="container"><image wx:if="{{ready}}" class="card" src="{{cardUrl}}" mode="aspectFit" bindtap="preview" binderror="imageFailed" show-menu-by-longpress="true"/><view wx:else class="state"><text>{{stateText}}</text><button bindtap="load">重新读取</button></view><button wx:if="{{ready}}" bindtap="saveCard">保存到相册</button></view>
