.center-error{display:flex;min-height:100vh;flex-direction:column;align-items:center;justify-content:center;gap:32rpx;padding:40rpx;box-sizing:border-box;background:#edf3ef;color:#234537;font-size:28rpx;text-align:center}.center-error button{display:flex;align-items:center;justify-content:center;min-width:220rpx;margin:0;height:80rpx;line-height:1.4;background:#087a48;color:#fff;font-size:28rpx;border-radius:12rpx}.center-error button:after{border:0}.center-back{padding:12rpx 24rpx;color:#527762}
.center-loading{padding:64rpx 30rpx;background:#edf3ef;color:#527762;text-align:center;font-size:28rpx}
