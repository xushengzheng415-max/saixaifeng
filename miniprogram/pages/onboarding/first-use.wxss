page{background:#edf3ef}.first-use-page{position:relative;min-height:100vh;background:#edf3ef;color:#183d2b}.first-bg{position:absolute;left:0;top:0;width:100%;height:420rpx}.first-shade{position:absolute;left:0;top:0;width:100%;height:440rpx;background:linear-gradient(180deg,rgba(0,27,18,.83),rgba(0,38,25,.27) 63%,#edf3ef)}.first-nav{position:relative;padding-left:36rpx;padding-bottom:35rpx;font-size:36rpx;color:#fff;font-weight:600;box-sizing:content-box;min-height:62rpx}.first-content{position:relative;padding:210rpx 34rpx 75rpx}.first-heading{display:block;margin-bottom:50rpx;font-size:46rpx;line-height:1.4;font-weight:650}.role-option{display:flex;align-items:center;gap:24rpx;min-height:190rpx;padding:27rpx 24rpx;margin-bottom:24rpx;border:2rpx solid #d6e3d9;border-radius:22rpx;background:#fff}.role-option.selected{background:#f2faf3;border-color:#3da46a}.role-option>image{flex:none;width:102rpx;height:102rpx}.role-option>view{min-width:0;flex:1}.role-option>view>text{display:block;font-size:31rpx;line-height:1.5;font-weight:600}.role-option>view>text+text{margin-top:10rpx;font-size:23rpx;line-height:1.7;color:#778d7d;font-weight:400}.role-option .radio{width:33rpx;height:33rpx;min-width:33rpx;flex:none;border:2rpx solid #a8baad;border-radius:50%;box-sizing:border-box}.selected .radio{border-color:#087a48;background:#087a48;box-shadow:inset 0 0 0 5rpx #f2faf3}.first-primary{margin:65rpx 0 0;height:96rpx;line-height:96rpx;border-radius:14rpx;background:#087a48;color:#fff;font-size:32rpx;font-weight:600}.first-primary:after{border:0}.first-primary[disabled]{background:#c7d9cc;color:#fff}.first-note{display:block;text-align:center;color:#799180;font-size:24rpx;margin-top:26rpx;line-height:1.6}@media(max-width:350px){.first-content{padding-left:28rpx;padding-right:28rpx}.role-option{gap:16rpx}.role-option>image{width:88rpx;height:88rpx}.role-option>view>text{font-size:30rpx}.role-option>view>text+text{font-size:23rpx}}
.first-primary{width:100%}
.first-primary{display:flex;align-items:center;justify-content:center;padding:0 24rpx;line-height:1.4}
