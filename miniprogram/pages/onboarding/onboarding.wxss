@import "../../styles/proto.wxss";
.onboarding-page { min-height: 100vh; position: relative; overflow: hidden; background: #04271a; color: #101915; }
.stadium-bg,.stadium-mask { position: absolute; inset: 0; width: 100%; height: 100%; }
.stadium-mask { background: linear-gradient(180deg, rgba(0,18,12,.18), rgba(0,31,19,.55) 52%, rgba(0,28,15,.82)); }
.content { position: relative; z-index: 1; padding: 104rpx 52rpx calc(56rpx + env(safe-area-inset-bottom)); }
.page-title { color: #fff; font-size: 40rpx; font-weight: 800; text-align: center; }
.steps { display: flex; align-items: flex-start; justify-content: center; margin: 74rpx 40rpx 174rpx; color: rgba(255,255,255,.85); font-size: 24rpx; text-align: center; }
.step { width: 124rpx; display: flex; flex-direction: column; align-items: center; gap: 14rpx; }
.step-badge { width: 50rpx; height: 50rpx; border-radius: 50%; background: rgba(211,220,214,.58); color: #fff; font-size: 30rpx; display: flex; align-items: center; justify-content: center; font-weight: 800; border: 3rpx solid rgba(255,255,255,.35); }
.step.is-current .step-badge,.step.is-complete .step-badge { background: #239b48; border-color: #fff; }
.step-line { width: 98rpx; height: 3rpx; margin-top: 24rpx; background: rgba(255,255,255,.38); }
.step.is-complete + .step-line,.step.is-current + .step-line { background: #36a952; }
.white-panel { background: rgba(255,255,255,.97); border-radius: 36rpx; padding: 54rpx 34rpx 38rpx; box-sizing: border-box; box-shadow: 0 20rpx 64rpx rgba(0,0,0,.2); }
.panel-title { font-size: 48rpx; line-height: 1.25; font-weight: 900; text-align: center; }
.panel-subtitle { color: #7b8380; text-align: center; font-size: 26rpx; margin: 20rpx 0 42rpx; }
.scene-card { min-height: 174rpx; border: 2rpx solid #e3e9e5; border-radius: 26rpx; padding: 26rpx; margin-bottom: 24rpx; display: flex; align-items: center; gap: 28rpx; box-sizing: border-box; }
.scene-card.is-selected { border-color: #168642; background: #f2fbf4; box-shadow: inset 0 0 0 1rpx rgba(22,134,66,.08); }
.scene-icon { width: 92rpx; height: 92rpx; border-radius: 50%; padding: 16rpx; background: #eff6f0; box-sizing: border-box; }
.scene-title,.scene-desc,.crest-title,.crest-hint,.created-team-name,.team-tag { display: block; }
.scene-title { font-size: 38rpx; font-weight: 800; margin-bottom: 10rpx; }.scene-desc { font-size: 25rpx; color: #737c78; }
.profile-panel { padding-bottom: 52rpx; }.crest-row { min-height: 188rpx; display:flex; align-items:center; gap:30rpx; }.crest-placeholder,.crest-preview { width: 150rpx; height: 150rpx; flex: none; }.crest-placeholder { background:#f0f7f1; border-radius:50%; padding:35rpx; box-sizing:border-box; }.crest-preview { object-fit:contain; }
.draft-confirmation{margin-top:28rpx;padding:22rpx 24rpx;border-radius:16rpx;background:#f4f8f4}.draft-confirmation view{display:flex;justify-content:space-between;margin:10rpx 0;color:#79827d;font-size:24rpx}.draft-confirmation view text:last-child{color:#27352c;font-weight:700}
.crest-upload-icon { position:relative; width:86rpx; height:86rpx; }.crest-upload-shield { position:absolute; inset:0; width:86rpx; height:86rpx; opacity:.28; }.crest-upload-shield-mask { position:absolute; left:20rpx; top:24rpx; width:46rpx; height:38rpx; background:#f0f7f1; }.crest-upload-plus { position:absolute; border-radius:4rpx; background:#168642; }.crest-upload-plus-horizontal { left:15rpx; top:41rpx; width:56rpx; height:4rpx; }.crest-upload-plus-vertical { left:41rpx; top:15rpx; width:4rpx; height:56rpx; }
.crest-title { font-size: 34rpx; font-weight: 800; margin-bottom: 12rpx; }.crest-hint { color:#77817c; font-size: 24rpx; line-height:1.5; }.form-divider { height:2rpx; background:#edf0ee; margin:30rpx 0 48rpx; }.field-label { font-size:32rpx; font-weight:800; display:block; margin-bottom:18rpx; }.team-input { height:94rpx; border:2rpx solid #d9dedb; border-radius:18rpx; padding:0 24rpx; font-size:30rpx; box-sizing:border-box; }.cooperate-note { min-height:68rpx; margin-top:54rpx; background:#f1f8f2; border-radius:34rpx; color:#269242; display:flex; align-items:center; justify-content:center; gap:12rpx; font-size:24rpx; }.cooperate-note image { width:34rpx; height:34rpx; }
.success-panel { padding:54rpx 46rpx 56rpx; }.success-mark { width:158rpx; height:158rpx; border-radius:50%; background:#eff8f0; padding:36rpx; box-sizing:border-box; margin:0 auto 38rpx; }.success-mark image { display:block; width:86rpx; height:86rpx; }.success-title { font-size:48rpx; font-weight:900; text-align:center; }.team-summary { display:flex; align-items:center; justify-content:center; gap:26rpx; margin:48rpx 0 30rpx; }.success-logo { width:126rpx; height:126rpx; object-fit:contain; }.fallback-logo { border-radius:50%; padding:26rpx; background:#f0f7f1; box-sizing:border-box; }.fallback-logo image { display:block; width:74rpx; height:74rpx; }.created-team-name { font-size:34rpx; font-weight:800; margin-bottom:12rpx; }.team-tag { color:#249243; background:#e9f6eb; padding:7rpx 18rpx; border-radius:26rpx; font-size:23rpx; text-align:center; }.success-subtitle { color:#737c78; font-size:28rpx; display:block; text-align:center; }.success-actions { display:flex; justify-content:space-between; margin-top:60rpx; }.success-actions view { width:31%; text-align:center; font-size:23rpx; color:#35423a; }.success-actions image { width:100rpx; height:100rpx; padding:22rpx; background:#f1f8f2; border-radius:50%; display:block; margin:0 auto 18rpx; box-sizing:border-box; }
.primary-button { width:100%; margin-top:78rpx; height:92rpx; border-radius:20rpx; color:#fff; font-size:36rpx; font-weight:800; background:linear-gradient(135deg,#1d9148,#0a7a42); box-shadow:0 12rpx 28rpx rgba(4,75,37,.28); }.primary-button::after { border:0; }.primary-button[disabled] { opacity:.72; }.bottom-tip { color:rgba(255,255,255,.78); text-align:center; font-size:24rpx; margin-top:28rpx; }.error-card { color:#a62020; background:#fff0ef; padding:20rpx 24rpx; border-radius:16rpx; margin-top:24rpx; font-size:25rpx; }.hidden-canvas { width:600px; height:600px; position:fixed; left:-2000px; top:-2000px; }.crop-mask { position:fixed; z-index:10; inset:0; background:rgba(0,0,0,.62); display:flex; align-items:flex-end; }.crop-dialog { width:100%; background:#fff; padding:42rpx 38rpx calc(42rpx + env(safe-area-inset-bottom)); border-radius:38rpx 38rpx 0 0; box-sizing:border-box; }.crop-title { display:block; text-align:center; font-size:34rpx; font-weight:800; margin-bottom:30rpx; }.crop-window { width:500rpx; height:500rpx; margin:0 auto 24rpx; border-radius:20rpx; overflow:hidden; background:#ebf1ed; display:flex; align-items:center; justify-content:center; }.crop-image { width:100%; height:100%; transition:transform .15s; }.crop-label { color:#68736c; font-size:24rpx; }.crop-actions { display:flex; gap:20rpx; margin-top:20rpx; }.crop-actions button { flex:1; height:82rpx; border-radius:16rpx; font-size:29rpx; }.crop-cancel { background:#eff3f0; color:#415047; }.crop-confirm { background:#168642; color:#fff; }.crop-actions button::after { border:0; }
.training-service-panel { margin-top: 122rpx; padding: 54rpx 38rpx 46rpx; }
.service-badge { width: 148rpx; margin: 0 auto 38rpx; padding: 10rpx 0; border-radius: 30rpx; background: #fff0da; color: #a65d10; font-size: 25rpx; text-align: center; }
.service-title { color: #101510; font-size: 44rpx; font-weight: 900; text-align: center; white-space: nowrap; }
.service-subtitle { margin-top: 18rpx; color: #646c69; font-size: 26rpx; text-align: center; }
.service-capabilities { display: flex; justify-content: space-between; margin: 66rpx 0 54rpx; }
.service-capabilities view { width: 25%; color: #151b17; font-size: 24rpx; text-align: center; }
.service-capabilities image { display: block; width: 108rpx; height: 108rpx; padding: 25rpx; margin: 0 auto 18rpx; border-radius: 50%; background: #f1f7f2; box-sizing: border-box; }
.service-note { color: #6c716d; font-size: 26rpx; line-height: 1.7; text-align: center; }
.service-divider { height: 2rpx; margin: 52rpx 0; border-top: 2rpx dashed #d6d9d7; }
.service-status-title { color: #141a16; font-size: 40rpx; font-weight: 900; }
.service-status { height: 98rpx; display: flex; align-items: center; justify-content: center; gap: 20rpx; margin-top: 30rpx; border: 2rpx solid; border-radius: 18rpx; font-size: 32rpx; font-weight: 800; }
.service-status image { width: 46rpx; height: 46rpx; }
.service-status-active { color: #168642; border-color: #82bb97; background: #fbfdfb; }
.service-status-inactive { color: #b5680a; border-color: #fac278; background: #fffaf2; }
.service-status-hint { margin: 34rpx 0 2rpx; color: #6c716d; font-size: 25rpx; text-align: center; }
.service-primary { margin-top: 38rpx; font-size: 30rpx; white-space: nowrap; }
.secondary-button,.demo-return { width: 100%; height: 88rpx; margin-top: 24rpx; border: 2rpx solid #168642; border-radius: 18rpx; background: rgba(255,255,255,.8); color: #168642; font-size: 32rpx; font-weight: 800; }
.secondary-button::after,.demo-return::after { border: 0; }
.refresh-link { margin-top: 32rpx; color: #168642; font-size: 29rpx; font-weight: 700; text-align: center; }
.training-demo { margin-top: 20rpx; }
.demo-notice { width: 374rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; gap: 14rpx; margin: 0 auto; border-radius: 34rpx; background: #fff7eb; color: #a45e1c; font-size: 24rpx; font-weight: 700; }
.demo-notice image { width: 34rpx; height: 34rpx; }.demo-subtitle { margin: 18rpx 0 28rpx; color: rgba(255,255,255,.7); font-size: 25rpx; text-align: center; }
.demo-metrics { display: flex; justify-content: space-between; gap: 14rpx; }.demo-metrics view { width: 25%; min-height: 188rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 18rpx; background: rgba(255,255,255,.98); color: #565d59; font-size: 22rpx; }.demo-metrics image { width: 50rpx; height: 50rpx; margin-bottom: 12rpx; }.metric-value { margin-bottom: 6rpx; color: #121813; font-size: 42rpx; font-weight: 900; }
.demo-card { margin-top: 20rpx; padding: 22rpx 24rpx; border-radius: 20rpx; background: rgba(255,255,255,.98); }.demo-card-title { padding-left: 16rpx; border-left: 7rpx solid #129047; color: #121813; font-size: 34rpx; font-weight: 900; }
.demo-schedule { display: flex; align-items: center; justify-content: space-between; min-height: 96rpx; padding: 8rpx 0; border-bottom: 2rpx dashed #dce2de; }.demo-schedule:last-child { border-bottom: 0; }.schedule-time { margin-right: 12rpx; color: #111712; font-size: 36rpx; font-weight: 900; }.schedule-tag { display: inline-block; padding: 8rpx 14rpx; border-radius: 20rpx; background: #edf6ee; color: #187a3d; font-size: 22rpx; }.schedule-place { display: block; margin-top: 8rpx; color: #6b716e; font-size: 21rpx; }.schedule-coach { color: #69706b; font-size: 21rpx; }
.demo-attention { display: flex; margin-top: 16rpx; }.demo-attention view { width: 50%; display: flex; flex-direction: column; padding: 2rpx 14rpx; box-sizing: border-box; }.demo-attention view + view { border-left: 2rpx solid #e5e8e6; }.demo-attention image { width: 52rpx; height: 52rpx; margin-bottom: 8rpx; }.demo-attention text:nth-child(2),.demo-core text:nth-child(2) { color: #202620; font-size: 23rpx; font-weight: 800; }.demo-attention text:nth-child(3),.demo-core text:nth-child(3) { margin-top: 7rpx; color: #7c837f; font-size: 19rpx; }
.demo-core { display: flex; margin-top: 16rpx; }.demo-core view { width: 25%; display: flex; flex-direction: column; align-items: center; padding: 0 8rpx; border-right: 2rpx solid #e6e9e7; box-sizing: border-box; text-align: center; }.demo-core view:last-child { border-right: 0; }.demo-core image { width: 50rpx; height: 50rpx; margin-bottom: 9rpx; }.demo-core text:nth-child(3) { line-height: 1.35; }.demo-return { margin-top: 20rpx; background: #fff; }.demo-footnote { margin: 18rpx 0 8rpx; color: rgba(255,255,255,.66); font-size: 20rpx; text-align: center; }
