<view class="page">
  <view class="workspace-bar" bindtap="onSwitchWorkspace">
    <view>
      <text class="workspace-label">{{workspaceTypeText}}</text>
      <text class="workspace-name">{{workspaceName}}</text>
    </view>
    <text class="switch-text" wx:if="{{canSwitchWorkspace}}">切换</text>
  </view>

  <view class="filter-row">
    <view
      wx:for="{{filters}}"
      wx:key="id"
      class="filter-item {{item.itemClass}}"
      data-id="{{item.id}}"
      bindtap="onFilterTap"
    >{{item.text}}</view>
  </view>

  <view class="loading" wx:if="{{loading}}">正在整理日程...</view>
  <view class="error" wx:if="{{errorText}}">{{errorText}}</view>

  <view class="timeline" wx:if="{{hasSchedule}}">
    <view
      class="schedule-card"
      wx:for="{{visibleSchedule}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onScheduleTap"
    >
      <view class="time-column">
        <text class="time-text">{{item.timeText}}</text>
        <view class="timeline-dot"></view>
      </view>
      <view class="schedule-content">
        <view class="card-head">
          <text class="source-tag">{{item.sourceText}}</text>
          <text class="status-text">{{item.statusText}}</text>
        </view>
        <text class="schedule-title">{{item.title}}</text>
        <text class="schedule-subtitle">{{item.subtitle}}</text>
        <text class="schedule-location">{{item.location}}</text>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading}}" hidden="{{hasSchedule}}">
    <text class="empty-icon">日</text>
    <text class="empty-title">暂无日程</text>
    <text class="empty-desc">比赛日程会自动汇总到这里，后续教务课程也将接入同一时间轴。</text>
  </view>
</view>
