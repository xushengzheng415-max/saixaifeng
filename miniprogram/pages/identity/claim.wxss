/* pages/identity/claim.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
}

.tip-box {
  background: #E3F2FD;
  border-radius: 12rpx;
  padding: 20rpx;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.tip-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.tip-text {
  font-size: 26rpx;
  color: #1565C0;
  flex: 1;
}

.player-list {
  padding: 0 10rpx;
}

.player-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}

.player-info {
  flex: 1;
}

.name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.jersey-num {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #E8F5E9;
  color: #2E7D32;
  font-size: 24rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
}

.player-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #212121;
  margin-right: 12rpx;
}

.jersey-name {
  font-size: 24rpx;
  color: #2E7D32;
  font-weight: bold;
}

.meta-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #757575;
}

.coach-tip {
  font-size: 22rpx;
  color: #F44336;
  background: #FFEBEE;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}

.action-col {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.claim-btn {
  background: #2E7D32;
  color: #fff;
  font-size: 26rpx;
  font-weight: bold;
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  text-align: center;
}

.ignore-btn {
  background: #f5f5f5;
  color: #757575;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  text-align: center;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #212121;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #757575;
  text-align: center;
  padding: 0 60rpx;
}