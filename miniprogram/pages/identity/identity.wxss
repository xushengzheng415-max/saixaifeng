
/* pages/identity/identity.wxss - EA FC26风格身份卡 */

/* ===== 页面容器 ===== */
.page-container {
  min-height: 100vh;
  background: #1a1a2e;
  padding: 20rpx;
  padding-bottom: 120rpx;
}

/* ===== 顶部用户信息栏 ===== */
.header-container {
  background: #262D47;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.header-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.header-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.header-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 10rpx;
}

.tag-group {
  display: flex;
  gap: 12rpx;
}

.tag {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.tag-player {
  background: rgba(46, 125, 50, 0.3);
  color: #4CAF50;
}

.tag-tier.bronze {
  background: rgba(205, 127, 50, 0.3);
  color: #CD7F32;
}

.tag-tier.silver {
  background: rgba(192, 192, 192, 0.3);
  color: #C0C0C0;
}

.tag-tier.gold {
  background: rgba(255, 215, 0, 0.3);
  color: #FFD700;
}

.tag-number {
  background: rgba(255, 255, 255, 0.1);
  color: #ffffff;
}

.tag-active {
  background: linear-gradient(135deg, #2E7D32, #4CAF50);
  color: white;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  font-size: 22rpx;
  font-weight: bold;
}

/* ===== 球员卡展示区 - 核心容器 ===== */
.card-display-area {
  display: flex;
  justify-content: center;
  margin-bottom: 30rpx;
}

/* ===== 球员卡容器 ===== */
.player-card {
  position: relative;
  width: 700rpx;
  height: 980rpx;
  border-radius: 40rpx;
  overflow: hidden;
  background-size: cover;
  background-position: center;
}

.player-card.bronze {
  background-image: url('../../images/cards/bronze-card.png');
}

.player-card.silver {
  background-image: url('../../images/cards/silver-card.png');
}

.player-card.gold {
  background-image: url('../../images/cards/gold-card.png');
}

/* ===== 左上角：号码+位置 ===== */
.card-top-left {
  position: absolute;
  top: 10%;
  left: 10%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.card-num {
  font-size: 80rpx;
  font-weight: bold;
  color: #000000;
  line-height: 1;
  margin-bottom: 20rpx;
}

.card-pos {
  font-size: 32rpx;
  font-weight: bold;
  color: #000000;
}

/* ===== 头像容器 - 关键：半身像裁剪+背景透明+被底部文本重叠 ===== */
.card-avatar-container {
  position: absolute;
  top: 15%;
  left: 50%;
  transform: translateX(-50%);
  width: 70%;
  height: 50%;
  z-index: 1;
  /* 关键：无背景色，让透明 PNG 完美融入金卡背景 */
  background: transparent;
}

.card-avatar {
  width: 100%;
  /* 关键：无背景色、无圆角、无边框，确保透明 PNG 完美显示 */
  background: transparent;
  border-radius: 0;
  border: none;
  height: 100%;
  border-radius: 0;
}

/* ===== 中部姓名和数据区 - 定位在头像下方并重叠 ===== */
.card-text-group {
  position: absolute;
  top: 58%;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 2;
}

.card-name {
  font-size: 44rpx;
  font-weight: bold;
  color: #000000;
  margin-bottom: 10rpx;
}

.card-jersey-name {
  font-size: 30rpx;
  color: #333333;
}

/* ===== 数据行：身高和体重 ===== */
.card-stats {
  position: absolute;
  top: 74%;
  width: 100%;
  display: flex;
  justify-content: space-between;
  padding: 0 20%;
  z-index: 2;
}

.stat-height {
  font-size: 28rpx;
  color: #000000;
}

.stat-weight {
  font-size: 28rpx;
  color: #000000;
}

/* ===== 底部图标区：国籍+队徽 ===== */
.card-bottom-icons {
  position: absolute;
  bottom: 5%;
  width: 100%;
  display: flex;
  justify-content: space-between;
  padding: 0 25%;
  z-index: 2;
}

.card-flag,
.card-logo {
  width: 80rpx;
  height: 80rpx;
}

/* ===== 数据详情列表 ===== */
.info-list-container {
  background: #1f2336;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #9e9e9e;
}

.info-value {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: bold;
}

.info-value.yellow {
  color: #FFD700;
}

.info-value.green {
  color: #4CAF50;
}

/* ===== 操作按钮 ===== */
.action-buttons-container {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  border-radius: 16rpx;
  gap: 10rpx;
}

.action-btn.btn-edit {
  background: #37474F;
}

.action-btn.btn-preview {
  background: linear-gradient(135deg, #FF5722, #FF9800);
}

.btn-icon {
  font-size: 32rpx;
}

.action-btn text {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: bold;
}

/* ===== 底部固定按钮 ===== */
.fixed-bottom-btn {
  position: fixed;
  bottom: 40rpx;
  left: 20rpx;
  right: 20rpx;
  background: linear-gradient(135deg, #2E7D32, #4CAF50);
  color: #ffffff;
  padding: 28rpx;
  border-radius: 50rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 24rpx rgba(46, 125, 50, 0.4);
}

/* ===== Flexbox 工具类 ===== */
.flex-row {
  display: flex;
  flex-direction: row;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.space-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.bold {
  font-weight: bold;
}

.text-black {
  color: #000000;
}

.text-white {
  color: #ffffff;
}

.text-grey {
  color: #9e9e9e;
}

.text-yellow {
  color: #FFD700;
}

.text-green {
  color: #4CAF50;
}

.border-radius-large {
  border-radius: 24rpx;
}

.background-dark {
  background: #1f2336;
}

.full-width {
  width: 100%;
}

/* ===== 隐藏 Canvas（用于抠图处理） ===== */
.hidden-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 1px;
  height: 1px;
  opacity: 0;
  pointer-events: none;
}

/* ===== 上传提示遮罩 ===== */
.upload-hint {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 20rpx;
}

.upload-icon {
  font-size: 60rpx;
  margin-bottom: 10rpx;
}

.upload-text {
  font-size: 28rpx;
  color: #ffffff;
}
