<view class="login-page">
  <image class="bg-image" src="/images/login-bg.jpg" mode="aspectFill"></image>
  <view class="login-shade"></view>

  <view class="content-overlay">
    <view class="login-card">
      <text class="login-audience">球员、球队管理者和赛事组织者使用</text>
      <text wx:if="{{restoringSession}}" class="restore-status">正在恢复登录…</text>
      <view wx:elif="{{restoreError}}" class="restore-error">
        <text>{{restoreError}}</text>
        <button class="phone-btn" bindtap="validateExistingSession">重试登录</button>
        <text wx:if="{{!restoreBlocked}}" class="restore-phone" bindtap="usePhoneLogin">手机号登录</text>
      </view>
      <block wx:if="{{showPhoneLogin}}">
      <view class="login-action">
        <button class="phone-btn" open-type="getPhoneNumber" bindgetphonenumber="loginWithPhone" disabled="{{loginDisabled}}">{{loginButtonText}}</button>
      </view>
      <text class="phone-auth-note">手机号用于识别账号、关联管理权限</text>

      <view class="agreement-row">
        <view class="checkbox {{checkboxClass}}" bindtap="toggleAgreement">
          <text wx:if="{{agreementChecked}}">✓</text>
        </view>
        <text class="agreement-text" bindtap="toggleAgreement">我已阅读并同意</text>
        <text class="agreement-link" catchtap="showUserAgreement">《用户协议》</text>
        <text class="agreement-text">和</text>
        <text class="agreement-link" catchtap="showPrivacyPolicy">《隐私政策》</text>
      </view>

      </block>
      <view class="guest-entry-btn" role="button" aria-label="免登录浏览公开赛事与球队" bindtap="goToGuestHome">
        <text class="guest-entry-main">先逛逛（免登录浏览）</text>
        <text class="guest-entry-hint">公开赛事、赛程赛果与球队信息可直接浏览；发布、报名、管理球队才需要手机号登录</text>
      </view>
    </view>
  </view>
</view>
