/* pages/login/login.wxss — 高保真原型 V2.0 登录页
 * 来源：原型生成源 styles.css 的 .login / .login-logo / .login-panel
 * 换算：原型 390px ↔ 750rpx，1px ≈ 1.92rpx
 */
@import "../../styles/proto.wxss";

.login-page {
  position: relative;
  min-height: 100vh;
  background: #031f16;
  overflow: hidden;
}

.login-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

/* 底部向 #eff6f2 过渡的渐变遮罩（对应 styles.css .login:after） */
.login-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(1, 22, 15, 0.15), rgba(1, 40, 26, 0.30) 45%, #eff6f2 69%);
}

/* ===== 白色 Logo + slogan ===== */
.login-logo {
  position: relative;
  z-index: 2;
  text-align: center;
  padding-top: 200rpx; /* 58px + 自定义导航下状态栏余量 */
}

.login-logo-img {
  width: 600rpx;
}

.login-slogan {
  display: none;
  font-size: 19rpx; /* 10px */
  letter-spacing: 6rpx; /* 3px */
  color: rgba(255, 255, 255, 0.68);
  margin-top: 23rpx; /* 12px */
}

/* ===== 底部白色圆角登录面板 ===== */
.login-panel {
  position: absolute;
  z-index: 3;
  left: 35rpx; /* 18px */
  right: 35rpx;
  bottom: calc(108rpx + env(safe-area-inset-bottom)); /* 28px + 底部版本号区域 */
  border-radius: 42rpx; /* 22px */
  background: rgba(255, 255, 255, 0.98);
  padding: 38rpx; /* 20px */
  box-shadow: 0 24rpx 60rpx rgba(3, 40, 26, 0.18);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  box-sizing: border-box;
}

.login-panel-title {
  font-size: 38rpx; /* 20px */
  font-weight: 900;
  color: #111b17;
}

.login-panel-sub {
  font-size: 19rpx; /* 10px */
  color: #7d8883;
  line-height: 1.6;
  margin: 12rpx 0 31rpx; /* 6px 0 16px */
}

.login-btn-main[disabled] {
  opacity: 0.75;
}

/* ===== 协议勾选行 ===== */
.agree-row {
  display: flex;
  align-items: flex-start;
  margin-top: 23rpx; /* 12px */
  font-size: 16rpx; /* 8.5px */
  color: #748079;
  line-height: 1.5;
}

.agree-check {
  width: 35rpx; /* 18px */
  height: 35rpx;
  border-radius: 12rpx; /* 6px */
  flex: none;
  box-sizing: border-box;
  border: 2rpx solid #b9c8c0;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 21rpx;
  font-weight: 900;
  margin-right: 13rpx; /* 7px */
}

.agree-check.checked {
  background: #087a48;
  border-color: #087a48;
}

.agree-text {
  flex: 1;
  min-width: 0;
}

.agree-link {
  color: #087a48;
}

/* ===== 底部低调版本号（长按 devLogin） ===== */
.dev-mode {
  position: absolute;
  z-index: 3;
  left: 0;
  right: 0;
  bottom: calc(30rpx + env(safe-area-inset-bottom));
  text-align: center;
}

.dev-mode-text {
  font-size: 17rpx;
  color: rgba(17, 27, 23, 0.35);
}
