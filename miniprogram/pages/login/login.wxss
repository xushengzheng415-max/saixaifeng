page {
  width: 100%;
  height: 100%;
  background: #002f1d;
}

.login-page {
  position: relative;
  width: 100%;
  min-height: 100vh;
  overflow: hidden;
  background: #002f1d;
}

.bg-image,
.login-shade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.bg-image { z-index: 0; }
.login-shade {
  z-index: 1;
  background: linear-gradient(180deg, rgba(0,18,11,.02), rgba(0,30,17,.12) 52%, rgba(0,28,15,.64));
}

.guest-home {
  position: fixed;
  z-index: 10;
  left: 28rpx;
  top: 54px;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255,255,255,.4);
  border-radius: 50%;
  background: rgba(0,42,24,.5);
  box-shadow: 0 8rpx 22rpx rgba(0,0,0,.18);
}

.guest-home image { width: 44rpx; height: 44rpx; }

.content-overlay {
  position: relative;
  z-index: 2;
  min-height: 100vh;
  display: flex;
  align-items: flex-end;
  padding: 0 36rpx calc(38rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.login-card {
  width: 100%;
  padding: 38rpx 36rpx 30rpx;
  border-radius: 34rpx;
  box-sizing: border-box;
  background: rgba(255,255,255,.98);
  box-shadow: 0 20rpx 60rpx rgba(0,27,15,.3);
  text-align: center;
}

.login-title {
  display: block;
  color: #101a13;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.3;
}

.login-subtitle {
  display: block;
  margin: 13rpx 0 27rpx;
  color: #7c8580;
  font-size: 22rpx;
  line-height: 1.55;
}

.login-action {
  width: 100%;
  padding: 0 2rpx;
  box-sizing: border-box;
}

.phone-btn {
  display: block;
  width: 100% !important;
  min-width: 100%;
  height: 84rpx;
  margin: 0 !important;
  padding: 0 18rpx !important;
  border: 0;
  border-radius: 18rpx;
  box-sizing: border-box;
  overflow: hidden;
  background: linear-gradient(135deg, #0ba158, #078443);
  box-shadow: 0 10rpx 28rpx rgba(4,126,64,.25);
  color: #fff;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 84rpx;
  text-align: center;
  white-space: nowrap;
}

.phone-btn::after { border: 0; }
.phone-btn[disabled] {
  background: linear-gradient(135deg, #72c59a, #51ae7b);
  color: rgba(255,255,255,.9);
  opacity: 1;
}

.phone-auth-note {
  display: block;
  margin: 14rpx 8rpx 0;
  color: #758078;
  font-size: 20rpx;
  line-height: 1.5;
  text-align: center;
}

.agreement-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
  white-space: nowrap;
}

.checkbox {
  width: 28rpx;
  height: 28rpx;
  margin-right: 9rpx;
  border: 2rpx solid #aab5ae;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: #fff;
  font-size: 20rpx;
}

.checkbox.checked { border-color: #078443; background: #078443; }
.agreement-text { color: #7a847e; font-size: 20rpx; }
.agreement-link { margin: 0 2rpx; color: #078443; font-size: 20rpx; }
.guest-review-note { display: block; margin-top: 24rpx; color: #b1b8b3; font-size: 19rpx; }
