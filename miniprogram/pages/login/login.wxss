/* pages/login/login.wxss */
/* 赛小蜂 - 仅微信授权登录 */

page { width: 100%; height: 100%; }

.login-page {
  width: 100%; min-height: 100vh;
  position: relative; overflow: hidden;
}

/* ===== 全屏背景图 + 缓慢放大动画 ===== */
.bg-image {
  position: absolute; top: 0; left: 0;
  width: 100%; height: 100vh; z-index: 0;
  animation: bgZoom 20s ease-in-out infinite alternate;
}
@keyframes bgZoom {
  0%   { transform: scale(1); }
  100% { transform: scale(1.10); }
}

/* ===== 内容层：底部对齐 ===== */
.content-overlay {
  position: relative; z-index: 2;
  width: 100%; min-height: 100vh;
  display: flex; flex-direction: column;
  justify-content: flex-end;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ===== 登录按钮区 ===== */
.login-section {
  padding: 34rpx 72rpx 44rpx;
}

/* 微信一键登录（主推大按钮） */
.wechat-btn {
  width: 430rpx;
  max-width: 100%;
  height: 88rpx;
  line-height: 1;
  background: linear-gradient(90deg, #43A047 0%, #2E7D32 100%);
  color: white;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 22rpx;
  padding: 0 40rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 24rpx rgba(67,160,71,0.34);
  border: none;
}
.wechat-btn::after { border: none; }
.wechat-btn .btn-icon { display: none; }
.btn-text {
  font-size: 30rpx;
  line-height: 1;
  letter-spacing: 0;
  white-space: nowrap;
}

/* agreement */
.agreement-row {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  max-width: 580rpx;
  margin: 4rpx auto 14rpx;
  row-gap: 8rpx;
  column-gap: 8rpx;
}
.agreement-check,
.agreement-links {
  display: flex;
  align-items: center;
  min-height: 44rpx;
}
.agreement-check { padding: 6rpx 0; }
.checkbox {
  width: 28rpx; height: 28rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255,255,255,0.7);
  margin-right: 10rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 18rpx; color: white;
  flex-shrink: 0;
}
.checkbox.checked { background: #43A047; border-color: #43A047; }
.agreement-text { font-size: 22rpx; color: rgba(255,255,255,0.72); line-height: 36rpx; }
.agreement-link {
  font-size: 22rpx;
  color: #C8E6C9;
  line-height: 44rpx;
  padding: 0 8rpx;
  font-weight: 600;
}

.dev-mode { display: flex; justify-content: center; padding: 14rpx 0; }
.dev-mode-text { font-size: 18rpx; color: rgba(255,255,255,0.18); }

/* ===== 身份选择卡片 ===== */
.role-section {
  width: 100%; background: rgba(255,255,255,0.97);
  border-radius: 28rpx 28rpx 0 0;
  padding: 44rpx 36rpx calc(56rpx + env(safe-area-inset-bottom)) 36rpx;
  margin: 0 -56rpx;
  width: calc(100% + 112rpx);
  box-sizing: border-box;
  box-shadow: 0 -8rpx 32rpx rgba(0,0,0,0.15);
}
.role-title { font-size: 36rpx; font-weight: bold; color: #1B5E20; text-align: center; margin-bottom: 8rpx; }
.role-subtitle { font-size: 24rpx; color: #999; text-align: center; margin-bottom: 32rpx; }
.role-list { display: flex; flex-wrap: wrap; justify-content: space-between; margin-bottom: 40rpx; }
.role-item {
  width: 47%; display: flex; flex-direction: column; align-items: center;
  padding: 28rpx 0; margin-bottom: 16rpx;
  background: #F5F7F5; border-radius: 16rpx; border: 3rpx solid transparent;
}
.role-item.active { background: #E8F5E9; border-color: #1B5E20; }
.role-name { font-size: 30rpx; font-weight: bold; color: #333; margin-bottom: 8rpx; }
.role-item.active .role-name { color: #1B5E20; }
.role-desc { font-size: 22rpx; color: #999; }
.enter-btn {
  width: 100%; height: 88rpx; line-height: 88rpx;
  background: linear-gradient(90deg, #43A047 0%, #2E7D32 100%);
  color: white; font-size: 32rpx; font-weight: bold;
  border-radius: 44rpx; border: none; margin-bottom: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(67,160,71,0.35);
}
.enter-btn::after { border: none; }
.enter-btn[disabled] { background: #CCC; box-shadow: none; }
.back-link { display: block; text-align: center; font-size: 26rpx; color: #999; text-decoration: underline; }


