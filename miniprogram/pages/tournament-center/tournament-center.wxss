/* 赛事中心样式（双模式：主办方卡片式 / 教练列表式） */

/* ===== 通用 ===== */
.container {
  background: #f5f6fa;
  min-height: 100vh;
  padding-bottom: 30rpx;
}

/* 加载中 */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid #e0e0e0;
  border-top-color: #2E7D32;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.loading-text {
  color: #999;
  font-size: 26rpx;
  margin-top: 16rpx;
}


/* ============================================================
   ★ 主办方模式：Web端风格卡片
   ============================================================ */

/* 状态筛选标签 */
.filter-tabs {
  display: flex;
  padding: 20rpx 24rpx;
  gap: 16rpx;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 10;
  border-bottom: 1rpx solid #eee;
}

.filter-tab {
  font-size: 26rpx;
  color: #666;
  padding: 10rpx 28rpx;
  border-radius: 32rpx;
  background: #f5f5f5;
  transition: all 0.2s;
}

.filter-tab.active {
  color: #2E7D32;
  background: #e8f5e9;
  font-weight: bold;
}

/* 页面标题 */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 30rpx 12rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.page-subtitle {
  font-size: 24rpx;
  color: #999;
}

/* 卡片列表 */
.card-list {
  padding: 0 24rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* ★ Web端风格卡片 */
.tour-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

/* 卡片顶部横幅（渐变背景+Logo） */
.card-banner {
  height: 220rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.banner-default {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.banner-league {
  background: linear-gradient(135deg, #2E7D32 0%, #43A047 50%, #81C784 100%);
}

.banner-cup {
  background: linear-gradient(135deg, #FF9800 0%, #F57C00 100%);
}

.banner-ongoing {
  background: linear-gradient(135deg, #1976D2 0%, #42A5F5 100%);
}

/* 横幅上的标签 */
.badge {
  position: absolute;
  z-index: 2;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.badge-hot {
  top: 18rpx;
  left: 18rpx;
  background: linear-gradient(135deg, #FF6B35, #FF8A00);
  color: #fff;
}

.badge-status {
  top: 18rpx;
  right: 18rpx;
  color: #fff;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.badge-registering { background: #52c41a; }
.badge-ongoing { background: #1890ff; }
.badge-completed { background: #bfbfbf; }
.badge-cancelled { background: #ff4d4f; }

/* 横幅中的Logo */
.card-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.95);
  border: 4rpx solid rgba(255,255,255,0.6);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.15);
}

/* 卡片内容区 */
.card-content {
  padding: 22rpx 24rpx 26rpx;
}

.card-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #1a1a1a;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.3;
  margin-bottom: 12rpx;
}

.card-info-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 16rpx;
}

.info-item {
  font-size: 23rpx;
  color: #888;
}

/* 参赛队伍进度条 */
.team-progress {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.progress-bar {
  flex: 1;
  height: 10rpx;
  background: #eef0f5;
  border-radius: 5rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #2E7D32, #43A047);
  border-radius: 5rpx;
  min-width: 0;
  transition: width 0.3s;
}

.progress-text {
  font-size: 22rpx;
  color: #999;
  white-space: nowrap;
}

/* 创建按钮 */
.create-btn {
  margin-top: 36rpx;
  background: linear-gradient(135deg, #2E7D32, #43A047);
  color: #fff;
  font-size: 28rpx;
  padding: 20rpx 80rpx;
  border-radius: 44rpx;
  border: none;
}
.create-btn::after { border: none; }


/* ============================================================
   教练/裁判模式：原有列表样式
   ============================================================ */

/* 球队信息头 */
.team-header {
  background: linear-gradient(135deg, #2E7D32, #43A047);
  padding: 36rpx 30rpx;
  display: flex;
  align-items: center;
  position: relative;
}

.team-logo {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255,255,255,0.5);
  background: #fff;
  margin-right: 24rpx;
}

.team-name-row {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.team-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #fff;
}

.sub-title {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 4rpx;
}

.match-count-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255,255,255,0.2);
  border-radius: 12rpx;
  padding: 10rpx 20rpx;
}

.count-num {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.count-label {
  font-size: 20rpx;
  color: rgba(255,255,255,0.8);
}

/* 未选择球队 */
.empty-team {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 150rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-title {
  font-size: 32rpx;
  color: #333;
  margin-top: 24rpx;
  font-weight: bold;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  margin-top: 12rpx;
  text-align: center;
}

.go-home-btn {
  margin-top: 36rpx;
  background: #2E7D32;
  color: #fff;
  font-size: 28rpx;
  padding: 18rpx 60rpx;
  border-radius: 44rpx;
  border: none;
}
.go-home-btn::after { border: none; }

/* 区块通用 */
.section {
  background: #fff;
  margin: 20rpx 20rpx 0;
  border-radius: 16rpx;
  overflow: hidden;
}

.section-primary {
  border: 2rpx solid rgba(46,125,50,0.15);
  box-shadow: 0 4rpx 20rpx rgba(46,125,50,0.08);
}

.section-header {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx 16rpx;
}

.title-accent {
  width: 8rpx;
  height: 32rpx;
  background: #2E7D32;
  border-radius: 4rpx;
  margin-right: 14rpx;
}
.title-accent.green { background: #2E7D32; }
.title-accent.orange { background: #FF9800; }

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.more-link, .count-tag {
  font-size: 24rpx;
  color: #999;
}

.count-tag {
  background: #f0f0f0;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  color: #666;
}

/* 即将比赛 */
.match-list {
  padding: 0 20rpx 20rpx;
}

.match-item {
  background: #fafafa;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #f0f0f0;
}
.match-item:last-child { margin-bottom: 0; }

.match-vs {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.side {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}
.side:last-child { justify-content: flex-end; }

.mini-logo {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  background: #eee;
  flex-shrink: 0;
}

.side-name {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.score-box { padding: 0 16rpx; }

.score-txt {
  font-size: 30rpx;
  font-weight: bold;
  color: #2E7D32;
}

.vs-txt {
  font-size: 24rpx;
  color: #bbb;
  font-weight: bold;
}

.match-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #eee;
  font-size: 22rpx;
  color: #999;
}

/* 赛事卡片列表（教练模式） */
.tournament-list {
  padding: 8rpx 16rpx 16rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tournament-card {
  background: #f9f9f9;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
}

.card-top {
  position: relative;
  height: 200rpx;
  background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover-img {
  width: 100%;
  height: 100%;
}

.status-badge {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  color: #fff;
  font-weight: 500;
}
.status-badge.registering { background: #52c41a; }
.status-badge.ongoing { background: #1890ff; }
.status-badge.completed { background: #999; }
.status-badge.cancelled { background: #ff4d4f; }

.roster-badge {
  position: absolute;
  top: 14px;
  left: 14px;
  font-size: 18rpx;
  padding: 3px 12rpx;
  border-radius: 12rpx;
  color: #fff;
  font-weight: 500;
}

.roster-not_submitted,
.roster-drafting { background: #FF9800; }
.roster-submitted,
.roster-pending_approval,
.roster-reviewing { background: #2196F3; }
.roster-approved,
.roster-confirmed { background: #4CAF50; }
.roster-modification_requested,
.roster-rejected { background: #F44336; }

.card-body { padding: 18rpx; }

.tn-name {
  font-size: 29rpx;
  font-weight: bold;
  color: #333;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tn-info { display: flex; flex-direction: column; gap: 6rpx; margin: 10rpx 0; }
.tn-info-item { font-size: 23rpx; color: #888; }

.tn-teams-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 10rpx;
  margin-bottom: 6rpx;
}

.tn-teams-info,
.tn-matches-info { font-size: 22rpx; color: #888; }
.tn-matches-info { color: #2E7D32; font-weight: 500; }

/* 参赛名单提示条 */
.roster-hint {
  display: flex;
  align-items: center;
  background: #FFF8E1;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  margin-top: 10rpx;
  font-size: 22rpx;
}

.roster-hint-icon { margin-right: 8rpx; font-size: 24rpx; }
.roster-hint-text { flex: 1; color: #B08D00; }
.roster-hint-action { color: #E65100; font-weight: bold; font-size: 20rpx; }

.roster-ok { background: #E8F5E9; }
.roster-ok .roster-hint-text { color: #2E7D32; }

.roster-waiting { background: #E3F2FD; }
.roster-waiting .roster-hint-text { color: #1565C0; }

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 20rpx;
}

.empty-icon-sm { font-size: 60rpx; }
.empty-text { font-size: 28rpx; color: #666; margin-top: 16rpx; }
.empty-sub { font-size: 24rpx; color: #bbb; margin-top: 8rpx; }
