@import "../../styles/proto.wxss";

/* Preserve the source image's upper stadium lights and keep lower content legible. */
.stadium-bg{object-position:center top}
.shade{background:linear-gradient(180deg,rgba(0,18,12,.08),rgba(0,35,21,.68) 78%,rgba(0,31,18,.9))}
.page{min-height:100vh;position:relative;overflow:hidden;background:#002818}.stadium-bg,.shade{position:fixed;inset:0;width:100%;height:100%}.shade{background:linear-gradient(180deg,rgba(0,25,16,.22),rgba(0,38,22,.9))}.content{position:relative;z-index:1;padding:200rpx 38rpx calc(145rpx + env(safe-area-inset-bottom))}.teams-hero{display:flex;align-items:center;justify-content:space-between;color:#fff;background:transparent;border-radius:0}.teams-hero-title,.teams-hero-subtitle{display:block}.teams-hero-title{font-size:52rpx;font-weight:900}.teams-hero-subtitle{margin-top:14rpx;font-size:29rpx}.teams-create-button{padding:19rpx 29rpx;border:2rpx solid #00a74d;border-radius:36rpx;color:#fff;font-size:29rpx}.team-list{margin-top:62rpx}.team-card{display:flex;align-items:center;min-height:172rpx;margin-bottom:26rpx;padding:26rpx 26rpx 26rpx 36rpx;border-radius:25rpx;background:rgba(255,255,255,.98);box-sizing:border-box}.team-logo{width:130rpx;height:130rpx;flex:0 0 130rpx}.logo-fallback{padding:30rpx;border-radius:50%;background:#ecf5ef;box-sizing:border-box}.team-main{flex:1;margin-left:30rpx}.team-name{display:block;color:#111712;font-size:37rpx;font-weight:900}.team-metrics{display:flex;flex-wrap:wrap;gap:18rpx;margin-top:16rpx;color:#626a65;font-size:25rpx}.claim-tag{display:inline-block;margin-top:17rpx;padding:7rpx 18rpx;border-radius:18rpx;background:#e5f6e8;color:#168344;font-size:23rpx}.arrow{margin-left:16rpx;color:#757c77;font-size:46rpx}.todo-section{margin-top:74rpx}.todo-title{display:block;padding-left:18rpx;border-left:8rpx solid #09ae5a;color:#fff;font-size:37rpx;font-weight:900}.task-card{display:flex;align-items:center;margin-top:26rpx;padding:27rpx;border-radius:24rpx;background:rgba(255,255,255,.98)}.task-card image{width:62rpx;height:62rpx;margin-right:24rpx;padding:13rpx;border-radius:12rpx;background:#eff7f1}.task-card view{flex:1}.task-card text{display:block;color:#151a16;font-size:29rpx;font-weight:700}.task-card text:nth-child(2){margin-top:12rpx;color:#767e78;font-size:22rpx;font-weight:400}.task-card .todo-status{margin-right:17rpx;color:#ef4034;font-size:25rpx;white-space:nowrap}.empty-card{margin-top:42rpx;padding:46rpx 30rpx;border-radius:24rpx;background:rgba(255,255,255,.97);color:#303832;text-align:center}.empty-card text{display:block;font-size:29rpx}.empty-card text:nth-child(2){margin-top:15rpx;color:#7c847e;font-size:23rpx}.todo-empty{margin-top:26rpx}.loading{margin-top:70rpx;color:#fff;text-align:center}.error-card{margin-top:25rpx;padding:20rpx;border-radius:16rpx;background:#fff0ee;color:#a43e38;font-size:24rpx;text-align:center}
.empty-team-panel{margin:220rpx 14rpx 0;padding:90rpx 52rpx 76rpx;border-radius:28rpx;background:rgba(255,255,255,.98);text-align:center}.empty-mark{width:220rpx;height:220rpx;margin:0 auto}.empty-mark image{width:100%;height:100%}.empty-heading{display:block;margin-top:58rpx;color:#111712;font-size:48rpx;font-weight:900}.empty-copy{display:block;margin-top:27rpx;color:#747b76;font-size:28rpx;line-height:1.75}.empty-create{margin-top:49rpx;background:#058746;color:#fff;border-radius:22rpx;font-size:35rpx;font-weight:800}.invite-note{display:flex;align-items:flex-start;margin:43rpx 14rpx 0;padding:32rpx;border:2rpx solid rgba(47,197,120,.45);border-radius:24rpx;background:rgba(0,55,33,.8);color:#fff}.invite-note image{width:76rpx;height:76rpx;flex:0 0 76rpx;margin:9rpx 26rpx 0 0}.invite-note text{font-size:27rpx;line-height:1.62}
.page-title{position:absolute;top:104rpx;left:0;right:0;color:#fff;font-size:42rpx;font-weight:900;text-align:center}

/* iPhone custom-navigation capsule: keeps a clear gap below the native capsule. */
.content{padding-top:180rpx}
.teams-hero-title{font-size:44rpx}
.teams-hero-subtitle{font-size:27rpx}
.team-list{margin-top:24rpx}
.team-card{min-height:164rpx;padding-top:23rpx;padding-bottom:23rpx}
.team-name{font-size:34rpx}
.task-card{padding-top:19rpx;padding-bottom:19rpx}
.task-card text{font-size:27rpx}
.task-card text:nth-child(2){font-size:20rpx}

/* Consecutive event tasks share one two-row card, matching the approved task group. */
.task-card+.task-card{margin-top:0;border-radius:0 0 24rpx 24rpx;border-top:1rpx solid #e6ebe7}
.task-card:first-of-type{border-radius:24rpx 24rpx 0 0}
.task-card:only-of-type{border-radius:24rpx}

/* Empty-state panel follows the approved y=320 @2 composition and uses the formal brand mark. */
.empty-team-panel{margin-top:180rpx}
.empty-mark{width:290rpx;height:174rpx}
.empty-heading{margin-top:36rpx}
.empty-create{height:96rpx;line-height:96rpx}
