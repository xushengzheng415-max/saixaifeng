page{background:#f3f6f4}.pass-page{padding:28rpx}.state{margin-top:160rpx;text-align:center;color:#748078}.state text{display:block}.state button{margin-top:24rpx;background:#08783f;color:#fff}.pass-card{overflow:hidden;padding:0 34rpx 34rpx;border-radius:20rpx;background:#fff;text-align:center;box-shadow:0 10rpx 34rpx rgba(8,72,42,.12)}.pass-head{margin:0 -34rpx 28rpx;padding:24rpx 30rpx;background:#075f37;color:#fff;display:flex;justify-content:space-between;font-size:24rpx}.portrait{width:156rpx;height:196rpx;object-fit:cover;background:#eaf2ed}.portrait.empty{display:flex;align-items:center;justify-content:center;margin:0 auto;color:#8b968f}.name,.number,.match,.meta,.certificate{display:block}.name{margin-top:18rpx;font-size:38rpx;font-weight:800}.number{margin-top:8rpx;color:#4d6958;font-size:24rpx}.qr{width:390rpx;height:390rpx;margin:24rpx auto 12rpx}.match{font-size:28rpx;font-weight:700}.meta,.certificate{margin-top:8rpx;color:#748078;font-size:22rpx}.notice{margin-top:18rpx;padding:20rpx;background:#eaf6ef;color:#275940;border-radius:10rpx;font-size:24rpx;line-height:1.5}
