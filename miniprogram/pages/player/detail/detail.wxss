/* pages/player/detail/detail.wxss */
.detail-container {
  background: #f5f7fa;
  min-height: 100vh;
}

/* 头部区域 */
.header-section {
  position: relative;
  background: linear-gradient(135deg, #2E7D32 0%, #4CAF50 100%);
  padding-bottom: 80rpx;
  overflow: hidden;
}

.header-background {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.05) 100%);
  opacity: 0.3;
}

.player-info {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 60rpx;
}

.player-photo-wrapper {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  border: 4rpx solid white;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
  margin-bottom: 24rpx;
  background: #f5f5f5;
}

.player-photo {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.player-details {
  text-align: center;
  color: white;
}

.player-name {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.player-jersey {
  display: block;
  font-size: 28rpx;
  opacity: 0.9;
  font-weight: 500;
}

/* 信息卡片 */
.info-card {
  margin: 20rpx;
  background: white;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  overflow: hidden;
}

.card-header {
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #e0e0e0;
  background: #fafafa;
}

.card-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.card-content {
  padding: 32rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  text-align: right;
  max-width: 60%;
  word-break: break-all;
}

/* 球队信息 */
.team-info {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.team-logo-wrapper {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  border: 1rpx solid #e0e0e0;
}

.team-logo-small {
  width: 60rpx;
  height: 60rpx;
}

.team-details {
  flex: 1;
}

.team-name {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 4rpx;
}

.team-level {
  display: block;
  font-size: 24rpx;
  color: #666;
}

/* 技术特点 */
.features-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.feature-item {
  background: #e8f5e9;
  color: #2E7D32;
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.feature-text {
  display: block;
}

/* 比赛记录 */
.match-list {
  border-top: 1rpx solid #f0f0f0;
}

.match-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.match-item:last-child {
  border-bottom: none;
}

.match-info {
  flex: 1;
}

.match-date {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.match-team {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.match-stats {
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.match-stat {
  font-size: 26rpx;
  color: #2E7D32;
  font-weight: 500;
  background: #e8f5e9;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

/* 操作按钮 */
.action-section {
  margin: 20rpx;
  padding-bottom: 40rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  transition: all 0.3s ease;
}

.action-btn.primary {
  background: linear-gradient(135deg, #2E7D32 0%, #4CAF50 100%);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(46, 125, 50, 0.3);
}

.action-btn.primary:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(46, 125, 50, 0.3);
}

.action-btn.secondary {
  background: linear-gradient(135deg, #FF6F00 0%, #FF8F00 100%);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(255, 111, 0, 0.3);
}

.action-btn.secondary:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(255, 111, 0, 0.3);
}

.btn-icon {
  font-size: 32rpx;
}

.btn-text {
  font-size: 30rpx;
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .card-content {
    padding: 24rpx;
  }
  
  .info-item {
    padding: 16rpx 0;
  }
  
  .info-label {
    font-size: 26rpx;
  }
  
  .info-value {
    font-size: 26rpx;
    max-width: 55%;
  }
  
  .match-item {
    flex-direction: column;
    align-items: flex-start;
    gap: 16rpx;
  }
  
  .match-stats {
    align-self: stretch;
    justify-content: space-between;
  }
  
  .action-btn {
    padding: 20rpx;
    font-size: 28rpx;
  }
}

/* 空状态 */
.empty-state {
  padding: 80rpx 40rpx;
  text-align: center;
  color: #999;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.empty-subtext {
  font-size: 24rpx;
  opacity: 0.8;
}