@import "../../../styles/proto.wxss";

.page{min-height:100vh;background:#1a1206;padding:28rpx 30rpx calc(120rpx + env(safe-area-inset-bottom))}

/* 球队卡 */
.team-card{display:flex;align-items:center;padding:24rpx 22rpx;border-radius:24rpx;background:linear-gradient(160deg,#b46e0a,#6e4105);border:2rpx solid rgba(255,195,90,.3)}
.team-card-empty{justify-content:center;color:rgba(255,255,255,.6);font-size:26rpx}
.team-logo{width:80rpx;height:80rpx;flex:0 0 80rpx;border-radius:16rpx;background:rgba(255,255,255,.15)}
.team-main{flex:1;margin-left:20rpx;min-width:0}
.team-label{display:block;color:rgba(255,220,160,.7);font-size:22rpx}
.team-name{display:block;margin-top:4rpx;color:#fff;font-size:32rpx;font-weight:800;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.team-badge{padding:6rpx 16rpx;border-radius:14rpx;background:rgba(255,255,255,.15);color:#ffd580;font-size:20rpx;font-weight:700}

/* 轻提示 */
.tip-bar{display:flex;align-items:center;margin-top:20rpx;padding:18rpx 20rpx;border-radius:18rpx;background:rgba(255,195,90,.12);border:2rpx solid rgba(255,195,90,.3);color:#ffd580;font-size:24rpx}
.tip-icon{font-size:28rpx;margin-right:10rpx}
.tip-text{flex:1}

/* 表单 */
.form-card{margin-top:24rpx;padding:10rpx 0;border-radius:20rpx;background:rgba(255,255,255,.06);border:2rpx solid rgba(255,255,255,.08)}
.form-item{padding:28rpx 28rpx;border-bottom:2rpx solid rgba(255,255,255,.06)}
.form-item:last-child{border-bottom:none}
.form-label{display:block;color:rgba(255,220,160,.72);font-size:24rpx;font-weight:600;margin-bottom:16rpx}

.form-picker{display:inline-block;padding:16rpx 24rpx;border-radius:16rpx;background:rgba(255,255,255,.1);margin-right:14rpx}
.picker-text{color:#fff;font-size:28rpx;font-weight:600}
.form-picker-pill{display:inline-block;padding:16rpx 24rpx;border-radius:32rpx;background:rgba(255,195,90,.25);border:2rpx solid rgba(255,195,90,.4)}
.picker-pill-text{color:#ffd580;font-size:26rpx;font-weight:700}

.form-input{width:100%;padding:18rpx 22rpx;border-radius:16rpx;background:rgba(255,255,255,.1);color:#fff;font-size:28rpx;box-sizing:border-box}
.form-placeholder{color:rgba(255,255,255,.32)}

/* 场地地图选点与常用场地 */
.venue-presets{margin-bottom:16rpx}
.venue-presets-label{display:block;color:rgba(255,220,160,.55);font-size:21rpx;margin-bottom:10rpx}
.venue-preset-list{display:flex;flex-wrap:wrap}
.venue-preset{max-width:100%;margin:0 12rpx 12rpx 0;padding:10rpx 20rpx;border-radius:14rpx;background:rgba(255,255,255,.12);color:#ffe0a8;font-size:23rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.venue-preset:active{background:rgba(255,195,90,.3)}
.venue-row{display:flex;align-items:center}
.venue-input{flex:1;min-width:0}
.venue-map-btn{flex:0 0 auto;margin-left:14rpx;padding:18rpx 24rpx;border-radius:16rpx;background:rgba(255,195,90,.22);border:2rpx solid rgba(255,195,90,.42)}
.venue-map-btn-text{color:#ffd580;font-size:26rpx;font-weight:700}
.venue-selected{display:flex;align-items:center;justify-content:space-between;margin-top:14rpx;padding:14rpx 18rpx;border-radius:14rpx;background:rgba(120,220,170,.12)}
.venue-selected-text{flex:1;color:rgba(255,255,255,.72);font-size:23rpx;line-height:1.5;margin-right:16rpx}
.venue-nav-btn{flex:0 0 auto;padding:8rpx 22rpx;border-radius:14rpx;background:#0aa85a;color:#fff;font-size:23rpx;font-weight:700}

/* Stepper */
.stepper{display:inline-flex;align-items:center;border-radius:16rpx;background:rgba(255,255,255,.1);overflow:hidden}
.stepper-btn{width:72rpx;height:72rpx;display:flex;align-items:center;justify-content:center;color:#fff;font-size:40rpx;font-weight:700;background:rgba(0,0,0,.15)}
.stepper-btn:active{background:rgba(0,0,0,.3)}
.stepper-value{min-width:80rpx;text-align:center;color:#fff;font-size:30rpx;font-weight:800}
.form-note{margin-left:16rpx;color:rgba(255,220,160,.48);font-size:22rpx}

/* 生成按钮 */
.generate-btn{margin-top:48rpx;height:112rpx;display:flex;align-items:center;justify-content:center;border-radius:28rpx;background:linear-gradient(135deg,#e88a0c,#b46e0a);box-shadow:0 16rpx 36rpx rgba(232,138,12,.35)}
.generate-btn.is-disabled{background:rgba(255,255,255,.12);box-shadow:none}
.generate-btn-text{color:#fff;font-size:34rpx;font-weight:900;letter-spacing:2rpx}

/* 说明 */
.notes{margin-top:28rpx;padding:0 16rpx}
.note-item{display:block;color:rgba(255,220,160,.45);font-size:22rpx;line-height:1.8}

/* ===== 报名海报弹层 ===== */
.poster-mask{position:fixed;left:0;top:0;width:100%;height:100%;background:rgba(10,26,19,.72);z-index:900;display:flex;align-items:flex-end}
.poster-sheet{width:100%;box-sizing:border-box;max-height:92vh;display:flex;flex-direction:column;background:#0F1A14;border-radius:28rpx 28rpx 0 0;padding:26rpx 30rpx calc(24rpx + env(safe-area-inset-bottom))}
.poster-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx}
.poster-title{flex:1;min-width:0;color:#fff;font-size:32rpx;font-weight:900}
.poster-close{flex:0 0 auto;color:rgba(255,255,255,.6);font-size:24rpx;padding:6rpx 12rpx}

.poster-frame{margin-top:20rpx;flex:1;min-height:0;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.05);border-radius:20rpx;padding:16rpx;box-sizing:border-box}
.poster-image{width:100%;border-radius:16rpx;display:block}
.poster-loading{color:rgba(255,220,160,.6);font-size:24rpx;padding:120rpx 0}

.poster-note{display:block;margin-top:18rpx;color:rgba(255,220,160,.6);font-size:23rpx;line-height:1.6;text-align:center}

.poster-actions{display:flex;align-items:center;gap:16rpx;margin-top:22rpx}
.poster-btn{flex:1;height:88rpx;border-radius:20rpx;display:flex;align-items:center;justify-content:center}
.poster-btn-primary{background:linear-gradient(135deg,#12A35F,#087A48)}
.poster-btn-ghost{background:rgba(255,255,255,.1);border:2rpx solid rgba(255,255,255,.18)}
.poster-btn-text{color:#fff;font-size:28rpx;font-weight:900}
.poster-btn-text-ghost{color:rgba(255,255,255,.82);font-size:26rpx;font-weight:700}

.poster-link-row{margin-top:20rpx;display:flex;align-items:center;justify-content:center;padding:14rpx 0}
.poster-link-text{color:#7BD3A2;font-size:24rpx;font-weight:700}

/* 画布离屏：只用于绘制导出，不占版面 */
.poster-canvas{position:fixed;left:-3000px;top:0}
