@import "../../styles/proto.wxss";

.page{min-height:100vh;position:relative;overflow:hidden;background:#002818}
.stadium-bg,.shade{position:fixed;inset:0;width:100%;height:100%}
.stadium-bg{object-position:center top}
.shade{background:linear-gradient(180deg,rgba(0,18,12,.10),rgba(0,35,21,.72) 62%,rgba(0,31,18,.94))}
.content{position:relative;z-index:1;padding:180rpx 34rpx calc(170rpx + env(safe-area-inset-bottom))}
.page-title{position:absolute;top:104rpx;left:0;right:0;color:#fff;font-size:42rpx;font-weight:900;text-align:center}

/* 记一场主操作 */
.record-hero{margin-top:20rpx;padding:36rpx 32rpx 32rpx;border:2rpx solid rgba(72,214,132,.42);border-radius:30rpx;background:linear-gradient(160deg,rgba(6,84,49,.96),rgba(3,52,31,.98))}
.record-hero-head{display:flex;align-items:center;justify-content:space-between}
.record-hero-title{color:#fff;font-size:46rpx;font-weight:900;letter-spacing:1rpx}
.record-hero-tag{padding:7rpx 16rpx;border-radius:16rpx;background:rgba(88,220,146,.18);color:#7fe0a8;font-size:21rpx}
.record-hero-copy{display:block;margin-top:16rpx;color:rgba(255,255,255,.66);font-size:25rpx;line-height:1.62}
.record-team{display:flex;align-items:center;margin-top:28rpx;padding:20rpx 22rpx;border-radius:20rpx;background:rgba(255,255,255,.07)}
.record-team-logo{width:76rpx;height:76rpx;flex:0 0 76rpx;border-radius:16rpx;background:rgba(255,255,255,.12)}
.record-team-main{flex:1;margin-left:20rpx}
.record-team-label{display:block;color:rgba(255,255,255,.52);font-size:21rpx}
.record-team-name{display:block;margin-top:6rpx;color:#fff;font-size:31rpx;font-weight:800}
.record-btn{margin-top:28rpx;height:104rpx;display:flex;align-items:center;justify-content:center;border-radius:24rpx;background:#0aa85a;box-shadow:0 12rpx 28rpx rgba(0,0,0,.22)}
.record-btn-text{color:#fff;font-size:36rpx;font-weight:900;letter-spacing:2rpx}
.record-btn.is-disabled{background:rgba(255,255,255,.14)}
.record-btn.is-disabled .record-btn-text{color:rgba(255,255,255,.45)}
.record-hint{display:block;margin-top:16rpx;color:rgba(255,255,255,.48);font-size:22rpx;text-align:center}
.guest-tip{margin-top:16rpx;padding:16rpx 20rpx;border:2rpx solid rgba(88,220,146,.42);border-radius:18rpx;background:rgba(88,220,146,.1);text-align:center}
.guest-tip text{color:#8df0b4;font-size:24rpx;font-weight:700}

/* 区块通用 */
.section{margin-top:56rpx}
.section-head{display:flex;align-items:baseline;justify-content:space-between;padding-left:18rpx;border-left:8rpx solid #09ae5a}
.section-title{color:#fff;font-size:35rpx;font-weight:900}
.section-sub{color:rgba(255,255,255,.5);font-size:21rpx}

/* 赛事预告 */
.event-list{margin-top:22rpx}
.event-card{display:flex;align-items:center;padding:24rpx;margin-bottom:18rpx;border-radius:22rpx;background:rgba(255,255,255,.97)}
.event-logo{width:84rpx;height:84rpx;flex:0 0 84rpx;border-radius:16rpx;background:#f1f6f2}
.event-main{flex:1;margin-left:20rpx;min-width:0}
.event-name{display:block;color:#131a15;font-size:29rpx;font-weight:800;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.event-meta{display:block;margin-top:9rpx;color:#78807a;font-size:22rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.event-status{flex:0 0 auto;margin-left:14rpx;padding:7rpx 16rpx;border-radius:16rpx;background:#e7f6ec;color:#0c8a4a;font-size:21rpx;font-weight:700}

/* 球队动态 */
.recent-list{margin-top:22rpx}
.recent-card{display:flex;align-items:center;padding:24rpx;margin-bottom:18rpx;border-radius:22rpx;background:rgba(255,255,255,.97)}
.recent-score{flex:0 0 150rpx;display:flex;flex-direction:column;align-items:center}
.recent-score-text{color:#101711;font-size:36rpx;font-weight:900;letter-spacing:1rpx}
.recent-result{margin-top:8rpx;padding:3rpx 14rpx;border-radius:12rpx;font-size:20rpx;font-weight:800}
.recent-result.win{background:#e7f6ec;color:#0c8a4a}
.recent-result.draw{background:#eef1ef;color:#5d6660}
.recent-result.lose{background:#fdeceb;color:#c0423a}
.recent-main{flex:1;margin-left:16rpx;min-width:0}
.recent-title{display:block;color:#131a15;font-size:28rpx;font-weight:800;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.recent-meta{display:block;margin-top:8rpx;color:#78807a;font-size:21rpx}
.recent-scorer{display:block;margin-top:7rpx;color:#0c8a4a;font-size:21rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.recent-arrow{margin-left:10rpx;color:#a9b1ab;font-size:40rpx}

/* 空态与错误 */
.empty-card{margin-top:22rpx;padding:44rpx 28rpx;border-radius:22rpx;background:rgba(255,255,255,.94);color:#7d857f;font-size:25rpx;text-align:center}
.error-card{margin-top:26rpx;padding:20rpx;border-radius:16rpx;background:#fff0ee;color:#a43e38;font-size:23rpx;text-align:center}
