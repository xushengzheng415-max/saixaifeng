/* pages/discover/discover.wxss
 * 发现一级页（动态／赛事／约球）
 * 设计令牌：主色 #087A48 / 正文 #162D22 / 辅助 #7C8B82 / 页面底 #F5F7F6 / 浅绿 #EAF6EE / 边界 #E7EEE9
 * 换算：390px 视口设计值 × 1.92 ≈ rpx（16px→31rpx、12px→23rpx、8px→15rpx、14px→27rpx、11px→21rpx）
 */

.page{min-height:100vh;background:#F5F7F6;padding-bottom:calc(170rpx + env(safe-area-inset-bottom));box-sizing:border-box}

/* ===== 顶部页框 ===== */
.topbar{padding-left:31rpx;padding-right:31rpx;background:#F5F7F6}
.title-row{display:flex;align-items:center;gap:16rpx;height:66rpx}
.page-title{font-size:46rpx;line-height:1.1;font-weight:900;color:#162D22;letter-spacing:1rpx}
.page-role{font-size:21rpx;line-height:1.4;font-weight:700;color:#087A48;background:#EAF6EE;border-radius:8rpx;padding:4rpx 12rpx}
.tool-row{display:flex;align-items:center;gap:16rpx;padding:8rpx 0 18rpx}

.city-chip{display:flex;align-items:center;gap:6rpx;height:64rpx;padding:0 14rpx;border-radius:15rpx;background:#fff;border:1rpx solid #E7EEE9;flex:0 0 auto;max-width:200rpx;box-sizing:border-box}
.city-icon{width:24rpx;height:24rpx;flex:0 0 24rpx}
.city-text{font-size:23rpx;color:#162D22;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

.search-box{flex:1;min-width:0;height:64rpx;display:flex;align-items:center;gap:10rpx;padding:0 18rpx;border-radius:15rpx;background:#fff;border:1rpx solid #E7EEE9;box-sizing:border-box}
.search-icon{width:26rpx;height:26rpx;flex:0 0 26rpx}
.search-input{flex:1;min-width:0;height:64rpx;line-height:64rpx;font-size:25rpx;color:#162D22}
.search-placeholder{color:#A7B3AC;font-size:24rpx}
.search-clear{flex:0 0 auto;font-size:21rpx;color:#7C8B82;padding:4rpx 2rpx 4rpx 8rpx}
/* 约球、转会栏没有检索接口：输入框禁用并降对比，避免看起来能搜其实不生效 */
.search-box-disabled{background:#EFF3F1;border-color:#E7EEE9}
.search-box-disabled .search-input{color:#A7B3AC}
.search-box-disabled .search-placeholder{color:#B7C2BB}

.record-btn{flex:0 0 auto;height:64rpx;padding:0 20rpx;border-radius:15rpx;display:flex;align-items:center;justify-content:center;background:#087A48;box-shadow:0 6rpx 14rpx rgba(8,122,72,.22);box-sizing:border-box}
.record-btn-text{font-size:25rpx;font-weight:900;color:#fff;letter-spacing:1rpx}
.record-btn-disabled{background:#B9CBC1;box-shadow:none}

/* ===== 四个顶部分栏 ===== */
.tab-row{display:flex;align-items:stretch;padding:0 31rpx;background:#F5F7F6;border-bottom:1rpx solid #E7EEE9}
.tab-item{flex:1;display:flex;flex-direction:column;align-items:center;padding-top:16rpx}
.tab-text{font-size:29rpx;font-weight:600;color:#7C8B82;padding-bottom:14rpx;line-height:1.3}
.tab-text-active{font-size:30rpx;font-weight:900;color:#087A48}
.tab-line{width:46rpx;height:5rpx;border-radius:3rpx;background:transparent}
.tab-line-active{background:#087A48}

/* ===== 当前栏筛选 ===== */
.filter-row{display:flex;align-items:center;justify-content:space-between;padding:18rpx 31rpx 4rpx}
.chip-row{display:flex;align-items:center;gap:14rpx;flex:1;min-width:0;overflow:hidden}
.chip{height:48rpx;padding:0 20rpx;border-radius:24rpx;background:#fff;border:1rpx solid #E7EEE9;display:flex;align-items:center;justify-content:center;flex:0 0 auto;box-sizing:border-box}
.chip-text{font-size:22rpx;font-weight:600;color:#7C8B82;white-space:nowrap}
.chip-active{background:#EAF6EE;border-color:#087A48}
.chip-active .chip-text{font-weight:800;color:#087A48}
.publish-entry{flex:0 0 auto;margin-left:14rpx;font-size:23rpx;font-weight:700;color:#7C8B82;padding:8rpx 4rpx}

/* ===== 系统提示条 ===== */
.guest-strip{margin:14rpx 31rpx 0;padding:14rpx 18rpx;border-radius:10rpx;background:#fff;border:1rpx solid #E7EEE9;display:flex;align-items:center;gap:14rpx}
.guest-strip-text{flex:1;min-width:0;font-size:21rpx;color:#7C8B82;line-height:1.55}
.guest-strip-action{flex:0 0 auto;font-size:22rpx;font-weight:800;color:#087A48;padding:4rpx 6rpx}
.page-error{margin:14rpx 31rpx 0;padding:16rpx 18rpx;border-radius:10rpx;background:#FDECEA}
.page-error-text{font-size:21rpx;color:#A43E38;line-height:1.55}
.notice-strip{margin:18rpx 31rpx 0;padding:14rpx 18rpx;border-radius:10rpx;background:#EAF6EE}
.notice-strip-text{font-size:21rpx;color:#087A48;line-height:1.55}

/* ===== 发布面板（低权重，仅动态栏出现） ===== */
.publish-panel{margin:14rpx 31rpx 0;padding:4rpx 20rpx 16rpx;border-radius:15rpx;background:#fff;border:1rpx solid #E7EEE9}
.publish-item{padding:18rpx 0;border-bottom:1rpx solid #E7EEE9}
.publish-item-title{display:block;font-size:26rpx;font-weight:800;color:#162D22}
.publish-item-desc{display:block;margin-top:4rpx;font-size:21rpx;color:#7C8B82;line-height:1.5}
.publish-close{display:block;margin-top:12rpx;text-align:center;font-size:21rpx;color:#7C8B82;padding:6rpx 0}

/* ===== 动态卡片（战报） ===== */
.card-list{padding:0 31rpx}
.feed-card{margin-top:18rpx;padding:24rpx;border-radius:15rpx;background:#fff;border:1rpx solid #E7EEE9}
.feed-head{display:flex;align-items:center;gap:14rpx}
.feed-logo{width:60rpx;height:60rpx;flex:0 0 60rpx;border-radius:12rpx;background:#F5F7F6}
.feed-head-main{flex:1;min-width:0;display:flex;flex-direction:column;gap:4rpx}
.feed-publisher{font-size:27rpx;font-weight:800;color:#162D22;line-height:1.3;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.feed-time{font-size:21rpx;color:#7C8B82}
.feed-source{flex:0 0 auto;font-size:20rpx;font-weight:700;color:#087A48;background:#EAF6EE;border-radius:8rpx;padding:4rpx 10rpx}
.feed-body{display:flex;align-items:center;gap:18rpx;margin-top:18rpx}
.feed-score{flex:0 0 152rpx;display:flex;flex-direction:column;align-items:center;gap:6rpx}
.feed-score-text{font-size:34rpx;font-weight:900;color:#162D22;letter-spacing:1rpx;line-height:1.2}
.feed-result{padding:2rpx 12rpx;border-radius:8rpx;font-size:19rpx;font-weight:800}
.result-win{background:#EAF6EE;color:#087A48}
.result-draw{background:#EFF3F1;color:#5F6E66}
.result-lose{background:#FDECEA;color:#C0423A}
.feed-main{flex:1;min-width:0;display:flex;flex-direction:column;gap:6rpx}
.feed-title{font-size:28rpx;font-weight:800;color:#162D22;line-height:1.35;word-break:break-all}
.feed-meta{font-size:21rpx;color:#7C8B82}
.feed-scorer{font-size:21rpx;color:#087A48;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.feed-actions{display:flex;align-items:center;justify-content:flex-end;gap:14rpx;margin-top:16rpx;padding-top:16rpx;border-top:1rpx solid #E7EEE9}
.feed-action{font-size:21rpx;font-weight:800;color:#087A48;background:#EAF6EE;border-radius:10rpx;padding:8rpx 16rpx}
.feed-action.danger{color:#C0423A;background:#FDECEA}

/* ===== 赛事卡片 ===== */
.event-card{margin-top:18rpx;border-radius:15rpx;background:#fff;border:1rpx solid #E7EEE9;overflow:hidden}
.event-cover-wrap{position:relative;width:100%;height:300rpx;background:#EFF3F1}
.event-cover{width:100%;height:100%;display:block}
.event-badge{position:absolute;left:18rpx;top:18rpx;padding:6rpx 14rpx;border-radius:8rpx;background:rgba(22,45,34,.62);color:#fff;font-size:20rpx;font-weight:700;line-height:1.4}
.event-body{padding:22rpx 24rpx 24rpx;display:flex;flex-direction:column;gap:8rpx}
.event-title-row{display:flex;align-items:flex-start;gap:14rpx}
.event-name{flex:1;min-width:0;font-size:31rpx;font-weight:900;color:#162D22;line-height:1.35;word-break:break-all}
.event-status{flex:0 0 auto;margin-top:4rpx;padding:5rpx 14rpx;border-radius:8rpx;font-size:20rpx;font-weight:800;line-height:1.4;background:#fff;color:#087A48;border:1rpx solid #E7EEE9}
.event-status-live{background:#087A48;color:#fff;border-color:#087A48}
.event-status-signup{background:#EAF6EE;color:#087A48;border-color:#EAF6EE}
.event-status-done{background:#EFF3F1;color:#5F6E66;border-color:#EFF3F1}
.event-status-wait{background:#fff;color:#7C8B82;border-color:#E7EEE9}
.event-meta{font-size:21rpx;color:#7C8B82;line-height:1.5}
.event-host{font-size:21rpx;color:#7C8B82;line-height:1.5}
.event-actions{display:flex;align-items:center;gap:16rpx;margin-top:8rpx}
.event-btn{flex:1;height:80rpx;border-radius:15rpx;display:flex;align-items:center;justify-content:center;box-sizing:border-box}
.event-btn-outline{background:#fff;border:1rpx solid #087A48}
.event-btn-solid{background:#087A48}
.event-btn-text{font-size:25rpx;font-weight:800;color:#fff}
.event-btn-text-outline{color:#087A48}

/* ===== 约球 ===== */
.invite-card{margin:18rpx 31rpx 0;padding:28rpx;border-radius:15rpx;background:#fff;border:1rpx solid #E7EEE9;display:flex;flex-direction:column;gap:10rpx}
.invite-title{font-size:31rpx;font-weight:900;color:#162D22;line-height:1.35}
.invite-desc{font-size:23rpx;color:#7C8B82;line-height:1.6}
.invite-btn{margin-top:12rpx;height:72rpx;border-radius:15rpx;display:flex;align-items:center;justify-content:center;background:#087A48}
.invite-btn-disabled{background:#B9CBC1}
.invite-btn-text{font-size:27rpx;font-weight:900;color:#fff}

/* 本队邀约列表：只读卡片，状态由截止时间与报名人数预计算 */
.invite-item{margin-top:18rpx;padding:24rpx;border-radius:15rpx;background:#fff;border:1rpx solid #E7EEE9;display:flex;flex-direction:column;gap:10rpx}
.invite-item-head{display:flex;align-items:flex-start;gap:14rpx}
.invite-item-title{flex:1;min-width:0;font-size:29rpx;font-weight:900;color:#162D22;line-height:1.35}
.invite-status{flex:0 0 auto;margin-top:2rpx;padding:5rpx 14rpx;border-radius:8rpx;font-size:20rpx;font-weight:800;line-height:1.4;background:#fff;color:#7C8B82;border:1rpx solid #E7EEE9}
.invite-status-open{background:#EAF6EE;color:#087A48;border-color:#EAF6EE}
.invite-status-full{background:#5F6E66;color:#fff;border-color:#5F6E66}
.invite-status-closed{background:#EFF3F1;color:#5F6E66;border-color:#EFF3F1}
.invite-status-cancelled{background:#FDECEA;color:#C0423A;border-color:#FDECEA}
.invite-item-row{display:flex;align-items:center;gap:10rpx}
.invite-item-icon{width:24rpx;height:24rpx;flex:0 0 24rpx}
.invite-item-venue{flex:1;min-width:0;font-size:23rpx;color:#162D22;line-height:1.5;word-break:break-all}
.invite-item-address{font-size:21rpx;color:#7C8B82;line-height:1.5;padding-left:34rpx;word-break:break-all}
.invite-item-foot{display:flex;align-items:center;justify-content:space-between;gap:14rpx;margin-top:4rpx;padding-top:14rpx;border-top:1rpx solid #E7EEE9}
.invite-item-signup{font-size:21rpx;font-weight:800;color:#087A48}
.invite-item-deadline{font-size:20rpx;color:#7C8B82}
.invite-item-cry{font-size:21rpx;color:#5F6E66;background:#F5F7F6;border-radius:10rpx;padding:12rpx 16rpx;line-height:1.6;word-break:break-all}
.invite-item-created{font-size:20rpx;color:#A7B3AC}

/* 约球范围切换：本队管理视角 / 跨队公开撮合 */
.scope-row{display:flex;align-items:center;gap:6rpx;margin:18rpx 31rpx 0;padding:6rpx;border-radius:15rpx;background:#EFF3F1}
.scope-item{flex:1;height:64rpx;border-radius:12rpx;display:flex;align-items:center;justify-content:center}
.scope-item-active{background:#fff;box-shadow:0 2rpx 8rpx rgba(22,45,34,.08)}
.scope-text{font-size:25rpx;font-weight:700;color:#7C8B82}
.scope-item-active .scope-text{font-weight:900;color:#087A48}

/* 公开约球：同城筛选条 */
.public-filter{display:flex;align-items:center;justify-content:space-between;gap:14rpx;margin:18rpx 31rpx 0;padding:0 18rpx;height:64rpx;border-radius:15rpx;background:#fff;border:1rpx solid #E7EEE9;box-sizing:border-box}
.public-city{display:flex;align-items:center;gap:8rpx;flex:1;min-width:0}
.public-city-icon{width:24rpx;height:24rpx;flex:0 0 24rpx}
.public-city-text{flex:1;min-width:0;font-size:22rpx;font-weight:700;color:#162D22;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.public-city-btn{flex:0 0 auto;font-size:21rpx;font-weight:800;color:#087A48;background:#EAF6EE;border-radius:10rpx;padding:8rpx 14rpx}

/* 公开约球卡片：队名与城市在上，应战按钮在底部 */
.public-item{margin-top:18rpx;padding:24rpx;border-radius:15rpx;background:#fff;border:1rpx solid #E7EEE9;display:flex;flex-direction:column;gap:10rpx}
.public-item-head{display:flex;align-items:center;gap:14rpx}
.public-item-logo{width:60rpx;height:60rpx;flex:0 0 60rpx;border-radius:12rpx;background:#F5F7F6}
.public-item-team-box{flex:1;min-width:0;display:flex;flex-direction:column;gap:4rpx}
.public-item-team{font-size:27rpx;font-weight:900;color:#162D22;line-height:1.3;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.public-item-city{font-size:20rpx;color:#7C8B82}
.public-badge{flex:0 0 auto;font-size:19rpx;font-weight:800;color:#087A48;background:#EAF6EE;border-radius:8rpx;padding:4rpx 12rpx}
.public-item-title{font-size:29rpx;font-weight:900;color:#162D22;line-height:1.35}
.public-action{margin-top:6rpx;height:72rpx;border-radius:15rpx;background:#087A48;display:flex;align-items:center;justify-content:center}
.public-action-done{background:#EFF3F1}
.public-action-text{font-size:25rpx;font-weight:900;color:#fff;letter-spacing:1rpx}
.public-action-done .public-action-text{color:#7C8B82}

/* 本队邀约：应战队伍行 */
.invite-response-row{display:flex;align-items:center;justify-content:space-between;gap:14rpx;margin-top:2rpx}
.invite-response-text{flex:1;min-width:0;font-size:21rpx;font-weight:700;color:#5F6E66}
.invite-response-btn{flex:0 0 auto;font-size:21rpx;font-weight:800;color:#087A48;background:#EAF6EE;border-radius:10rpx;padding:8rpx 16rpx}

/* ===== 状态卡与尾部提示 ===== */
.state-card{margin:18rpx 31rpx 0;padding:40rpx 28rpx;border-radius:15rpx;background:#fff;border:1rpx solid #E7EEE9;display:flex;flex-direction:column;align-items:center;gap:10rpx}
.state-title{font-size:27rpx;font-weight:800;color:#162D22;text-align:center;line-height:1.4}
.state-desc{font-size:22rpx;color:#7C8B82;line-height:1.6;text-align:center}
.state-btn{margin-top:6rpx;height:64rpx;padding:0 32rpx;border-radius:15rpx;background:#EAF6EE;border:1rpx solid #087A48;display:flex;align-items:center;justify-content:center}
.state-btn-text{font-size:23rpx;font-weight:800;color:#087A48}
.refresh-strip,.end-strip{display:flex;align-items:center;justify-content:center;padding:18rpx 31rpx 0}
.refresh-strip-text,.end-strip-text{font-size:21rpx;color:#A7B3AC}

/* ===== 转会公开市场（发现根目录独立分栏，按 2026-10-27 拆解原型） ===== */
/* 01 范围筛选：赛事／年龄类型／时间。接口未接入时只做说明，不做看起来能筛的假控件 */
.market-scope{display:flex;align-items:center;gap:14rpx;padding:20rpx 31rpx 0}
.scope-chip{flex:1;min-width:0;height:60rpx;border-radius:12rpx;background:#fff;border:1rpx solid #E7EEE9;display:flex;align-items:center;justify-content:center;gap:6rpx;box-sizing:border-box}
.scope-chip-text{font-size:23rpx;font-weight:700;color:#162D22;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.scope-caret{flex:0 0 auto;font-size:19rpx;color:#7C8B82}
.market-scope-note{display:block;padding:10rpx 31rpx 0;font-size:19rpx;color:#A7B3AC;line-height:1.5}
/* 已选范围用高亮区分：赛事与年龄段为真实筛选，时间范围仍为全部 */
.scope-chip-active{background:#EAF6EE;border-color:#087A48}
.scope-chip-active .scope-chip-text{color:#087A48}

/* 02b 范围选择面板：底部弹层，选项列表可滚动 */
.scope-mask{position:fixed;left:0;top:0;width:100%;height:100%;background:rgba(10,26,19,.42);z-index:800}
.scope-sheet{position:fixed;left:0;right:0;bottom:0;z-index:801;box-sizing:border-box;max-height:72vh;display:flex;flex-direction:column;background:#fff;border-radius:24rpx 24rpx 0 0;padding:26rpx 31rpx calc(24rpx + env(safe-area-inset-bottom));box-shadow:0 -12rpx 40rpx rgba(10,26,19,.16)}
.scope-sheet-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx}
.scope-sheet-title{flex:1;min-width:0;font-size:32rpx;font-weight:900;color:#162D22;line-height:1.3}
.scope-sheet-close{flex:0 0 auto;font-size:23rpx;font-weight:700;color:#7C8B82;padding:6rpx 10rpx}
.scope-sheet-desc{display:block;margin-top:8rpx;font-size:20rpx;color:#A7B3AC;line-height:1.5}
.scope-sheet-list{margin-top:16rpx;max-height:56vh}
.scope-option{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:12rpx;padding:22rpx 20rpx;border-radius:14rpx;background:#F7F9F8;border:1rpx solid transparent;box-sizing:border-box}
.scope-option-active{background:#EAF6EE;border-color:#087A48}
.scope-option-text{flex:1;min-width:0;font-size:25rpx;font-weight:700;color:#162D22;line-height:1.4;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.scope-option-active .scope-option-text{font-weight:900;color:#087A48}
.scope-option-check{flex:0 0 auto;font-size:24rpx;font-weight:900;color:#087A48}

/* 模块标题：标题 + 右侧注解 */
.section-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:30rpx 31rpx 16rpx}
.section-title{flex:0 0 auto;font-size:34rpx;font-weight:900;color:#162D22;letter-spacing:1rpx;line-height:1.2}
.section-note{flex:0 0 auto;font-size:21rpx;color:#7C8B82}

/* 02 转会焦点：背景图 + 深绿遮罩，文字与流向全部由数据渲染 */
.spotlight{position:relative;margin:0 31rpx;border-radius:20rpx;overflow:hidden;background:#0B3B2A}
.spotlight-bg{position:absolute;left:0;top:0;width:100%;height:100%}
.spotlight-mask{position:absolute;left:0;top:0;width:100%;height:100%;background:linear-gradient(118deg,rgba(6,50,33,.95) 0%,rgba(8,74,47,.86) 52%,rgba(8,122,72,.58) 100%)}
.spotlight-body{position:relative;box-sizing:border-box;min-height:336rpx;padding:22rpx 26rpx 20rpx;display:flex;flex-direction:column}
.spotlight-top{display:flex;align-items:center;gap:12rpx}
.spotlight-badge{flex:0 0 auto;font-size:19rpx;font-weight:800;color:#3A2A05;background:#F6C445;border-radius:6rpx;padding:4rpx 12rpx;line-height:1.4}
.spotlight-state{flex:0 0 auto;margin-left:auto;font-size:19rpx;font-weight:700;color:rgba(255,255,255,.84)}
.spotlight-title{display:block;margin-top:14rpx;font-size:32rpx;font-weight:900;color:#fff;line-height:1.32;word-break:break-all}
.spotlight-flow{display:flex;align-items:center;gap:16rpx;margin-top:20rpx}
.flow-team{flex:1;min-width:0;display:flex;flex-direction:column;align-items:center;gap:8rpx}
.flow-crest{width:62rpx;height:62rpx;border-radius:14rpx;background:rgba(255,255,255,.14);border:1rpx solid rgba(255,255,255,.3);box-sizing:border-box}
.flow-crest-empty{display:flex;align-items:center;justify-content:center}
.flow-crest-initial{font-size:26rpx;font-weight:900;color:#fff}
.flow-name{max-width:100%;font-size:21rpx;font-weight:700;color:rgba(255,255,255,.92);line-height:1.35;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;word-break:break-all}
