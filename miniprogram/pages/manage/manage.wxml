<!--pages/manage/manage.wxml-->
<!--赛小蜂 - 主办方管理后台（对应网页端菜单）-->

<view class="container">
  <!-- 顶部统计卡片 -->
  <view class="stats-row">
    <view class="stat-card">
      <text class="stat-num">{{stats.tournamentCount}}</text>
      <text class="stat-label">赛事</text>
    </view>
    <view class="stat-card">
      <text class="stat-num">{{stats.teamCount}}</text>
      <text class="stat-label">球队</text>
    </view>
    <view class="stat-card">
      <text class="stat-num">{{stats.refereeCount}}</text>
      <text class="stat-label">裁判</text>
    </view>
    <view class="stat-card">
      <text class="stat-num">{{stats.coachCount}}</text>
      <text class="stat-label">教练</text>
    </view>
  </view>

  <!-- 功能菜单（和网页端菜单相辅相成） -->
  <view class="menu-group">
    <view class="menu-group-title">赛事管理</view>
    <view class="menu-grid">
      <view class="menu-card" bindtap="goTo" data-url="/pages/tournament/create/create">
        <view class="menu-icon-wrap" style="background:#E8F5E9">
          <text class="menu-icon-text">🏆</text>
        </view>
        <text class="menu-card-text">创建赛事</text>
      </view>
      <view class="menu-card" bindtap="goTo" data-url="/pages/tournament-center/tournament-center">
        <view class="menu-icon-wrap" style="background:#E3F2FD">
          <text class="menu-icon-text">📋</text>
        </view>
        <text class="menu-card-text">我的赛事</text>
      </view>
    </view>
  </view>

  <view class="menu-group">
    <view class="menu-group-title">人员管理</view>
    <view class="menu-grid">
      <view class="menu-card" bindtap="goTo" data-url="/pages/team/team">
        <view class="menu-icon-wrap" style="background:#FFF3E0">
          <text class="menu-icon-text">⚽</text>
        </view>
        <text class="menu-card-text">球队管理</text>
      </view>
      <view class="menu-card" bindtap="goTo" data-url="/pages/referee/index">
        <view class="menu-icon-wrap" style="background:#F3E5F5">
          <text class="menu-icon-text">📞</text>
        </view>
        <text class="menu-card-text">裁判管理</text>
      </view>
      <view class="menu-card" bindtap="goToCoachList">
        <view class="menu-icon-wrap" style="background:#E0F7FA">
          <text class="menu-icon-text">📞</text>
        </view>
        <text class="menu-card-text">教练组</text>
      </view>
    </view>
  </view>

  <view class="menu-group">
    <view class="menu-group-title">数据</view>
    <view class="menu-grid">
      <view class="menu-card" bindtap="goToDashboard">
        <view class="menu-icon-wrap" style="background:#FCE4EC">
          <text class="menu-icon-text">📊</text>
        </view>
        <text class="menu-card-text">数据概览</text>
      </view>
    </view>
  </view>
</view>
