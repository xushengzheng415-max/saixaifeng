<!-- pages/manage/manage.wxml -->
<view class="container">
  <view class="dashboard-hero">
    <view class="hero-topline">
      <text class="hero-kicker">主办方工作台</text>
      <text class="hero-badge">赛事运营</text>
    </view>
    <text class="hero-title">管理后台</text>
    <text class="hero-subtitle">赛事、球队、裁判与数据统一管理</text>
  </view>

  <view class="stats-grid">
    <view class="stat-card stat-green">
      <view class="stat-head">
        <text class="stat-label">赛事</text>
        <text class="stat-mark">赛</text>
      </view>
      <text class="stat-num">{{stats.tournamentCount}}</text>
    </view>
    <view class="stat-card stat-blue">
      <view class="stat-head">
        <text class="stat-label">球队</text>
        <text class="stat-mark">队</text>
      </view>
      <text class="stat-num">{{stats.teamCount}}</text>
    </view>
    <view class="stat-card stat-gold">
      <view class="stat-head">
        <text class="stat-label">裁判</text>
        <text class="stat-mark">裁</text>
      </view>
      <text class="stat-num">{{stats.refereeCount}}</text>
    </view>
    <view class="stat-card stat-pink">
      <view class="stat-head">
        <text class="stat-label">教练</text>
        <text class="stat-mark">教</text>
      </view>
      <text class="stat-num">{{stats.coachCount}}</text>
    </view>
  </view>

  <view class="section-block">
    <view class="section-head">
      <text class="section-title">赛事管理</text>
    </view>
    <view class="action-grid">
      <view class="action-card action-primary" bindtap="goTo" data-url="/pages/tournament/create/create">
        <view class="action-icon icon-green">＋</view>
        <view class="action-copy">
          <text class="action-title">创建赛事</text>
          <text class="action-sub">新建赛事档案</text>
        </view>
        <text class="action-arrow">›</text>
      </view>
      <view class="action-card" bindtap="goTo" data-url="/pages/tournament-center/tournament-center">
        <view class="action-icon icon-blue">赛</view>
        <view class="action-copy">
          <text class="action-title">我的赛事</text>
          <text class="action-sub">查看赛事列表</text>
        </view>
        <text class="action-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="section-block">
    <view class="section-head">
      <text class="section-title">人员管理</text>
    </view>
    <view class="action-grid">
      <view class="action-card" bindtap="goTo" data-url="/pages/team/team">
        <view class="action-icon icon-gold">队</view>
        <view class="action-copy">
          <text class="action-title">球队管理</text>
          <text class="action-sub">球队资料与阵容</text>
        </view>
        <text class="action-arrow">›</text>
      </view>
      <view class="action-card" bindtap="goTo" data-url="/pages/referee/index">
        <view class="action-icon icon-pink">裁</view>
        <view class="action-copy">
          <text class="action-title">裁判管理</text>
          <text class="action-sub">裁判库维护</text>
        </view>
        <text class="action-arrow">›</text>
      </view>
      <view class="action-card" bindtap="goToCoachList">
        <view class="action-icon icon-cyan">教</view>
        <view class="action-copy">
          <text class="action-title">教练组</text>
          <text class="action-sub">教练成员管理</text>
        </view>
        <text class="action-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="section-block section-last">
    <view class="section-head">
      <text class="section-title">数据</text>
    </view>
    <view class="action-grid">
      <view class="action-card" bindtap="goToDashboard">
        <view class="action-icon icon-purple">数</view>
        <view class="action-copy">
          <text class="action-title">数据概览</text>
          <text class="action-sub">赛事运营指标</text>
        </view>
        <text class="action-arrow">›</text>
      </view>
    </view>
  </view>
</view>
