/* pages/manage/manage.wxss */
/* 赛小蜂 - 主办方管理后台样式 */

.container {
  padding: 24rpx;
  background: #F5F6FA;
  min-height: 100vh;
}

/* ===== 统计卡片行 ===== */
.stats-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.stat-card {
  flex: 1;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #2E7D32;
  line-height: 1.2;
}

.stat-label {
  font-size: 22rpx;
  color: #9E9E9E;
  margin-top: 6rpx;
}

/* ===== 功能菜单 ===== */
.menu-group {
  margin-bottom: 32rpx;
}

.menu-group-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #424242;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.menu-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 16rpx;
}

.menu-card {
  width: calc(50% - 8rpx);
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 20rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.menu-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.menu-icon-text {
  font-size: 36rpx;
}

.menu-card-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #424242;
}
