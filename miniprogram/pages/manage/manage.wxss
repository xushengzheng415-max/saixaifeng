/* pages/manage/manage.wxss */
page {
  background: #f3f6f4;
}

.container {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 24rpx 24rpx 40rpx;
  background: #f3f6f4;
}

.dashboard-hero {
  box-sizing: border-box;
  min-height: 208rpx;
  padding: 28rpx 30rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #17652a 0%, #2f8f46 58%, #86b84d 100%);
  color: #fff;
  box-shadow: 0 16rpx 34rpx rgba(23, 101, 42, 0.22);
}

.hero-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.hero-kicker {
  font-size: 24rpx;
  color: rgba(255,255,255,0.78);
}

.hero-badge {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.16);
  color: rgba(255,255,255,0.9);
  font-size: 22rpx;
}

.hero-title {
  display: block;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.2;
}

.hero-subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 25rpx;
  color: rgba(255,255,255,0.76);
  line-height: 1.5;
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 22rpx;
}

.stat-card {
  box-sizing: border-box;
  width: calc(50% - 9rpx);
  min-height: 146rpx;
  margin-bottom: 18rpx;
  padding: 22rpx 22rpx 18rpx;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(27, 45, 34, 0.06);
  border: 1rpx solid rgba(31, 72, 45, 0.05);
}

.stat-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #6f7b72;
  font-weight: 600;
}

.stat-mark {
  width: 42rpx;
  height: 42rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
}

.stat-num {
  display: block;
  font-size: 44rpx;
  line-height: 1;
  font-weight: 800;
  color: #1e3225;
}

.stat-green .stat-mark { background: #e5f5e8; color: #1f7a34; }
.stat-blue .stat-mark { background: #e5f0ff; color: #2368b8; }
.stat-gold .stat-mark { background: #fff4d8; color: #9b6b00; }
.stat-pink .stat-mark { background: #ffe8ef; color: #bd3f69; }

.section-block {
  margin-top: 12rpx;
}

.section-last {
  padding-bottom: 20rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 12rpx 4rpx 16rpx;
}

.section-title {
  position: relative;
  padding-left: 18rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #24352a;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 8rpx;
  width: 6rpx;
  height: 24rpx;
  border-radius: 999rpx;
  background: #2f8f46;
}

.action-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.action-card {
  box-sizing: border-box;
  width: calc(50% - 9rpx);
  min-height: 150rpx;
  margin-bottom: 18rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(27, 45, 34, 0.06);
  border: 1rpx solid rgba(31, 72, 45, 0.05);
  display: flex;
  align-items: center;
}

.action-primary {
  background: linear-gradient(135deg, #ffffff 0%, #edf8ef 100%);
  border-color: rgba(47, 143, 70, 0.12);
}

.action-icon {
  width: 66rpx;
  height: 66rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 18rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.icon-green { background: #e5f5e8; color: #1f7a34; }
.icon-blue { background: #e5f0ff; color: #2368b8; }
.icon-gold { background: #fff4d8; color: #9b6b00; }
.icon-pink { background: #ffe8ef; color: #bd3f69; }
.icon-cyan { background: #e3f7f7; color: #177a7a; }
.icon-purple { background: #efe9ff; color: #6b46b8; }

.action-copy {
  min-width: 0;
  flex: 1;
}

.action-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #24352a;
  line-height: 1.35;
}

.action-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #879188;
  line-height: 1.35;
}

.action-arrow {
  margin-left: 10rpx;
  color: #b8c0ba;
  font-size: 36rpx;
  line-height: 1;
}
