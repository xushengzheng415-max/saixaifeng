@import "../../../styles/proto.wxss";

.page{min-height:100vh;position:relative;overflow:hidden;background:#002818}
.stadium-bg,.shade{position:fixed;inset:0;width:100%;height:100%}
.stadium-bg{object-position:center top}
.shade{background:linear-gradient(180deg,rgba(0,16,11,.42),rgba(0,32,19,.9) 58%,rgba(0,26,16,.97))}
.content{position:relative;z-index:1;padding:150rpx 34rpx calc(60rpx + env(safe-area-inset-bottom))}

/* 自定义返回键（navigationStyle:custom 时系统返回键不显示） */
.nav-back{position:fixed;left:20rpx;top:calc(env(safe-area-inset-top) + 12rpx);z-index:20;width:72rpx;height:72rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;background:rgba(0,0,0,.32);border:2rpx solid rgba(255,255,255,.18)}
.nav-back-arrow{width:20rpx;height:20rpx;border-left:4rpx solid #fff;border-bottom:4rpx solid #fff;transform:rotate(45deg);margin-left:8rpx}

/* ===== 准备 ===== */
.prepare-card{padding:40rpx 32rpx 36rpx;border:2rpx solid rgba(72,214,132,.36);border-radius:30rpx;background:linear-gradient(165deg,rgba(7,88,51,.96),rgba(3,50,30,.98))}
.prepare-title{display:block;color:#fff;font-size:48rpx;font-weight:900}
.prepare-copy{display:block;margin-top:14rpx;color:rgba(255,255,255,.6);font-size:24rpx;line-height:1.6}
.prepare-team{display:flex;align-items:center;margin-top:32rpx;padding:22rpx;border-radius:22rpx;background:rgba(255,255,255,.08)}
.prepare-logo{width:92rpx;height:92rpx;flex:0 0 92rpx;border-radius:18rpx;background:rgba(255,255,255,.12)}
.prepare-team-main{flex:1;margin-left:22rpx}
.prepare-team-label{display:block;color:rgba(255,255,255,.5);font-size:21rpx}
.prepare-team-name{display:block;margin-top:7rpx;color:#fff;font-size:34rpx;font-weight:800}
.opponent-input{margin-top:24rpx;height:96rpx;padding:0 26rpx;border:2rpx solid rgba(255,255,255,.2);border-radius:20rpx;background:rgba(255,255,255,.07);color:#fff;font-size:30rpx}
.opponent-placeholder{color:rgba(255,255,255,.36)}
.start-btn{margin-top:32rpx;height:110rpx;display:flex;align-items:center;justify-content:center;border-radius:26rpx;background:#0aa85a;box-shadow:0 14rpx 30rpx rgba(0,0,0,.24)}
.start-btn-text{color:#fff;font-size:38rpx;font-weight:900;letter-spacing:3rpx}
.prepare-note{display:block;margin-top:18rpx;color:rgba(255,255,255,.42);font-size:22rpx;text-align:center}

/* 对局设置分段选择 */
.seg-block{margin-top:26rpx;padding:22rpx 24rpx;border-radius:22rpx;background:rgba(255,255,255,.07)}
.seg-row{display:flex;align-items:center;margin-top:14rpx}
.seg-row:first-child{margin-top:0}
.seg-label{flex:0 0 84rpx;color:rgba(255,255,255,.55);font-size:23rpx}
.seg-group{flex:1;display:flex;flex-wrap:wrap}
.seg-item{min-width:96rpx;height:60rpx;padding:0 18rpx;margin:6rpx 12rpx 6rpx 0;display:flex;align-items:center;justify-content:center;border-radius:16rpx;background:rgba(255,255,255,.1);border:2rpx solid transparent}
.seg-item.active{background:rgba(10,168,90,.28);border:2rpx solid rgba(88,220,146,.65)}
.seg-item-text{color:rgba(255,255,255,.75);font-size:23rpx;font-weight:600}
.seg-item.active .seg-item-text{color:#8df0b4}

/* ===== 记分 ===== */
.record-head{display:flex;align-items:center;justify-content:space-between;padding:0 8rpx}
.record-clock{color:#fff;font-size:52rpx;font-weight:900;letter-spacing:2rpx}
.record-mode{padding:8rpx 18rpx;border-radius:16rpx;background:rgba(88,220,146,.16);color:#7fe0a8;font-size:21rpx}
.record-sub{display:block;margin-top:10rpx;padding:0 8rpx;color:rgba(255,255,255,.45);font-size:21rpx}
.clock-controls{display:flex;margin-top:22rpx}
.ctrl-btn{flex:1;height:84rpx;display:flex;align-items:center;justify-content:center;border:2rpx solid rgba(255,255,255,.3);border-radius:22rpx;background:rgba(255,255,255,.1)}
.ctrl-btn+.ctrl-btn{margin-left:18rpx}
.ctrl-btn.primary{background:#0aa85a;border-color:transparent}
.ctrl-btn-text{color:#fff;font-size:28rpx;font-weight:800;letter-spacing:2rpx}
.break-btn{flex:1;height:96rpx;display:flex;align-items:center;justify-content:center;border-radius:24rpx;background:#0aa85a;box-shadow:0 12rpx 26rpx rgba(0,0,0,.22)}
.break-btn-text{color:#fff;font-size:32rpx;font-weight:900;letter-spacing:2rpx}
.score-board{display:flex;align-items:stretch;margin-top:36rpx;border-radius:32rpx;overflow:hidden}
.score-side{flex:1;display:flex;flex-direction:column;align-items:center;padding:30rpx 18rpx 26rpx;background:linear-gradient(170deg,rgba(8,92,54,.96),rgba(3,48,29,.98))}
.score-divider{width:2rpx;background:rgba(255,255,255,.1)}
.score-team{color:rgba(255,255,255,.78);font-size:26rpx;font-weight:700;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.score-num{margin-top:18rpx;color:#fff;font-size:120rpx;line-height:1.05;font-weight:900;letter-spacing:2rpx}
.score-plus{margin-top:26rpx;width:100%;height:190rpx;display:flex;align-items:center;justify-content:center;border-radius:24rpx;background:#0aa85a;box-shadow:inset 0 -8rpx 0 rgba(0,0,0,.14)}
.score-plus:active{transform:scale(.97);background:#0bbd65}
.score-plus-text{color:#fff;font-size:72rpx;font-weight:900}
.score-tip{margin-top:14rpx;color:rgba(255,255,255,.4);font-size:20rpx}
.finish-btn{margin-top:36rpx;height:104rpx;display:flex;align-items:center;justify-content:center;border:2rpx solid rgba(255,255,255,.34);border-radius:26rpx;background:rgba(255,255,255,.1)}
.finish-btn-text{color:#fff;font-size:33rpx;font-weight:800;letter-spacing:2rpx}
.scorer-summary{margin-top:34rpx;padding:26rpx 28rpx;border-radius:22rpx;background:rgba(255,255,255,.1)}
.scorer-summary-title{display:block;color:rgba(255,255,255,.6);font-size:22rpx}
.scorer-row{display:flex;align-items:center;justify-content:space-between;margin-top:16rpx}
.scorer-row-name{color:#fff;font-size:27rpx;font-weight:700}
.scorer-row-minute{color:#7fe0a8;font-size:24rpx}

/* ===== 战报 ===== */
.report-status{margin-top:8rpx;text-align:center}
.report-card{padding:44rpx 32rpx 36rpx;border:2rpx solid rgba(72,214,132,.4);border-radius:32rpx;background:linear-gradient(165deg,rgba(8,94,55,.97),rgba(2,44,27,.99));text-align:center}
.report-tag{display:inline-block;padding:7rpx 18rpx;border-radius:14rpx;background:rgba(88,220,146,.16);color:#7fe0a8;font-size:21rpx}
.report-teams{display:flex;align-items:center;justify-content:center;margin-top:30rpx}
.report-team{flex:1;color:#fff;font-size:26rpx;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.report-score{margin:0 18rpx;color:#fff;font-size:64rpx;font-weight:900;letter-spacing:2rpx;white-space:nowrap}
.report-result{display:inline-block;margin-top:22rpx;padding:6rpx 24rpx;border-radius:16rpx;font-size:24rpx;font-weight:800}
.report-result.win{background:rgba(88,220,146,.2);color:#8df0b4}
.report-result.draw{background:rgba(255,255,255,.14);color:#dfe6e1}
.report-result.lose{background:rgba(255,120,110,.18);color:#ff9f97}
.report-meta{display:block;margin-top:18rpx;color:rgba(255,255,255,.55);font-size:23rpx}
.report-story{display:block;margin-top:20rpx;padding:20rpx 24rpx;border-radius:18rpx;background:rgba(255,255,255,.08);color:rgba(255,255,255,.85);font-size:25rpx;line-height:1.75}
.report-scorers{margin-top:30rpx;padding-top:24rpx;border-top:1rpx solid rgba(255,255,255,.12);text-align:left}
.report-scorers-title{display:block;color:rgba(255,255,255,.55);font-size:22rpx}
.report-scorer{display:flex;align-items:center;justify-content:space-between;margin-top:14rpx}
.report-scorer-name{color:#fff;font-size:26rpx;font-weight:600}
.report-scorer-minute{color:#7fe0a8;font-size:23rpx}
.report-empty{display:block;margin-top:26rpx;color:rgba(255,255,255,.4);font-size:23rpx}
.report-state{display:block;margin-top:28rpx;color:rgba(255,255,255,.5);font-size:21rpx}
.report-retry{display:inline-block;margin-top:16rpx;padding:10rpx 28rpx;border:2rpx solid rgba(255,255,255,.32);border-radius:18rpx;color:#fff;font-size:23rpx}
.share-btn{margin-top:30rpx;height:104rpx;display:flex;align-items:center;justify-content:center;border-radius:26rpx;background:#0aa85a;color:#fff;font-size:34rpx;font-weight:900;letter-spacing:2rpx;border:none}
.share-btn::after{border:none}
.report-actions{display:flex;margin-top:20rpx}
.ghost-btn{flex:1;height:92rpx;display:flex;align-items:center;justify-content:center;border:2rpx solid rgba(255,255,255,.24);border-radius:22rpx;color:rgba(255,255,255,.82);font-size:27rpx}
.ghost-btn+.ghost-btn{margin-left:18rpx}

/* ===== 进球者选择 ===== */
.scorer-mask{position:fixed;inset:0;z-index:20;background:rgba(0,0,0,.52)}
.scorer-sheet{position:fixed;left:0;right:0;bottom:0;z-index:21;padding:30rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));border-radius:30rpx 30rpx 0 0;background:#fff}
.scorer-sheet-head{display:flex;align-items:center;justify-content:space-between}
.scorer-sheet-title{color:#131a15;font-size:31rpx;font-weight:800}
.scorer-skip{color:#0c8a4a;font-size:26rpx;font-weight:700}
.scorer-scroll{margin-top:26rpx;white-space:nowrap}
.scorer-item{display:inline-flex;flex-direction:column;align-items:center;width:132rpx;margin-right:18rpx;vertical-align:top}
.scorer-avatar{width:104rpx;height:104rpx;border-radius:52rpx;background:#eef2ef}
.scorer-name{display:block;margin-top:12rpx;width:132rpx;color:#1a211c;font-size:23rpx;text-align:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

/* ===== Canvas 战报海报（9:16） ===== */
.poster-wrap{margin-bottom:24rpx}
.poster-canvas{width:100%;height:1212rpx;border-radius:24rpx}
.poster-actions{margin-top:16rpx;display:flex;flex-wrap:wrap;justify-content:center;gap:14rpx}
.poster-action-btn{margin:0;padding:0 26rpx;height:72rpx;line-height:72rpx;border-radius:36rpx;background:rgba(255,255,255,.14);color:#fff;font-size:26rpx;font-weight:700;border:2rpx solid rgba(255,255,255,.26)}
.poster-action-btn.ai{background:rgba(88,220,146,.2);border-color:rgba(88,220,146,.5);color:#8df0b4}
.poster-action-btn.style{background:rgba(255,210,122,.16);border-color:rgba(255,210,122,.5);color:#ffd27a}
.poster-action-btn[disabled]{opacity:.6;color:#8df0b4}
.poster-action-btn::after{border:none}
