/* packageA/pages/lineup/lineup.wxss */
.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #0F1A0F;
  color: white;
}

/* 顶部信息栏 */
.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 24rpx;
  background: rgba(27, 94, 32, 0.9);
  border-bottom: 1rpx solid rgba(255,255,255,0.1);
}

.match-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.team-name {
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.vs {
  color: #FFD700;
  font-size: 24rpx;
}

.formation-selector {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  background: rgba(255,255,255,0.15);
  border-radius: 8rpx;
  font-size: 26rpx;
}

.arrow {
  font-size: 20rpx;
  color: #FFD700;
}

/* 主体区域 */
.main-area {
  flex: 1;
  display: flex;
  flex-direction: row;
  overflow: hidden;
}

/* 左侧：足球场区域 */
.field-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  position: relative;
}

.field-container {
  position: relative;
  width: 100%;
  max-width: 800rpx;
  aspect-ratio: 1.6 / 1;
  border-radius: 12rpx;
  overflow: hidden;
  background: #1B5E20;
}

.field-bg {
  width: 100%;
  height: 100%;
}

/* 阵型位置层 */
.positions-layer {
  position: absolute;
  left: 7%;
  top: 5%;
  width: 86%;
  height: 90%;
}

.position-slot {
  position: absolute;
  width: 72rpx;
  height: 72rpx;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: all 0.2s;
}

.position-slot.empty {
  background: rgba(255,255,255,0.1);
  border: 2rpx dashed rgba(255,255,255,0.3);
}

.position-slot.empty:active {
  background: rgba(255,255,255,0.2);
  border-color: #FFD700;
}

.position-slot.filled {
  background: rgba(255,255,255,0.95);
  border: 2rpx solid #1B5E20;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.3);
}

.jersey {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  background: #1B5E20;
  border-radius: 50%;
  border: 2rpx solid #FFD700;
}

.jersey-number {
  color: white;
  font-size: 24rpx;
  font-weight: 700;
}

.empty-slot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
}

.plus {
  font-size: 40rpx;
  color: rgba(255,255,255,0.5);
  font-weight: 300;
}

.position-label {
  font-size: 18rpx;
  color: rgba(255,255,255,0.9);
  margin-top: 4rpx;
  text-align: center;
  text-shadow: 0 1rpx 4rpx rgba(0,0,0,0.8);
}

/* 已选计数 */
.selection-count {
  position: absolute;
  bottom: 24rpx;
  left: 50%;
  transform: translateX(-50%);
  padding: 8rpx 24rpx;
  background: rgba(0,0,0,0.7);
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #FFD700;
  font-weight: 600;
}

/* 右侧：球员面板 */
.player-panel {
  width: 420rpx;
  background: #1A2E1A;
  border-left: 1rpx solid rgba(255,255,255,0.1);
  display: flex;
  flex-direction: column;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  background: rgba(27, 94, 32, 0.8);
  border-bottom: 1rpx solid rgba(255,255,255,0.1);
}

.panel-title {
  font-size: 26rpx;
  font-weight: 600;
  color: white;
}

.panel-close {
  font-size: 32rpx;
  color: rgba(255,255,255,0.6);
  padding: 8rpx;
}

/* 搜索框 */
.search-box {
  padding: 12rpx 16rpx;
}

.search-input {
  width: 100%;
  height: 64rpx;
  padding: 0 20rpx;
  background: rgba(255,255,255,0.1);
  border: 1rpx solid rgba(255,255,255,0.2);
  border-radius: 8rpx;
  color: white;
  font-size: 26rpx;
}

.search-input::placeholder {
  color: rgba(255,255,255,0.4);
}

/* 球员列表 */
.player-list {
  flex: 1;
  padding: 0 12rpx;
}

.player-item {
  display: flex;
  align-items: center;
  padding: 16rpx;
  margin-bottom: 8rpx;
  background: rgba(255,255,255,0.05);
  border-radius: 8rpx;
  transition: all 0.2s;
}

.player-item:active {
  background: rgba(255,255,255,0.1);
}

.player-item.selected {
  background: rgba(27, 94, 32, 0.4);
  border: 1rpx solid #43A047;
}

.player-jersey {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1B5E20;
  border-radius: 50%;
  border: 2rpx solid #FFD700;
  color: white;
  font-size: 24rpx;
  font-weight: 700;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.player-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.player-name {
  font-size: 26rpx;
  color: white;
  font-weight: 500;
}

.player-position {
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
  margin-top: 4rpx;
}

.player-status {
  flex-shrink: 0;
}

.status-badge {
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.status-badge:not(.substitute) {
  background: #1B5E20;
  color: #81C784;
}

.status-badge.substitute {
  background: #E65100;
  color: #FFCC80;
}

/* 空状态 */
.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 300rpx;
  color: rgba(255,255,255,0.4);
  font-size: 26rpx;
}

/* 面板底部 */
.panel-footer {
  padding: 16rpx;
  border-top: 1rpx solid rgba(255,255,255,0.1);
}

.btn-remove {
  width: 100%;
  height: 72rpx;
  background: rgba(244, 67, 54, 0.2);
  color: #EF5350;
  border: 1rpx solid rgba(244, 67, 54, 0.4);
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
}

/* 替补面板 */
.substitute-panel {
  width: 420rpx;
  background: #1A2E1A;
  border-left: 1rpx solid rgba(255,255,255,0.1);
  display: flex;
  flex-direction: column;
}

.panel-subtitle {
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
  margin-top: 4rpx;
}

.sub-list {
  flex: 1;
  padding: 0 12rpx;
}

.sub-item {
  display: flex;
  align-items: center;
  padding: 14rpx 16rpx;
  margin-bottom: 8rpx;
  background: rgba(255,255,255,0.05);
  border-radius: 8rpx;
}

.sub-jersey {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #E65100;
  border-radius: 50%;
  color: white;
  font-size: 22rpx;
  font-weight: 700;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.sub-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.sub-name {
  font-size: 24rpx;
  color: white;
}

.sub-position {
  font-size: 20rpx;
  color: rgba(255,255,255,0.5);
  margin-top: 2rpx;
}

.sub-remove {
  font-size: 28rpx;
  color: rgba(255,255,255,0.4);
  padding: 8rpx;
}

.sub-remove:active {
  color: #EF5350;
}

/* 添加替补空框 */
.add-slot {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  margin-bottom: 8rpx;
  background: rgba(255,255,255,0.03);
  border: 2rpx dashed rgba(255,255,255,0.2);
  border-radius: 8rpx;
}

.add-icon {
  font-size: 48rpx;
  color: rgba(255,255,255,0.3);
  font-weight: 300;
}

.add-text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.4);
  margin-top: 8rpx;
}

/* 底部操作栏 */
.bottom-bar {
  display: flex;
  gap: 20rpx;
  padding: 16rpx 24rpx;
  background: rgba(0,0,0,0.8);
  border-top: 1rpx solid rgba(255,255,255,0.1);
}

.btn-cancel {
  flex: 1;
  height: 80rpx;
  background: rgba(255,255,255,0.1);
  color: white;
  border: 1rpx solid rgba(255,255,255,0.3);
  border-radius: 8rpx;
  font-size: 28rpx;
}

.btn-submit {
  flex: 2;
  height: 80rpx;
  background: linear-gradient(135deg, #1B5E20, #43A047);
  color: white;
  border: none;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.btn-submit.disabled {
  background: rgba(255,255,255,0.1);
  color: rgba(255,255,255,0.3);
}

/* 阵型选择弹窗 */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.picker-modal {
  width: 600rpx;
  max-height: 70vh;
  background: #1A2E1A;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255,255,255,0.1);
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: rgba(27, 94, 32, 0.8);
}

.modal-title {
  font-size: 30rpx;
  font-weight: 600;
  color: white;
}

.modal-close {
  font-size: 36rpx;
  color: rgba(255,255,255,0.6);
  padding: 8rpx;
}

.formation-grid {
  padding: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  overflow-y: auto;
  max-height: 55vh;
}

.formation-item {
  width: calc(50% - 8rpx);
  padding: 20rpx;
  background: rgba(255,255,255,0.05);
  border-radius: 8rpx;
  text-align: center;
  transition: all 0.2s;
}

.formation-item:active {
  background: rgba(27, 94, 32, 0.3);
}

.formation-item.selected {
  background: rgba(27, 94, 32, 0.4);
  border: 1rpx solid #43A047;
}

.formation-name {
  font-size: 28rpx;
  color: white;
  font-weight: 600;
}

.formation-desc {
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
  margin-top: 4rpx;
}

/* 提交成功弹窗 */
.success-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.success-modal {
  width: 500rpx;
  padding: 48rpx 40rpx;
  background: #1A2E1A;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255,255,255,0.1);
  text-align: center;
}

.success-icon {
  font-size: 80rpx;
  color: #4CAF50;
  margin-bottom: 24rpx;
}

.success-title {
  font-size: 32rpx;
  font-weight: 600;
  color: white;
  margin-bottom: 16rpx;
}

.success-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
  margin-bottom: 32rpx;
}

.btn-confirm {
  width: 100%;
  height: 80rpx;
  background: linear-gradient(135deg, #1B5E20, #43A047);
  color: white;
  border: none;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
}
