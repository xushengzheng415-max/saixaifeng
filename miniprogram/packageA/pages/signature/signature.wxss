/* pages/signature/signature.wxss */
.signature-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 比赛信息 */
.match-info {
  background: linear-gradient(135deg, #1B5E20, #43A047);
  color: #fff;
  padding: 32rpx;
  text-align: center;
}
.match-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}
.match-meta {
  font-size: 26rpx;
  opacity: 0.9;
}

/* 签字区域 */
.canvas-section {
  margin: 32rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}
.canvas-wrapper {
  position: relative;
  width: 100%;
  height: 400rpx;
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
  background: #fafafa;
  overflow: hidden;
}
.signature-canvas {
  width: 100%;
  height: 100%;
}
.canvas-placeholder {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}
.placeholder-text {
  font-size: 32rpx;
  color: #ccc;
  letter-spacing: 4rpx;
}
.canvas-actions {
  margin-top: 20rpx;
  display: flex;
  justify-content: flex-end;
}
.btn-clear {
  font-size: 26rpx;
  color: #f44336;
  background: #fff;
  border: 1rpx solid #f44336;
  border-radius: 8rpx;
  padding: 8rpx 32rpx;
  line-height: 1.8;
}

/* 预览 */
.preview-section {
  margin: 0 24rpx 32rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
}
.preview-img {
  width: 100%;
  height: 200rpx;
  border: 1rpx solid #eee;
  border-radius: 8rpx;
}

/* 提交 */
.submit-section {
  margin: 0 24rpx;
  padding-bottom: 40rpx;
}
.btn-submit {
  width: 100%;
  background: linear-gradient(135deg, #1B5E20, #43A047);
  color: #fff;
  border: none;
  border-radius: 12rpx;
  font-size: 32rpx;
  padding: 24rpx 0;
  font-weight: 600;
}
.btn-submit[loading] {
  opacity: 0.7;
}

/* 成功状态 */
.success-section {
  margin: 0 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 80rpx 32rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
}
.success-icon {
  font-size: 100rpx;
  color: #4CAF50;
  margin-bottom: 24rpx;
}
.success-text {
  font-size: 36rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.success-hint {
  font-size: 26rpx;
  color: #999;
}
