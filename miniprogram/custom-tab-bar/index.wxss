.tab-bar{display:flex;align-items:flex-start;justify-content:space-around;height:106rpx;padding:11rpx 0 env(safe-area-inset-bottom);border-top:1rpx solid rgba(8,122,72,.08);background:rgba(255,255,255,.98);box-sizing:content-box}.tab-item{height:94rpx;flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-start}.tab-icon{display:block;width:48rpx;height:48rpx;opacity:.86;transition:opacity .18s ease,transform .18s ease}.tab-text{margin-top:5rpx;color:#77837b;font-size:21rpx;line-height:1.25}.tab-item.active .tab-icon{opacity:1;transform:translateY(-2rpx)}.tab-item.active .tab-text{color:#087A48;font-weight:700}
