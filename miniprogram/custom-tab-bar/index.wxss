.tab-bar{position:fixed;left:0;right:0;bottom:0;z-index:1000;display:flex;align-items:flex-start;justify-content:space-around;height:118rpx;padding:10rpx 0 env(safe-area-inset-bottom);border-top:1rpx solid rgba(8,122,72,.08);background:rgba(255,255,255,.98);box-sizing:content-box}.tab-item{height:108rpx;flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-start}.tab-icon{display:block;width:64rpx;height:64rpx;opacity:.62;transition:opacity .18s ease,transform .18s ease}.tab-text{margin-top:2rpx;color:#68766e;font-size:28rpx;line-height:1.25}.tab-item.active .tab-icon{opacity:1;transform:translateY(-2rpx)}.tab-item.active .tab-text{color:#087A48;font-weight:800}
.tab-item.disabled .tab-icon{filter:grayscale(1);opacity:.25;transform:none}.tab-item.disabled .tab-text{color:#b7bcb9;font-weight:400}
