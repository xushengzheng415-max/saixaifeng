<view class="card-container"><dynamic-player-card wx:if="{{hasDynamicCard}}" scene="{{cardScene}}"/><image wx:elif="{{ready}}" src="{{cardUrl}}" class="card-image" mode="aspectFit" bindtap="previewImage" binderror="imageFailed" show-menu-by-longpress="true"/><view wx:else class="card-state"><image wx:if="{{hasPortrait}}" src="{{portraitUrl}}" class="portrait-image" mode="aspectFit" bindtap="previewImage" binderror="portraitFailed"/><text wx:if="{{stateText}}">{{stateText}}</text></view></view>
