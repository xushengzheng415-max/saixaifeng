.guide-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, .72);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.guide-card {
  width: 78%;
  max-width: 620rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 48rpx 40rpx 36rpx;
  text-align: center;
  position: relative;
}
.guide-skip {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  color: #999;
  font-size: 22rpx;
  padding: 8rpx 12rpx;
}
.guide-icon { font-size: 72rpx; margin-bottom: 20rpx; }
.guide-title { font-size: 36rpx; font-weight: 800; color: #1a2b22; margin-bottom: 14rpx; }
.guide-desc { font-size: 26rpx; color: #5a6b60; line-height: 1.6; margin-bottom: 30rpx; }
.guide-dots { display: flex; justify-content: center; gap: 12rpx; margin-bottom: 30rpx; }
.guide-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #ddd; }
.guide-dot.active { background: #0ba158; }
.guide-btn {
  width: 100%;
  height: 80rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #0ba158, #078443);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 80rpx;
  border: 0;
}
.guide-btn::after { border: 0; }
