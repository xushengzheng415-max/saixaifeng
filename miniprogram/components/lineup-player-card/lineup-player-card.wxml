<view class="lineup-player {{size}}"><image wx:if="{{ready}}" class="saved-card" src="{{cardUrl}}" mode="aspectFit" binderror="imageFailed"/><view wx:else class="ordinary-player"><image wx:if="{{hasPortrait}}" class="player-photo" src="{{photoUrl}}" mode="aspectFit" binderror="portraitFailed"/><text wx:else class="photo-fallback">{{number || '—'}}</text><view class="player-info"><text>{{number || '—'}}号</text><text>{{name || '球员'}}</text></view><text wx:if="{{stateText}}" class="card-state">{{stateText}}</text></view></view>
