:host{display:block}.home-entry{position:relative;min-height:238rpx;margin-bottom:20rpx;overflow:hidden;border:1rpx solid rgba(124,193,155,.42);border-radius:20rpx;background:#073326;color:#fff}
.home-entry:after{content:"";position:absolute;top:26rpx;bottom:26rpx;left:0;width:5rpx;border-radius:0 5rpx 5rpx 0;background:rgba(144,210,171,.65);pointer-events:none}
.entry-watermark{position:absolute;right:-76rpx;top:-112rpx;width:580rpx;height:580rpx;opacity:.24;pointer-events:none}.entry-shade{position:absolute;inset:0;width:100%;height:100%;background:linear-gradient(90deg,rgba(2,31,21,.88),rgba(2,31,21,.4) 69%,rgba(2,31,21,.14));pointer-events:none}.entry-content{position:relative;padding:16rpx 24rpx 12rpx}
.entry-top,.entry-category{display:flex;align-items:center;gap:14rpx;min-height:28rpx;font-size:22rpx;line-height:28rpx}.entry-top{justify-content:space-between}.entry-kind{color:#c5ddcf}.entry-badge{padding:0 12rpx;border-radius:5rpx;background:#227c50;color:#fff;font-weight:600}
.entry-main{display:flex;flex-direction:row-reverse;align-items:center;gap:20rpx;min-height:112rpx;margin-top:10rpx}.entry-title{flex:1;min-width:0}.entry-name{display:block;overflow-wrap:break-word;font-size:34rpx;line-height:1.4;font-weight:600}.entry-logo{flex:none;width:110rpx;height:110rpx}.entry-status{flex:none;color:#bde2ca;font-size:22rpx}.entry-meta{margin-top:8rpx;color:#c0d9cc;font-size:23rpx;line-height:1.45}.entry-meta text{display:block;overflow-wrap:break-word;white-space:normal}
.entry-footer{display:flex;align-items:center;justify-content:space-between;min-height:32rpx;margin-top:12rpx;padding-top:10rpx;border-top:1rpx solid rgba(204,234,216,.18);color:#f1fff6;font-size:23rpx;line-height:30rpx}.entry-roster{display:flex;align-items:baseline;gap:9rpx;color:#bed9c9;font-size:22rpx}.entry-count{font-size:30rpx;line-height:1;color:#fff;font-weight:700}.entry-action{margin-left:auto;font-weight:600}
.entry-participant{margin-top:12rpx;color:#ecfff2;font-size:28rpx;font-weight:600;line-height:1.5;word-break:break-all}.entry-participant text{display:block}.entry-participant .participant-label{margin-bottom:3rpx;color:#bad8c8;font-size:22rpx;font-weight:400}
