:host{display:block}.lineup-editor{margin-top:28rpx;border-top:1rpx solid #dce6df;padding-top:20rpx;font-size:26rpx}.lineup-summary{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.summary-title{font-size:28rpx;font-weight:600;display:block}.summary-count{display:block;color:#657b6e;font-size:24rpx;margin-top:8rpx}.summary-dirty{font-size:22rpx;color:#97651f}.lineup-summary button{margin:0;font-size:26rpx;color:#087b3d;background:#fff;padding:0 40rpx}.formation-stage{position:fixed;inset:0;z-index:900;box-sizing:border-box;background:#080e0c;color:#e8f0eb;display:flex;flex-direction:column;padding-bottom:env(safe-area-inset-bottom);overflow:hidden}.stage-header{display:flex;align-items:center;justify-content:space-between;padding:22rpx 30rpx 12rpx;font-size:30rpx;font-weight:600}.close{font-size:25rpx;color:#b6c8bf;padding:8rpx 0 8rpx 30rpx;font-weight:400}.team-tabs{display:flex;margin:0 24rpx;border-bottom:1rpx solid #ffffff26;flex-shrink:0}.team-tab{flex:1;min-width:0;padding:12rpx 8rpx;border-bottom:4rpx solid transparent;line-height:1.3;text-align:center;font-size:25rpx;color:#849b8e}.team-tab text{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.team-tab text:last-child{font-size:22rpx;margin-top:6rpx}.team-tab.active{border-color:#80d8a0;color:#e8fff0;font-weight:600}.lineup-heading{display:flex;align-items:center;gap:18rpx;padding:16rpx 30rpx 0;font-size:24rpx;flex-shrink:0}.unsaved{font-size:22rpx;color:#e7bd71;margin-left:auto}.formations{display:flex;gap:10rpx}.formation{padding:6rpx 12rpx;color:#7f988a;font-size:22rpx}.formation.active{color:#b7f1c8;background:#ffffff0e;border-radius:4rpx}.pitch-area{flex:1;min-height:0;position:relative}.pitch{height:100%;position:relative;overflow:hidden;background:radial-gradient(ellipse at 50% 90%,#16362a 0,#0d1e17 50%,#080e0c 85%)}.pitch-markings{position:absolute;left:3%;right:3%;top:3%;bottom:1%;transform:perspective(800rpx) rotateX(18deg);transform-origin:50% 100%;pointer-events:none}.pitch-outline{position:absolute;inset:12rpx;border:2rpx solid #91a69a70}.pitch-outline:after{content:'';position:absolute;left:0;right:0;top:50%;border-top:2rpx solid #91a69a70}.pitch-center{position:absolute;left:50%;top:50%;width:168rpx;height:168rpx;transform:translate(-50%,-50%);border:2rpx solid #91a69a70;border-radius:50%}.pitch-center:after{content:'';position:absolute;left:50%;top:50%;width:7rpx;height:7rpx;margin:-3rpx;border-radius:50%;background:#91a69a}.pitch-box{position:absolute;left:25%;width:50%;height:16%;border:2rpx solid #91a69a70}.pitch-box-top{top:12rpx;border-top:0}.pitch-box-bottom{bottom:12rpx;border-bottom:0}.pitch-goal{position:absolute;left:38%;width:24%;height:6%;border:2rpx solid #91a69a70}.pitch-goal-top{top:12rpx;border-top:0}.pitch-goal-bottom{bottom:12rpx;border-bottom:0}.slot{position:absolute;z-index:2;width:120rpx;height:172rpx;transform:translate(-50%,-50%);display:flex;align-items:center;justify-content:center}.slot-empty{display:flex;flex-direction:column;align-items:center;justify-content:center;width:88rpx;height:110rpx;border:2rpx dashed #90ad9d85;background:#14271d90;border-radius:6rpx;color:#c1d4c8;font-size:21rpx}.slot-empty text:first-child{font-size:40rpx;line-height:1.2;font-weight:300}.slot-label{position:absolute;top:100%;left:50%;transform:translateX(-50%);font-size:18rpx;line-height:1.2;color:#e0f0e6;max-width:140rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;background:#0b1610d9;padding:3rpx 8rpx;border-radius:3rpx}.hint{font-size:21rpx;color:#819c8c}.warning{padding:8rpx 30rpx;color:#e7bd71;flex-shrink:0}.bench-heading{display:flex;align-items:center;gap:18rpx;padding:12rpx 28rpx 4rpx;background:#111d17;border-top:1rpx solid #ffffff1a;font-size:24rpx;flex-shrink:0}.add-bench{margin-left:auto;color:#b2ebc3;font-size:24rpx;padding:6rpx 0 6rpx 20rpx}.bench-scroll{width:100%;background:#111d17;flex-shrink:0}.bench{display:flex;gap:16rpx;padding:12rpx 28rpx;min-width:100%;width:max-content;box-sizing:border-box}.bench-player{display:flex;flex-direction:column;align-items:center;gap:4rpx;flex-shrink:0;width:90rpx;font-size:17rpx}.bench-player text{max-width:100%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#a8bdaf}.bench-add{width:70rpx;height:100rpx;flex-shrink:0;display:flex;align-items:center;justify-content:center;border:1rpx dashed #587465;color:#87a392;font-size:36rpx;border-radius:4rpx}.save-lineup{display:flex;align-items:center;justify-content:space-between;gap:18rpx;padding:16rpx 28rpx;background:#111d17;font-size:22rpx;color:#92ad9e;flex-shrink:0}.save-lineup button{margin:0;flex-shrink:0;font-size:26rpx;border-radius:6rpx;line-height:2.4;padding:0 36rpx}.primary{background:#ace4bb;color:#123b24;font-weight:600}.primary[disabled]{background:#2a3d31;color:#7d9787}.status{display:block;padding:14rpx 30rpx;color:#9cb4a5;font-size:24rpx}.error{font-size:24rpx;color:#edb5aa;padding:12rpx 30rpx}.picker-mask{position:fixed;inset:0;background:#0009;z-index:1000;display:flex;align-items:flex-end}.picker-panel{width:100%;box-sizing:border-box;background:#101b15;color:#e4f0e8;border-top:1rpx solid #354e3f;border-radius:12rpx 12rpx 0 0;padding:24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));max-height:82vh}.picker-heading{display:flex;justify-content:space-between;gap:20rpx;margin-bottom:20rpx;font-size:29rpx;font-weight:600}.picker-heading text:last-child{font-size:25rpx;color:#abc7b6;font-weight:400}.picker-scroll{height:65vh}.picker-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24rpx 12rpx}.picker-player{min-width:0;display:flex;flex-direction:column;align-items:center;gap:8rpx;font-size:23rpx;text-align:center;word-break:break-all}.selection-status{font-size:21rpx;color:#90b19b}

