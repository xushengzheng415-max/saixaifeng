<view class="lineup-editor">
  <view wx:if="{{!primaryView}}" class="lineup-summary"><view><text class="summary-title">比赛阵容</text><text class="summary-count">{{selectionSummary}}</text><text wx:if="{{dirty}}" class="summary-dirty">未保存</text></view><button bindtap="openEditor">排阵</button></view>
  <view wx:if="{{editorOpen}}" class="formation-stage">
    <view wx:if="{{primaryView}}" class="stage-toolbar"><text bindtap="closeEditor">‹ 列表</text><text class="toolbar-score">{{match.status}} {{match.score}}</text><view class="toolbar-tools"><text wx:if="{{canUpload}}" bindtap="report">上传裁判表</text><text wx:if="{{canEdit}}" bindtap="settings">设置</text></view></view><view wx:else class="stage-header"><text>比赛阵容</text><text class="close" bindtap="closeEditor">收起</text></view>
    <view wx:if="{{hasLayout}}" class="team-tabs"><view wx:for="{{teams}}" wx:for-item="team" wx:key="id" class="team-tab {{team.itemClass}}" data-id="{{team.id}}" bindtap="changeSide"><text>{{team.name}}</text><text>{{team.count}} / {{playersOnField}}</text></view></view>
    <view class="lineup-heading"><text>{{lineupHeading}}</text><scroll-view scroll-x class="formations-scroll"><view class="formations"><text wx:for="{{formationOptions}}" wx:for-item="formation" wx:key="id" class="formation {{formation.itemClass}}" data-id="{{formation.id}}" bindtap="changeFormation">{{formation.label}}</text></view></scroll-view><text wx:if="{{dirty}}" class="unsaved">未保存</text></view>
    <view wx:if="{{loading}}" class="status">正在读取比赛人数…</view>
    <view wx:if="{{errorText}}" class="error" bindtap="loadCards">{{errorText}} · 重试</view>
    <text wx:if="{{cardWarning}}" class="hint warning" bindtap="loadCards">{{cardWarning}} · 重试</text>
    <view wx:if="{{hasLayout}}" class="pitch-area">
      <view class="pitch">
        <view class="pitch-markings"><view class="pitch-outline"></view><view class="pitch-center"></view><view class="pitch-box pitch-box-top"></view><view class="pitch-box pitch-box-bottom"></view><view class="pitch-goal pitch-goal-top"></view><view class="pitch-goal pitch-goal-bottom"></view></view>
        <view wx:for="{{slots}}" wx:for-item="slot" wx:for-index="slotIndex" wx:key="id" class="slot {{slot.slotClass}}" style="{{slot.slotStyle}}" data-index="{{slotIndex}}" bindtap="chooseSlot" bindlongpress="removeSlot">
          <view wx:if="{{slot.empty}}" class="slot-empty"><text>+</text><text>{{slot.title}}</text></view>
          <lineup-player-card wx:else size="pitch" player-id="{{slot.playerId}}" image-context="{{slot.imageContext}}" image-required="{{slot.imageRequired}}" bindresolved="cardResolved" card-scene="{{slot.cardScene}}" card-url="{{slot.cardUrl}}" card-state="{{slot.cardState}}" photo-url="{{slot.photoUrl}}" number="{{slot.jerseyNumber}}" name="{{slot.name}}"/>
          <text wx:if="{{!slot.empty}}" class="slot-label">{{slot.jerseyNumber}} · {{slot.name}}</text>
        </view>
      </view>
    </view>
    <view wx:if="{{unplacedCount}}" class="bench-heading"><text>首发待排位 {{unplacedCount}}</text></view>
    <scroll-view wx:if="{{unplacedCount}}" scroll-x class="bench-scroll" bindscroll="onBenchScroll"><view class="bench"><view wx:for="{{unplaced}}" wx:for-item="player" wx:key="id" class="bench-player"><lineup-player-card size="bench" player-id="{{player.id}}" image-context="{{player.imageContext}}" image-required="{{player.imageRequired}}" bindresolved="cardResolved" card-url="{{player.cardUrl}}" card-state="{{player.cardState}}" number="{{player.jerseyNumber}}" name="{{player.name}}"/><text>{{player.jerseyNumber}} · {{player.name}}</text></view></view></scroll-view>
    <block wx:if="{{hasLayout}}">
      <view class="bench-heading"><text>{{benchLabel}}</text><text class="hint">点位置选人 · 长按移出</text><text wx:if="{{canAddBench}}" class="add-bench" bindtap="chooseBench">+ 添加</text></view>
      <scroll-view scroll-x class="bench-scroll" bindscroll="onBenchScroll"><view class="bench"><view wx:for="{{bench}}" wx:for-item="player" wx:key="id" class="bench-player" data-id="{{player.id}}" bindtap="removeBench"><lineup-player-card size="bench" player-id="{{player.id}}" image-context="{{player.imageContext}}" image-required="{{player.imageRequired}}" bindresolved="cardResolved" card-scene="{{player.cardScene}}" card-url="{{player.cardUrl}}" card-state="{{player.cardState}}" photo-url="{{player.photoUrl}}" number="{{player.jerseyNumber}}" name="{{player.name}}"/><text>{{player.jerseyNumber}} · {{player.name}}</text></view><view wx:if="{{canAddBench}}" class="bench-add" bindtap="chooseBench">+</view></view></scroll-view>
      <view class="save-lineup"><text>{{selectionSummary}}</text><button wx:if="{{showSave}}" class="primary" bindtap="save" disabled="{{!canSave || saving}}" loading="{{saving}}">保存阵容</button><button wx:if="{{showStart}}" class="primary" bindtap="start" disabled="{{saving}}">开始比赛</button><button wx:if="{{canRecord}}" class="secondary" bindtap="events" disabled="{{saving}}">事件</button><button wx:if="{{canFinish}}" class="primary" bindtap="finish" disabled="{{saving}}">结束比赛</button></view>
    </block>
  </view>
  <view wx:if="{{pickerOpen}}" class="picker-mask" bindtap="closePicker"><view class="picker-panel" catchtap="noop"><view class="picker-heading"><text>{{pickerTitle}}</text><text bindtap="closePicker">关闭</text></view><scroll-view scroll-y class="picker-scroll" lower-threshold="120" bindscrolltolower="morePlayers"><view class="picker-grid"><view wx:for="{{pickerPlayers}}" wx:for-item="player" wx:key="id" class="picker-player" data-id="{{player.id}}" bindtap="pickPlayer"><lineup-player-card size="selection" player-id="{{player.id}}" image-context="{{player.imageContext}}" image-required="{{player.imageRequired}}" bindresolved="cardResolved" card-scene="{{player.cardScene}}" card-url="{{player.cardUrl}}" card-state="{{player.cardState}}" photo-url="{{player.photoUrl}}" number="{{player.jerseyNumber}}" name="{{player.name}}"/><text>{{player.jerseyNumber}}号 {{player.name}}</text><text class="selection-status">{{player.selectionText}}</text></view></view><button wx:if="{{pickerHasMore}}" class="more-players" bindtap="morePlayers">更多球员</button><text wx:if="{{pickerEmpty}}" class="status">本队暂无可选名单球员</text></scroll-view></view></view>
</view>
