:host{font-family:inherit}.quick-mask{position:fixed;inset:0;z-index:9999;display:flex;align-items:flex-end;background:rgba(0,23,16,.54);color:#17392e}.quick-sheet{width:100%;max-height:86vh;background:#fbfdfb;border-radius:32rpx 32rpx 0 0;overflow:hidden;animation:sheet-in .25s ease-out;padding-bottom:env(safe-area-inset-bottom)}@keyframes sheet-in{from{transform:translateY(100%)}to{transform:translateY(0)}}.sheet-handle{width:66rpx;height:7rpx;background:#d6e0d8;border-radius:5rpx;margin:16rpx auto 0}.sheet-header{display:flex;align-items:center;justify-content:space-between;padding:22rpx 34rpx 12rpx;font-size:36rpx;font-weight:650}.sheet-skip{margin:0;padding:12rpx 0 12rpx 24rpx;background:none;color:#668575;font-size:27rpx;font-weight:400;line-height:1.4}.sheet-skip:after,.sheet-primary:after,.pc-address button:after,.sheet-error button:after{border:0}.sheet-scroll{max-height:59vh}.sheet-body{padding:0 34rpx 10rpx}.field{display:flex;align-items:center;min-height:108rpx;border-bottom:1rpx solid #e1e9e3;gap:24rpx;font-size:29rpx}.field>text{flex:none;width:140rpx;color:#354e40}.field input{flex:1;min-width:0;font-size:29rpx;color:#183d2b}.field picker{flex:1;min-width:0}.picker-value{display:flex;align-items:center;justify-content:space-between;line-height:1.5;padding:22rpx 0;color:#284e37}.picker-value>text{margin-left:15rpx;color:#90a395;font-size:35rpx}.sheet-note{padding:24rpx 0 8rpx;font-size:24rpx;line-height:1.65;color:#708675}.organization-summary{padding-top:12rpx;font-size:24rpx;color:#738b7a;line-height:1.6}.logo-row{display:flex;align-items:center;gap:26rpx;padding:22rpx 0}.logo-row image{width:112rpx;height:112rpx;flex:none}.logo-row>view>text{display:block;font-size:29rpx;color:#167344}.logo-row>view>text+text{font-size:23rpx;color:#889d8c;margin-top:10rpx}.sheet-footer{padding:22rpx 34rpx 28rpx}.sheet-primary{background:#087a48;border-radius:13rpx;color:#fff;margin:0;font-size:31rpx;line-height:92rpx;height:92rpx;font-weight:600}.sheet-primary[disabled]{background:#c3d7ca;color:#f3f8f5}.sheet-loading{padding:45rpx 0;color:#6b8575;font-size:27rpx}.sheet-error{background:#fff3e7;color:#985c28;padding:18rpx 20rpx;margin-top:20rpx;border-radius:10rpx;font-size:25rpx;line-height:1.65}.sheet-error button{display:inline-block;margin:10rpx 0 0;padding:5rpx 20rpx;font-size:24rpx;line-height:1.6;color:#087a48;background:#fff}.success-content{text-align:center;padding:27rpx 0 20rpx}.success-content>image{width:76rpx;height:76rpx;margin-bottom:20rpx}.success-name{display:block;font-size:35rpx;font-weight:600;line-height:1.5;word-break:break-all}.success-description{display:block;margin-top:20rpx;color:#708675;font-size:26rpx;line-height:1.75}.pc-address{margin-top:27rpx;background:#edf5ef;border-radius:10rpx;padding:18rpx;display:flex;align-items:center;justify-content:space-between;gap:10rpx;font-size:26rpx}.pc-address button{margin:0;padding:7rpx 12rpx;color:#087a48;background:#fff;font-size:24rpx;line-height:1.6}
.sheet-primary{width:100%}
.sheet-primary{display:flex;align-items:center;justify-content:center;padding:0 24rpx;line-height:1.4}
.sheet-skip{display:flex;align-items:center;justify-content:center;line-height:1.4;padding:10rpx 0 10rpx 24rpx}
.pc-address button{display:flex;align-items:center;justify-content:center;line-height:1.4;min-height:52rpx;padding:0 14rpx}
