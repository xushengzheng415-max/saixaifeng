.ctab {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  display: flex;
  padding: 8px 10px calc(8px + env(safe-area-inset-bottom));
  background: rgba(8, 10, 16, 0.92);
  border-top: 1px solid rgba(255, 215, 130, 0.14);
}
.ctab-item {
  flex: 1;
  text-align: center;
  padding: 6px 4px;
  border-radius: 12px;
}
.ctab-ico { font-size: 18px; line-height: 1.2; }
.ctab-txt {
  margin-top: 2px;
  font-size: 11px;
  color: #9aa3b5;
}
.ctab-txt.is-on { color: #d4a84b; }
