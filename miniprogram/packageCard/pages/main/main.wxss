.page {
  min-height: 100vh;
  padding: 12px 14px 88px;
  box-sizing: border-box;
  background: linear-gradient(180deg, #101522, #07090f);
  color: #f3f5fa;
}
.topbar { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
.brand { width: 40px; height: 40px; border-radius: 10px; }
.topbar-text { flex: 1; display: flex; flex-direction: column; gap: 2px; }
.title { font-size: 16px; font-weight: 700; }
.sub { font-size: 11px; color: #9aa3b5; }
.badge {
  font-size: 11px; padding: 4px 8px; border-radius: 999px;
  color: #f0c75e; background: rgba(240,199,94,.12); border: 1px solid rgba(240,199,94,.28);
}
.panel {
  margin: 8px 0; padding: 14px; border-radius: 18px;
  background: rgba(18,24,38,.62); border: 1px solid rgba(255,215,130,.18);
}
.panel-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 12px; }
.h2 { font-size: 15px; font-weight: 700; }
.hint { font-size: 11px; color: #9aa3b5; }
.hero { display: flex; flex-direction: column; align-items: center; gap: 10px; }
.hero-card { width: 68%; border-radius: 12px; box-shadow: 0 12px 28px rgba(0,0,0,.45); }
.foil-tip { font-size: 12px; color: #9aa3b5; text-align: center; }
.stats { display: flex; gap: 8px; margin-top: 12px; }
.stat {
  flex: 1; text-align: center; padding: 10px 4px; border-radius: 12px;
  background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.06);
}
.stat-num { display: block; font-size: 18px; font-weight: 800; color: #f0c75e; }
.stat-label { display: block; margin-top: 2px; font-size: 11px; color: #9aa3b5; }
.quick { display: flex; flex-direction: column; gap: 8px; margin-top: 12px; }
.quick-btn {
  display: flex; align-items: center; gap: 10px; padding: 12px;
  border-radius: 14px; background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.08);
}
.quick-ico { font-size: 22px; }
.quick-txt { display: flex; flex-direction: column; gap: 2px; }
.quick-strong { font-size: 14px; font-weight: 700; }
.quick-em { font-size: 11px; color: #9aa3b5; }
.actions { display: flex; gap: 8px; margin-top: 12px; }
.btn {
  flex: 1; font-size: 13px; font-weight: 600; border-radius: 12px; padding: 11px 8px; border: none;
}
.btn.gold { background: linear-gradient(135deg, #ffe39a, #d4a84b); color: #1a1408; }
.btn.ghost { background: rgba(255,255,255,.06); color: #f3f5fa; border: 1px solid rgba(255,255,255,.1); }
.growth { white-space: nowrap; }
.stamp {
  display: inline-block; min-width: 88px; margin-right: 8px; padding: 10px;
  border-radius: 12px; text-align: center; vertical-align: top;
  background: rgba(255,255,255,.04); border: 1px dashed rgba(240,199,94,.35);
}
.stamp.is-locked { opacity: .5; border-style: solid; border-color: rgba(255,255,255,.08); }
.stamp-ico { display: block; font-size: 20px; }
.stamp-name { display: block; margin-top: 4px; font-size: 11px; color: #f0c75e; }
.stamp.is-locked .stamp-name { color: #9aa3b5; }
.pad { height: 12px; }
