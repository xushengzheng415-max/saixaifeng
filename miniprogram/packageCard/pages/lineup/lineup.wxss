.page {
  min-height: 100vh; padding: 12px 14px 88px; box-sizing: border-box;
  background: linear-gradient(180deg, #101522, #07090f); color: #f3f5fa;
}
.panel {
  margin: 8px 0; padding: 14px; border-radius: 18px;
  background: rgba(18,24,38,.62); border: 1px solid rgba(255,215,130,.18);
}
.panel-head { display: flex; justify-content: space-between; margin-bottom: 12px; }
.h2 { font-size: 15px; font-weight: 700; }
.hint { font-size: 11px; color: #9aa3b5; }
.pitch {
  border-radius: 16px; overflow: hidden; min-height: 320px; padding: 16px 12px 20px;
  background: linear-gradient(180deg, rgba(20,80,40,.55), rgba(10,40,22,.75));
  border: 1px solid rgba(255,255,255,.08);
}
.row { display: flex; justify-content: center; gap: 14px; margin-bottom: 18px; }
.slot {
  width: 78px; min-height: 86px; border-radius: 14px; padding: 8px 4px;
  border: 1.5px dashed rgba(255,255,255,.28); background: rgba(0,0,0,.22);
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px;
  color: #9aa3b5; font-size: 11px; text-align: center;
}
.slot.is-filled { border-style: solid; border-color: rgba(240,199,94,.55); background: rgba(240,199,94,.1); color: #f3f5fa; }
.slot.is-active { outline: 2px solid #f0c75e; outline-offset: 2px; }
.pos { font-size: 10px; color: #f0c75e; font-weight: 700; }
.avatar { width: 36px; height: 36px; border-radius: 50%; background: #222; }
.name { font-size: 11px; font-weight: 600; max-width: 70px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.picker { margin-top: 12px; }
.chips { display: flex; flex-wrap: wrap; gap: 8px; }
.chip {
  padding: 8px 12px; border-radius: 999px; font-size: 12px;
  border: 1px solid rgba(255,255,255,.12); background: rgba(255,255,255,.05);
}
.chip.is-used { opacity: .4; }
.challenge { margin-top: 12px; }
.challenge-meta { display: flex; justify-content: space-between; font-size: 12px; color: #9aa3b5; margin-bottom: 6px; }
.pct { color: #f0c75e; font-weight: 700; }
.bar { height: 8px; border-radius: 999px; background: rgba(255,255,255,.08); overflow: hidden; }
.fill { height: 100%; background: linear-gradient(90deg, #1f8f4e, #f0c75e); }
.tip { display: block; margin-top: 8px; font-size: 12px; color: #9aa3b5; }
.actions { display: flex; gap: 8px; margin-top: 12px; }
.btn {
  flex: 1; font-size: 13px; font-weight: 600; border-radius: 12px; padding: 11px 8px; border: none;
}
.btn.gold { background: linear-gradient(135deg, #ffe39a, #d4a84b); color: #1a1408; }
.btn.ghost { background: rgba(255,255,255,.06); color: #f3f5fa; border: 1px solid rgba(255,255,255,.1); }
.btn.full { width: 100%; margin-top: 8px; }
.btn[disabled] { opacity: .45; }
.pad { height: 12px; }
