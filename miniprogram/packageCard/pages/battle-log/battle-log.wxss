.page {
  min-height: 100vh; padding: 16px; box-sizing: border-box;
  background: linear-gradient(180deg, #101522, #07090f); color: #f3f5fa;
}
.tip { display: block; font-size: 12px; color: #9aa3b5; margin-bottom: 14px; }
.empty { text-align: center; padding: 48px 12px; }
.empty-ico { display: block; font-size: 36px; margin-bottom: 8px; }
.empty-title { display: block; font-weight: 700; margin-bottom: 6px; }
.empty-p { display: block; font-size: 12px; color: #9aa3b5; margin-bottom: 16px; }
.list { display: flex; flex-direction: column; gap: 10px; }
.row {
  padding: 12px 14px; border-radius: 14px;
  background: rgba(18,24,38,.62); border: 1px solid rgba(255,215,130,.18);
}
.row-main { display: flex; align-items: baseline; gap: 10px; }
.outcome { color: #f0c75e; font-weight: 800; font-size: 16px; }
.score { font-size: 15px; font-weight: 700; }
.comment { display: block; margin-top: 6px; font-size: 12px; color: #c9d0dc; }
.time { display: block; margin-top: 4px; font-size: 11px; color: #9aa3b5; }
.btn.gold {
  background: linear-gradient(135deg, #ffe39a, #d4a84b); color: #1a1408;
  border: none; border-radius: 12px; padding: 11px 18px; font-weight: 700;
}
