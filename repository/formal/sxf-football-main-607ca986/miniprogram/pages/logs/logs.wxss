/* pages/logs/logs.wxss */

/* 统计卡片 */
.stats-card {
  display: flex;
  justify-content: space-around;
  background: linear-gradient(135deg, #2E7D32, #4CAF50);
  padding: 30rpx 20rpx;
  border-radius: 16rpx;
  margin: 20rpx;
  color: white;
}

.stat-item {
  text-align: center;
}

.stat-item .stat-num {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
}

.stat-item .stat-label {
  font-size: 22rpx;
  opacity: 0.8;
}

.stat-item.info .stat-num { color: #2196F3; }
.stat-item.warn .stat-num { color: #FF9800; }
.stat-item.error .stat-num { color: #F44336; }

/* 筛选区域 */
.filter-section {
  display: flex;
  padding: 20rpx;
  background: white;
  margin: 0 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.filter-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  font-size: 26rpx;
  color: #333;
  background: #f5f5f5;
  border-radius: 8rpx;
  margin-right: 10rpx;
}

.filter-item:last-child {
  margin-right: 0;
}

.filter-item .icon {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: #999;
}

.filter-item.search {
  flex: 2;
  background: #fff;
  border: 1rpx solid #e0e0e0;
}

.filter-item input {
  width: 100%;
  text-align: center;
  font-size: 26rpx;
}

/* 日志列表 */
.log-list {
  height: calc(100vh - 450rpx);
  padding: 20rpx;
}

.log-item {
  background: white;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
  border-left: 6rpx solid #999;
}

.log-item.level-info {
  border-left-color: #2196F3;
}

.log-item.level-warn {
  border-left-color: #FF9800;
  background: #FFF8E1;
}

.log-item.level-error {
  border-left-color: #F44336;
  background: #FFEBEE;
}

.log-item.level-debug {
  border-left-color: #9E9E9E;
}

.log-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.log-level {
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
  font-weight: bold;
  color: white;
}

.log-level.level-info { background: #2196F3; }
.log-level.level-warn { background: #FF9800; }
.log-level.level-error { background: #F44336; }
.log-level.level-debug { background: #9E9E9E; }

.log-time {
  font-size: 22rpx;
  color: #999;
}

.log-page {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
  background: #f5f5f5;
  padding: 4rpx 8rpx;
  border-radius: 4rpx;
  display: inline-block;
}

.log-message {
  font-size: 26rpx;
  color: #333;
  line-height: 1.5;
  word-break: break-all;
  margin-bottom: 12rpx;
}

.log-user {
  font-size: 22rpx;
  color: #999;
}

/* 加载状态 */
.loading-more, .no-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 26rpx;
}

.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  color: #999;
  font-size: 28rpx;
}

/* 底部操作栏 */
.action-bar {
  display: flex;
  padding: 20rpx;
  background: white;
  box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.05);
}

.action-bar .btn {
  flex: 1;
  margin: 0 8rpx;
  padding: 20rpx;
  font-size: 26rpx;
  background: #f5f5f5;
  color: #333;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-bar .btn-error {
  background: #FFEBEE;
  color: #F44336;
}

.hover {
  opacity: 0.8;
}
