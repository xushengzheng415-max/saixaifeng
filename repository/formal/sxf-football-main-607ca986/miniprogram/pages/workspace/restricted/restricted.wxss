@import "../../../styles/proto.wxss";.page{min-height:100vh;position:relative;overflow:hidden;background:#031f16}.bg,.shade{position:absolute;inset:0;width:100%;height:100%}.shade{background:rgba(0,25,14,.54)}.content{position:relative;z-index:1;padding:112rpx 64rpx calc(60rpx + env(safe-area-inset-bottom))}.title{color:#fff;font-size:40rpx;font-weight:900;text-align:center}.panel{margin-top:140rpx;padding:55rpx 30rpx 45rpx;border-radius:34rpx;background:rgba(255,255,255,.98);text-align:center}.lock{width:196rpx;height:196rpx;margin:0 auto 45rpx;padding:42rpx;border-radius:50%;background:#eef5f0;box-sizing:border-box}.lock image{width:100%;height:100%}.main-title{display:block;color:#111612;font-size:42rpx;font-weight:900}.desc{display:block;margin-top:22rpx;color:#707873;font-size:25rpx;line-height:1.5}.details{margin-top:44rpx;border:2rpx solid #e4e8e5;border-radius:20rpx;text-align:left}.details view{display:flex;align-items:center;min-height:102rpx;padding:0 22rpx;border-bottom:2rpx solid #edf0ee}.details view:last-child{border:0}.details image{width:42rpx;height:42rpx;margin-right:18rpx}.details text:nth-child(2){width:180rpx;color:#787f7b;font-size:23rpx}.details text:nth-child(3){flex:1;color:#171c18;font-size:25rpx;font-weight:700}.is-danger{color:#df3834!important}.is-pending{color:#b56d13!important}.panel button{margin-top:48rpx;background:#108c43;color:#fff;border-radius:20rpx;font-size:33rpx;font-weight:800}.panel button[disabled]{opacity:.55}.back{display:block;margin-top:33rpx;color:#198b46;font-size:29rpx}.error{margin-top:22rpx;color:#b64038;font-size:23rpx}.foot{display:block;margin-top:50rpx;color:rgba(255,255,255,.78);font-size:22rpx;line-height:1.5;text-align:center}
