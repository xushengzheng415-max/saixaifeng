.page{min-height:100vh;padding:calc(26rpx + env(safe-area-inset-top)) 30rpx 60rpx;box-sizing:border-box;background:#f4f7f5;color:#17241d}.nav{height:80rpx;display:grid;grid-template-columns:120rpx 1fr 120rpx;align-items:center}.nav text:first-child{color:#16834d;font-size:27rpx}.nav text:nth-child(2){font-size:34rpx;font-weight:800;text-align:center}.state{margin-top:160rpx;color:#768079;text-align:center}.state.error{color:#a43e38}.workspace-list{margin-top:28rpx}.workspace-row{display:flex;align-items:center;gap:22rpx;margin-bottom:18rpx;padding:26rpx 24rpx;border:2rpx solid transparent;border-radius:18rpx;background:#fff}.workspace-row.current{border-color:#198b55;background:#f3faf6}.workspace-row image,.workspace-logo{width:78rpx;height:78rpx;flex:none;border-radius:16rpx}.workspace-logo{display:flex;align-items:center;justify-content:center;color:#fff;background:#16834d;font-size:27rpx;font-weight:700}.workspace-main{min-width:0;flex:1}.workspace-main text{display:block}.workspace-main text:first-child{overflow:hidden;color:#1d2d24;font-size:29rpx;font-weight:800;text-overflow:ellipsis;white-space:nowrap}.workspace-main text:last-child{margin-top:9rpx;color:#768079;font-size:22rpx}.current-text{color:#16834d;font-size:23rpx;font-weight:700}.arrow{color:#8a948d;font-size:42rpx}.switching{position:fixed;left:50%;bottom:80rpx;padding:16rpx 28rpx;transform:translateX(-50%);border-radius:12rpx;color:#fff;background:rgba(0,45,28,.88);font-size:23rpx}
