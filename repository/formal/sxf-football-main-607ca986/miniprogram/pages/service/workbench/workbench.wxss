page { background: #F4F7F4; min-height: 100%; }
.page { min-height: 100vh; padding: 0 24rpx 48rpx; box-sizing: border-box; }
.hero { margin: 0 -24rpx 28rpx; padding: 46rpx 34rpx 54rpx; color: #fff; background: linear-gradient(135deg, #174C20, #2E7D32 58%, #43A047); border-radius: 0 0 36rpx 36rpx; }
.hero-kicker, .hero-title, .hero-desc { display: block; }
.hero-kicker { font-size: 23rpx; opacity: .78; letter-spacing: 4rpx; }
.hero-title { margin-top: 10rpx; font-size: 46rpx; line-height: 1.25; font-weight: 800; }
.hero-desc { margin-top: 12rpx; font-size: 26rpx; opacity: .88; }
.loading-card, .phone-card, .error-card, .empty-card { padding: 48rpx 32rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 28rpx rgba(23,76,32,.08); text-align: center; }
.loading-card { display: flex; align-items: center; justify-content: center; gap: 18rpx; color: #607064; font-size: 27rpx; }
.spinner { width: 34rpx; height: 34rpx; border: 5rpx solid #DDE9DF; border-top-color: #2E7D32; border-radius: 50%; animation: spin .8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.card-icon, .card-title, .card-desc { display: block; }
.card-icon { font-size: 72rpx; }
.card-title { margin-top: 18rpx; color: #18331D; font-size: 34rpx; font-weight: 750; }
.card-desc { margin: 14rpx auto 30rpx; max-width: 560rpx; color: #758078; font-size: 26rpx; line-height: 1.65; }
.primary-btn { height: 92rpx; line-height: 92rpx; border-radius: 46rpx; color: #fff; font-size: 31rpx; font-weight: 700; background: linear-gradient(135deg, #1B5E20, #43A047); }
.bind-input { height: 84rpx; margin-bottom: 18rpx; padding: 0 24rpx; text-align: left; border: 2rpx solid #DDE8DF; border-radius: 16rpx; background: #FAFCFA; box-sizing: border-box; }
.code-row { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.code-input { flex: 1; margin-bottom: 0; }
.code-btn { width: 220rpx; height: 84rpx; line-height: 84rpx; padding: 0; color: #1B5E20; font-size: 25rpx; border-radius: 16rpx; background: #E8F3EA; }
.plain-btn { height: 82rpx; line-height: 82rpx; border-radius: 42rpx; color: #1B5E20; font-size: 29rpx; border: 2rpx solid #A8C9AD; background: #F7FBF7; }
.error-card { margin-bottom: 22rpx; }
.error-text { display: block; margin-bottom: 24rpx; color: #C62828; font-size: 27rpx; }
.identity-bar { display: flex; justify-content: space-between; padding: 18rpx 24rpx; margin-bottom: 26rpx; color: #718075; font-size: 24rpx; background: #EAF3EB; border-radius: 16rpx; }
.identity-phone { color: #1B5E20; font-weight: 700; }
.section { margin-bottom: 34rpx; }
.section-heading { display: flex; align-items: flex-end; justify-content: space-between; margin: 0 6rpx 16rpx; }
.section-title { color: #17351C; font-size: 34rpx; font-weight: 800; }
.section-tip { color: #859087; font-size: 23rpx; }
.task-card { margin-bottom: 18rpx; padding: 28rpx; border-radius: 22rpx; background: #fff; box-shadow: 0 7rpx 24rpx rgba(24,71,30,.07); border-left: 8rpx solid #2E7D32; }
.task-topline { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.task-tournament { flex: 1; color: #68736A; font-size: 24rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.task-status { padding: 7rpx 16rpx; border-radius: 18rpx; font-size: 22rpx; color: #1B5E20; background: #E7F3E9; }
.task-teams { display: block; margin-top: 22rpx; color: #142F18; font-size: 32rpx; font-weight: 750; }
.task-meta { display: block; margin-top: 12rpx; color: #7B857D; font-size: 25rpx; }
.task-action { margin-top: 24rpx; padding-top: 20rpx; color: #1B5E20; font-size: 27rpx; font-weight: 700; border-top: 1rpx solid #EDF1ED; text-align: right; }
.empty-card { margin-top: 20rpx; }
.empty-icon { display: block; font-size: 72rpx; }
button::after { border: none; }
