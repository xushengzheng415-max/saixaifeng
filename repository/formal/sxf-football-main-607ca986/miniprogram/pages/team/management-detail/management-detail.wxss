/* pages/team/management-detail/management-detail.wxss */
/* 官员详情页 - 卡片式设计 */

page {
  background: linear-gradient(180deg, #1565C0 0%, #1976D2 30%, #2196F3 60%, #42A5F5 100%);
  min-height: 100vh;
}

.management-detail-container {
  padding: 30rpx 24rpx;
  padding-bottom: 200rpx;
  position: relative;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 20rpx;
}

/* 背景装饰 */
.hero-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 500rpx;
  overflow: hidden;
  pointer-events: none;
}

.bg-circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.1;
}

.circle-1 {
  width: 400rpx;
  height: 400rpx;
  background: #fff;
  top: -100rpx;
  right: -100rpx;
}

.circle-2 {
  width: 300rpx;
  height: 300rpx;
  background: #fff;
  top: 100rpx;
  left: -80rpx;
}

.bg-pattern {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(76, 175, 80, 0.1) 0%, rgba(46, 125, 50, 0.05) 100%);
}

/* 官员主卡片 */
.management-card {
  background: linear-gradient(135deg, rgba(255,255,255,0.98) 0%, rgba(255,255,255,0.95) 100%);
  border-radius: 32rpx;
  padding: 50rpx 40rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.2);
  position: relative;
  overflow: hidden;
}

.position-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: linear-gradient(135deg, #2196F3 0%, #42A5F5 100%);
  border-radius: 30rpx;
  padding: 10rpx 24rpx;
  box-shadow: 0 6rpx 16rpx rgba(33, 150, 243, 0.3);
  z-index: 10;
}

.position-text {
  font-size: 24rpx;
  font-weight: bold;
  color: #fff;
}

/* 头像区域 */
.avatar-section {
  position: relative;
  display: flex;
  justify-content: center;
  margin-bottom: 30rpx;
}

.avatar-frame {
  width: 200rpx;
  height: 200rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.15);
  border: 6rpx solid #fff;
  position: relative;
  z-index: 2;
}

.management-avatar {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.avatar-glow {
  position: absolute;
  width: 240rpx;
  height: 240rpx;
  background: linear-gradient(135deg, rgba(33, 150, 243, 0.2) 0%, rgba(66, 165, 245, 0.15) 100%);
  border-radius: 32rpx;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 1;
}

/* 信息区域 */
.info-section {
  text-align: center;
  position: relative;
  z-index: 2;
}

.management-name {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #1565C0;
  letter-spacing: 4rpx;
  margin-bottom: 16rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
}

.role-tag {
  display: inline-block;
  background: linear-gradient(135deg, #E3F2FD 0%, #BBDEFB 100%);
  padding: 10rpx 32rpx;
  border-radius: 30rpx;
  border: 2rpx solid rgba(33, 150, 243, 0.3);
}

.tag-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #1976D2;
  letter-spacing: 2rpx;
}

/* 详细信息卡片 */
.info-card, .team-card, .remark-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.info-title-bar, .team-title-bar, .remark-title-bar {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.title-accent {
  width: 6rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #2196F3 0%, #1976D2 100%);
  border-radius: 3rpx;
  margin-right: 16rpx;
}

.title-accent.green {
  background: linear-gradient(180deg, #66BB6A 0%, #4CAF50 100%);
}

.title-accent.orange {
  background: linear-gradient(180deg, #FFA726 0%, #FB8C00 100%);
}

.info-title, .team-title, .remark-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  letter-spacing: 1rpx;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.info-item {
  background: linear-gradient(135deg, rgba(227, 242, 253, 0.5) 0%, rgba(187, 222, 251, 0.3) 100%);
  border-radius: 16rpx;
  padding: 20rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.info-icon {
  font-size: 32rpx;
}

.info-content {
  flex: 1;
  min-width: 0;
}

.info-label {
  display: block;
  font-size: 22rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.info-value {
  display: block;
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.phone-link {
  color: #1976D2;
  text-decoration: underline;
}

/* 球队卡片 */
.team-info-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.team-logo-small {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.team-meta {
  flex: 1;
}

.team-name-text {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 6rpx;
}

.team-code-text {
  display: block;
  font-size: 24rpx;
  color: #666;
}

/* 备注卡片 */
.remark-content {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
}

/* 底部操作按钮 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.98) 30%);
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 28rpx 0;
  border-radius: 50rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  transition: all 0.3s ease;
}

.action-btn::after {
  border: none;
}

.action-btn:active {
  transform: translateY(2rpx);
}

.edit-btn {
  background: linear-gradient(135deg, #2196F3 0%, #42A5F5 100%);
}

.edit-btn .btn-icon, .edit-btn .btn-text {
  color: #fff;
}

.delete-btn {
  background: linear-gradient(135deg, #F44336 0%, #EF5350 100%);
}

.delete-btn .btn-icon, .delete-btn .btn-text {
  color: #fff;
}

.btn-icon {
  font-size: 28rpx;
}

.btn-text {
  font-size: 28rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
}
