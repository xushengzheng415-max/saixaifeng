<view class="progress-page"><image class="progress-bg" src="/images/runtime/team-data-emerald-stadium-v1.jpg" mode="aspectFill"/><view class="progress-content"><view class="progress-nav"><text class="progress-back" bindtap="back">‹</text><text>球员资料进度</text></view><view wx:if="{{loading}}" class="progress-loading">正在读取球员资料…</view><block wx:else><view class="progress-hero"><image wx:if="{{teamLogo}}" class="progress-crest" src="{{teamLogo}}" mode="aspectFit"/><image wx:if="{{!teamLogo}}" class="progress-crest" src="/images/runtime/icons/brand-v1-tab-team.png" mode="aspectFit"/><view class="progress-team"><text>{{teamName}}</text><text>长期球员资产 · 共 {{total}} 人</text><view class="progress-score"><text>{{percent}}%</text><view><view class="progress-bar"><view class="progress-fill" style="width: {{progressWidth}};"></view></view><text>{{complete}} / {{total}} 已完成</text></view></view></view></view><view class="progress-filters"><text wx:for="{{filters}}" wx:key="id" data-filter="{{item.id}}" bindtap="setFilter" class="{{item.className}}">{{item.label}}</text></view><view class="progress-list"><view wx:for="{{visiblePlayers}}" wx:key="id" class="progress-row"><image wx:if="{{item.avatar}}" class="progress-avatar" src="{{item.avatar}}" mode="aspectFill"/><text wx:else class="progress-avatar progress-avatar-letter">{{item.avatarText}}</text><view class="progress-info"><text>{{item.name}}</text><text>{{item.birthDate}}</text><view class="progress-chips"><text wx:for="{{item.chips}}" wx:key="text" class="{{item.className}}">{{item.text}}</text></view></view><view class="progress-actions"><text class="{{item.statusClass}}">{{item.statusText}}</text><button bindtap="remind" data-id="{{item.id}}"><image src="/images/runtime/icons/brand-v2-05.png" mode="aspectFit"/>提醒</button><button bindtap="open" data-id="{{item.id}}">查看</button></view></view></view><button wx:if="{{canManage}}" class="progress-remind-all" bindtap="remindAll"><image src="/images/runtime/icons/brand-v2-11.png" mode="aspectFit"/>再次提醒未完成人员</button><view class="progress-note">ⓘ 已关闭的资料要求（如比赛号码、球衣码数等）不会产生待办，不会影响球员的参赛与管理。</view></block></view></view>
