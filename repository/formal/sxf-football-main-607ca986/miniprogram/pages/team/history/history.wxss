.history-page{min-height:100vh;position:relative;background:#03271b}.history-bg{position:absolute;inset:0;width:100%;height:100%;opacity:.76}.history-content{position:relative;padding:0 28rpx 100rpx;color:#fff}.history-nav{height:208rpx;position:relative;display:flex;align-items:flex-end;justify-content:center;padding-bottom:28rpx;box-sizing:border-box;font-size:40rpx;font-weight:700}.history-back{position:absolute;left:8rpx;bottom:16rpx;font-size:76rpx;font-weight:300}.history-loading{padding:160rpx 0;text-align:center}.history-hero{display:flex;align-items:center;gap:26rpx;padding:8rpx 30rpx 38rpx}.history-hero image{width:142rpx;height:142rpx}.history-hero view{flex:1}.history-hero text{display:block;font-size:40rpx;font-weight:700}.history-hero text:last-child{margin-top:16rpx;font-size:28rpx;font-weight:400}.history-panel{padding:28rpx 18rpx;border-radius:28rpx;background:#fff;color:#18241d}.history-tabs{display:flex;height:76rpx;margin-bottom:25rpx;border:2rpx solid #e2e6e2;border-radius:18rpx;overflow:hidden}.history-tab{flex:1;display:flex;align-items:center;justify-content:center;border-right:2rpx solid #e2e6e2;color:#46534a;font-size:27rpx}.history-tab:last-child{border:0}.history-tab-active{background:#005332;color:#fff;font-weight:700}.history-card{margin-bottom:24rpx;padding:26rpx;border:2rpx solid #e5e9e5;border-radius:22rpx;box-shadow:0 4rpx 12rpx rgba(20,57,34,.06)}.history-head{display:flex;align-items:center;gap:18rpx}.history-head image{width:92rpx;height:92rpx}.history-head>view{flex:1}.history-head>view>text{display:block;font-size:31rpx;line-height:1.34;font-weight:700}.history-head>view>view{display:flex;gap:15rpx;margin-top:14rpx;color:#637168;font-size:22rpx}.history-head>view>view text:first-child{padding:3rpx 10rpx;border-radius:8rpx;background:#f0f7f0;color:#287042}.history-arrow{font-size:52rpx;color:#5b655e}.history-line{height:2rpx;margin-top:22rpx;background:#e7ece7}.history-stats{display:flex;align-items:flex-end;gap:42rpx;padding-top:20rpx}.history-stats view text{display:block;font-size:22rpx;color:#7a867e}.history-stats view text:last-child{margin-top:7rpx;font-size:27rpx;color:#1f2a22}.history-stats .ranked{font-size:32rpx!important;font-weight:700;color:#0b6c37!important}.history-stats button{margin-left:auto;width:158rpx;height:64rpx;line-height:60rpx;padding:0;border:2rpx solid #0d6b39;border-radius:10rpx;background:#fff;color:#0d6b39;font-size:25rpx}.history-stats button::after{border:0}.history-empty{padding:110rpx 20rpx;text-align:center;color:#758178}.history-notice{display:flex;align-items:center;gap:13rpx;margin-top:26rpx;padding:19rpx;border-radius:16rpx;background:rgba(0,87,42,.84);font-size:23rpx;line-height:1.45}.history-notice image{width:32rpx;height:32rpx;flex:none}
