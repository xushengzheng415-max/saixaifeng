page{background:#f4f7f5;color:#17231c}.review-page{min-height:100vh;padding-bottom:150rpx}.review-nav{padding:calc(env(safe-area-inset-top) + 28rpx) 28rpx 24rpx;background:#08783f;color:#fff;display:flex;align-items:center;gap:24rpx}.review-nav>text{font-size:56rpx;line-height:1}.review-nav>view{display:flex;flex-direction:column;flex:1}.review-nav>view text:first-child{font-size:34rpx;font-weight:700}.review-nav>view text:last-child{font-size:22rpx;opacity:.8;margin-top:4rpx}.review-nav button{margin:0;padding:0 20rpx;height:58rpx;line-height:58rpx;background:transparent;border:1rpx solid rgba(255,255,255,.6);color:#fff;font-size:24rpx}.review-summary{margin:24rpx;padding:24rpx;background:#edf8f1;border-left:6rpx solid #0a9952;font-size:25rpx;line-height:1.55}.review-tabs{display:flex;gap:16rpx;padding:0 24rpx 18rpx}.review-tabs text{padding:15rpx 22rpx;border-radius:10rpx;background:#fff;color:#657068;font-size:25rpx}.review-tabs .active{background:#08783f;color:#fff}.draft-list{margin:0 24rpx;background:#fff;border-radius:16rpx;overflow:hidden}.draft-row{min-height:132rpx;display:flex;align-items:center;gap:18rpx;padding:20rpx;border-bottom:1rpx solid #edf0ee}.draft-row:last-child{border-bottom:0}.draft-row>image,.draft-avatar{width:84rpx;height:84rpx;border-radius:10rpx;background:#e8f3ec;display:flex;align-items:center;justify-content:center;font-size:22rpx;overflow:hidden}.draft-check,.draft-lock{width:38rpx;height:38rpx;border:2rpx solid #0a9952;border-radius:7rpx;display:flex;align-items:center;justify-content:center;color:#0a9952;font-weight:700}.draft-lock{border-color:#d8902b;color:#d8902b;border-radius:50%}.draft-main{display:flex;flex-direction:column;flex:1;min-width:0}.draft-main>text:first-child{font-size:29rpx;font-weight:700}.draft-main>text:nth-child(2){font-size:23rpx;color:#7b847e;margin-top:8rpx}.draft-main .draft-reason{font-size:22rpx;color:#b65b20;margin-top:7rpx}.draft-row>button{margin:0;padding:0 14rpx;height:52rpx;line-height:52rpx;background:#fff;color:#9a403a;border:1rpx solid #e8c4c1;font-size:22rpx}.draft-row.conflict{background:#fffaf2}.review-empty,.review-state{margin:80rpx 24rpx;text-align:center;color:#7c857f}.review-state{display:flex;flex-direction:column;gap:20rpx}.review-footer{position:fixed;left:0;right:0;bottom:0;padding:18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));background:#fff;display:flex;gap:18rpx;box-shadow:0 -8rpx 24rpx rgba(0,0,0,.08)}.review-footer button{flex:1;margin:0;background:#edf3ef;color:#24533a;font-size:27rpx}.review-footer .primary{background:#08783f;color:#fff}.review-footer button[disabled]{opacity:.45}.player-import-task{margin:0 0 18rpx;padding:22rpx 24rpx;background:#fff6df;border:1rpx solid #e8bd58;border-radius:14rpx;display:flex;align-items:center;justify-content:space-between;color:#795314}.player-import-task>view{display:flex;flex-direction:column}.player-import-task>view text:first-child{font-size:28rpx;font-weight:700}.player-import-task>view text:last-child{font-size:22rpx;margin-top:5rpx}.player-import-task>text{font-size:24rpx;font-weight:700}
.draft-name{display:flex;align-items:center;gap:10rpx}.draft-name>text:first-child{font-size:29rpx;font-weight:700}.draft-name>text:last-child{padding:3rpx 9rpx;border:1rpx solid #d8902b;border-radius:6rpx;color:#a66313;font-size:20rpx}.draft-main>.draft-name+text{font-size:23rpx;color:#7b847e;margin-top:8rpx;font-weight:400}
