/* pages/match/match.wxss */
.container {
  background-color: #f5f7fa;
  min-height: 100vh;
  padding-bottom: 30rpx;
}

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, #1b5e20 0%, #2e7d32 50%, #43a047 100%);
}

.page-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
}

.page-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 400rpx;
  gap: 16rpx;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid rgba(46, 125, 50, 0.15);
  border-top-color: #2e7d32;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #888;
}

.referee-list {
  padding: 24rpx 28rpx;
  height: calc(100vh - 180rpx);
  box-sizing: border-box;
}

.referee-card {
  background: #fff;
  border-radius: 18rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.referee-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #fff;
  box-shadow: 0 2rpx 12rpx rgba(46, 125, 50, 0.15);
}

.avatar-img {
  width: 96rpx;
  height: 96rpx;
}

.avatar-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #2e7d32;
}

.card-info {
  margin-left: 22rpx;
  flex: 1;
  min-width: 0;
}

.referee-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
  margin-bottom: 10rpx;
}

.tag-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.level-tag,
.status-tag {
  display: inline-block;
  border-radius: 6rpx;
  font-weight: 500;
}

.level-tag {
  font-size: 20rpx;
  padding: 3rpx 14rpx;
}

.level-top {
  background: #fff3e0;
  color: #e65100;
}

.level-middle {
  background: #e3f2fd;
  color: #1565c0;
}

.level-basic {
  background: #f3e5f5;
  color: #6a1b9a;
}

.level-junior {
  background: #eceff1;
  color: #546e7a;
}

.status-tag {
  font-size: 18rpx;
  padding: 3rpx 12rpx;
}

.status-approved {
  background: #e8f5e9;
  color: #2e7d32;
}

.status-pending {
  background: #fff8e1;
  color: #f57f17;
}

.status-rejected {
  background: #ffebee;
  color: #c62828;
}

.card-body {
  margin-left: 118rpx;
  padding-top: 8rpx;
}

.info-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 8rpx;
}

.info-label {
  font-size: 24rpx;
  color: #888;
  width: 140rpx;
  flex-shrink: 0;
}

.info-value {
  font-size: 25rpx;
  color: #333;
  word-break: break-all;
}

.phone-value {
  color: #1976d2;
}

.cert-value {
  font-size: 23rpx;
  color: #666;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 30rpx;
  color: #666;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #aaa;
}
