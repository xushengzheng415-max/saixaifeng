.page{min-height:100vh;background:#f4f7f5}.hero{min-height:505rpx;padding:70rpx 34rpx 0;background-image:linear-gradient(180deg,rgba(0,20,14,.9),rgba(0,75,47,.9)),url('/images/runtime/stadium-tech-bg.jpg');background-size:cover}.nav{height:76rpx;position:relative;text-align:center}.back{position:absolute;left:0;color:#fff;font-size:68rpx;line-height:50rpx}.title{color:#fff;font-size:39rpx;font-weight:700}.score-card{margin-top:37rpx;padding:27rpx;border:2rpx solid #1aa46a;border-radius:29rpx;background:rgba(0,68,42,.88);color:#fff}.score-top,.score-row,.actions{display:flex;align-items:center;justify-content:space-between}.score-row{margin-top:30rpx}.score-row text{width:180rpx;text-align:center;font-size:24rpx}.score-value{font-size:60rpx}.readonly{display:block;margin-top:24rpx;padding-top:18rpx;border-top:1rpx solid rgba(255,255,255,.2);color:#c7e4d3;font-size:21rpx}.content{padding:0 34rpx 115rpx;margin-top:-8rpx}.loading,.error,.denied{padding:90rpx 0;text-align:center;color:#839088}.error{color:#bc5146}.panel{margin-top:20rpx;padding:25rpx;border-radius:22rpx;background:#fff;box-shadow:0 8rpx 24rpx rgba(15,55,36,.07)}.panel-title{display:block;padding-left:15rpx;border-left:7rpx solid #128055;font-size:28rpx;font-weight:700}.types{display:flex;flex-wrap:wrap;gap:14rpx;margin-top:22rpx}.type{padding:16rpx;border:1rpx solid #e0e8e3;border-radius:15rpx;color:#536b5d;font-size:22rpx}.type.active{border-color:#168153;background:#edf8f1;color:#176e4d;font-weight:600}textarea{width:100%;height:150rpx;margin-top:20rpx;padding:16rpx;border:1rpx solid #dfe6e1;border-radius:14rpx;box-sizing:border-box;font-size:23rpx}.field{display:flex;align-items:center;margin-top:18rpx}.field text{width:130rpx;font-size:23rpx}.field input{flex:1;padding:14rpx;border:1rpx solid #dfe6e1;border-radius:12rpx;font-size:23rpx}.evidence{display:flex;justify-content:space-between;margin-top:19rpx;padding:20rpx;border:1rpx dashed #9fcaaf;border-radius:14rpx;color:#4d7660;font-size:22rpx}.actions{gap:18rpx;margin-top:23rpx}.actions button{flex:1;background:#edf5f0;color:#197451;font-size:25rpx}.actions .submit{color:#fff;background:#087d4e}.report{display:flex;flex-direction:column;gap:8rpx;padding:20rpx 0;border-bottom:1rpx solid #edf0ee;color:#79877f;font-size:20rpx}.report-description{color:#314c3e;font-size:24rpx}
.page{padding-top:0}.hero{padding-top:0}.nav{height:208rpx;box-sizing:border-box;align-items:flex-end;padding-bottom:28rpx}.back{bottom:16rpx}
