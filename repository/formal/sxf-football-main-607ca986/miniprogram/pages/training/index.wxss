.training-page{min-height:100vh;position:relative;background:#031b11;color:#173d2a}.training-bg{position:absolute;inset:0;width:100%;height:100%;opacity:.92}.training-content{position:relative;z-index:1;min-height:100vh;box-sizing:border-box;padding:0 28rpx 150rpx}.training-nav{height:208rpx;box-sizing:border-box;padding:106rpx 8rpx 0;display:flex;align-items:center;justify-content:space-between;color:#fff;font-size:37rpx;font-weight:700}.training-more{box-sizing:border-box;padding:9rpx 14rpx;border:1rpx solid rgba(255,255,255,.6);border-radius:34rpx;font-size:24rpx;letter-spacing:2rpx}.training-hero{display:flex;align-items:center;justify-content:space-between;padding:31rpx;border-radius:26rpx;background:linear-gradient(135deg,#007b45,#169b62);border:1rpx solid rgba(255,205,64,.65);color:#fff}.training-hero image{width:132rpx;height:132rpx}.training-eyebrow,.training-name,.training-entitlement{display:block}.training-eyebrow{font-size:20rpx;opacity:.74}.training-name{max-width:470rpx;margin-top:9rpx;font-size:38rpx;font-weight:700}.training-entitlement{display:inline-block;margin-top:17rpx;padding:6rpx 13rpx;border-radius:18rpx;background:rgba(255,255,255,.16);font-size:21rpx}.training-loading,.training-error{margin-top:25rpx;padding:28rpx;border-radius:20rpx;background:#fff;text-align:center;font-size:24rpx}.training-error{color:#c4443b;background:#fff1ef}.training-access,.training-note{display:flex;gap:18rpx;margin-top:25rpx;padding:28rpx;border-radius:24rpx;background:#fff}.training-access image,.training-note image{flex:0 0 72rpx;width:72rpx;height:72rpx}.training-access view,.training-note view{flex:1}.training-access text,.training-note text{display:block}.training-access text:first-child,.training-note text:first-child{font-size:29rpx;font-weight:700}.training-access text:last-child,.training-note text:last-child{margin-top:10rpx;color:#6f8277;font-size:22rpx;line-height:1.55}.training-access button{height:72rpx;line-height:72rpx;margin:21rpx 0 0;border-radius:14rpx;background:#058747;color:#fff;font-size:25rpx}.training-note{background:#eaf8ef;border:1rpx solid #bde8ca}.training-section{margin-top:30rpx}.training-section-head{display:flex;justify-content:space-between;align-items:baseline;margin:0 6rpx 13rpx;color:#fff}.training-section-head text:first-child{font-size:31rpx;font-weight:700}.training-section-head text:last-child{font-size:20rpx;opacity:.76}.training-card{display:flex;align-items:center;gap:17rpx;min-height:108rpx;margin-top:13rpx;padding:18rpx 22rpx;border-radius:22rpx;background:#fff}.training-card image{width:60rpx;height:60rpx}.training-card view{flex:1}.training-card text{display:block}.training-card view text:first-child{font-size:27rpx;font-weight:700}.training-card view text:last-child{margin-top:7rpx;color:#7a8a81;font-size:21rpx}.training-card>text{color:#098a4c;font-size:21rpx}.training-empty{padding:32rpx;border-radius:20rpx;background:#fff;color:#829087;text-align:center;font-size:23rpx}
