<!--pages/invite/invite.wxml-->
<view class="invite-page">
  <!-- 顶部信息 -->
  <view class="invite-header">
    <image class="invite-logo" src="/images/logo.png" mode="aspectFit" />
    <view class="invite-title">麦部足球赛事系统</view>
    <view class="invite-subtitle">邀请确认</view>
  </view>

  <!-- 邀请信息 -->
  <view class="invite-info card" wx:if="{{inviteInfo}}">
    <view class="info-row">
      <text class="info-label">邀请类型</text>
      <text class="info-value"></text>
    </view>
    <view class="info-row">
      <text class="info-label">球队名称</text>
      <text class="info-value">{{inviteInfo.teamName || '加载中...'}}</text>
    </view>
    <view class="info-row" wx:if="{{inviteInfo.role}}">
      <text class="info-label">担任角色</text>
      <text class="info-value">{{inviteInfo.role}}</text>
    </view>
  </view>

  <!-- 未登录 -->
  <view class="login-section card" wx:if="{{!isLoggedIn}}">
    <view class="login-tip">请先登录微信账号，以接受邀请</view>
    <button class="btn-login" bindtap="handleWechatLogin">微信登录</button>
  </view>

  <!-- 已登录 - 填写资料 -->
  <view class="form-section card" wx:if="{{showInviteForm}}">
    <view class="form-title">填写个人资料</view>

    <!-- 头像 -->
    <view class="form-item avatar-item">
      <text class="form-label">头像</text>
      <view class="avatar-wrapper" bindtap="handleChooseAvatar">
        <image class="avatar-img" src="{{form.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill" />
        <view class="avatar-edit">更换</view>
      </view>
    </view>

    <!-- 姓名 -->
    <view class="form-item">
      <text class="form-label">姓名 *</text>
      <input class="form-input" placeholder="请输入姓名" value="{{form.name}}" bindinput="handleInputChange" data-field="name" />
    </view>

    <!-- 手机号 -->
    <view class="form-item">
      <text class="form-label">手机号 *</text>
      <input class="form-input" type="number" maxlength="11" placeholder="请输入手机号" value="{{form.phone}}" bindinput="handleInputChange" data-field="phone" />
    </view>

    <!-- 证件号 -->
    <view class="form-item">
      <text class="form-label">证件号</text>
      <input class="form-input" placeholder="请输入身份证号（选填）" value="{{form.idNumber}}" bindinput="handleInputChange" data-field="idNumber" />
    </view>

    <!-- 教练专属：专长 -->
    <view class="form-item">
      <text class="form-label">执教专长</text>
      <input class="form-input" placeholder="如：进攻训练、守门员训练" value="{{form.specialty}}" bindinput="handleInputChange" data-field="specialty" />
    </view>

    <!-- 教练专属：证书等级 -->
    <view class="form-item">
      <text class="form-label">证书等级</text>
      <picker mode="selector" range="{{certLevels}}" value="{{certIndex}}" bindchange="handleCertChange">
        <view class="form-picker">{{form.certLevel || '请选择证书等级'}}</view>
      </picker>
    </view>

    <!-- 提交按钮 -->
    <button class="btn-submit" bindtap="handleSubmit">提交资料，接受邀请</button>
  </view>

  <!-- 提交成功 -->
  <view class="success-section card" wx:if="{{submitSuccess}}">
    <view class="success-icon">✅</view>
    <view class="success-title">资料提交成功！</view>
    <view class="success-desc">您已成功加入「{{inviteInfo.teamName}}」</view>
    <view class="success-role">担任角色：{{submitResult.role}}</view>
    <button class="btn-back" bindtap="handleBackToHome">返回首页</button>
  </view>
</view>
