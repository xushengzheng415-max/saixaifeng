<view class="page">
  <button bindtap="openDataCenter">历史统计</button>
  <view class="head" bindtap="onSwitchWorkspace">
    <view>
      <text class="head-label">{{workspaceTypeText}}</text>
      <text class="head-title">{{workspaceName}}</text>
    </view>
    <text class="switch-text" wx:if="{{canSwitchWorkspace}}">切换</text>
  </view>

  <view class="loading" wx:if="{{loading}}">正在汇总数据...</view>
  <view class="error" wx:if="{{errorText}}">{{errorText}}</view>

  <view class="metric-grid">
    <view class="metric-card {{item.cardClass}}" wx:for="{{cards}}" wx:key="id">
      <text class="metric-value">{{item.value}}</text>
      <text class="metric-label">{{item.label}}</text>
    </view>
  </view>

  <view class="section" wx:if="{{hasTournaments}}">
    <view class="section-head">
      <text class="section-title">赛事概览</text>
      <text class="section-note">仅展示当前空间授权数据</text>
    </view>
    <view
      class="list-card"
      wx:for="{{tournaments}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onTournamentTap"
    >
      <view>
        <text class="item-title">{{item.name}}</text>
        <text class="item-subtitle">{{item.relationText}} · {{item.dateText}}</text>
      </view>
      <text class="item-status">{{item.statusText}}</text>
    </view>
  </view>

  <view class="section" wx:if="{{hasTeams}}">
    <view class="section-head">
      <text class="section-title">球队概览</text>
      <text class="section-note">长期球队资产</text>
    </view>
    <view
      class="list-card"
      wx:for="{{teams}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onTeamTap"
    >
      <view>
        <text class="item-title">{{item.name}}</text>
        <text class="item-subtitle">{{item.teamCode || '暂无球队编号'}}</text>
      </view>
      <text class="item-link">查看</text>
    </view>
  </view>
</view>
