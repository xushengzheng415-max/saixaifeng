<view class="pass-page">
  <view wx:if="{{loading}}" class="state">正在生成本场参赛证…</view>
  <view wx:elif="{{errorText}}" class="state"><text>{{errorText}}</text><button bindtap="load">重新加载</button></view>
  <block wx:else>
    <view class="pass-card">
      <view class="pass-head"><text>赛小蜂足球</text><text>成人电子参赛证</text></view>
      <image wx:if="{{player.photoUrl}}" class="portrait" src="{{player.photoUrl}}" mode="aspectFill"/><view wx:else class="portrait empty">照片</view>
      <text class="name">{{player.name}}</text><text class="number">{{player.jerseyNumber}}号 · {{player.identityLabel}}</text>
      <image class="qr" src="{{qrUrl}}" mode="aspectFit"/>
      <text class="match">{{match.teamsText}}</text><text class="meta">{{match.timeText}} · {{expiresText}}</text>
      <text class="certificate">证号 {{certificate.number}}</text>
    </view>
    <view class="notice">请由球员本人出示。扫码后仍需裁判当面核对照片。</view>
  </block>
</view>
