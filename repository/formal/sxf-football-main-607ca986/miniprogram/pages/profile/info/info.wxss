.page {
  min-height: 100vh;
  background: #f5f6fa;
  padding: 28rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.avatar-row {
  display: flex;
  align-items: center;
}

.avatar-preview {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #eef3ef;
  flex-shrink: 0;
}

.avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #7da17e;
  font-size: 24rpx;
}

.avatar-actions {
  flex: 1;
  margin-left: 24rpx;
}

.action-btn {
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  margin: 0 0 16rpx;
  background: #2e7d32;
  color: #fff;
}

.action-btn-wechat {
  background: #e8f5e9;
  color: #2e7d32;
}

.input {
  width: 100%;
  height: 88rpx;
  background: #f8faf8;
  border: 2rpx solid #e1e7e1;
  border-radius: 14rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #333;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
  font-size: 26rpx;
}

.meta-label {
  color: #888;
}

.meta-value {
  color: #333;
}

.footer {
  padding-top: 16rpx;
}

.save-btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #2e7d32, #43a047);
  color: #fff;
  font-size: 30rpx;
}
