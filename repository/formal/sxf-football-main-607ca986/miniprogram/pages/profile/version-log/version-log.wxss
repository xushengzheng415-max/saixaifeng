.page{min-height:100vh;padding:30rpx 28rpx 70rpx;background:#f2f7f4;box-sizing:border-box}.hero{padding:42rpx 36rpx;border-radius:30rpx;background:linear-gradient(145deg,#063f28,#0b6b3a 65%,#159653);color:#fff;box-shadow:0 18rpx 48rpx rgba(3,61,36,.18)}.eyebrow,.version,.title,.summary{display:block}.eyebrow{color:rgba(255,255,255,.72);font-size:23rpx;letter-spacing:2rpx}.version{margin-top:28rpx;font-size:54rpx;font-weight:900}.title{margin-top:12rpx;font-size:34rpx;font-weight:800}.summary{margin-top:24rpx;color:rgba(255,255,255,.86);font-size:26rpx;line-height:1.7}.meta{display:flex;gap:16rpx;margin-top:30rpx}.meta text{padding:8rpx 16rpx;border:2rpx solid rgba(255,255,255,.28);border-radius:18rpx;color:rgba(255,255,255,.9);font-size:22rpx}.notice{margin-top:24rpx;padding:22rpx 26rpx;border:2rpx solid #f1d69c;border-radius:20rpx;background:#fff8e8;color:#8a5b16;font-size:24rpx;line-height:1.65}.section{margin-top:24rpx;padding:30rpx 28rpx 16rpx;border:2rpx solid #dce8e0;border-radius:26rpx;background:#fff}.section-title{display:flex;align-items:center;margin-bottom:16rpx}.section-title view{width:8rpx;height:32rpx;margin-right:15rpx;border-radius:8rpx;background:#159653}.section-title text{color:#17261d;font-size:30rpx;font-weight:800}.log-row{display:flex;align-items:flex-start;padding:15rpx 0;border-bottom:2rpx solid #eef3f0}.log-row:last-child{border-bottom:0}.dot{flex:0 0 auto;width:34rpx;height:34rpx;margin:2rpx 15rpx 0 0;border-radius:50%;background:#e4f5e9;color:#159653;font-size:21rpx;line-height:34rpx;text-align:center}.log-text{flex:1;color:#48564e;font-size:25rpx;line-height:1.65}.footer{padding:40rpx 0 10rpx;text-align:center}.footer text{display:block;color:#77827b;font-size:23rpx;line-height:1.8}.footer text:first-child{color:#31513e;font-size:26rpx;font-weight:700}
