.page{min-height:100vh;position:relative;background:#002517}.bg,.shade{position:fixed;inset:0;width:100%;height:100%}.shade{background:linear-gradient(180deg,rgba(0,18,11,.3),rgba(0,28,16,.82))}.content{position:relative;z-index:1;padding:102rpx 38rpx calc(66rpx + env(safe-area-inset-bottom));color:#fff}.top{text-align:center;font-size:42rpx;font-weight:900}.steps{display:flex;justify-content:space-between;margin:42rpx 14rpx 34rpx}.steps view{width:30%;display:flex;flex-direction:column;align-items:center;color:rgba(255,255,255,.62);font-size:21rpx}.steps view:first-child{color:#fff}.steps text:first-child{display:flex;align-items:center;justify-content:center;width:43rpx;height:43rpx;margin-bottom:12rpx;border-radius:50%;border:2rpx solid rgba(255,255,255,.48);font-size:25rpx}.steps .active text:first-child{background:#169348;border-color:#fff}.form-card{padding:36rpx;border-radius:28rpx;background:rgba(255,255,255,.98);color:#151a16}.crest{display:flex;align-items:center;justify-content:center;width:154rpx;height:154rpx;margin:0 auto;border-radius:50%;background:#edf7ef;overflow:hidden}.crest>image{width:100%;height:100%}.crest view{display:flex;flex-direction:column;align-items:center;color:#178846;font-size:21rpx}.crest view image{width:78rpx;height:78rpx;margin-bottom:6rpx}.crest-hint{display:block;margin:17rpx 0 30rpx;color:#77807a;font-size:23rpx;text-align:center}.divider{height:2rpx;background:#edf0ee;margin-bottom:29rpx}.label{display:block;margin:23rpx 0 12rpx;color:#263029;font-size:25rpx;font-weight:800}.form-card input,.picker,.readonly{display:flex;align-items:center;min-height:76rpx;padding:0 20rpx;border:2rpx solid #dce2de;border-radius:14rpx;box-sizing:border-box;color:#1b231d;font-size:26rpx}.picker{justify-content:space-between}.picker text{color:#758078;font-size:38rpx}.readonly{color:#718078;background:#f5f7f5}.snapshot{display:flex;align-items:center;gap:14rpx;margin:23rpx 0;padding:19rpx 22rpx;border-radius:18rpx;background:rgba(223,246,229,.95);color:#1f8544;font-size:22rpx}.snapshot image{width:34rpx;height:34rpx}.error{display:block;margin-bottom:16rpx;color:#ffb1aa;font-size:23rpx;text-align:center}.content button{background:#0b8a45;color:#fff;border-radius:18rpx;font-size:32rpx;font-weight:800}.content button::after{border:0}
.content{padding-top:82rpx;padding-bottom:calc(50rpx + env(safe-area-inset-bottom))}.top{font-size:40rpx}.steps{margin-top:28rpx;margin-bottom:24rpx}.steps text:first-child{width:40rpx;height:40rpx;margin-bottom:8rpx;font-size:23rpx}.form-card{padding:26rpx;border-radius:26rpx}.crest{width:116rpx;height:116rpx}.crest view{font-size:19rpx}.crest view image{width:60rpx;height:60rpx;margin-bottom:4rpx}.crest-hint{margin:10rpx 0 20rpx;font-size:21rpx}.divider{margin-bottom:18rpx}.label{margin:15rpx 0 8rpx;font-size:23rpx}.form-card input,.picker,.readonly{min-height:64rpx;padding:0 18rpx;border-radius:13rpx;font-size:24rpx}.picker text{font-size:34rpx}.snapshot{gap:12rpx;margin:16rpx 0;padding:14rpx 18rpx;border-radius:16rpx;font-size:20rpx}.snapshot image{width:28rpx;height:28rpx}.content button{height:80rpx;font-size:29rpx}
.crest-state{display:block;margin:14rpx 0 -4rpx;color:#d3f4df;font-size:20rpx;text-align:center}.content>button{width:100%;padding:0}.hidden-canvas{position:fixed;left:-2000px;top:-2000px;width:600px;height:600px}.crop-mask{position:fixed;z-index:10;inset:0;background:rgba(0,0,0,.62);display:flex;align-items:flex-end}.crop-dialog{width:100%;box-sizing:border-box;padding:42rpx 38rpx calc(42rpx + env(safe-area-inset-bottom));border-radius:38rpx 38rpx 0 0;background:#fff}.crop-title{display:block;margin-bottom:30rpx;text-align:center;font-size:34rpx;font-weight:800}.crop-window{display:flex;align-items:center;justify-content:center;width:500rpx;height:500rpx;margin:0 auto 24rpx;overflow:hidden;border-radius:20rpx;background:#ebf1ed}.crop-image{width:100%;height:100%;transition:transform .15s}.crop-label{color:#68736c;font-size:24rpx}.crop-actions{display:flex;gap:20rpx;margin-top:20rpx}.crop-actions button{flex:1;height:82rpx;border-radius:16rpx;font-size:29rpx}.crop-cancel{background:#eff3f0;color:#415047}.crop-confirm{background:#168642;color:#fff}.crop-actions button::after{border:0}
