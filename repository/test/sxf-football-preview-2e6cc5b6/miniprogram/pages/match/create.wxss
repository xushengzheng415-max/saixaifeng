/* pages/match/create.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx 30rpx 120rpx;
}

.form-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}

.form-item {
  margin-bottom: 30rpx;
  padding-bottom: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.label {
  font-size: 28rpx;
  color: #212121;
  font-weight: bold;
  display: block;
  margin-bottom: 16rpx;
}

.sub-label {
  font-size: 24rpx;
  color: #9e9e9e;
  display: block;
  margin-bottom: 16rpx;
}

.input {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.textarea {
  width: 100%;
  height: 200rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 赛事类型选择 */
.type-list {
  display: flex;
  gap: 16rpx;
}

.type-card {
  flex: 1;
  padding: 24rpx 16rpx;
  border-radius: 16rpx;
  border: 3rpx solid #e0e0e0;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.type-card.active {
  border-color: #2E7D32;
  background: #E8F5E9;
}

.type-icon {
  font-size: 48rpx;
  margin-bottom: 10rpx;
}

.type-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #212121;
  margin-bottom: 6rpx;
}

.type-card.active .type-name {
  color: #2E7D32;
}

.type-desc {
  font-size: 22rpx;
  color: #757575;
  display: block;
}

/* 日期选择 */
.date-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.date-picker {
  flex: 1;
  height: 80rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #212121;
  line-height: 80rpx;
  text-align: center;
  box-sizing: border-box;
}

.date-sep {
  font-size: 28rpx;
  color: #757575;
}

/* 数字输入 */
.number-row {
  display: flex;
  gap: 20rpx;
}

.number-item {
  flex: 1;
}

.number-label {
  font-size: 24rpx;
  color: #757575;
  display: block;
  margin-bottom: 8rpx;
}

.number-input {
  width: 100%;
  height: 72rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 官员角色 */
.official-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.official-tag {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #757575;
  background: #f5f5f5;
  border-radius: 24rpx;
  border: 2rpx solid transparent;
}

.official-tag.active {
  color: #2E7D32;
  background: #E8F5E9;
  border-color: #2E7D32;
}

.check-icon {
  margin-right: 6rpx;
}

/* 提示框 */
.tip-box {
  background: #FFFDE7;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-top: 16rpx;
}

.tip-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #F57F17;
  display: block;
  margin-bottom: 10rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #795548;
  display: block;
  margin-bottom: 4rpx;
}

.save-btn {
  margin-top: 30rpx;
  height: 88rpx;
  background: #2E7D32;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 44rpx;
}