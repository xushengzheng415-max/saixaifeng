/* 创建赛事页面样式 */

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #E8F5E9 0%, #F5F5F5 100%);
  padding-bottom: 40rpx;
}

/* 顶部区域 */
.header-section {
  position: relative;
  height: 280rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #1B5E20 0%, #2E7D32 50%, #43A047 100%);
}

.header-content {
  position: relative;
  z-index: 1;
  padding: 60rpx 40rpx 40rpx;
}

.header-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 16rpx;
}

.header-desc {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 表单区域 */
.form-section {
  padding: 0 24rpx;
  margin-top: -40rpx;
}

/* 表单卡片 */
.form-card {
  background: rgba(255, 255, 255, 0.98);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.card-title {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.title-bar {
  width: 8rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #43A047 0%, #2E7D32 100%);
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #1B5E20;
}

/* 表单项 */
.form-item {
  margin-bottom: 32rpx;
  position: relative;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.required {
  color: #F44336;
  margin-left: 4rpx;
}

/* 输入框 */
.input-field {
  width: 100%;
  height: 88rpx;
  background: #F5F5F5;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.input-field::placeholder {
  color: #999;
}

/* 文本域 */
.textarea-field {
  width: 100%;
  min-height: 200rpx;
  background: #F5F5F5;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  line-height: 1.6;
}

.textarea-field::placeholder {
  color: #999;
}

.char-count {
  position: absolute;
  right: 0;
  bottom: -40rpx;
  font-size: 24rpx;
  color: #999;
}

/* 选择器 */
.picker-field {
  width: 100%;
  height: 88rpx;
  background: #F5F5F5;
  border-radius: 16rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.picker-field .placeholder {
  font-size: 28rpx;
  color: #999;
}

.picker-field .selected {
  font-size: 28rpx;
  color: #333;
}

.picker-arrow {
  font-size: 24rpx;
  color: #999;
}

/* 步进器 */
.stepper-wrapper {
  width: 100%;
}

.stepper-box {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F5F5;
  border-radius: 16rpx;
  overflow: hidden;
  height: 88rpx;
}

.stepper-btn {
  width: 88rpx;
  height: 88rpx;
  background: transparent;
  border: none;
  font-size: 48rpx;
  color: #43A047;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  flex-shrink: 0;
}

.stepper-btn::after {
  border: none;
}

.stepper-btn.minus {
  color: #999;
}

.stepper-btn.plus {
  color: #43A047;
}

.stepper-value {
  flex: 1;
  text-align: center;
  font-size: 40rpx;
  font-weight: bold;
  color: #1B5E20;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stepper-hint {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

/* 标签行 */
.label-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.label-tip {
  font-size: 24rpx;
  color: #999;
  margin-left: 8rpx;
}

/* 字段说明 */
.field-notice {
  display: flex;
  align-items: flex-start;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: rgba(76, 175, 80, 0.08);
  border-radius: 12rpx;
  border-left: 4rpx solid #43A047;
}

.notice-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.notice-text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
}

/* 赛制选择卡片 */
.schedule-types {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.type-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #F5F5F5;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.type-card.selected {
  background: rgba(67, 160, 71, 0.08);
  border-color: #43A047;
}

.type-card .type-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.type-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.type-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #212121;
  margin-bottom: 6rpx;
}

.type-desc {
  font-size: 24rpx;
  color: #999;
}

.type-check {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #43A047, #2E7D32);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  flex-shrink: 0;
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #43A047 0%, #2E7D32 100%);
  border-radius: 48rpx;
  border: none;
  margin-top: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(46, 125, 50, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn::after {
  border: none;
}

.btn-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

/* 加载状态 */
.submit-btn[loading] {
  opacity: 0.7;
}

/* LOGO 上传 */
.logo-upload-box {
  width: 100%;
}

.logo-preview {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #F5F5F5;
}

.logo-preview image {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 48rpx;
  height: 48rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
}

.upload-btn {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #CCC;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #FAFAFA;
}

.upload-icon {
  font-size: 64rpx;
  color: #CCC;
  margin-bottom: 8rpx;
}

.upload-text {
  font-size: 24rpx;
  color: #999;
}

/* 赞助商 */
.sponsors-section {
  width: 100%;
}

.sponsor-item {
  position: relative;
  display: inline-block;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
}

.sponsor-preview {
  width: 160rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sponsor-preview image {
  max-width: 100%;
  max-height: 100%;
}

.sponsor-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.delete-sponsor-btn {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(244, 67, 54, 0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(244, 67, 54, 0.3);
}

.add-sponsor-box {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.add-sponsor-btn {
  flex: 1;
  height: 80rpx;
  background: #FFF;
  border: 2rpx solid #43A047;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #43A047;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.add-sponsor-btn::after {
  border: none;
}

.btn-icon {
  margin-right: 8rpx;
  font-size: 28rpx;
}
