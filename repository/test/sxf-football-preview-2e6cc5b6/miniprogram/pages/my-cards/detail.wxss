/* pages/my-cards/detail.wxss */
/* 球员卡详情页样式 */

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  padding: 30rpx 24rpx 120rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif;
}

/* 卡片容器 */
.card-container {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 30rpx;
}

/* 球员卡卡片 - 重用列表页样式 */
.player-card {
  width: 100%;
  height: 600rpx;
  background: linear-gradient(135deg, #ffd700 0%, #ffed4e 50%, #ffd700 100%);
  border-radius: 24rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(255, 215, 0, 0.4);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}

.player-card::before {
  content: '';
  position: absolute;
  top: -200rpx;
  right: -200rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.2) 0%, transparent 70%);
  border-radius: 50%;
  animation: pulse 4s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
    opacity: 0.8;
  }
  50% {
    transform: scale(1.1);
    opacity: 1;
  }
}

.card-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: 
    linear-gradient(135deg, transparent 30%, rgba(255, 255, 255, 0.1) 50%, transparent 70%),
    repeating-linear-gradient(45deg, transparent, transparent 30rpx, rgba(255, 215, 0, 0.05) 30rpx, rgba(218, 165, 32, 0.1) 60rpx);
  pointer-events: none;
  z-index: 1;
}

.team-logo {
  position: absolute;
  top: 32rpx;
  left: 32rpx;
  width: 64rpx;
  height: 64rpx;
  background: rgba(0, 0, 0, 0.15);
  border: 3rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  z-index: 2;
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.15);
}

.team-logo image {
  width: 100%;
  height: 100%;
  background-color: transparent;
}

.team-logo-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #000;
  font-size: 32rpx;
  font-weight: 700;
  background-color: transparent;
}

.jersey-number {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  font-size: 64rpx;
  font-weight: 900;
  color: rgba(255, 255, 255, 0.9);
  z-index: 2;
  text-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.2);
  letter-spacing: 2rpx;
  font-style: italic;
}

.player-avatar {
  width: 240rpx;
  height: 240rpx;
  margin-top: 60rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 50%;
  overflow: hidden;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0.1) 100%);
  z-index: 2;
  position: relative;
  box-shadow: 
    0 8rpx 16rpx rgba(0, 0, 0, 0.15),
    0 0 0 4rpx rgba(255, 255, 255, 0.2);
}

.player-avatar image {
  width: 100%;
  height: 100%;
  background-color: transparent;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(0, 0, 0, 0.3);
  font-size: 100rpx;
  font-weight: 700;
  background-color: transparent;
}

.player-name {
  font-size: 36rpx;
  font-weight: 800;
  color: #fff;
  margin-top: 24rpx;
  text-align: center;
  text-shadow: 0 3rpx 6rpx rgba(0, 0, 0, 0.2);
  z-index: 2;
  letter-spacing: 1rpx;
}

.player-position {
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(0, 0, 0, 0.6);
  margin-top: 12rpx;
  text-align: center;
  z-index: 2;
  text-transform: uppercase;
  letter-spacing: 2rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  backdrop-filter: blur(10rpx);
}

.jersey-name {
  font-size: 20rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
  text-align: center;
  z-index: 2;
  letter-spacing: 3rpx;
  text-transform: uppercase;
  font-style: italic;
}

.player-stats {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-top: 24rpx;
  z-index: 2;
  width: 100%;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.stat-item {
  font-size: 22rpx;
  font-weight: 600;
  color: rgba(0, 0, 0, 0.7);
  padding: 12rpx 16rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
  backdrop-filter: blur(10rpx);
  text-align: center;
  min-width: 80rpx;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* 详细信息区域 */
.detail-section {
  width: 100%;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  padding: 30rpx;
  box-sizing: border-box;
  backdrop-filter: blur(10rpx);
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 20rpx;
  display: block;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
  padding-bottom: 10rpx;
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  line-height: 1.6;
}

.info-label {
  font-size: 26rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.7);
  width: 120rpx;
}

.info-value {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  flex: 1;
  font-weight: 600;
}

/* 操作按钮区域 */
.action-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-btn {
  width: 100%;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  backdrop-filter: blur(10rpx);
  transition: all 0.3s ease;
}

.action-btn.primary {
  background: linear-gradient(135deg, #ffd700 0%, #ffed4e 100%);
  color: #000;
  border-color: transparent;
  box-shadow: 0 8rpx 16rpx rgba(255, 215, 0, 0.3);
}

.action-btn:active {
  transform: translateY(2rpx);
}

.btn-icon {
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-text {
  flex: 1;
  text-align: center;
}

/* 加载状态 */
.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 400rpx;
}

.loading-text {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.6);
}