.page { min-height:100vh; background:#f6f7f6; color:#182d23; }.hero { min-height:655rpx; padding:72rpx 36rpx 0; box-sizing:border-box; background-image:linear-gradient(180deg,rgba(0,21,15,.84),rgba(0,49,31,.90) 70%,rgba(0,55,33,.74)),url('/images/runtime/stadium-tech-bg.jpg'); background-position:center top; background-size:cover; }.nav-row { display:flex; align-items:center; justify-content:space-between; height:74rpx; }.back-button { width:52rpx; color:#fff; font-size:66rpx; font-weight:200; line-height:48rpx; }.page-title { position:absolute; left:0; right:0; color:#fff; font-size:38rpx; font-weight:700; text-align:center; pointer-events:none; }.workspace-dot { max-width:155rpx; overflow:hidden; padding:9rpx 14rpx; border:1rpx solid rgba(255,255,255,.25); border-radius:20rpx; color:rgba(255,255,255,.82); font-size:19rpx; text-overflow:ellipsis; white-space:nowrap; }.tournament-panel { margin-top:48rpx; overflow:hidden; padding:29rpx 29rpx 20rpx; border:2rpx solid #d4a33d; border-radius:31rpx; background:linear-gradient(130deg,rgba(0,79,53,.92),rgba(0,53,35,.89)); color:#fff; }.panel-top { display:flex; align-items:center; justify-content:space-between; }.hosted-tag,.pending-tag { padding:10rpx 16rpx; border-radius:22rpx; font-size:22rpx; line-height:1; }.hosted-tag { color:#865907; background:#ffdf98; font-weight:600; }.pending-tag { color:#ffe7a8; background:rgba(191,135,34,.55); }.tournament-name { display:block; margin-top:34rpx; font-size:39rpx; font-weight:700; line-height:1.3; }.tournament-meta { display:block; margin-top:21rpx; color:rgba(255,255,255,.76); font-size:25rpx; }.panel-rule { height:1rpx; margin-top:28rpx; background:rgba(255,255,255,.28); }.panel-summary { display:block; padding-top:20rpx; color:rgba(255,255,255,.66); font-size:21rpx; }.stage-row { display:flex; justify-content:space-between; margin-top:27rpx; }.stage-item { min-width:115rpx; padding:17rpx 13rpx; border:1rpx solid rgba(255,255,255,.22); border-radius:34rpx; color:rgba(255,255,255,.8); font-size:25rpx; line-height:1; text-align:center; }.stage-item.active { border-color:#18a66c; background:#078454; color:#fff; }.content { margin-top:-12rpx; padding:0 36rpx 165rpx; }.loading,.error { padding:100rpx 0; color:#7c8983; font-size:25rpx; text-align:center; }.error { color:#b5443c; }.task-list { overflow:hidden; border-radius:26rpx; background:#fff; box-shadow:0 10rpx 32rpx rgba(18,57,39,.10); }.task-card { display:flex; align-items:center; min-height:165rpx; padding:24rpx; border-bottom:1rpx solid #edf0ee; box-sizing:border-box; }.task-card:last-child { border-bottom:0; }.task-glyph { flex:none; width:73rpx; height:73rpx; margin-right:20rpx; border-radius:18rpx; color:#fff; background:linear-gradient(135deg,#1aa46e,#057748); font-size:38rpx; font-weight:700; line-height:73rpx; text-align:center; }.task-glyph.reviewing { color:#8c611c; background:linear-gradient(135deg,#ffe4a4,#dfa43f); }.task-content { flex:1; min-width:0; }.task-title-row { display:flex; align-items:center; }.task-title { overflow:hidden; flex:1; color:#172d23; font-size:30rpx; font-weight:700; text-overflow:ellipsis; white-space:nowrap; }.task-status { margin-left:8rpx; padding:6rpx 10rpx; border-radius:16rpx; color:#a65e07; background:#fff0db; font-size:19rpx; }.task-status.reviewing { color:#287047; background:#e5f4eb; }.task-subtitle { display:block; overflow:hidden; margin-top:12rpx; color:#566b60; font-size:23rpx; text-overflow:ellipsis; white-space:nowrap; }.task-detail-row { display:flex; align-items:center; margin-top:12rpx; }.task-detail { overflow:hidden; max-width:168rpx; color:#8b9690; font-size:19rpx; text-overflow:ellipsis; white-space:nowrap; }.task-detail-separator { margin:0 10rpx; color:#d2d8d4; }.task-action { flex:none; margin-left:8rpx; padding:13rpx 18rpx; border-radius:15rpx; color:#197451; background:#edf7f1; font-size:22rpx; }.task-arrow { flex:none; margin-left:12rpx; color:#aab4ae; font-size:40rpx; font-weight:200; }.empty { margin-top:110rpx; text-align:center; }.empty-icon { display:block; width:90rpx; height:90rpx; margin:0 auto; border-radius:50%; color:#23805b; background:#e6f3ec; font-size:40rpx; line-height:90rpx; }.empty-title { display:block; margin-top:24rpx; color:#24362e; font-size:29rpx; font-weight:600; }.empty-desc { display:block; margin:14rpx auto; max-width:520rpx; color:#7d8983; font-size:23rpx; line-height:1.7; }
.page{padding-top:0}.hero{padding-top:0}.nav-row{height:208rpx;box-sizing:border-box;align-items:flex-end;padding-bottom:28rpx}.back-button{position:absolute;left:36rpx;bottom:18rpx}.task-glyph image{width:60rpx;height:60rpx;margin:6rpx}
