@import "./participation-schedule.wxss";
.event-page{min-height:100vh;background:#03271b;position:relative}.event-bg{position:absolute;inset:0;width:100%;height:100%;opacity:.75}.event-content{position:relative;padding:0 28rpx 100rpx}.event-nav{height:208rpx;display:flex;align-items:flex-end;justify-content:center;padding-bottom:28rpx;box-sizing:border-box;color:#fff;font-size:40rpx;font-weight:700;position:relative}.event-back{position:absolute;left:8rpx;bottom:16rpx;font-size:76rpx;font-weight:300}.event-loading{padding:160rpx 0;text-align:center;color:#fff}.event-team{display:flex;align-items:center;gap:24rpx;color:#fff;padding:15rpx 22rpx}.event-team image{width:136rpx;height:136rpx}.event-team>view{flex:1}.event-team>view>text{display:block;font-size:40rpx;font-weight:700}.event-count{display:flex;align-items:center;gap:8rpx;margin-top:14rpx}.event-count image{width:30rpx;height:30rpx}.event-count text{font-size:25rpx;font-weight:400}.event-tabs{display:flex;margin:20rpx 0 26rpx;padding:14rpx;background:#fff;border-radius:25rpx}.event-filter{flex:1;text-align:center;padding:17rpx 0;color:#68736c;font-size:27rpx}.event-filter.active{border-radius:32rpx;background:#078247;color:#fff;font-weight:700}.event-card{background:#fff;border-radius:28rpx;margin-bottom:24rpx;padding:28rpx;box-shadow:0 15rpx 35rpx rgba(0,28,16,.15)}.event-title{display:flex;align-items:center;gap:18rpx}.event-title image{width:80rpx;height:80rpx}.event-title view{flex:1;min-width:0}.event-title view text{display:block;font-size:31rpx;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.event-title view text:last-child{font-size:24rpx;color:#68736c;font-weight:400;margin-top:8rpx}.state-ok,.state-wait{padding:7rpx 12rpx;border-radius:14rpx;background:#e7f5eb;color:#167a4b;font-size:23rpx;white-space:nowrap}.state-wait{background:#fff3e3;color:#da8918}.event-meta{display:flex;gap:20rpx;margin:22rpx 0;padding:20rpx 0;border-top:1rpx solid #e7ebe8;color:#617067;font-size:24rpx;line-height:1.45}.event-meta text{flex:1;white-space:pre-line;min-width:0}.event-primary,.event-secondary{height:78rpx;line-height:78rpx;border-radius:14rpx;background:#087b46;color:#fff;font-size:28rpx;font-weight:700}.event-secondary{background:#fff;color:#087b46;border:2rpx solid #087b46}.event-secondary::after,.event-lineup::after{border:0}.event-lineup{margin-top:15rpx;height:66rpx;line-height:66rpx;background:#f2fbf5;color:#087b46;font-size:24rpx}.event-note{margin-top:28rpx;padding:22rpx;border-radius:18rpx;background:rgba(0,77,45,.84);color:#fff;font-size:24rpx;line-height:1.55}
