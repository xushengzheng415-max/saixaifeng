<view class="player-detail-container">
  <view wx:if="{{loading}}" class="loading-state"><view class="loading-spinner"></view><text class="loading-text">加载中...</text></view>
  <view wx:elif="{{errorText}}" class="loading-state"><text class="loading-text">{{errorText}}</text><button bindtap="loadPlayerData">重新加载</button></view>
  <block wx:else>
    <view class="hero-bg"><view class="bg-circle circle-1"></view><view class="bg-circle circle-2"></view><view class="bg-pattern"></view></view>
    <view class="player-card-fifa">
      <view wx:if="{{player.hasJerseyNumber}}" class="jersey-badge"><text class="jersey-num">{{player.jerseyNumber}}</text></view>
      <view class="avatar-section"><view class="avatar-frame"><image class="player-avatar" src="{{player.displayPhoto}}" mode="aspectFill" bindtap="previewImage"></image></view><view class="avatar-glow"></view></view>
      <view class="info-section"><text class="player-name">{{player.name}}</text><view wx:if="{{player.hasJerseyName}}" class="jersey-name">{{player.jerseyName}}</view><view wx:if="{{player.hasPosition}}" class="position-tag"><text class="tag-text">{{player.positionLabel}}</text></view><view class="profile-state-tag">{{player.profileStatusText}}</view><view class="card-score-line"><text>{{cardScore.level}}</text><text>{{cardScore.points}} 分</text><text>{{cardScore.progress}}</text></view><view wx:if="{{cardScore.breakdown}}" class="card-score-line">{{cardScore.breakdown}}</view></view>
    </view>

    <view class="core-stats-card">
      <view class="stats-grid-four"><view class="stat-box"><text class="stat-number">{{player.heightText}}</text><text class="stat-unit">{{player.heightUnit}}</text><text class="stat-name">身高</text></view><view class="stat-box"><text class="stat-number">{{player.weightText}}</text><text class="stat-unit">{{player.weightUnit}}</text><text class="stat-name">体重</text></view><view class="stat-box"><text class="stat-number">{{player.ageText}}</text><text class="stat-unit">岁</text><text class="stat-name">年龄</text></view><view class="stat-box"><text class="stat-number">{{stats.appearances}}</text><text class="stat-unit">场</text><text class="stat-name">参赛</text></view></view>
    </view>

    <view class="stats-record-card">
      <view class="card-title-bar"><view class="title-accent"></view><text class="card-title">本队贡献</text><text wx:if="{{statisticsNote}}">{{statisticsNote}}</text></view>
      <view class="stats-record-grid"><view class="stats-record-item"><view class="stats-icon-wrapper matches"><text class="stats-icon">出</text></view><view class="stats-content"><text class="stats-record-value">{{stats.appearances}}</text><text class="stats-record-label">出场</text></view></view><view class="stats-record-item"><view class="stats-icon-wrapper goals"><text class="stats-icon">球</text></view><view class="stats-content"><text class="stats-record-value">{{stats.goals}}</text><text class="stats-record-label">进球</text></view></view><view class="stats-record-item"><view class="stats-icon-wrapper yellow"><text class="stats-icon">黄</text></view><view class="stats-content"><text class="stats-record-value">{{stats.yellowCards}}</text><text class="stats-record-label">黄牌</text></view></view><view class="stats-record-item"><view class="stats-icon-wrapper red"><text class="stats-icon">红</text></view><view class="stats-content"><text class="stats-record-value">{{stats.redCards}}</text><text class="stats-record-label">红牌</text></view></view></view>
    </view>

    <view class="detail-card">
      <view class="card-title-bar"><view class="title-accent"></view><text class="card-title">详细信息</text></view>
      <view class="detail-grid"><view class="detail-item" wx:for="{{detailItems}}" wx:key="id"><text class="detail-label">{{item.label}}</text><text class="detail-value">{{item.value}}</text></view></view>
    </view>

    <view class="team-card">
      <view class="card-title-bar"><view class="title-accent green"></view><text class="card-title">所属球队</text></view>
      <view class="team-info-row"><image class="team-logo-small" src="{{teamInfo.logo || '/images/logo.png'}}" mode="aspectFit"></image><view class="team-meta"><text class="team-name-text">{{teamInfo.name}}</text><text class="team-code-text">球队代码：{{teamInfo.code || '待生成'}}</text></view></view>
    </view>

    <view wx:if="{{player.remark}}" class="remark-card"><view class="card-title-bar"><view class="title-accent orange"></view><text class="card-title">备注</text></view><text class="remark-content">{{player.remark}}</text></view>

    <view wx:if="{{canManage}}" class="action-bar"><button class="action-btn edit-btn" bindtap="onEdit"><text class="btn-text">编辑信息</text></button><button class="action-btn delete-btn" bindtap="onDelete"><text class="btn-text">移出球队</text></button></view>
  </block>
</view>
