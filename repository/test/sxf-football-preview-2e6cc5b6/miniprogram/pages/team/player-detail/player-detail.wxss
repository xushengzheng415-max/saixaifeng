/* pages/team/player-detail/player-detail.wxss */
/* 球员详情页 - FIFA卡片风格 */

page {
  background: linear-gradient(180deg, #1B5E20 0%, #2E7D32 30%, #43A047 60%, #66BB6A 100%);
  min-height: 100vh;
}

.player-detail-container {
  padding: 30rpx 24rpx;
  padding-bottom: 200rpx;
  position: relative;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 20rpx;
}

/* 背景装饰 */
.hero-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 500rpx;
  overflow: hidden;
  pointer-events: none;
}

.bg-circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.1;
}

.circle-1 {
  width: 400rpx;
  height: 400rpx;
  background: #fff;
  top: -100rpx;
  right: -100rpx;
}

.circle-2 {
  width: 300rpx;
  height: 300rpx;
  background: #fff;
  top: 100rpx;
  left: -80rpx;
}

.bg-pattern {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(76, 175, 80, 0.1) 0%, rgba(46, 125, 50, 0.05) 100%);
}

/* FIFA风格主卡片 */
.player-card-fifa {
  background: linear-gradient(135deg, rgba(255,255,255,0.98) 0%, rgba(255,255,255,0.95) 100%);
  border-radius: 32rpx;
  padding: 50rpx 40rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.2);
  position: relative;
  overflow: hidden;
}

.jersey-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 90rpx;
  height: 90rpx;
  background: linear-gradient(135deg, #FF6B35 0%, #F7931E 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 53, 0.4);
  z-index: 10;
}

.jersey-num {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

/* 头像区域 */
.avatar-section {
  position: relative;
  display: flex;
  justify-content: center;
  margin-bottom: 30rpx;
}

.avatar-frame {
  width: 220rpx;
  height: 220rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.15);
  border: 6rpx solid #fff;
  position: relative;
  z-index: 2;
}

.player-avatar {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.avatar-glow {
  position: absolute;
  width: 280rpx;
  height: 280rpx;
  background: linear-gradient(135deg, rgba(76, 175, 80, 0.25) 0%, rgba(129, 199, 132, 0.2) 100%);
  border-radius: 32rpx;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 1;
}

/* 信息区域 */
.info-section {
  text-align: center;
  position: relative;
  z-index: 2;
}

.player-name {
  display: block;
  font-size: 52rpx;
  font-weight: bold;
  color: #1B5E20;
  letter-spacing: 6rpx;
  margin-bottom: 12rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
}

.jersey-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #66BB6A;
  letter-spacing: 4rpx;
  margin-bottom: 16rpx;
  text-transform: uppercase;
}

.position-tag {
  display: inline-block;
  background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
  padding: 12rpx 36rpx;
  border-radius: 30rpx;
  border: 2rpx solid rgba(76, 175, 80, 0.3);
}

.tag-text {
  font-size: 30rpx;
  font-weight: bold;
  color: #2E7D32;
  letter-spacing: 2rpx;
}

/* 核心数据卡片 - 四宫格 */
.core-stats-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.stats-grid-four {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.stat-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 8rpx;
  background: linear-gradient(135deg, rgba(232, 245, 233, 0.6) 0%, rgba(200, 230, 201, 0.4) 100%);
  border-radius: 16rpx;
}

.stat-number {
  font-size: 48rpx;
  font-weight: bold;
  color: #1B5E20;
  line-height: 1;
}

.stat-unit {
  font-size: 20rpx;
  color: #666;
  margin-top: 4rpx;
}

.stat-name {
  font-size: 22rpx;
  color: #888;
  margin-top: 8rpx;
}

/* 参赛数据统计卡片 */
.stats-record-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.stats-record-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.stats-record-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 12rpx;
  background: linear-gradient(135deg, rgba(232, 245, 233, 0.5) 0%, rgba(200, 230, 201, 0.3) 100%);
  border-radius: 20rpx;
}

.stats-icon-wrapper {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.stats-icon-wrapper.matches {
  background: linear-gradient(135deg, #4CAF50 0%, #66BB6A 100%);
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.3);
}

.stats-icon-wrapper.goals {
  background: linear-gradient(135deg, #FF6B35 0%, #F7931E 100%);
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 53, 0.3);
}

.stats-icon-wrapper.yellow {
  background: linear-gradient(135deg, #FFD54F 0%, #FFCA28 100%);
  box-shadow: 0 4rpx 12rpx rgba(255, 213, 79, 0.3);
}

.stats-icon-wrapper.red {
  background: linear-gradient(135deg, #E53935 0%, #EF5350 100%);
  box-shadow: 0 4rpx 12rpx rgba(229, 57, 53, 0.3);
}

.stats-icon {
  font-size: 32rpx;
}

.stats-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-record-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #1B5E20;
  line-height: 1;
}

.stats-record-label {
  font-size: 22rpx;
  color: #666;
  margin-top: 8rpx;
}

/* 详细信息卡片 */
.detail-card, .team-card, .remark-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.card-title-bar {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.title-accent {
  width: 6rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #4CAF50 0%, #2E7D32 100%);
  border-radius: 3rpx;
  margin-right: 16rpx;
}

.title-accent.green {
  background: linear-gradient(180deg, #66BB6A 0%, #4CAF50 100%);
}

.title-accent.orange {
  background: linear-gradient(180deg, #FFA726 0%, #FB8C00 100%);
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  letter-spacing: 1rpx;
}

/* 详细信息网格 - 两列 */
.detail-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.detail-item {
  display: flex;
  flex-direction: column;
  padding: 20rpx 16rpx;
  background: linear-gradient(135deg, rgba(232, 245, 233, 0.5) 0%, rgba(200, 230, 201, 0.3) 100%);
  border-radius: 16rpx;
}

.detail-label {
  font-size: 22rpx;
  color: #888;
  margin-bottom: 8rpx;
}

.detail-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.phone-link {
  color: #1976D2;
  text-decoration: underline;
}

/* 球队卡片 */
.team-info-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.team-logo-small {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.team-meta {
  flex: 1;
}

.team-name-text {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 6rpx;
}

.team-code-text {
  display: block;
  font-size: 24rpx;
  color: #666;
}

/* 备注卡片 */
.remark-content {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
}

/* 底部操作按钮 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.98) 30%);
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 28rpx 0;
  border-radius: 50rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  transition: all 0.3s ease;
}

.action-btn::after {
  border: none;
}

.action-btn:active {
  transform: translateY(2rpx);
}

.edit-btn {
  background: linear-gradient(135deg, #4CAF50 0%, #66BB6A 100%);
}

.edit-btn .btn-icon, .edit-btn .btn-text {
  color: #fff;
}

.delete-btn {
  background: linear-gradient(135deg, #F44336 0%, #EF5350 100%);
}

.delete-btn .btn-icon, .delete-btn .btn-text {
  color: #fff;
}

.btn-icon {
  font-size: 28rpx;
}

.btn-text {
  font-size: 28rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
}
.card-score-line { display:flex; justify-content:center; flex-wrap:wrap; gap:12rpx; margin-top:12rpx; font-size:24rpx; color:#21693b; }
