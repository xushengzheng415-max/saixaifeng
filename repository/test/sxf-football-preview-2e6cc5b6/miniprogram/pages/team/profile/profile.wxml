<view class="page"><image class="bg" src="/images/runtime/team-data-emerald-stadium-v1.jpg" mode="aspectFill"/><view class="content"><view class="nav"><text class="back" bindtap="back">‹</text><text class="nav-title">球队资料</text></view><view wx:if="{{loading}}" class="loading">正在读取球队资料…</view><block wx:else><view class="hero"><image wx:if="{{profile.logo}}" src="{{profile.logo}}" mode="aspectFit" class="crest"/><text wx:else class="crest placeholder">球队</text><view><text class="name">{{profile.name}}</text><text class="claimed">{{profile.claimText}}</text><text class="complete">资料完整度 {{completenessText}}</text></view></view><view wx:if="{{editing}}" class="card"><text class="card-title">编辑基础资料</text><input value="{{form.name}}" data-key="name" bindinput="input" placeholder="球队名称"/><input value="{{form.shortName}}" data-key="shortName" bindinput="input" placeholder="球队简称"/><input value="{{form.ageGroup}}" data-key="ageGroup" bindinput="input" placeholder="年龄组"/><input value="{{form.foundedYear}}" data-key="foundedYear" bindinput="input" placeholder="成立年份"/><input value="{{form.city}}" data-key="city" bindinput="input" placeholder="所在城市"/><input value="{{form.managerName}}" data-key="managerName" bindinput="input" placeholder="负责人"/><button bindtap="save" loading="{{saving}}" class="primary">保存长期球队资料</button><button bindtap="cancel" class="secondary">取消</button></view><block wx:else><view class="card"><text class="card-title">基础资料</text><view class="row"><text>球队名称</text><text>{{profile.name}}</text></view><view class="row"><text>球队简称</text><text>{{profile.shortName}}</text></view><view class="row"><text>年龄组</text><text>{{profile.ageGroup}}</text></view><view class="row"><text>成立年份</text><text>{{profile.foundedYear}}</text></view><view class="row"><text>所在城市</text><text>{{profile.city}}</text></view></view><view class="card"><text class="card-title">联系资料</text><view class="row"><text>负责人</text><text>{{profile.managerName}}</text></view><view class="row"><text>联系电话</text><text>{{profile.managerPhoneMasked}}</text></view><view class="row"><text>所属机构</text><text>{{profile.orgName}}</text></view></view><view class="note">长期球队资料的修改不会覆盖已审核名单和已完成比赛快照。</view><button wx:if="{{canManage}}" bindtap="edit" class="primary">编辑球队资料</button></block></block></view></view>
