.page{min-height:100vh;position:relative;background:#03271a}.bg{position:absolute;inset:0;width:100%;height:100%;opacity:.78}.content{position:relative;z-index:1;padding:0 28rpx 68rpx;color:#fff}.nav{height:142rpx;display:flex;align-items:center;justify-content:center;font-size:40rpx;font-weight:700}.back{position:absolute;left:8rpx;font-size:80rpx;font-weight:300}.loading{padding:220rpx 0;text-align:center}.hero{padding:34rpx;border:2rpx solid rgba(228,191,90,.7);border-radius:25rpx;background:linear-gradient(120deg,rgba(0,71,42,.94),rgba(34,158,101,.78))}.hero text{display:block}.hero text:first-child{font-size:26rpx}.hero text:nth-child(2){margin:20rpx 0 12rpx;font-size:48rpx;font-weight:700}.hero text:last-child{font-size:25rpx;line-height:1.55;color:#d9f4e5}.panel{margin-top:28rpx;padding:30rpx;border-radius:26rpx;background:#fff;color:#1e2b22}.qr{display:flex;flex-direction:column;align-items:center;justify-content:center;width:300rpx;height:300rpx;margin:0 auto;border:2rpx solid #e2ebe4;border-radius:18rpx}.qr image{width:174rpx;height:174rpx}.qr text{margin-top:12rpx;color:#4e6255;font-size:23rpx}.actions{text-align:center}.actions text{display:block;margin:24rpx 0 16rpx;color:#587064;font-size:24rpx}.primary{height:86rpx;line-height:86rpx;border-radius:14rpx;background:#087844;color:#fff;font-size:29rpx}.link{margin-top:14rpx;border:0;background:#fff;color:#1a7144;font-size:26rpx}.link::after{border:0}.section-title{margin:35rpx 0 14rpx;padding-left:13rpx;border-left:7rpx solid #11a25b;font-size:31rpx;font-weight:700}.requirement{display:flex;align-items:center;gap:14rpx;padding:20rpx 4rpx;border-bottom:1rpx solid #edf1ed;font-size:26rpx}.requirement image,.privacy image{width:34rpx;height:34rpx}.privacy{display:flex;gap:13rpx;margin-top:23rpx;padding:18rpx;border-radius:14rpx;background:#edf8f0;color:#337450;font-size:23rpx;line-height:1.5}.record{display:flex;align-items:center;justify-content:space-between;margin-top:28rpx;padding:20rpx;border:1rpx solid #e1eae3;border-radius:16rpx;color:#59695f}.record button{margin:0;padding:0 20rpx;height:60rpx;line-height:56rpx;border:2rpx solid #14824b;border-radius:30rpx;background:#fff;color:#14824b;font-size:24rpx}.record button::after{border:0}
.nav{height:208rpx;position:relative;align-items:flex-end;padding-bottom:28rpx;box-sizing:border-box}.back{bottom:16rpx}
