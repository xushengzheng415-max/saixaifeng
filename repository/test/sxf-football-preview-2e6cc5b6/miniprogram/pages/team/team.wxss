@import "../../styles/proto.wxss";
.page{min-height:100vh;background:#002819;position:relative}.stadium-bg,.shade{position:fixed;inset:0;width:100%;height:100%}.stadium-bg{object-position:center top}.shade{background:linear-gradient(180deg,rgba(0,24,15,.08),rgba(0,39,23,.82))}.content{position:relative;z-index:1;padding:94rpx 22rpx calc(140rpx + env(safe-area-inset-bottom))}.top{position:relative;height:72rpx;display:flex;align-items:center;justify-content:center;color:#fff;font-size:42rpx;font-weight:900}.top text:first-child{position:absolute;left:18rpx;font-size:70rpx;font-weight:400}.team-summary{margin-top:26rpx;padding:28rpx;border:2rpx solid #d9b55d;border-radius:28rpx;background:rgba(0,61,38,.56);box-sizing:border-box}.team-summary .hero{display:flex;align-items:center;margin:0;padding:0;border:0;border-radius:0;background:transparent;box-shadow:none;color:#fff;overflow:visible;min-height:0}.team-summary .hero>image,.team-summary .logo-fallback{width:148rpx;height:164rpx;flex:0 0 148rpx}.team-summary .hero>image{padding:0;background:transparent}.team-summary .logo-fallback{padding:30rpx;border-radius:0;background:rgba(234,244,236,.96);clip-path:polygon(50% 0,91% 16%,91% 70%,50% 100%,9% 70%,9% 16%);box-sizing:border-box}.team-summary .hero-main{min-width:0;flex:1;margin-left:24rpx}.team-summary .name{display:block;font-size:40rpx;line-height:1.2;font-weight:900}.hero-meta{display:flex;align-items:center;gap:15rpx;margin-top:14rpx;color:rgba(255,255,255,.9);font-size:23rpx;white-space:nowrap}.hero-meta .claim{margin:0;padding:5rpx 13rpx;border-radius:15rpx;background:#e5f5e8;color:#158446;font-size:22rpx}.hero-meta .completion{margin:0;color:#5ae49a;font-size:23rpx}.summary-arrow{margin-left:12rpx;color:#fff;font-size:58rpx;font-weight:300}.team-summary .metrics{display:flex;margin-top:28rpx;padding:25rpx 0;border-radius:22rpx;background:rgba(255,255,255,.98)}.team-summary .metrics view{flex:1;text-align:center;border-right:2rpx solid #e5e8e6}.team-summary .metrics view:last-child{border:0}.team-summary .metrics text{display:block}.team-summary .metrics text:first-child{color:#078143;font-size:43rpx;font-weight:900}.team-summary .metrics text:last-child{margin-top:10rpx;color:#59615c;font-size:23rpx}.menu{margin-top:28rpx;border-radius:26rpx;background:rgba(255,255,255,.98);overflow:hidden}.menu-row{display:flex;align-items:center;min-height:104rpx;padding:18rpx 26rpx;border-bottom:2rpx solid #edf0ee}.menu-row:last-child{border:0}.menu-row image{width:62rpx;height:62rpx;margin-right:25rpx;padding:10rpx;border-radius:15rpx;background:#edf7f0;box-sizing:border-box}.menu-row view{flex:1}.menu-row text{display:block;color:#101510;font-size:30rpx;font-weight:800}.menu-row view text:last-child{margin-top:9rpx;color:#737b76;font-size:23rpx;font-weight:400}.menu-row>text{color:#818983;font-size:44rpx}.current{margin-top:32rpx;padding:30rpx;border-radius:26rpx;background:rgba(255,255,255,.98)}.section{display:block;padding-left:15rpx;border-left:7rpx solid #0ca65a;color:#1a241d;font-size:32rpx;font-weight:900}.event-name{display:block;margin-top:19rpx;color:#131813;font-size:32rpx;font-weight:900}.current>text:nth-child(3){display:block;margin-top:10rpx;color:#707872;font-size:25rpx}.current button{float:right;margin-top:-48rpx;background:#078143;color:#fff;border-radius:22rpx;font-size:26rpx}.notice{margin-top:26rpx;padding:24rpx;border:2rpx solid rgba(34,192,100,.45);border-radius:20rpx;background:rgba(0,65,38,.76);color:#fff;font-size:24rpx;line-height:1.6}.empty{margin-top:250rpx;padding:70rpx 40rpx;border-radius:26rpx;background:#fff;text-align:center}.empty image{width:180rpx;height:180rpx}.empty text{display:block;margin-top:34rpx;font-size:36rpx;font-weight:900}.empty button{margin-top:40rpx;background:#078143;color:#fff;border-radius:22rpx}.loading,.error{margin-top:30rpx;color:#fff;text-align:center}.error{padding:20rpx;border-radius:16rpx;background:#fff0ee;color:#a43e38}
