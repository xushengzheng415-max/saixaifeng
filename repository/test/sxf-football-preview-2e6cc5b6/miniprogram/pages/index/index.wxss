/* pages/index/index.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.user-bar {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  background: linear-gradient(135deg, #2E7D32, #4CAF50);
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 2rpx solid rgba(255,255,255,0.5);
}

.user-info {
  flex: 1;
}

.nickname {
  font-size: 30rpx;
  font-weight: bold;
  color: #fff;
  display: block;
}

.role-tag {
  font-size: 22rpx;
  color: #2E7D32;
  background: rgba(255,255,255,0.9);
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  margin-top: 4rpx;
  display: inline-block;
}

.logout {
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
  padding: 10rpx 20rpx;
}

.section {
  margin: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
  color: #212121;
}

.more {
  font-size: 26rpx;
  color: #2E7D32;
}

.team-scroll {
  display: flex;
  gap: 16rpx;
}

.team-card {
  background: #E8F5E9;
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
}

.team-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #2E7D32;
  display: block;
  margin-bottom: 4rpx;
}

.team-count {
  font-size: 22rpx;
  color: #757575;
}

.match-item {
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.match-teams {
  font-size: 28rpx;
  font-weight: bold;
  color: #212121;
  display: block;
}

.match-time {
  font-size: 24rpx;
  color: #757575;
  display: block;
  margin-top: 4rpx;
}

.empty {
  text-align: center;
  padding: 30rpx;
  color: #9e9e9e;
  font-size: 26rpx;
}

.goToTeam {
  margin-top: 20rpx;
}