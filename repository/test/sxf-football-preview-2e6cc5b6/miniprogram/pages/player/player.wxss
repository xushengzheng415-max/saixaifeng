/* pages/player/player.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 140rpx;
}

.team-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  background: #2E7D32;
}

.team-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.player-count {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.player-list {
  padding: 20rpx;
}

.player-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.player-photo {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
  border: 2rpx solid #e0e0e0;
}

.jersey-num {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #E8F5E9;
  color: #2E7D32;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.player-info {
  flex: 1;
}

.name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.player-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #212121;
  margin-right: 12rpx;
}

.position-tag {
  font-size: 22rpx;
  color: #1565C0;
  background: #E3F2FD;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  margin-right: 8rpx;
}

.bind-tag {
  font-size: 20rpx;
  color: #F44336;
  background: #FFEBEE;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  margin-left: 8rpx;
}

.captain-tag {
  font-size: 22rpx;
  color: #E65100;
  background: #FFF3E0;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  margin-left: 8rpx;
}

.meta-row {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}

.jersey-name-row {
  margin-bottom: 4rpx;
}

.jersey-name {
  font-size: 24rpx;
  color: #2E7D32;
  font-weight: bold;
  letter-spacing: 2rpx;
  font-style: italic;
}

.meta-item {
  font-size: 24rpx;
  color: #757575;
}

.meta-item.phone {
  color: #2E7D32;
}

.player-actions {
  display: flex;
  gap: 10rpx;
  flex-shrink: 0;
}

.action-btn {
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
}

.action-btn.edit {
  color: #2E7D32;
  background: #E8F5E9;
}

.action-btn.delete {
  color: #F44336;
  background: #FFEBEE;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #212121;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #757575;
}

.add-btn {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  background: #2E7D32;
  border-radius: 40rpx;
  padding: 16rpx 32rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(46, 125, 50, 0.3);
}

.add-icon {
  font-size: 44rpx;
  color: #fff;
  font-weight: 300;
  margin-right: 8rpx;
}

.add-text {
  font-size: 28rpx;
  color: #fff;
}