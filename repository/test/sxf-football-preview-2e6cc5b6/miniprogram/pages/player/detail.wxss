/* pages/player/detail.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx 30rpx 120rpx;
}

.form-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}

.form-item {
  margin-bottom: 28rpx;
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

/* 球员照片 */
.photo-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.photo-upload {
  margin-top: 12rpx;
}

.photo-preview {
  width: 200rpx;
  height: 240rpx;
  border-radius: 16rpx;
  border: 3rpx solid #e0e0e0;
}

.photo-placeholder {
  width: 200rpx;
  height: 240rpx;
  border: 3rpx dashed #bdbdbd;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fafafa;
}

.photo-icon {
  font-size: 60rpx;
  margin-bottom: 8rpx;
}

.photo-hint {
  font-size: 24rpx;
  color: #bdbdbd;
}

.form-item.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.label {
  font-size: 28rpx;
  color: #212121;
  font-weight: bold;
  display: block;
  margin-bottom: 12rpx;
}

.form-item.row .label {
  margin-bottom: 0;
}

.input {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.textarea {
  width: 100%;
  height: 140rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 球衣名 */
.jersey-name-box {
  margin-top: 8rpx;
}

.jersey-input {
  font-weight: bold;
  letter-spacing: 4rpx;
  color: #2E7D32;
}

.example {
  font-size: 22rpx;
  color: #9e9e9e;
  margin-top: 8rpx;
  display: block;
}

.auto-hint {
  font-size: 22rpx;
  color: #FFA000;
  margin-top: 8rpx;
  display: block;
}

/* 自动识别字段 */
.auto-field {
  height: 80rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  background: #E8F5E9;
  box-sizing: border-box;
}

.auto-value {
  flex: 1;
  font-size: 28rpx;
  color: #2E7D32;
  font-weight: bold;
}

.auto-badge {
  font-size: 20rpx;
  color: #fff;
  background: #2E7D32;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}

/* 位置选择 */
.position-list {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.pos-tag {
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #757575;
  background: #f5f5f5;
  border-radius: 24rpx;
  border: 2rpx solid transparent;
}

.pos-tag.active {
  color: #2E7D32;
  background: #E8F5E9;
  border-color: #2E7D32;
}

.picker-value {
  height: 80rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  line-height: 80rpx;
  color: #9e9e9e;
  box-sizing: border-box;
}

/* 横向布局 */
.form-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.form-row .input {
  flex: 1;
}

.input-sep {
  font-size: 28rpx;
  color: #9e9e9e;
  flex-shrink: 0;
}

.input-group {
  flex: 1;
}

/* 保存按钮 */
.save-btn {
  margin-top: 30rpx;
  height: 88rpx;
  background: #2E7D32;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 44rpx;
}