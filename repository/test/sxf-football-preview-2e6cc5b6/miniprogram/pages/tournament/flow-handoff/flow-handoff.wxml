<view class="page"><image class="bg" src="/images/runtime/team-data-emerald-stadium-v1.jpg" mode="aspectFill"/><view class="content"><view class="nav"><text class="back" bindtap="onBack">‹</text><text class="title">交接说明</text></view><view class="hero"><text class="hero-title">{{title}}</text></view><view class="steps"><view class="step" wx:for="{{steps}}" wx:key="index" data-url="{{item.url}}" bindtap="onStepTap"><view class="index">{{item.index}}</view><view class="step-body"><text class="role">{{item.role}}</text><text class="step-title">{{item.title}}</text><text class="action">{{item.state}} ›</text></view></view></view><view class="boundary"><text class="boundary-title">责任边界</text><text wx:if="{{isPlayer}}">长期球队资料、赛事正式名单和单场阵容是三类独立数据；日常修改不会覆盖已审核或完赛快照。</text><text wx:else>赛中事件与比分由裁判负责写入；主办方赛中只读，赛后仅进行受控复核与归档。</text></view><button class="primary" bindtap="onPrimary">{{primaryText}}</button></view></view>
