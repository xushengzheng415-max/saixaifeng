/* 赛事列表页 */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #F1F8E9 0%, #FFFFFF 100%);
  padding-bottom: 120rpx;
}

/* 搜索栏 */
.search-bar {
  padding: 20rpx 24rpx;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.search-input-wrapper {
  display: flex;
  align-items: center;
  background: #F5F5F5;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

/* Tab 导航 */
.tab-bar {
  display: flex;
  background: #fff;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #E0E0E0;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #757575;
  position: relative;
}

.tab-item.active {
  color: #2E7D32;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: #2E7D32;
  border-radius: 2rpx;
}

/* 加载中 */
.loading-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 100rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 赛事列表 */
.tournament-list {
  padding: 24rpx;
  height: calc(100vh - 280rpx);
}

/* 赛事卡片 */
.tournament-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
}

/* 卡片头部 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #E8F5E9 0%, #F1F8E9 100%);
  border-bottom: 1rpx solid rgba(46, 125, 50, 0.1);
}

.tournament-type-tag {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.tournament-type-tag.tournament {
  background: rgba(67, 160, 71, 0.1);
  color: #2E7D32;
}

.tournament-type-tag.cup {
  background: rgba(255, 152, 0, 0.1);
  color: #F57C00;
}

.tournament-type-tag.league {
  background: rgba(33, 150, 243, 0.1);
  color: #1976D2;
}

.tournament-type-tag.combined {
  background: rgba(156, 39, 176, 0.1);
  color: #7B1FA2;
}

.type-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.type-text {
  font-weight: 500;
}

.status-tag {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.status-tag.registering {
  background: #FFF3E0;
  color: #F57C00;
}

.status-tag.ongoing {
  background: #E8F5E9;
  color: #43A047;
}

.status-tag.completed {
  background: #F5F5F5;
  color: #757575;
}

/* 卡片主体 */
.card-body {
  padding: 24rpx;
}

.tournament-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #212121;
  margin-bottom: 16rpx;
  display: block;
}

.info-row {
  margin-bottom: 12rpx;
}

.info-item {
  display: flex;
  align-items: center;
}

.info-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.info-text {
  font-size: 26rpx;
  color: #666;
}

/* 统计数据 */
.stats-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F0F0F0;
}

.stat-item {
  display: flex;
  align-items: baseline;
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #2E7D32;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-left: 4rpx;
}

.stat-divider {
  width: 1rpx;
  height: 32rpx;
  background: #E0E0E0;
  margin: 0 32rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  color: #212121;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
}

/* 创建按钮 */
.fab-btn {
  position: fixed;
  right: 32rpx;
  bottom: 32rpx;
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #43A047 0%, #2E7D32 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(46, 125, 50, 0.4);
}

.fab-icon {
  font-size: 48rpx;
  color: #fff;
  font-weight: 300;
}
