.page{min-height:100vh;background:#f5f7f5}.hero{min-height:505rpx;padding:70rpx 34rpx 0;background-image:linear-gradient(180deg,rgba(0,20,14,.9),rgba(0,75,47,.9)),url('/images/runtime/stadium-tech-bg.jpg');background-size:cover}.nav{height:76rpx;text-align:center;position:relative}.back{position:absolute;left:0;color:#fff;font-size:68rpx;line-height:50rpx}.title{color:#fff;font-size:39rpx;font-weight:700}.score-card{margin-top:37rpx;padding:27rpx;border:2rpx solid #1aa46a;border-radius:29rpx;background:rgba(0,68,42,.88);color:#fff}.score-top,.score-row,.evidence,.actions{display:flex;align-items:center;justify-content:space-between}.status{padding:9rpx 14rpx;border-radius:19rpx;background:rgba(196,143,27,.68);color:#ffe6a1;font-size:20rpx}.record-no{display:block;margin-top:15rpx;color:#cbe7d7;font-size:21rpx}.score-row{margin-top:27rpx}.score-row text{width:180rpx;font-size:24rpx;text-align:center}.score-value{font-size:60rpx}.venue{display:block;margin-top:15rpx;text-align:center;color:#c7e4d3;font-size:23rpx}.content{padding:0 34rpx 120rpx;margin-top:-8rpx}.loading,.error,.denied{padding:90rpx 0;text-align:center;color:#839088}.error{color:#bc5146}.evidence{padding:25rpx 12rpx;border-radius:23rpx;background:#fff;box-shadow:0 8rpx 24rpx rgba(15,55,36,.07)}.evidence view{width:25%;text-align:center;border-right:1rpx solid #e5ebe7}.evidence view:last-child{border:0}.evidence text{display:block;font-size:20rpx;color:#526b5d}.evidence-value{display:block;margin-top:9rpx;color:#197451;font-size:22rpx}.referee,.reason{margin-top:20rpx;padding:25rpx;border-radius:22rpx;background:#fff}.referee text{display:block}.referee-value{display:block;margin:9rpx 0;font-size:30rpx}.referee text:last-child{color:#839088;font-size:21rpx}.notice{margin-top:20rpx;padding:24rpx;border:1rpx solid #f0d5a0;border-radius:18rpx;background:#fff9ee;color:#785323;font-size:23rpx;line-height:1.65}.reason text{display:block;font-size:26rpx;font-weight:600}.reason textarea{width:100%;height:145rpx;margin-top:18rpx;padding:16rpx;border:1rpx solid #dfe6e1;border-radius:14rpx;box-sizing:border-box;font-size:23rpx}.actions{gap:20rpx;margin-top:28rpx}.actions button{flex:1;font-size:27rpx}.return{color:#d83c35;background:#fff;border:2rpx solid #e4554d}.archive{color:#fff;background:#087d4e}
.page{padding-top:0}.hero{padding-top:0}.nav{height:208rpx;box-sizing:border-box;align-items:flex-end;padding-bottom:28rpx}.back{bottom:16rpx}
