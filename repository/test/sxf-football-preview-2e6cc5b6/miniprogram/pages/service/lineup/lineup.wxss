page { background: #F4F7F4; min-height: 100%; }
.page { min-height: 100vh; padding: 22rpx 22rpx 40rpx; box-sizing: border-box; }
.match-header { padding: 32rpx 26rpx; color: #fff; border-radius: 24rpx; background: linear-gradient(135deg, #174C20, #43A047); text-align: center; box-shadow: 0 8rpx 26rpx rgba(23,76,32,.18); }
.tournament-name, .team-name, .opponent-name, .match-meta { display: block; }
.tournament-name { font-size: 23rpx; opacity: .78; }
.team-name { margin-top: 15rpx; font-size: 39rpx; font-weight: 800; }
.opponent-name { margin-top: 10rpx; font-size: 27rpx; }
.match-meta { margin-top: 12rpx; font-size: 23rpx; opacity: .86; }
.loading-card, .error-card, .empty-card { margin-top: 22rpx; padding: 42rpx 28rpx; border-radius: 20rpx; background: #fff; color: #68736A; font-size: 27rpx; text-align: center; }
.error-card { color: #C62828; }
.plain-btn { margin-top: 22rpx; height: 76rpx; line-height: 76rpx; color: #1B5E20; border-radius: 38rpx; border: 2rpx solid #A8C9AD; background: #F7FBF7; }
.progress-card { display: flex; align-items: center; justify-content: space-between; margin-top: 22rpx; padding: 24rpx 26rpx; border-radius: 20rpx; background: #fff; box-shadow: 0 5rpx 18rpx rgba(23,76,32,.06); }
.progress-title, .progress-tip { display: block; }
.progress-title { color: #18331D; font-size: 29rpx; font-weight: 750; }
.progress-tip { margin-top: 6rpx; color: #889089; font-size: 23rpx; }
.count-badge { min-width: 94rpx; padding: 14rpx 18rpx; border-radius: 30rpx; color: #1B5E20; background: #E6F2E8; font-size: 28rpx; font-weight: 800; text-align: center; }
.readonly-tip { margin-top: 18rpx; padding: 18rpx 22rpx; color: #1B5E20; background: #E5F2E7; border-radius: 16rpx; font-size: 25rpx; text-align: center; }
.player-list { margin-top: 18rpx; display: flex; flex-direction: column; gap: 12rpx; }
.player-row { display: flex; align-items: center; min-height: 96rpx; padding: 16rpx 20rpx; border: 2rpx solid transparent; border-radius: 18rpx; background: #fff; box-shadow: 0 4rpx 14rpx rgba(23,76,32,.05); box-sizing: border-box; }
.player-row.selected { border-color: #43A047; background: #F1FAF2; }
.number-box { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; color: #1B5E20; background: #E8F3E9; border-radius: 15rpx; font-size: 28rpx; font-weight: 800; }
.player-info { flex: 1; min-width: 0; padding: 0 20rpx; }
.player-name, .player-position { display: block; }
.player-name { color: #18331D; font-size: 30rpx; font-weight: 700; }
.player-position { margin-top: 5rpx; color: #8A928B; font-size: 23rpx; }
.check-box { display: flex; align-items: center; justify-content: center; width: 46rpx; height: 46rpx; border: 3rpx solid #C8D2C9; border-radius: 50%; color: #fff; font-size: 28rpx; font-weight: 800; }
.check-box.selected { border-color: #2E7D32; background: #2E7D32; }
.bottom-space { height: 150rpx; }
.bottom-bar { position: fixed; left: 0; right: 0; bottom: 0; display: flex; align-items: center; gap: 20rpx; padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); background: rgba(255,255,255,.97); box-shadow: 0 -6rpx 24rpx rgba(20,50,25,.09); z-index: 10; }
.bottom-count { width: 150rpx; }
.bottom-label, .bottom-number { display: block; }
.bottom-label { color: #7A847C; font-size: 22rpx; }
.bottom-number { margin-top: 2rpx; color: #1B5E20; font-size: 31rpx; font-weight: 800; }
.submit-btn { flex: 1; height: 88rpx; line-height: 88rpx; border-radius: 44rpx; color: #fff; font-size: 30rpx; font-weight: 750; background: linear-gradient(135deg, #1B5E20, #43A047); }
.submit-btn[disabled] { color: #fff; background: #A9B7AB; }
.back-btn { margin-top: 24rpx; color: #1B5E20; background: transparent; font-size: 27rpx; }
button::after { border: none; }
