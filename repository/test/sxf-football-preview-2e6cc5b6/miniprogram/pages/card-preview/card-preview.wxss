/* pages/card-preview/card-preview.wxss */
/* 深色精美球员卡预览 */

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #0f0c29 0%, #302b63 50%, #24243e 100%);
  padding: 20rpx;
  padding-bottom: 120rpx;
}

.preview-section {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 精美卡片 */
.card-preview {
  width: 600rpx;
  border-radius: 24rpx;
  overflow: hidden;
  position: relative;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.5);
}

/* 卡片背景 - 深色渐变 */
.card-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 0;
}

.card-preview.gold .card-bg {
  background: linear-gradient(135deg, #1a1a2e 0%, #2d2d5e 30%, #3d2d1e 70%, #4a3a1e 100%);
}

.card-preview.silver .card-bg {
  background: linear-gradient(135deg, #1a1a2e 0%, #2d3d4e 30%, #3d4d5e 70%, #4a5a6e 100%);
}

.card-preview.bronze .card-bg {
  background: linear-gradient(135deg, #1a1a2e 0%, #2e2420 30%, #3e2e1e 70%, #4e3e2e 100%);
}

/* 金色光效 */
.card-preview.gold .card-bg::after {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; height: 200rpx;
  background: linear-gradient(180deg, rgba(255,215,0,0.15) 0%, transparent 100%);
}

/* 卡片内容 */
.card-preview > view:not(.card-bg) {
  position: relative;
  z-index: 1;
}

/* 顶部 */
.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
}

.team-logo-box {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.team-logo-img {
  width: 50rpx;
  height: 50rpx;
}

.tier-badge {
  font-size: 22rpx;
  font-weight: bold;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

.tier-badge.gold {
  background: linear-gradient(90deg, #FFD700, #FFA500);
  color: #333;
}

.tier-badge.silver {
  background: linear-gradient(90deg, #E8E8E8, #A0A0A0);
  color: #333;
}

.tier-badge.bronze {
  background: linear-gradient(90deg, #CD7F32, #8B4513);
  color: #fff;
}

/* 头像 */
.avatar-section {
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
}

.avatar-circle {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255,255,255,0.3);
  overflow: hidden;
  background: rgba(0,0,0,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.4);
}

.card-preview.gold .avatar-circle {
  border-color: rgba(255,215,0,0.5);
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  font-size: 80rpx;
}

/* 球员信息 */
.player-info {
  text-align: center;
  padding: 0 30rpx;
  margin-bottom: 24rpx;
}

.player-name {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
  display: block;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.5);
}

.player-role {
  font-size: 26rpx;
  color: rgba(255,255,255,0.7);
  display: block;
  margin-top: 4rpx;
}

.player-number {
  font-size: 36rpx;
  font-weight: bold;
  color: #FFD700;
  display: block;
  margin-top: 8rpx;
}

/* 数据网格 */
.data-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 20rpx 30rpx 30rpx;
}

.data-row {
  background: rgba(0,0,0,0.2);
  border-radius: 12rpx;
  padding: 16rpx;
}

.data-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
  display: block;
  margin-bottom: 4rpx;
}

.data-value {
  font-size: 26rpx;
  font-weight: bold;
  color: #fff;
  display: block;
}

.data-value.jersey {
  color: #FFD700;
  letter-spacing: 2rpx;
}

/* 空状态 */
.empty-state {
  width: 600rpx;
  height: 800rpx;
  background: rgba(255,255,255,0.05);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255,255,255,0.6);
  font-size: 28rpx;
}

/* 操作按钮 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(15,12,41,0.95);
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.1);
  color: #fff;
  font-size: 28rpx;
  gap: 8rpx;
}

.action-btn.primary {
  background: linear-gradient(135deg, #FFD700, #FFA500);
  color: #333;
}
